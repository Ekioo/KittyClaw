{
  "setup": [
    { "type": "createProject", "name": "qa-160-decision-brief" },
    {
      "type": "api",
      "method": "GET",
      "path": "/api/projects/qa-160-decision-brief/columns"
    },
    {
      "type": "api",
      "method": "PATCH",
      "path": "/api/projects/qa-160-decision-brief/columns/6",
      "body": { "role": 4 }
    },
    {
      "type": "api",
      "method": "PUT",
      "path": "/api/projects/qa-160-decision-brief/columns/6/processor",
      "body": {
        "name": "Owner decision routing",
        "mission": "Expose the configured owner decision destinations.",
        "enabled": false,
        "defaultTargetColumnId": 7,
        "routes": [
          { "outcome": "approved", "targetColumnId": 7 },
          { "outcome": "changes_requested", "targetColumnId": 2 }
        ]
      }
    },
    {
      "type": "createTicket",
      "project": "qa-160-decision-brief",
      "title": "Verify decision brief panel renders in Review",
      "status": "Todo"
    },
    {
      "type": "setStatus",
      "project": "qa-160-decision-brief",
      "status": "Review"
    }
  ],
  "actions": [
    { "type": "navigate", "url": "/board/qa-160-decision-brief/ticket/{ticketId}" },
    { "type": "wait", "ms": 3000 },
    {
      "type": "screenshot",
      "name": "qa-160-brief-panel-empty",
      "description": "DecisionBriefPanel in Review column (OwnerAction) — no evidence seeded, with owner actions resolved from configured routing."
    },
    { "type": "assertVisible", "selector": ".decision-brief-panel" },
    { "type": "assertVisible", "selector": ".decision-brief-actions" },
    { "type": "assertVisible", "selector": ".decision-brief-empty" },
    { "type": "assertVisible", "selector": ".brief-action-btn--correct" }
  ],
  "verdict": { "passOn": "all-asserts-pass" }
}
