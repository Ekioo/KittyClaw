    { "type": "assertJson", "path": "/api/projects/qa-repository-254", "jsonPath": "resolvedRepositoryPath", "expected": "C:\\Sources\\KittyClaw\\Sources" },
    { "type": "screenshot", "name": "nested-code-repository-settings", "description": "Control workspace and explicitly resolved nested code repository" }
  ],
  "verdict": { "passOn": "all-asserts-pass" }
