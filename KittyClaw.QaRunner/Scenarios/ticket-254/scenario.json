  "setup": [
    { "type": "createProject", "name": "qa-repository-254", "workspacePath": "C:\\Sources\\KittyClaw" },
    { "type": "api", "method": "PATCH", "path": "/api/projects/qa-repository-254", "body": { "repositoryPath": "Sources", "worktreesEnabled": true, "integrationBranch": "dev" } }
