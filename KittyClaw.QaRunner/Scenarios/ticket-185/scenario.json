{
  "setup": [
    { "type": "createTemporaryDirectory", "saveAs": "repositoryPath", "initializeGit": true }
  ],
  "actions": [
    { "type": "navigate", "url": "/" },
    { "type": "wait", "ms": 1200 },
    { "type": "click", "selector": ".unified-page-header > .settings-primary" },
    { "type": "fill", "selector": "#new-project-name", "value": "Dashboard guidance journey" },
    { "type": "fill", "selector": "#repository-path", "value": "{repositoryPath}" },
    { "type": "fill", "selector": "#first-objective", "value": "Deliver a visible first dashboard result" },
    { "type": "click", "selector": "#validate-repository" },
    { "type": "wait", "ms": 1600 },
    { "type": "click", "selector": "#confirm-first-ticket" },
    { "type": "wait", "ms": 3000 },
    { "type": "navigate", "url": "/board/dashboard-guidance-journey/dashboard" },
    { "type": "wait", "ms": 1000 },
    { "type": "assertVisible", "selector": "[data-testid='dashboard-guidance']" },
    { "type": "assertVisible", "selector": "[data-testid='dashboard-primary-action']" },
    { "type": "assertVisible", "selector": "[data-testid='dashboard-real-activity']" },
    { "type": "screenshot", "name": "progressive-dashboard-guidance", "description": "Progressive first-result guidance alongside real ticket and run activity" },
    { "type": "navigate", "url": "/board/dashboard-guidance-journey" },
    { "type": "navigate", "url": "/board/dashboard-guidance-journey/dashboard" },
    { "type": "wait", "ms": 600 },
    { "type": "assertVisible", "selector": "[data-testid='dashboard-guidance']" },
    { "type": "assertVisible", "selector": "[data-testid='dashboard-real-activity']" }
  ],
  "verdict": { "passOn": "all-asserts-pass" }
}
