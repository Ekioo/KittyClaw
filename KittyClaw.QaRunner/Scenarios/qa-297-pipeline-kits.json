{
  "setup": [
    { "type": "createWorkspaceDirectory", "name": "kitWorkspace" },
    { "type": "writeWorkspaceFile", "workspacePath": "{kitWorkspace}", "name": ".agents/skills/demo/SKILL.md", "text": "---\nname: demo\ndescription: demo\n---\n\nPortable demo skill.\n" },
    { "type": "createProject", "name": "qa-pipeline-kits", "workspacePath": "{kitWorkspace}" },
    { "type": "api", "method": "PUT", "path": "/api/projects/qa-pipeline-kits/secrets/DEPLOY_TOKEN", "body": { "value": "qa-only-secret" } },
    { "type": "api", "method": "POST", "path": "/api/projects/qa-pipeline-kits/pipelines", "body": { "name": "Portable Safe" }, "extract": { "safePipelineId": "id" } },
    { "type": "api", "method": "POST", "path": "/api/projects/qa-pipeline-kits/pipelines", "body": { "name": "Blocked Export" }, "extract": { "blockedPipelineId": "id" } },
    { "type": "api", "method": "POST", "path": "/api/projects/qa-pipeline-kits/columns", "body": { "name": "Ready", "pipelineId": 2 }, "extract": { "safeColumnId": "id" } },
    { "type": "api", "method": "POST", "path": "/api/projects/qa-pipeline-kits/columns", "body": { "name": "Execute", "pipelineId": 3 }, "extract": { "blockedColumnId": "id" } },
    { "type": "api", "method": "PUT", "path": "/api/projects/qa-pipeline-kits/columns/{safeColumnId}/processor", "body": { "name": "Portable worker", "mission": "Deploy to {{input.REGION}} with {{secret.TOKEN}}", "prompt": "Review every action", "enabled": true, "maxTurns": 10, "availableSkills": ["demo"], "recommendedSkills": ["demo"], "requiredSkills": ["demo"], "selectionOrder": "Position", "maxAttempts": 1, "retryBackoffSeconds": 1, "routes": [], "beforeActions": [{ "id": "shell", "action": { "type": "executePowerShell", "script": "Write-Output safe" } }, { "id": "network", "action": { "type": "httpRequest", "method": "POST", "url": "https://example.invalid/hook" } }], "afterActions": [] } },
    { "type": "api", "method": "PUT", "path": "/api/projects/qa-pipeline-kits/columns/{blockedColumnId}/processor", "body": { "name": "Unsafe processor", "mission": "Demonstrate scanner refusal", "prompt": "Read Z:/fixtures/private-token.txt before continuing", "enabled": false, "maxTurns": 10, "selectionOrder": "Position", "maxAttempts": 1, "retryBackoffSeconds": 1, "routes": [], "beforeActions": [], "afterActions": [] } },
    { "type": "apiBinary", "path": "/api/projects/qa-pipeline-kits/pipelines/{safePipelineId}/export", "name": "safeKit" },
    { "type": "writeWorkspaceFile", "workspacePath": "{kitWorkspace}", "name": ".agents/skills/demo/SKILL.md", "text": "---\nname: demo\ndescription: divergent\n---\n\nExisting target skill must never be overwritten.\n" }
  ],
  "actions": [
    { "type": "navigate", "url": "/board/qa-pipeline-kits/settings" },
    { "type": "wait", "ms": 800 },
    { "type": "selectOption", "selector": ".settings-section select.settings-input", "value": "fr" },
    { "type": "wait", "ms": 400 },
    { "type": "navigate", "url": "/board/qa-pipeline-kits/workflows" },
    { "type": "wait", "ms": 800 },
    { "type": "click", "selector": "button[data-pipeline-id='{safePipelineId}']" },
    { "type": "click", "selector": "button[data-testid='open-pipeline-kits']" },
    { "type": "assertFocused", "selector": ".pipeline-kit-dialog" },
    { "type": "assertText", "selector": "#pipeline-kit-title", "expected": "Exporter ou importer un pipeline" },
    { "type": "click", "selector": "button[data-testid='review-pipeline-export']" },
    { "type": "wait", "ms": 700 },
    { "type": "assertText", "selector": ".pipeline-kit-alert.safe", "expected": "Le scanner de sécurité n’a détecté aucun blocage. Vérifiez le contenu complet avant le téléchargement." },
    { "type": "download", "selector": "button[data-testid='download-pipeline-kit']", "expected": "portable-safe.kittyclaw-pipeline" },
    { "type": "screenshot", "name": "297-export-review-fr", "selector": ".pipeline-kit-dialog", "description": "French safe-export review and successful downloadable kit" },
    { "type": "press", "selector": ".pipeline-kit-dialog", "property": "Escape" },
    { "type": "assertCount", "selector": ".pipeline-kit-dialog", "expected": "0" },

    { "type": "click", "selector": "button[data-pipeline-id='{blockedPipelineId}']" },
    { "type": "click", "selector": "button[data-testid='open-pipeline-kits']" },
    { "type": "click", "selector": "button[data-testid='review-pipeline-export']" },
    { "type": "wait", "ms": 700 },
    { "type": "assertVisible", "selector": ".pipeline-kit-alert.danger" },
    { "type": "screenshot", "name": "297-export-blocked-fr", "selector": ".pipeline-kit-dialog", "description": "French scanner refusal with actionable correction" },
    { "type": "click", "selector": ".dialog-close" },

    { "type": "click", "selector": "button[data-pipeline-id='{safePipelineId}']" },
    { "type": "click", "selector": "button[data-testid='open-pipeline-kits']" },
    { "type": "click", "selector": "button[data-testid='pipeline-kit-import-tab']" },
    { "type": "setInputFile", "selector": ".pipeline-kit-drop input[type=file]", "value": "bm90LWEtY29tcGF0aWJsZS1raXQ=", "name": "invalid.kittyclaw-pipeline", "property": "application/zip" },
    { "type": "wait", "ms": 500 },
    { "type": "assertVisible", "selector": ".pipeline-kit-alert.danger" },
    { "type": "assertJson", "path": "/api/projects/qa-pipeline-kits/pipelines", "jsonPath": "length", "expected": "3" },
    { "type": "click", "selector": "button[data-testid='pipeline-kit-export-tab']" },
    { "type": "click", "selector": "button[data-testid='pipeline-kit-import-tab']" },

    { "type": "setViewport", "maxMs": 640, "ms": 1400 },
    { "type": "setInputFile", "selector": ".pipeline-kit-drop input[type=file]", "value": "{safeKit}", "name": "portable-safe.kittyclaw-pipeline", "property": "application/zip" },
    { "type": "wait", "ms": 700 },
    { "type": "assertVisible", "selector": ".pipeline-kit-summary" },
    { "type": "assertVisible", "selector": "input[data-testid='pipeline-kit-pipeline-rename']" },
    { "type": "assertVisible", "selector": "input[data-testid='pipeline-kit-skill-rename']" },
    { "type": "assertVisible", "selector": "input[data-testid='pipeline-kit-parameter']" },
    { "type": "assertAttribute", "selector": "input[data-testid='pipeline-kit-secret-binding']", "property": "type", "expected": "password" },
    { "type": "assertAttribute", "selector": "input[data-testid='pipeline-kit-secret-binding']", "property": "autocomplete", "expected": "new-password" },
    { "type": "assertCount", "selector": ".pipeline-kit-approval", "expected": "2" },
    { "type": "assertJson", "path": "/api/projects/qa-pipeline-kits/pipelines", "jsonPath": "length", "expected": "3" },
    { "type": "screenshot", "name": "297-import-preview-decisions-fr-narrow", "selector": ".pipeline-kit-dialog", "description": "Narrow French preview with collision remapping, parameter, masked vault binding and separate approvals before any write" },
    { "type": "scrollIntoView", "selector": ".pipeline-kit-approval:last-of-type" },
    { "type": "screenshot", "name": "297-import-approvals-fr-narrow", "selector": ".pipeline-kit-dialog", "description": "Narrow French decision area showing masked vault binding, separate PowerShell and network approvals, executable content and disabled reasons" },
    { "type": "click", "selector": "button[data-testid='cancel-pipeline-import']" },
    { "type": "assertJson", "path": "/api/projects/qa-pipeline-kits/pipelines", "jsonPath": "length", "expected": "3" },

    { "type": "setInputFile", "selector": ".pipeline-kit-drop input[type=file]", "value": "{safeKit}", "name": "portable-safe.kittyclaw-pipeline", "property": "application/zip" },
    { "type": "wait", "ms": 500 },
    { "type": "fill", "selector": "input[data-testid='pipeline-kit-pipeline-rename']", "value": "Race Import" },
    { "type": "fill", "selector": "input[data-testid='pipeline-kit-skill-rename']", "value": "demo-imported" },
    { "type": "api", "method": "POST", "path": "/api/projects/qa-pipeline-kits/pipelines", "body": { "name": "Race Import" } },
    { "type": "click", "selector": "button[data-testid='confirm-pipeline-import']" },
    { "type": "wait", "ms": 500 },
    { "type": "assertVisible", "selector": ".pipeline-kit-alert.danger" },
    { "type": "assertJson", "path": "/api/projects/qa-pipeline-kits/pipelines", "jsonPath": "length", "expected": "4" },
    { "type": "click", "selector": "button[data-testid='cancel-pipeline-import']" },

    { "type": "setInputFile", "selector": ".pipeline-kit-drop input[type=file]", "value": "{safeKit}", "name": "portable-safe.kittyclaw-pipeline", "property": "application/zip" },
    { "type": "wait", "ms": 500 },
    { "type": "fill", "selector": "input[data-testid='pipeline-kit-pipeline-rename']", "value": "Portable Imported" },
    { "type": "fill", "selector": "input[data-testid='pipeline-kit-skill-rename']", "value": "demo-imported" },
    { "type": "fill", "selector": "input[data-testid='pipeline-kit-parameter']", "value": "eu-west" },
    { "type": "fill", "selector": "input[data-testid='pipeline-kit-secret-binding']", "value": "DEPLOY_TOKEN" },
    { "type": "click", "selector": ".pipeline-kit-approval input >> nth=0" },
    { "type": "assertCount", "selector": ".pipeline-kit-approval input:checked", "expected": "1" },
    { "type": "click", "selector": ".pipeline-kit-approval input >> nth=1" },
    { "type": "assertCount", "selector": ".pipeline-kit-approval input:checked", "expected": "2" },
    { "type": "doubleClick", "selector": "button[data-testid='confirm-pipeline-import']" },
    { "type": "wait", "ms": 900 },
    { "type": "assertVisible", "selector": ".pipeline-kit-alert.safe" },
    { "type": "assertText", "selector": ".pipeline-kit-alert.safe strong", "expected": "Pipeline importé" },
    { "type": "assertJson", "path": "/api/projects/qa-pipeline-kits/pipelines", "jsonPath": "length", "expected": "5" },
    { "type": "screenshot", "name": "297-import-confirmed-active-fr", "selector": ".pipeline-kit-dialog", "description": "Single atomic import after double-click, with explicit active state after every decision is resolved" }
  ],
  "verdict": { "passOn": "all-asserts-pass" }
}
