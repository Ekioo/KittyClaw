{
  "setup": [
    { "type": "createProject", "name": "qa-156-model-persistence" },
    {
      "type": "api",
      "method": "POST",
      "path": "/api/projects/qa-156-model-persistence/members",
      "body": { "name": "programmer" }
    },
    {
      "type": "createTicket",
      "project": "qa-156-model-persistence",
      "title": "Model persistence verification",
      "status": "Todo",
      "assignedTo": "programmer"
    }
  ],
  "actions": [
    { "type": "navigate", "url": "/board/qa-156-model-persistence/ticket/{ticketId}" },
    { "type": "wait", "ms": 1500 },
    { "type": "click", "selector": ".chat-with-agent-btn" },
    { "type": "selectOption", "selector": ".chat-drawer-model-select", "value": "claude-fable-5-1" },
    { "type": "assertValue", "selector": ".chat-drawer-model-select", "expected": "claude-fable-5-1" },
    { "type": "click", "selector": ".chat-drawer .agent-close-btn" },
    { "type": "assertInteractionDuration", "selector": ".chat-with-agent-btn", "waitForSelector": ".chat-drawer-model-select:has(option[value='claude-fable-5-1']:checked)", "maxMs": 5000 },
    { "type": "assertValue", "selector": ".chat-drawer-model-select", "expected": "claude-fable-5-1" },
    {
      "type": "screenshot",
      "name": "qa-156-model-restored",
      "description": "The reopened New instruction drawer retains claude-fable-5-1."
    }
  ],
  "verdict": { "passOn": "all-asserts-pass" }
}
