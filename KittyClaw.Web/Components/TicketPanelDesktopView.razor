<div class="ticket-panel ticket-panel-desktop" aria-busy="@(Loading ? "true" : "false")">
    @Header
    <div class="ticket-properties-row">
        @Column
        @Properties
    </div>
    @Context
    @DependencyEditor
    @Content
</div>

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Column { get; set; }
    [Parameter] public RenderFragment? Properties { get; set; }
    [Parameter] public RenderFragment? Context { get; set; }
    [Parameter] public RenderFragment? DependencyEditor { get; set; }
    [Parameter] public RenderFragment? Content { get; set; }
}
