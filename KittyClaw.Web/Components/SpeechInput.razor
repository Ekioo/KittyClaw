@implements IAsyncDisposable
@inject IJSRuntime JS
@inject LocalizationService L

<div class="speech-input @(Compact ? "speech-input-compact" : "")" @ref="_root" data-start="@L["SpeechStart"]" data-stop="@L["SpeechStop"]"
     data-disabled="@Disabled.ToString().ToLowerInvariant()"
     data-insecure="@L["SpeechInsecure"]" data-denied="@L["SpeechDenied"]"
     data-no-microphone="@L["SpeechNoMicrophone"]" data-service-denied="@L["SpeechServiceDenied"]"
     data-language-unsupported="@L["SpeechLanguageUnsupported"]"
     data-unavailable="@L["SpeechUnavailable"]" data-error="@L["SpeechError"]" data-language="@L.Lang">
    <button type="button" class="speech-toggle conversation-submit-action" disabled="@Disabled" aria-pressed="false"
            title="@L["SpeechStart"]" aria-label="@L["SpeechStart"]">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="9" y="2" width="6" height="12" rx="3" />
            <path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3m-4 0h8" />
        </svg>
    </button>
    <span class="speech-status" role="status"></span>
</div>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Compact { get; set; }
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _controller;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (_controller is not null) await _controller.InvokeVoidAsync("refresh");
            return;
        }
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/speech-input.js");
        _controller = await _module.InvokeAsync<IJSObjectReference>("attach", _root);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_controller is not null) { await _controller.InvokeVoidAsync("dispose"); await _controller.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
