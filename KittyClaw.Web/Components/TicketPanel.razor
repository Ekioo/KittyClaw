    private BoardColumn? CurrentColumn() => _ticket is null
        ? null
        : _columns.FirstOrDefault(column => column.Id == _ticket.ColumnId)
          ?? _columns.FirstOrDefault(column => column.Name.Equals(_ticket.Status, StringComparison.OrdinalIgnoreCase));

    private bool _movingColumn;
    private string? _columnMoveError;

    private async Task ChangeColumnAsync(ChangeEventArgs args)
    {
        if (_movingColumn || _ticket is null || !int.TryParse(args.Value?.ToString(), out var id)) return;
        var column = _columns.FirstOrDefault(c => c.Id == id);
        if (column is null || column.Id == CurrentColumn()?.Id) return;
        var ticketId = _ticket.Id;
        var oldStatus = _ticket.Status;
        var oldColumnId = _ticket.ColumnId;
        var pipelineId = _ticket.PipelineId;
        _movingColumn = true;
        _columnMoveError = null;
        try
        {
            await TicketService.UpdateTicketAsync(Slug, ticketId, author: "owner",
                status: column.Name, pipelineId: pipelineId, columnId: column.Id, enforceRouting: true);
            PushUndo?.Invoke($"{L["UndoMove"]} #{ticketId}", async () =>
                await TicketService.UpdateTicketAsync(Slug, ticketId, author: "owner",
                    status: oldStatus, pipelineId: pipelineId, columnId: oldColumnId));
            await RefreshAsync();
            BoardUpdateNotifier.NotifyProjectUpdated(Slug);
        }
        catch (InvalidOperationException ex) { _columnMoveError = ex.GetBaseException().Message.Contains("column_acceptance_criteria_not_validated") ? L["ColumnAcceptanceCriteriaNotValidatedError"] : ex.GetBaseException().Message.Contains("column_acceptance_criteria_required") ? L["ColumnAcceptanceCriteriaRequiredError"] : ex.Message; }
        finally { _movingColumn = false; }
    }

    private string WaitingGuidance(BoardColumn column)
    {
        if (!string.IsNullOrWhiteSpace(column.UserGuidance))
            return column.UserGuidance;

        if (column.Role == ColumnRole.Waiting)
        {
            if (_ticket?.FireAt is DateTime fireAt)
                return L.Get("TicketWaitingScheduledGuidance", UtcToLocal(fireAt).ToString("g"),
                    _ticket.ScheduleTarget ?? L["TicketWaitingNextConfiguredStep"]);

            var summary = _summaries.FirstOrDefault(ticket => ticket.Id == _ticket?.Id);
            if (summary?.SubTickets.Any(child => child.BlocksParent &&
                    child.ColumnRole is not ColumnRole.Success and not ColumnRole.Failure) == true)
                return L["TicketWaitingChildrenGuidance"];

            return L["TicketWaitingAutomaticGuidance"];
        }

        var next = _columns
            .Where(candidate => candidate.SortOrder > column.SortOrder &&
                                candidate.Role is not ColumnRole.Waiting and not ColumnRole.OwnerAction and not ColumnRole.Failure)
            .OrderBy(candidate => candidate.SortOrder)
            .FirstOrDefault();
        var rejected = _columns.FirstOrDefault(candidate => candidate.Role == ColumnRole.Failure);

        if (next is not null && rejected is not null)
            return L.Get("TicketOwnerActionApproveRejectGuidance", EscapeMarkdown(next.Name), EscapeMarkdown(rejected.Name));
        if (next is not null)
            return L.Get("TicketOwnerActionContinueGuidance", EscapeMarkdown(next.Name));
        if (rejected is not null)
            return L.Get("TicketOwnerActionRejectGuidance", EscapeMarkdown(rejected.Name));
        return L["TicketOwnerActionCommentGuidance"];
    }

    private static string EscapeMarkdown(string value) => value
        .Replace("\\", "\\\\", StringComparison.Ordinal)
        .Replace("*", "\\*", StringComparison.Ordinal)
        .Replace("_", "\\_", StringComparison.Ordinal)
        .Replace("[", "\\[", StringComparison.Ordinal)
        .Replace("]", "\\]", StringComparison.Ordinal);

