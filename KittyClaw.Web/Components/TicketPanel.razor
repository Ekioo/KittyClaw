    private void OnProjectUpdatedExternal(string slug)
    {
        if (!slug.Equals(Slug, StringComparison.OrdinalIgnoreCase)) return;
        InvokeAsync(async () =>
        {
            if (_disposed) return;
            _ticket = await TicketService.GetTicketAsync(Slug, TicketId);
            if (_ticket is null)
            {
                // Ticket deleted from elsewhere (API, agent) — close rather than show a husk.
                await OnClose.InvokeAsync();
                return;
            }
            _summaries = await TicketService.ListTicketsAsync(Slug);
            _columns = await ColumnService.ListColumnsAsync(Slug, _ticket.PipelineId);
            _allLabels = await LabelService.ListLabelsAsync(Slug);
            _allMembers = await MemberService.ListMembersAsync(Slug);
            await RebuildPipelineAsync();
            if (!_disposed) StateHasChanged();
        });
    }

    private async Task CloseAsync() => await OnClose.InvokeAsync();

    // ── Markdown pipeline (ticket refs + cross-project refs + mentions) ──

    private MarkdownPipeline _mdPipeline = KittyClaw.Web.Markdown.CommentMarkdownPipeline.Build();

    private readonly Dictionary<string, Dictionary<int, string>> _crossProjectTickets =
        new(StringComparer.OrdinalIgnoreCase);

    private static readonly System.Text.RegularExpressions.Regex CrossProjectRefPattern =
        new(@"#([A-Za-z0-9][A-Za-z0-9-]*):\d+", System.Text.RegularExpressions.RegexOptions.Compiled);

    private async Task FetchCrossProjectTicketsAsync()
    {
        var allText = string.Join('\n', _summaries.Select(t => (t.Description ?? "") + '\n' + t.Title));
        if (_ticket is not null)
            allText += '\n' + string.Join('\n', _ticket.Comments.Select(c => c.Content));

        var foreignSlugs = CrossProjectRefPattern.Matches(allText)
            .Select(m => m.Groups[1].Value.ToLowerInvariant())
            .Where(s => !s.Equals(Slug, StringComparison.OrdinalIgnoreCase))
            .ToHashSet();

        foreach (var foreignSlug in foreignSlugs)
        {
            if (_crossProjectTickets.ContainsKey(foreignSlug)) continue;
            var project = await ProjectService.GetProjectAsync(foreignSlug);
            if (project is null)
            {
                _crossProjectTickets[foreignSlug] = [];
                continue;
            }
            var tickets = await TicketService.ListTicketsAsync(foreignSlug);
            _crossProjectTickets[foreignSlug] = tickets.ToDictionary(t => t.Id, t => t.Title);
        }
    }

    private async Task RebuildPipelineAsync()
    {
        await FetchCrossProjectTicketsAsync();
        var index = _summaries.ToDictionary(t => t.Id, t => t.Title);
        var memberHandles = new HashSet<string>(_allMembers.Select(m => m.Slug), StringComparer.OrdinalIgnoreCase);
        _mdPipeline = KittyClaw.Web.Markdown.CommentMarkdownPipeline.Configure(new MarkdownPipelineBuilder())
            .Use(new TicketReferenceExtension(Slug, index, _crossProjectTickets))
            .Use(new MentionExtension(memberHandles))
            .Build();
    }

    // ── Timeline ──

    private record TimelineItem(DateTime At, string Author, bool IsComment, string Text, int? Id,
        JevRoutingProposal? Proposal = null, JevProposalDecision? Decision = null, JevWorkDecision? WorkDecision = null);
    private List<TimelineItem> _jevHistory = [];
    private async Task RefreshJevHistoryAsync()
    {
        await LoadJevHistoryAsync();
        StateHasChanged();
    }
    private async Task LoadJevHistoryAsync()
    {
        var decisions = await JevDecisions.ListAsync(Slug, TicketId);
        var proposals = await JevQualification.GetPostRunAsync(Slug, TicketId);
        if (await JevQualification.GetAsync(Slug, TicketId) is { } qualification &&
            (qualification.TicketUpdatedAt != _ticket?.UpdatedAt || qualification.TicketColumnId != _ticket?.ColumnId ||
                decisions.Any(d => d.ProposalId == JevDecisionStore.ProposalId(qualification))))
            proposals.Add(qualification);
        _jevHistory = proposals.Concat(decisions.Select(d => d.Proposal))
            .DistinctBy(JevDecisionStore.ProposalId)
            .Select(p =>
            {
                var decision = decisions.FirstOrDefault(d => d.ProposalId == JevDecisionStore.ProposalId(p));
                return new TimelineItem(decision?.DecidedAt ?? p.ObservedAt, "JEV", false, "", null, p, decision);
            }).ToList();
        _jevHistory.AddRange((await JevWorkReviews.DecisionsAsync(Slug, TicketId))
            .Select(d => new TimelineItem(d.DecidedAt, "JEV", false, "", null, WorkDecision: d)));
    }

    private IEnumerable<TimelineItem> GetTimeline()
    {
        if (_ticket is null) return [];
        return _ticket.Comments
            .Select(c => new TimelineItem(c.CreatedAt, c.Author, true, c.Content, c.Id))
            .Concat(_ticket.Activities
                .Where(a => !a.Text.StartsWith("JEV proposal ", StringComparison.Ordinal) && !a.Text.StartsWith("Automatic routing. JEV proposal ", StringComparison.Ordinal) &&
                    !a.Text.StartsWith("JEV acceptance ", StringComparison.Ordinal) && !a.Text.StartsWith("JEV profile ", StringComparison.Ordinal))
                .Select(a => new TimelineItem(a.CreatedAt, ActivityAuthor(a.Author), false, a.Text, null)))
            .Concat(_jevHistory)
            .OrderByDescending(x => x.At);
    }

    private string ActivityAuthor(string author)
    {
        const string prefix = "column-";
        if (author.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
            && int.TryParse(author[prefix.Length..], out var columnId)
            && _processorNames.TryGetValue(columnId, out var processorName))
            return processorName;
        return author;
    }

