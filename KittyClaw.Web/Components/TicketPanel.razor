    private async Task LoadAsync()
    {
        _detailsLoading = true;
        try
        {
            _ticket = await TicketService.GetTicketAsync(Slug, TicketId);
            if (_disposed || _ticket is null) return;
            // Show the ticket before loading ancillary history, processor files and Git state.
            _worktreeState = null; _mergeRequest = null; _mergePosition = null; _worktreeLoadError = null;
            StateHasChanged();
            await Task.Yield();
            if (_disposed) return;
            var summaries = TicketService.ListTicketsAsync(Slug);
            var columns = ColumnService.ListColumnsAsync(Slug, _ticket.PipelineId);
            var labels = LabelService.ListLabelsAsync(Slug);
            var members = MemberService.ListMembersAsync(Slug);
            var slug = Slug;
            var processors = Task.Run(() => ProcessorService.ListAsync(slug));
            await Task.WhenAll(summaries, columns, labels, members, processors);
            if (_disposed) return;
            _summaries = await summaries;
            _columns = await columns;
            _allLabels = await labels;
            _allMembers = await members;
            _processorNames = (await processors)
                .ToDictionary(processor => processor.ColumnId, processor => processor.Name);
            await LoadJevHistoryAsync();
            await LoadWorktreeAsync();
            await RebuildPipelineAsync();
        }
        finally { _detailsLoading = false; }
    }

    /// <summary>Reload after a local mutation, then let the parent refresh its lists.</summary>
    private async Task RefreshAsync()
    {
        _ticket = await TicketService.GetTicketAsync(Slug, TicketId);
        await LoadJevHistoryAsync();
        _summaries = await TicketService.ListTicketsAsync(Slug);
        if (_ticket is not null)
            _columns = await ColumnService.ListColumnsAsync(Slug, _ticket.PipelineId);
        await LoadWorktreeAsync();
        await RebuildPipelineAsync();
        await OnChanged.InvokeAsync();
        await OnMutatedTicket.InvokeAsync(TicketId);
    }

    private async Task LoadWorktreeAsync()
    {
        _worktreeState = null; _mergeRequest = null; _mergePosition = null; _worktreeLoadError = null;
        try
        {
            if ((await ProjectService.GetProjectAsync(Slug))?.WorktreesEnabled != true) return;
            var slug = Slug;
            var ticketId = TicketId;
            _worktreeState = await Task.Run(() => TicketWorktreeService.InspectAsync(slug, ticketId));
            if (_worktreeState is not null)
                (_mergeRequest, _mergePosition) = await WorktreeMergeQueueService.GetForTicketAsync(Slug, TicketId);
        }
        catch (Exception ex) { _worktreeLoadError = ex.Message; }
    }

    private string WorktreeStatusLabel() => _mergeRequest?.Status switch
    {
        WorktreeMergeStatus.Pending => _mergePosition is int p ? L.Get("WorktreeQueuedPosition", p) : L["WorktreeQueued"],
        WorktreeMergeStatus.Processing => L["WorktreeProcessing"],
        WorktreeMergeStatus.Conflict => L["WorktreeConflict"],
        WorktreeMergeStatus.Failed => L["WorktreeFailed"],
        WorktreeMergeStatus.NeedsReview or WorktreeMergeStatus.CommitPending or WorktreeMergeStatus.ValidationRequired => L["WorktreeNeedsReview"],
        WorktreeMergeStatus.BlockedByExternalChanges => L["WorktreeBlockedByExternalChanges"],
        WorktreeMergeStatus.Completed => L["WorktreeCompleted"],
        _ when _worktreeState?.IsDirty == true => L["WorktreeDirty"],
        _ when _worktreeState?.Exists == true => L["WorktreeReady"],
        _ => L["WorktreeNotCreated"]
    };

    private string WorktreeTone() => _mergeRequest?.Status switch
    {
        WorktreeMergeStatus.Completed => "success",
        WorktreeMergeStatus.Conflict or WorktreeMergeStatus.Failed or WorktreeMergeStatus.NeedsReview
            or WorktreeMergeStatus.CommitPending or WorktreeMergeStatus.ValidationRequired => "danger",
        WorktreeMergeStatus.Pending or WorktreeMergeStatus.Processing or WorktreeMergeStatus.BlockedByExternalChanges => "waiting",
        _ when _worktreeState?.IsDirty == true => "danger",
        _ => "neutral"
    };

