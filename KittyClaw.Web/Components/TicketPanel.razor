        _editingTitle = true;
    }

    private async Task SaveTitle()
    {
        if (_ticket is null || string.IsNullOrWhiteSpace(_editTitle)) return;
        var oldTitle = _ticket.Title;
        var ticketId = _ticket.Id;
        await TicketService.UpdateTicketAsync(Slug, ticketId, title: _editTitle.Trim());
        PushUndo?.Invoke($"{L["UndoRename"]} #{ticketId}", async () =>
            await TicketService.UpdateTicketAsync(Slug, ticketId, title: oldTitle));
        _editingTitle = false;
        await RefreshAsync();
    }

    private async Task HandleTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveTitle();
        else if (e.Key == "Escape") _editingTitle = false;
    }

    // ── Schedule ──

    private static DateTime UtcToLocal(DateTime utc) =>
        DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime();

    private void StartEditSchedule()
    {
        if (_ticket is null) return;
        _editFireAtLocal = _ticket.FireAt is DateTime fireAt
            ? UtcToLocal(fireAt)
            : DateTime.Now.Date.AddDays(1).AddHours(9);
        var target = _ticket.ScheduleTarget;
        _editScheduleTarget = !string.IsNullOrWhiteSpace(target) && _columns.Any(c => c.Name == target)
            ? target!
            : _columns.FirstOrDefault(c => c.Name == "Todo")?.Name
              ?? _columns.FirstOrDefault(c => c.Name != "Scheduled")?.Name ?? "Todo";
        _editingSchedule = true;
    }

    private async Task SaveSchedule()
    {
        if (_ticket is null) return;
        if (_editFireAtLocal is not DateTime local) return;
        var fireAtUtc = DateTime.SpecifyKind(local, DateTimeKind.Local).ToUniversalTime();
        await TicketService.ScheduleTicketAsync(Slug, _ticket.Id, fireAtUtc, _editScheduleTarget);
        _editingSchedule = false;
        await RefreshAsync();
    }

    // ── Description / comments (fullscreen editor) ──

    private void StartEditDescription() => OpenFullscreen("description");

    private void StartNewComment() => OpenFullscreen("newComment");

    private void StartEditComment(int commentId, string currentContent)
    {
        _editComment = currentContent;
        _editingCommentId = commentId;
        OpenFullscreen("editComment");
    }

    private void OpenFullscreen(string target)
    {
        _fullscreenTarget = target;
        _fullscreenText = target switch
        {
            "description" => _ticket?.Description ?? "",
            "newComment" => "",
            "editComment" => _editComment,
            _ => ""
        };
        _fullscreenOriginalText = _fullscreenText;
        ArmFullscreenEscape();
    }

    private void ArmFullscreenEscape()
    {
        _escFullscreenEditor?.Dispose();
        _escFullscreenEditor = EscapeStack.PushWithFocus(JS, () =>
        {
            InvokeAsync(() =>
            {
                if (_fullscreenText != _fullscreenOriginalText)
                {
                    _showDiscardConfirm = true;
                    StateHasChanged();
                }
                else
                {
                    CancelFullscreen();
                    StateHasChanged();
                }
            });
        });
    }

    private void CancelFullscreen()
    {
        _escFullscreenEditor?.Dispose();
        _escFullscreenEditor = null;
        _showDiscardConfirm = false;
        _fullscreenTarget = "";
        _fullscreenText = "";
        _pasteListenerAttached = false;
    }

    private void ConfirmDiscard()
    {
        _showDiscardConfirm = false;
        CancelFullscreen();
    }

    private void CancelDiscard()
    {
        _showDiscardConfirm = false;
        // Re-register ESC handler so subsequent ESC still triggers the dirty-check
        ArmFullscreenEscape();
    }

    private async Task SaveFullscreen()
    {
        _escFullscreenEditor?.Dispose();
        _escFullscreenEditor = null;
        var target = _fullscreenTarget;
        var text = _fullscreenText;
        _fullscreenTarget = "";
        _fullscreenText = "";
        _pasteListenerAttached = false;

        switch (target)
        {
            case "description":
                if (_ticket is not null)
                {
                    var oldDesc = _ticket.Description;
                    var descTicketId = _ticket.Id;
                    await TicketService.UpdateTicketAsync(Slug, descTicketId, description: text);
                    PushUndo?.Invoke($"{L["UndoDescription"]} #{descTicketId}", async () =>
                        await TicketService.UpdateTicketAsync(Slug, descTicketId, description: oldDesc));
                }
                break;
            case "newComment":
                if (_ticket is not null && !string.IsNullOrWhiteSpace(text))
                    await TicketService.AddCommentAsync(Slug, _ticket.Id, text.Trim());
                break;
            case "editComment":
                if (_ticket is not null && _editingCommentId is not null)
                {
                    var oldComment = _editComment;
                    var commentId = _editingCommentId.Value;
                    var editTicketId = _ticket.Id;
                    await TicketService.UpdateCommentAsync(Slug, editTicketId, commentId, text.Trim());
                    PushUndo?.Invoke($"{L["UndoComment"]} #{editTicketId}", async () =>
                        await TicketService.UpdateCommentAsync(Slug, editTicketId, commentId, oldComment));
                    _editingCommentId = null;
                }
                break;
        }

        await RefreshAsync();
    }

    // ── Delete ──

    private async Task DeleteTicketAsync()
    {
        if (_ticket is null) return;
        var t = _ticket;
        var labelIds = t.Labels.Select(l => l.Id).ToList();
        await TicketService.DeleteTicketAsync(Slug, t.Id);
        PushUndo?.Invoke($"{L["UndoDelete"]} #{t.Id}", async () =>
        {
            var restored = await TicketService.CreateTicketAsync(Slug, t.Title, t.Description, t.CreatedBy, t.Status, labelIds, t.Priority, t.AssignedTo, t.ParentId, t.PipelineId, t.ColumnId, t.BlocksParent);
            if (restored is not null)
            {
                foreach (var criterion in t.AcceptanceCriteria)
                    await TicketService.SaveAcceptanceCriterionAsync(Slug, restored.Id, null, new(criterion.Text, criterion.Status, criterion.Evidence));
                await OnMutatedTicket.InvokeAsync(restored.Id);
            }
        });
        _confirmDelete = false;
        await OnDeleted.InvokeAsync();
    }

    // ── Labels ──

    private List<Label> GetLabelSuggestions()
    {
        if (_ticket is null) return [];
        var currentIds = _ticket.Labels.Select(l => l.Id).ToHashSet();
        var query = _labelSearch?.Trim() ?? "";
        return _allLabels
            .Where(l => !currentIds.Contains(l.Id))
            .Where(l => string.IsNullOrEmpty(query) || l.Name.Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private async Task AddExistingLabel(Label label)
    {
        if (_ticket is null) return;
        var oldIds = _ticket.Labels.Select(l => l.Id).ToList();
        var ticketId = _ticket.Id;
        var ids = oldIds.ToList();
        ids.Add(label.Id);
        await TicketService.SetTicketLabelsAsync(Slug, ticketId, ids);
        PushUndo?.Invoke($"{L["UndoLabel"]} +{label.Name} #{ticketId}", async () =>
            await TicketService.SetTicketLabelsAsync(Slug, ticketId, oldIds));
        _labelSearch = "";
        CloseLabelDropdown();
        await RefreshAsync();
    }

    private async Task RemoveLabel(int labelId)
    {
        if (_ticket is null) return;
        var oldIds = _ticket.Labels.Select(l => l.Id).ToList();
        var ticketId = _ticket.Id;
        var ids = oldIds.Where(id => id != labelId).ToList();
        await TicketService.SetTicketLabelsAsync(Slug, ticketId, ids);
        PushUndo?.Invoke($"{L["UndoLabel"]} #{ticketId}", async () =>
            await TicketService.SetTicketLabelsAsync(Slug, ticketId, oldIds));
        await RefreshAsync();
    }

    private async Task CreateAndAddLabel()
    {
        if (_ticket is null || string.IsNullOrWhiteSpace(_labelSearch)) return;
        var label = await LabelService.CreateLabelAsync(Slug, _labelSearch.Trim(), "#6366f1");
        _allLabels = await LabelService.ListLabelsAsync(Slug);
        var ids = _ticket.Labels.Select(l => l.Id).ToList();
        ids.Add(label.Id);
        await TicketService.SetTicketLabelsAsync(Slug, _ticket.Id, ids);
        _labelSearch = "";
        CloseLabelDropdown();
        await RefreshAsync();
    }

    private async Task HandleLabelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_labelSearch))
        {
            var suggestions = GetLabelSuggestions();
            if (suggestions.Count > 0)
                await AddExistingLabel(suggestions[0]);
            else
                await CreateAndAddLabel();
        }
        else if (e.Key == "Escape")
        {
            _labelSearch = "";
            CloseLabelDropdown();
        }
    }

    private void OpenLabelDropdown()
    {
        if (_labelDropdownOpen) return;
        _labelDropdownOpen = true;
        _escLabelDropdown?.Dispose();
        _escLabelDropdown = EscapeStack.PushWithFocus(JS, () => InvokeAsync(() => { CloseLabelDropdown(); StateHasChanged(); }));
    }

    private void CloseLabelDropdown()
    {
        _labelDropdownOpen = false;
        _escLabelDropdown?.Dispose();
        _escLabelDropdown = null;
    }

    private void OnLabelBlur()
    {
        // Small delay handled by @onmousedown on dropdown items
        CloseLabelDropdown();
    }

    // ── Dependencies ──

    private async Task AddBlockerAsync()
    {
        if (_ticket is null || !int.TryParse(_addBlockerIdText, out var blockerId)) return;
        _depError = null;
        try
        {
            await TicketService.AddDependencyAsync(Slug, _ticket.Id, blockerId);
            _addBlockerIdText = "";
            await RefreshAsync();
        }
        catch (DependencyValidationException ex) { _depError = ex.Message; }
        catch (Exception ex) { _depError = ex.Message; }
    }

    private async Task RemoveBlockerAsync(int depId)
    {
        if (_ticket is null) return;
        _depError = null;
        try
        {
            await TicketService.RemoveDependencyAsync(Slug, _ticket.Id, depId);
            await RefreshAsync();
        }
        catch (Exception ex) { _depError = ex.Message; }
    }

    private async Task RemoveBlockedAsync(int depId, int blockedTicketId)
    {
        _depError = null;
        try
        {
            await TicketService.RemoveDependencyAsync(Slug, blockedTicketId, depId);
            await RefreshAsync();
        }
        catch (Exception ex) { _depError = ex.Message; }
    }

    private async Task HandleDepKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddBlockerAsync();
        else if (e.Key == "Escape") { _addBlockerIdText = ""; _depError = null; }
    }

    // ── Assignee ──

    private List<Member> GetAssigneeSuggestions()
    {
        var query = _assigneeSearch?.Trim() ?? "";
        return _allMembers
            .Where(m => string.IsNullOrEmpty(query)
                || m.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                || m.Slug.Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private string MemberDisplayName(string? slug)
    {
        if (string.IsNullOrEmpty(slug)) return "";
        var member = _allMembers.FirstOrDefault(m => m.Slug == slug);
        return member?.Name ?? slug;
    }

    private async Task SetAssignee(string slug)
    {
        if (_ticket is null) return;
        var oldAssignee = _ticket.AssignedTo ?? "";
        var ticketId = _ticket.Id;
        await TicketService.UpdateTicketAsync(Slug, ticketId, assignedTo: slug);
        PushUndo?.Invoke($"{L["UndoAssign"]} #{ticketId}", async () =>
            await TicketService.UpdateTicketAsync(Slug, ticketId, assignedTo: oldAssignee));
        _assigneeSearch = "";
        CloseAssigneeDropdown();
        await RefreshAsync();
    }

    private async Task RemoveAssignee()
    {
        if (_ticket is null) return;
        var oldAssignee = _ticket.AssignedTo ?? "";
        var ticketId = _ticket.Id;
        await TicketService.UpdateTicketAsync(Slug, ticketId, assignedTo: "");
        PushUndo?.Invoke($"{L["UndoUnassign"]} #{ticketId}", async () =>
            await TicketService.UpdateTicketAsync(Slug, ticketId, assignedTo: oldAssignee));
        await RefreshAsync();
    }

    private async Task CreateAndAssign()
    {
        if (_ticket is null || string.IsNullOrWhiteSpace(_assigneeSearch)) return;
        var name = _assigneeSearch.Trim();
        var created = await MemberService.CreateMemberAsync(Slug, name);
        _allMembers = await MemberService.ListMembersAsync(Slug);
        await SetAssignee(created.Slug);
    }

    private async Task HandleAssigneeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_assigneeSearch))
        {
            var suggestions = GetAssigneeSuggestions();
            if (suggestions.Count > 0)
                await SetAssignee(suggestions[0].Slug);
            else
                await CreateAndAssign();
        }
        else if (e.Key == "Escape")
        {
            _assigneeSearch = "";
            CloseAssigneeDropdown();
        }
    }

    private void OpenAssigneeDropdown()
    {
        if (_assigneeDropdownOpen) return;
        _assigneeDropdownOpen = true;
        _escAssigneeDropdown?.Dispose();
        _escAssigneeDropdown = EscapeStack.PushWithFocus(JS, () => InvokeAsync(() => { CloseAssigneeDropdown(); StateHasChanged(); }));
    }

    private void CloseAssigneeDropdown()
    {
        _assigneeDropdownOpen = false;
        _escAssigneeDropdown?.Dispose();
        _escAssigneeDropdown = null;
    }

    private void OnAssigneeBlur() => CloseAssigneeDropdown();

    // ── Ticket chat ──

    private void OpenTicketChat()
    {
        if (_ticket is null) return;
        var assignee = _ticket.AssignedTo;
        // With an assignee: jump straight into the conversation with that agent.
        // Without: leave InitialAgent null so the drawer shows the picker — the ticket
        // context still propagates through the TicketId/TicketTitle parameters.
        if (!string.IsNullOrWhiteSpace(assignee) && assignee != "owner")
        {
            var member = _allMembers.FirstOrDefault(m => m.Slug == assignee);
            _chatInitialAgent = assignee;
            _chatInitialAgentName = member?.Name ?? assignee;
        }
        else
        {
            _chatInitialAgent = null;
            _chatInitialAgentName = null;
        }
        _showChatDrawer = true;
        _escChatDrawer?.Dispose();
        _escChatDrawer = EscapeStack.PushWithFocus(JS, () => InvokeAsync(() => { CloseChatDrawer(); StateHasChanged(); }));
    }

    private void CloseChatDrawer()
    {
        _showChatDrawer = false;
        _chatInitialAgent = null;
        _chatInitialAgentName = null;
        _escChatDrawer?.Dispose();
        _escChatDrawer = null;
    }

    private bool CanChatWithAssignee()
    {
        var a = _ticket?.AssignedTo;
        return !string.IsNullOrWhiteSpace(a) && a != "owner";
    }

    private string _chatInitialAgentNameForTooltip()
    {
        var a = _ticket?.AssignedTo;
        if (string.IsNullOrWhiteSpace(a)) return "";
        return _allMembers.FirstOrDefault(m => m.Slug == a)?.Name ?? a;
    }

    private string GetColumnColor(string status) =>
        _columns.FirstOrDefault(c => c.Name == status)?.Color ?? "#5a6a80";
}
