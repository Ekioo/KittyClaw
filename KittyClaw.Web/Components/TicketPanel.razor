        WorktreeMergeStatus.Failed => L["WorktreeFailedGuidance"],
        WorktreeMergeStatus.NeedsReview or WorktreeMergeStatus.CommitPending or WorktreeMergeStatus.ValidationRequired => L["WorktreeNeedsReviewGuidance"],
        WorktreeMergeStatus.BlockedByExternalChanges => L["WorktreeBlockedByExternalChangesGuidance"],
        WorktreeMergeStatus.Completed => L["WorktreeCompletedGuidance"],
        _ when _worktreeState?.IsDirty == true => L["WorktreeDirtyGuidance"],
        _ when _worktreeState?.Exists == true => L["WorktreeReadyGuidance"],
        _ => L["WorktreeNotCreatedGuidance"]
