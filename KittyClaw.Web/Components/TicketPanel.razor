@using Markdig
@using KittyClaw.Core.Evidence
@using KittyClaw.Core.Models
@using KittyClaw.Core.Services
@using KittyClaw.Core.Extensions
@using KittyClaw.Web.Extensions
@inject ProjectService ProjectService
@inject TicketService TicketService
@inject LabelService LabelService
@inject ColumnService ColumnService
@inject ColumnProcessorService ProcessorService
@inject JevQualificationService JevQualification
@inject JevDecisionStore JevDecisions
@inject JevWorkReviewService JevWorkReviews
@inject MemberService MemberService
@inject TicketWorktreeService TicketWorktreeService
@inject WorktreeMergeQueueService WorktreeMergeQueueService
@inject KittyClaw.Web.Services.BoardUpdateNotifier BoardUpdateNotifier
@inject IJSRuntime JS
@inject LocalizationService L
@inject KittyClaw.Web.Services.EscapeKeyStack EscapeStack
@implements IDisposable

@* Full ticket detail panel, rendered as an overlay ON TOP of whatever page mounts it.
   The panel owns its own data (ticket, project ticket index, columns, labels, members)
   so both the project board and the unified home can open a ticket without loading a
   different page underneath. Parents react through OnClose / OnChanged / OnDeleted /
   OnEnterSubKanban; undoable actions are offered to the optional PushUndo sink. *@

@if (_ticket is not null)
{
    <div class="ticket-modal-overlay">
        <div class="ticket-panel" aria-busy="@(_detailsLoading ? "true" : "false")">
        <div class="ticket-panel-header">
            <div class="editable-field">
                <button type="button" class="priority-dot-btn" @onclick="TogglePriorityPicker"
                        title="@L["ChangePriority"]" aria-label="@L["ChangePriority"]"
                        aria-expanded="@(_showPriorityPicker ? "true" : "false")">
                    <span class="priority-dot priority-@GetPriorityClass(_ticket.Priority)"></span>
                </button>
                @if (_showPriorityPicker)
                {
                    <div class="priority-dropdown">
                        @foreach (var p in Enum.GetValues<TicketPriority>())
                        {
                            <button class="priority-option @(_ticket.Priority == p ? "active" : "")"
                                    @onclick="() => SetPriorityAndClose(p)">
                                <span class="priority-dot priority-@GetPriorityClass(p)"></span>
                                @GetPriorityLabel(p)
                            </button>
                        }
                    </div>
                }
                @if (_editingTitle)
                {
                    <span class="ticket-id-prefix">#@_ticket.Id &mdash;</span>
                    <input class="edit-title-input" @bind="_editTitle" @onkeydown="HandleTitleKeyDown" />
                    <button class="icon-btn save-btn" title="@L["Save"]" @onclick="SaveTitle">&#10003;</button>
                    <button class="icon-btn cancel-icon-btn" title="@L["Cancel"]" @onclick="() => _editingTitle = false">&#10005;</button>
                }
                else
                {
                    <h2>#@_ticket.Id &mdash; @_ticket.Title</h2>
                    <button class="icon-btn pencil-btn" title="@L["EditTitle"]" @onclick="StartEditTitle">&#9998;</button>
                }
            </div>
            <div class="header-actions">
                <button class="tile-config-revise" @onclick="() => _showImprovement = true">✦ @L["ImproveTicket"]</button>
                <button class="close-btn" @onclick="CloseAsync">&times;</button>
            </div>
        </div>

        <div class="ticket-properties-row">
        <div class="ticket-column-row" data-testid="ticket-current-column">
            <label class="ticket-column-badge" title="@L["TicketCurrentColumn"]">
                <span class="sub-ticket-status-dot" style="background: @(CurrentColumn()?.Color ?? GetColumnColor(_ticket.Status))" aria-hidden="true"></span>
                <select class="ticket-column-select" aria-label="@L["TicketCurrentColumn"]"
                        value="@CurrentColumn()?.Id" @onchange="ChangeColumnAsync" disabled="@_movingColumn">
                    @foreach (var column in _columns)
                    {
                        <option value="@column.Id">@column.Name</option>
                    }
                </select>
            </label>
            @if (_columnMoveError is not null)
            {
                <span class="dep-error" role="alert">@_columnMoveError</span>
            }
        </div>

        @* ── Labels row ── *@
        <div class="ticket-labels-row" title="@L["Labels"]">
            @foreach (var label in _ticket.Labels)
            {
                var lid = label.Id;
                <span class="label-pill label-removable" style="--lc: @label.Color">
                    @label.Name
                    <button class="label-remove-btn" @onclick="() => RemoveLabel(lid)" @onclick:stopPropagation>&times;</button>
                </span>
            }
            <div class="label-autocomplete">
                <input class="label-autocomplete-input"
                       placeholder="+ Label..."
                       aria-label="@L["Labels"]"
                       @bind="_labelSearch"
                       @bind:event="oninput"
                       @onfocus="OpenLabelDropdown"
                       @onblur="OnLabelBlur"
                       @onkeydown="HandleLabelKeyDown" />
                @if (_labelDropdownOpen && GetLabelSuggestions().Any())
                {
                    <div class="label-dropdown">
                        @foreach (var suggestion in GetLabelSuggestions())
                        {
                            <button class="label-dropdown-item" style="--lc: @suggestion.Color"
                                    @onmousedown="() => AddExistingLabel(suggestion)">
                                <span class="label-pill" style="--lc: @suggestion.Color">@suggestion.Name</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        @* ── Assignee row ── *@
        <div class="ticket-assignee-row" title="@L["AssignedToLabel"]">
            @if (!string.IsNullOrEmpty(_ticket.AssignedTo))
            {
                <span class="assignee-pill">
                    @MemberDisplayName(_ticket.AssignedTo)
                    <button class="label-remove-btn" @onclick="RemoveAssignee">&times;</button>
                </span>
            }
            <div class="label-autocomplete">
                <input class="label-autocomplete-input"
                       placeholder="@(string.IsNullOrEmpty(_ticket.AssignedTo) ? L["AssignPlaceholder"] : L["ChangePlaceholder"])"
                       aria-label="@L["AssignedToLabel"]"
                       @bind="_assigneeSearch"
                       @bind:event="oninput"
                       @onfocus="OpenAssigneeDropdown"
                       @onblur="OnAssigneeBlur"
                       @onkeydown="HandleAssigneeKeyDown" />
                @if (_assigneeDropdownOpen && GetAssigneeSuggestions().Any())
                {
                    <div class="label-dropdown">
                        @foreach (var member in GetAssigneeSuggestions())
                        {
                            <button class="label-dropdown-item" @onmousedown="() => SetAssignee(member.Slug)">
                                <span class="assignee-pill">@member.Name</span>
                                <span class="member-slug-hint">@member.Slug</span>
                            </button>
                        }
                    </div>
                }
            </div>

        </div>

        @* ── Schedule row ── *@
        @if (_editingSchedule)
        {
            <div class="ticket-schedule-row">
                <span class="section-label-sm">⏰ @L["ScheduledForLabel"]</span>
                <input type="datetime-local" class="schedule-input" @bind="_editFireAtLocal" @bind:event="oninput" />
                <span class="schedule-arrow">&#8594;</span>
                <select class="schedule-target-select" @bind="_editScheduleTarget">
                    @foreach (var c in _columns.Where(c => c.Name != "Scheduled"))
                    {
                        <option value="@c.Name">@c.Name</option>
                    }
                </select>
                <button class="icon-btn save-btn" title="@L["Save"]" disabled="@(_editFireAtLocal is null)" @onclick="SaveSchedule">&#10003;</button>
                <button class="icon-btn cancel-icon-btn" title="@L["Cancel"]" @onclick="() => _editingSchedule = false">&#10005;</button>
            </div>
        }
        else if (_ticket.FireAt is not null || _ticket.Status == "Scheduled")
        {
            <div class="ticket-schedule-row">
                <span class="section-label-sm">⏰ @L["ScheduledForLabel"]</span>
                @if (_ticket.FireAt is DateTime fireAtUtc)
                {
                    <span class="schedule-value">@UtcToLocal(fireAtUtc).ToString("g")</span>
                    <span class="schedule-arrow">&#8594; @(_ticket.ScheduleTarget ?? "Todo")</span>
                }
                else
                {
                    <span class="schedule-value empty-hint">@L["ScheduleNoDate"]</span>
                }
                <button class="icon-btn pencil-btn" title="@L["ScheduleEdit"]" @onclick="StartEditSchedule">&#9998;</button>
            </div>
        }
        else if (_columns.Any(c => c.Name == "Scheduled"))
        {
            <div class="ticket-schedule-row">
                <button class="schedule-add-btn" title="@L["ScheduleButton"]" @onclick="StartEditSchedule">⏰ @L["ScheduleButton"]</button>
            </div>
        }

            <div class="ticket-meta">
                <span>@_ticket.CreatedBy</span>
                <span>@_ticket.CreatedAt.ToString("d")</span>
                @if (_ticket.AgentTokens > 0)
                {
                    <span class="token-badge" title="@CostTooltip(_ticket.AgentTokens, _ticket.AgentCostUsd, _ticket.AgentCostEstimated)">⛁ @KittyClaw.Web.Services.TokenDisplay.Compact(_ticket.AgentTokens)@(_ticket.AgentCostUsd > 0 ? $" · {(_ticket.AgentCostEstimated ? "≈ " : "")}{KittyClaw.Web.Services.TokenDisplay.Usd(_ticket.AgentCostUsd)}" : "")</span>
                }
            </div>

        </div>

        @if (_worktreeState is not null)
        {
            <section class="worktree-summary" data-testid="ticket-worktree-summary">
                <div class="worktree-summary-title"><strong>@L["WorktreeTitle"]</strong></div>
                <div><span>@L["WorktreeRoot"]</span> <strong>#@_worktreeState.RootTicketId</strong></div>
                <div><span>@L["WorktreeBranch"]</span> <code data-testid="worktree-branch">@_worktreeState.Branch</code></div>
                <div><span>@L["WorktreePath"]</span> <code data-testid="worktree-path">@_worktreeState.Path</code></div>
                <div class="worktree-phase" data-testid="integration-status">
                    <div class="worktree-phase-title"><strong>@L["WorktreeIntegrationTitle"]</strong><span class="worktree-state worktree-state--@WorktreeTone()">@WorktreeStatusLabel()</span></div>
                    @if (_mergeRequest?.SourceCommit is { Length: > 0 }) { <div>@L["WorktreeSourceCommit"] <code>@_mergeRequest.SourceCommit</code></div> }
                    @if (_mergeRequest?.IntegratedCommit is { Length: > 0 }) { <div>@L["WorktreeIntegratedCommit"] <code>@_mergeRequest.IntegratedCommit</code></div> }
                    <p>@WorktreeGuidance()</p>
                </div>
                @if (_mergeRequest?.ConflictFiles is { Length: > 0 })
                {
                    <div class="worktree-conflicts">@L["WorktreeConflictFiles"] @_mergeRequest.ConflictFiles</div>
                }
                @if (_mergeRequest?.Error is { Length: > 0 })
                {
                    <div class="worktree-error">@_mergeRequest.Error</div>
                }
                @if (_mergeRequest?.Status is WorktreeMergeStatus.Conflict or WorktreeMergeStatus.Failed
                    or WorktreeMergeStatus.BlockedByExternalChanges or WorktreeMergeStatus.NeedsReview
                    or WorktreeMergeStatus.CommitPending or WorktreeMergeStatus.ValidationRequired)
                {
                    <button class="worktree-action" @onclick="ResumeMergeAsync" disabled="@_worktreeActionBusy">@L["WorktreeResume"]</button>
                }
                else if (_mergeRequest?.Status == WorktreeMergeStatus.Pending)
                {
                    <button class="worktree-action" @onclick="ProcessMergeAsync" disabled="@_worktreeActionBusy">@L["WorktreeRetry"]</button>
                }
                @if (_mergeRequest is not null)
                {
                    <div class="worktree-phase" data-testid="synchronization-status">
                        <div class="worktree-phase-title"><strong>@L["WorktreeSynchronizationTitle"]</strong><span class="worktree-state worktree-state--@SyncTone()">@SyncStatusLabel()</span></div>
                        @if (_mergeRequest.SyncTargetCommit is { Length: > 0 }) { <div>@L["WorktreeSyncCommit"] <code>@_mergeRequest.SyncTargetCommit</code></div> }
                        @if (_mergeRequest.HasSynchronizationLag) { <div class="worktree-sync-lag" data-testid="synchronization-lag">@L["WorktreeSyncLag"]</div> }
                        @if (_mergeRequest.SyncConflictFiles is { Length: > 0 }) { <div class="worktree-conflicts">@L["WorktreeConflictFiles"] @_mergeRequest.SyncConflictFiles</div> }
                        @if (_mergeRequest.SyncError is { Length: > 0 }) { <div class="worktree-error">@_mergeRequest.SyncError</div> }
                        <p>@SyncGuidance()</p>
                        @if (CanRetrySynchronization())
                        {
                            <button class="worktree-action" data-testid="retry-synchronization" @onclick="RetrySynchronizationAsync" disabled="@_worktreeActionBusy">@L["WorktreeRetrySynchronization"]</button>
                        }
                    </div>
                }
            </section>
        }
        else if (_worktreeLoadError is not null)
        {
            <div class="worktree-summary worktree-error" data-testid="ticket-worktree-error">@L["WorktreeLoadError"] @_worktreeLoadError</div>
        }

        @* ── Sub-tickets section ── *@
        @{ var selectedSummary = _summaries.FirstOrDefault(t => t.Id == _ticket.Id); }
        @if (selectedSummary?.SubTickets is { Count: > 0 })
        {
            <div class="sub-tickets-section">
                <div class="section-header">
                    <span class="section-label">@L["SubTickets"] (@selectedSummary.SubTickets.Count)</span>
                    <button class="sub-kanban-btn" @onclick="() => OnEnterSubKanban.InvokeAsync(_ticket.Id)">@L["ViewAll"] &#8594;</button>
                </div>
                <div class="sub-ticket-list">
                    @foreach (var sub in selectedSummary.SubTickets)
                    {
                        <div class="sub-ticket-row">
                            <span class="sub-ticket-status-dot" style="background: @GetColumnColor(sub.Status)"></span>
                            <span class="sub-ticket-id">#@sub.Id</span>
                            <span class="sub-ticket-title">@sub.Title</span>
                            <span class="sub-ticket-status">@sub.Status</span>
                            <button class="sub-ticket-blocking-toggle"
                                    title="@(sub.BlocksParent ? "This child blocks its parent" : "This child is informational")"
                                    @onclick="() => ToggleBlockingAsync(sub)">
                                @(sub.BlocksParent ? "Blocking" : "Non-blocking")
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        @if (_ticket.ParentId is not null)
        {
            var parentSummary = _summaries.FirstOrDefault(t => t.Id == _ticket.ParentId);
            <div class="parent-ticket-section">
                <span class="section-label-sm">@L["Parent"]</span>
                <span class="parent-ticket-link">#@_ticket.ParentId @(parentSummary?.Title ?? "")</span>
            </div>
        }

        @* ── Dependencies section ── *@
        @if (_ticket.BlockedBy.Count > 0)
        {
            <div class="dep-section">
                <div class="section-header">
                    <span class="section-label">@L["BlockedBy"] (@_ticket.BlockedBy.Count)</span>
                </div>
                <div class="dep-list">
                    @foreach (var b in _ticket.BlockedBy)
                    {
                        <div class="dep-row">
                            <a class="dep-link" href="/board/@Slug/ticket/@b.TicketId">#@b.TicketId @b.Title</a>
                            <span class="dep-status @(string.Equals(b.Status, "Done", StringComparison.OrdinalIgnoreCase) ? "dep-status--done" : "dep-status--pending")">@b.Status</span>
                            <button class="dep-remove-btn" title="@L["RemoveDependency"]"
                                    @onclick="() => RemoveBlockerAsync(b.DependencyId)" @onclick:stopPropagation>×</button>
                        </div>
                    }
                </div>
            </div>
        }
        @if (_ticket.Blocks.Count > 0)
        {
            <div class="dep-section">
                <div class="section-header">
                    <span class="section-label">@L["Blocks"] (@_ticket.Blocks.Count)</span>
                </div>
                <div class="dep-list">
                    @foreach (var b in _ticket.Blocks)
                    {
                        <div class="dep-row">
                            <a class="dep-link" href="/board/@Slug/ticket/@b.TicketId">#@b.TicketId @b.Title</a>
                            <span class="dep-status @(string.Equals(b.Status, "Done", StringComparison.OrdinalIgnoreCase) ? "dep-status--done" : "dep-status--pending")">@b.Status</span>
                            <button class="dep-remove-btn" title="@L["RemoveDependency"]"
                                    @onclick="() => RemoveBlockedAsync(b.DependencyId, b.TicketId)" @onclick:stopPropagation>×</button>
                        </div>
                    }
                </div>
            </div>
        }
        <div class="dep-add-row">
            <span class="section-label-sm">@L["BlockedBy"]:</span>
            <input class="dep-add-input" type="number" min="1" placeholder="@L["BlockerIdPlaceholder"]"
                   @bind="_addBlockerIdText" @bind:event="oninput"
                   @onkeydown="HandleDepKeyDown" />
            <button class="dep-add-btn" @onclick="AddBlockerAsync"
                    disabled="@(!int.TryParse(_addBlockerIdText, out _))">@L["AddBlocker"]</button>
        </div>
        @if (_depError is not null)
        {
            <div class="dep-error">@_depError</div>
        }

        @* ── Ticket body (thread layout) ── *@
            <div class="ticket-panel-thread">
                <div class="section-header">
                    <span class="section-label">@L["AutomationQueue"]</span>
                </div>
                <AutomationQueueSummary Slug="@Slug" TicketId="@_ticket.Id" />
                <ColumnExecutionRecovery Slug="@Slug" TicketId="@_ticket.Id" />
                <div class="section-header">
                    <span class="section-label">@L["Description"]</span>
                    <button class="icon-btn pencil-btn" title="@L["EditDescription"]" @onclick="StartEditDescription">&#9998;</button>
                </div>
                <div class="ticket-desc markdown">
                    @if (_ticket.Description is { Length: > 0 })
                    {
                        @((MarkupString)Markdown.ToHtml(_ticket.Description, _mdPipeline))
                    }
                    else
                    {
                        <p class="empty-hint">@L["NoDescription"]</p>
                    }
                </div>

                @if (!_detailsLoading)
                {
                    <TicketAcceptanceCriteria Slug="@Slug" Ticket="@_ticket" OnChanged="@RefreshAsync" />
                }

                @if (CurrentColumn() is { } guidanceColumn &&
                    guidanceColumn.Role is ColumnRole.Waiting or ColumnRole.OwnerAction)
                {
                    @if (guidanceColumn.Role == ColumnRole.OwnerAction && _ticket is not null)
                    {
                        <DecisionBriefPanel Slug="@Slug"
                                            TicketId="@_ticket.Id"
                                            Columns="@_columns"
                                            CurrentColumn="@guidanceColumn"
                                            OnDecisionTaken="@RefreshAsync" />
                    }
                    else
                    {
                        <section class="ticket-waiting-guidance ticket-waiting-guidance--automatic"
                                 role="note" aria-label="@L["TicketWaitingGuidanceTitle"]">
                            <header>
                                <span class="ticket-waiting-guidance-icon">◷</span>
                                <div>
                                    <strong>@L["TicketAutomaticWaitingTitle"]</strong>
                                    <small>@guidanceColumn.Name</small>
                                </div>
                            </header>
                            <div class="markdown">@((MarkupString)Markdown.ToHtml(WaitingGuidance(guidanceColumn), _mdPipeline))</div>
                        </section>
                    }
                }

                @if (!_detailsLoading)
                {
                    <JevWorkReviewPanel Slug="@Slug" TicketId="@TicketId" OnDecided="RefreshAsync" />
                    <JevProposalPanel Slug="@Slug" TicketId="@TicketId" OnDecisionTaken="RefreshAsync" OnHistoryChanged="RefreshJevHistoryAsync" />
                }
                <div class="thread-section-divider">
                    <div class="activity-header">
                        <span class="section-label">@L["Activity"]</span>
                        <div class="activity-header-actions">
                            <button class="add-comment-btn-sm" @onclick="StartNewComment">@L["AddComment"]</button>
                            <button class="chat-with-agent-btn"
                                    @onclick="OpenTicketChat"
                                    title="@(CanChatWithAssignee()
                                        ? L.Get("ChatWithAssigneeTooltip", _chatInitialAgentNameForTooltip())
                                        : L["ChatPickAgentTooltip"])">
                                💬 @L["ChatWithAssignee"]
                            </button>
                        </div>
                    </div>
                    @foreach (var item in GetTimeline())
                    {
                        @if (item.Proposal is not null)
                        {
                            <JevHistoryEntry Proposal="@item.Proposal" Decision="@item.Decision" Columns="@_columns" />
                        }
                        else if (item.WorkDecision is not null)
                        {
                            <JevWorkHistoryEntry Decision="@item.WorkDecision" />
                        }
                        else if (item.IsComment)
                        {
                            <div class="timeline-comment">
                                <div class="timeline-comment-header">
                                    <strong>@item.Author</strong>
                                    <small><time datetime="@BrowserLocalDateTime.UtcIso(item.At)" data-local-date-time data-local-date-time-locale="@L.Lang">@BrowserLocalDateTime.UtcFallback(item.At)</time></small>
                                    @if (_editingCommentId != item.Id)
                                    {
                                        <button class="icon-btn pencil-btn" title="@L["Edit"]" @onclick="() => StartEditComment(item.Id!.Value, item.Text)">&#9998;</button>
                                    }
                                </div>
                                <div class="markdown">@((MarkupString)Markdown.ToHtml(item.Text, _mdPipeline))</div>
                            </div>
                        }
                        else
                        {
                            <div class="timeline-event">
                                <span class="event-dot"></span>
                                <div class="event-content">
                                    <span class="event-author">@item.Author</span>
                                    <span class="event-text">@item.Text</span>
                                    <small><time datetime="@BrowserLocalDateTime.UtcIso(item.At)" data-local-date-time data-local-date-time-locale="@L.Lang">@BrowserLocalDateTime.UtcFallback(item.At)</time></small>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="panel-footer-actions">
                    @if (_confirmDelete)
                    {
                        <span class="confirm-delete-label">@L["DeleteThisTicketConfirm"]</span>
                        <button class="delete-btn" @onclick="DeleteTicketAsync">@L["Confirm"]</button>
                        <button class="cancel-btn" @onclick="() => _confirmDelete = false">@L["Cancel"]</button>
                    }
                    else
                    {
                        <button class="delete-btn" @onclick="() => _confirmDelete = true">@L["DeleteThisTicket"]</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_fullscreenTarget))
{
    <div class="fullscreen-editor-overlay">
        <div class="fullscreen-editor">
            <div class="fullscreen-editor-header">
                <span>@(_fullscreenTarget == "description" ? L["FullscreenDescription"] : L["FullscreenComment"])</span>
                <button class="icon-btn cancel-icon-btn" @onclick="CancelFullscreen">&#10005;</button>
            </div>
            <textarea @ref="_editorTextarea" @bind="_fullscreenText" @bind:event="oninput"></textarea>
            <div class="fullscreen-editor-footer">
                <button @onclick="SaveFullscreen">@L["Save"]</button>
                <button class="cancel-btn" @onclick="CancelFullscreen">@L["Cancel"]</button>
            </div>
        </div>
    </div>
}

@if (_showDiscardConfirm)
{
    <div class="modal-backdrop">
        <div class="modal-dialog">
            <p>@L["DiscardChangesConfirm"]</p>
            <div class="modal-actions">
                <button @onclick="ConfirmDiscard">@L["Discard"]</button>
                <button class="cancel-btn" @onclick="CancelDiscard">@L["Cancel"]</button>
            </div>
        </div>
    </div>
}

@if (_showChatDrawer && _ticket is not null)
{
    <ErrorBoundary>
        <ChildContent>
            <ChatDrawer ProjectSlug="@Slug"
                              InitialAgent="@_chatInitialAgent"
                              InitialAgentName="@_chatInitialAgentName"
                              TicketId="_ticket.Id"
                              TicketTitle="@_ticket.Title"
                              OnClose="CloseChatDrawer" />
        </ChildContent>
        <ErrorContent Context="ex">
            <div class="chat-drawer-overlay" @onclick="CloseChatDrawer"></div>
            <div class="chat-drawer" style="padding:1.5rem;color:#f06b6b">
                <strong>Erreur : </strong>@ex.Message
                <br/><button @onclick="CloseChatDrawer" style="margin-top:1rem">Fermer</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
}

@if (_showImprovement)
{
    <TicketImprovementDialog Slug="@Slug" TicketId="@TicketId" OnClose="() => _showImprovement = false" OnChanged="RefreshAsync" />
}

@code {
    private bool _showImprovement;

    private string CostTooltip(long tokens, double cost, bool estimated)
    {
        var value = cost > 0 ? $" · {(estimated ? "≈ " : "")}{KittyClaw.Web.Services.TokenDisplay.Usd(cost)}" : "";
        var note = estimated ? $" · {L["EstimatedCostTooltip"]}" : "";
        return $"{tokens:N0} tokens{value}{note}";
    }

    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter, EditorRequired] public int TicketId { get; set; }
    /// <summary>Bumped by the parent to force a full reload (e.g. after an undo).</summary>
    [Parameter] public int RefreshToken { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Raised after any mutation so the parent can refresh its ticket lists.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Raised with the ticket changed by the user's own successful action.</summary>
    [Parameter] public EventCallback<int> OnMutatedTicket { get; set; }
    /// <summary>Raised after the ticket is deleted; the parent decides where to go.</summary>
    [Parameter] public EventCallback OnDeleted { get; set; }
    /// <summary>Raised with the parent-ticket id when the user opens the sub-kanban.</summary>
    [Parameter] public EventCallback<int> OnEnterSubKanban { get; set; }
