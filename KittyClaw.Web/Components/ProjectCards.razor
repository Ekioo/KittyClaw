@using KittyClaw.Core.Models
@inject LocalizationService L
@inject IJSRuntime JS
@inject KittyClaw.Web.Services.AgentRunsState RunsState
@inject KittyClaw.Core.Services.WorktreeMergeQueueService WorktreeMergeQueueService
@rendermode InteractiveServer
@implements IDisposable

@* Project cards grid (the former Home view): pause toggle, live agent-run badge, and a
   right-click sort menu persisted in localStorage. One of the two display modes of the
   unified home — the other being the swimlane kanban. *@
<div class="project-list" @oncontextmenu="ShowSortMenu" @oncontextmenu:preventDefault>
    @foreach (var project in Sorted)
    {
        <div class="project-card-wrap @(project.IsPaused ? "project-paused" : "")">
            @if (RunsState.ActiveForProject(project.Slug).Any())
            {
                <span class="project-card-agent-badge" title="Agent running"></span>
            }
            <a class="project-card" href="/board/@project.Slug">
                <div class="project-card-heading">
                    <h3>@project.Name</h3>
                    @if (project.IsPaused)
                    {
                        <span class="project-paused-badge">⏸ @L["Paused"]</span>
                    }
                </div>
                @{ var ownerActionCount = OwnerActionCount(project); }
                <div class="project-card-owner-actions @(ownerActionCount > 0 ? "project-card-owner-actions--pending" : "")">
                    <span aria-hidden="true">@(ownerActionCount > 0 ? "⚠" : "✓")</span><span>@L.Get(ownerActionCount == 1 ? "ProjectOwnerActionOne" : "ProjectOwnerActionMany", ownerActionCount)</span>
                </div>
                @if (IntegrationAlert(project) is { } integration)
                {
                    <div class="project-card-integration-alert @IntegrationAlertClass(integration)"
                         title="@IntegrationAlertTitle(integration)">
                        <span aria-hidden="true">⚠</span>
                        <span>@IntegrationAlertText(integration)</span>
                    </div>
                }
            </a>
            <button class="project-pause-btn" title="@(project.IsPaused ? L["Resume"] : L["Pause"])"
                    @onclick="() => OnTogglePause.InvokeAsync(project)" @onclick:stopPropagation>
                <span aria-hidden="true">@(project.IsPaused ? "▶" : "⏸")</span>
                <span class="project-pause-btn-label">@(project.IsPaused ? L["Resume"] : L["Pause"])</span>
            </button>
        </div>
    }
</div>

@if (_sortMenuVisible)
{
    <div class="column-context-menu-backdrop" @onclick="HideSortMenu" @oncontextmenu="HideSortMenu" @oncontextmenu:preventDefault></div>
    <div class="column-context-menu" style="left:@(_sortMenuX)px;top:@(_sortMenuY)px" @onclick:stopPropagation @oncontextmenu:preventDefault>
        <div class="column-context-menu-title">@L["SortProjectsTitle"]</div>
        <button class="column-context-menu-item @(_sortOrder == "name" ? "column-context-menu-item--active" : "")" @onclick='() => SetSort("name")'>
            <span class="column-context-menu-check">@(_sortOrder == "name" ? "✓" : "")</span>
            <span>@L["SortByName"]</span>
        </button>
        <button class="column-context-menu-item @(_sortOrder == "created" ? "column-context-menu-item--active" : "")" @onclick='() => SetSort("created")'>
            <span class="column-context-menu-check">@(_sortOrder == "created" ? "✓" : "")</span>
            <span>@L["SortByCreationDate"]</span>
        </button>
        <button class="column-context-menu-item @(_sortOrder == "updated" ? "column-context-menu-item--active" : "")" @onclick='() => SetSort("updated")'>
            <span class="column-context-menu-check">@(_sortOrder == "updated" ? "✓" : "")</span>
            <span>@L["SortByLastModified"]</span>
        </button>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<Project> Projects { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, int> OwnerActionCounts { get; set; } =
        new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public EventCallback<Project> OnTogglePause { get; set; }

    private int OwnerActionCount(Project project) =>
        OwnerActionCounts.TryGetValue(project.Slug, out var count) ? count : 0;

    private string _sortOrder = "name";
    private bool _sortMenuVisible;
    private double _sortMenuX, _sortMenuY;
    private bool _sortLoaded;
    private readonly Dictionary<string, KittyClaw.Core.Services.WorktreeMergeAlertSummary?> _integrationAlerts =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _alertRefreshCancellation = new();
    private bool _refreshingAlerts;

    // Paused projects sink to the bottom, mirroring the kanban view's lane ordering.
    private IEnumerable<Project> Sorted =>
        Projects.OrderBy(p => p.IsPaused ? 1 : 0).ThenBy(SortKey).ThenBy(p => p.Name);

    private IComparable SortKey(Project p) => _sortOrder switch
    {
        "created" => p.CreatedAt,
        "updated" => p.UpdatedAt,
        _ => (IComparable)p.Name
    };

    protected override void OnInitialized()
    {
        RunsState.OnChange += OnRunsChanged;
        _ = RefreshIntegrationAlertsLoopAsync(_alertRefreshCancellation.Token);
    }

    protected override Task OnParametersSetAsync() => RefreshIntegrationAlertsAsync();

    private async Task RefreshIntegrationAlertsAsync()
    {
        if (_refreshingAlerts) return;
        _refreshingAlerts = true;
        try
        {
            foreach (var project in Projects)
            {
                try { _integrationAlerts[project.Slug] = await WorktreeMergeQueueService.GetAlertSummaryAsync(project.Slug); }
                catch { _integrationAlerts[project.Slug] = null; }
            }
        }
        finally { _refreshingAlerts = false; }
    }

    private async Task RefreshIntegrationAlertsLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(10), cancellationToken);
                await InvokeAsync(async () =>
                {
                    await RefreshIntegrationAlertsAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    private KittyClaw.Core.Services.WorktreeMergeAlertSummary? IntegrationAlert(Project project) =>
        _integrationAlerts.TryGetValue(project.Slug, out var alert) ? alert : null;

    private static string IntegrationAlertClass(KittyClaw.Core.Services.WorktreeMergeAlertSummary alert) =>
        alert.MostSevereStatus is KittyClaw.Core.Services.WorktreeMergeStatus.Conflict
            or KittyClaw.Core.Services.WorktreeMergeStatus.Quarantined
            or KittyClaw.Core.Services.WorktreeMergeStatus.Failed
            or KittyClaw.Core.Services.WorktreeMergeStatus.NeedsReview
            ? "project-card-integration-alert--danger"
            : "project-card-integration-alert--warning";

    private string IntegrationAlertText(KittyClaw.Core.Services.WorktreeMergeAlertSummary alert) =>
        alert.MostSevereStatus == KittyClaw.Core.Services.WorktreeMergeStatus.BlockedByExternalChanges
            ? L["ProjectIntegrationBlockedByLocalChanges"]
            : L.Get(alert.ActiveCount == 1 ? "ProjectIntegrationPendingOne" : "ProjectIntegrationPendingMany", alert.ActiveCount);

    private string IntegrationAlertTitle(KittyClaw.Core.Services.WorktreeMergeAlertSummary alert) =>
        $"{IntegrationAlertText(alert)} · {L.Get("ProjectIntegrationWaitingSince", RelativeAge(alert.OldestUpdatedAt))}";

    private static string RelativeAge(DateTime since)
    {
        var age = DateTime.UtcNow - since.ToUniversalTime();
        if (age.TotalMinutes < 1) return "< 1 min";
        if (age.TotalHours < 1) return $"{(int)age.TotalMinutes} min";
        if (age.TotalDays < 1) return $"{(int)age.TotalHours} h";
        return $"{(int)age.TotalDays} d";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_sortLoaded)
        {
            _sortLoaded = true;
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "kc-project-sort");
            if (stored is "name" or "created" or "updated")
            {
                _sortOrder = stored;
                StateHasChanged();
            }
        }
    }

    private void ShowSortMenu(MouseEventArgs e)
    {
        _sortMenuX = e.ClientX;
        _sortMenuY = e.ClientY;
        _sortMenuVisible = true;
    }

    private void HideSortMenu() => _sortMenuVisible = false;

    private async Task SetSort(string order)
    {
        _sortOrder = order;
        _sortMenuVisible = false;
        await JS.InvokeVoidAsync("localStorage.setItem", "kc-project-sort", order);
    }

    private void OnRunsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _alertRefreshCancellation.Cancel();
        _alertRefreshCancellation.Dispose();
        RunsState.OnChange -= OnRunsChanged;
    }
}
