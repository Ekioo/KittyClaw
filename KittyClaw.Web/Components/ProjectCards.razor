@using KittyClaw.Core.Models
@inject LocalizationService L
@inject IJSRuntime JS
@inject KittyClaw.Web.Services.AgentRunsState RunsState
@inject KittyClaw.Core.Services.WorktreeMergeQueueService WorktreeMergeQueueService
@rendermode InteractiveServer
@implements IDisposable

<div class="project-directory-tools">
    <div class="project-directory-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <input type="search" placeholder="@L["UnifiedBoardSearchPlaceholder"]" aria-label="@L["UnifiedBoardSearchPlaceholder"]"
               @bind="_filterText" @bind:event="oninput" disabled="@(!_interactive)" />
    </div>
    <label class="project-directory-sort">
        <span>@L["SortProjectsTitle"]</span>
        <select value="@_sortOrder" @onchange="SetSort" disabled="@(!_interactive)">
            <option value="name">@L["SortByName"]</option>
            <option value="updated">@L["SortByLastModified"]</option>
            <option value="created">@L["SortByCreationDate"]</option>
        </select>
    </label>
</div>

@{ var visibleProjects = Sorted.ToList(); }
@if (visibleProjects.Count == 0)
{
    <p class="empty-hint" role="status">@L["UnifiedBoardNoMatches"]</p>
}
else
{
    <div class="project-list project-directory-list">
        @foreach (var project in visibleProjects)
        {
            <article @key="project.Slug" class="project-card-wrap project-directory-card @(project.IsPaused ? "project-paused" : "")" data-project-slug="@project.Slug">
                <div class="project-directory-summary">
                    <div class="project-card-heading">
                        <a class="project-directory-title" href="/board/@project.Slug"><h2>@project.Name</h2></a>
                        @if (project.IsPaused)
                        {
                            <span class="project-paused-badge">@L["Paused"]</span>
                        }
                        @if (RunsState.ActiveForProject(project.Slug).Any())
                        {
                            <span class="project-directory-running">
                                <span class="project-card-agent-badge" aria-hidden="true"></span>
                                @L["ProjectAgentsRunning"]
                            </span>
                        }
                    </div>
                    @{ var pipelines = ColumnsFor(project).GroupBy(column => column.PipelineId).ToArray(); }
                    <div class="project-directory-pipelines" aria-label="@L["ProjectColumns"]">
                        @foreach (var pipeline in pipelines)
                        {
                            <div class="project-directory-pipeline" data-pipeline-id="@pipeline.Key">
                                @if (pipelines.Length > 1)
                                {
                                    <span class="project-directory-pipeline-name">@pipeline.First().PipelineName</span>
                                }
                                <div class="project-directory-columns">
                                    @foreach (var column in pipeline)
                                    {
                                        <a class="project-column-summary" style="--column-color: @column.Color"
                                              href="@($"/board/{project.Slug}?pipeline={column.PipelineId}&column={column.ColumnId}")"
                                              title="@L.Get("ProjectOpenColumn", project.Name, column.PipelineName, column.Name)"
                                              data-column-id="@column.ColumnId" data-ticket-count="@column.TicketCount">
                                            <span class="project-column-name">@column.Name</span>
                                            <b class="project-column-count">@column.TicketCount</b>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @if (IntegrationAlert(project) is { } integration)
                    {
                        <div class="project-directory-alerts">
                            <span class="project-card-integration-alert @IntegrationAlertClass(integration)" title="@IntegrationAlertTitle(integration)">
                                <span aria-hidden="true">⚠</span><span>@IntegrationAlertText(integration)</span>
                            </span>
                        </div>
                    }
                </div>
                <nav class="project-directory-actions" aria-label="@L.Get("ProjectQuickAccess", project.Name)">
                    <a class="project-quick-link project-quick-link--primary" href="/board/@project.Slug">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16M15 4v16M5.5 8h1M11.5 8h1M17.5 8h1" /></svg>
                        <span>@L["KanbanView"]</span>
                    </a>
                    <a class="project-quick-link" href="/board/@project.Slug/dashboard">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                        <span>@L["Dashboard"]</span>
                    </a>
                    <a class="project-quick-link" href="/board/@project.Slug/settings">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m9.5 3-.6 2.2-2 .9-2-.6-2.4 4.1L4 11.3v2l-1.5 1.7 2.4 4.1 2-.6 2 .9.6 2.2h5l.6-2.2 2-.9 2 .6 2.4-4.1-1.5-1.7v-2l1.5-1.7-2.4-4.1-2 .6-2-.9-.6-2.2z" /><circle cx="12" cy="12" r="3" /></svg>
                        <span>@L["ProjectSettings"]</span>
                    </a>
                </nav>
            </article>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<Project> Projects { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<BoardColumnSummary>> ProjectColumns { get; set; } =
        new Dictionary<string, IReadOnlyList<BoardColumnSummary>>(StringComparer.OrdinalIgnoreCase);

    private string _sortOrder = "name";
    private string _filterText = "";
    private bool _interactive;
    private readonly Dictionary<string, KittyClaw.Core.Services.WorktreeMergeAlertSummary?> _integrationAlerts =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _alertRefreshCancellation = new();
    private bool _refreshingAlerts;

    private IReadOnlyList<BoardColumnSummary> ColumnsFor(Project project) =>
        ProjectColumns.TryGetValue(project.Slug, out var columns) ? columns : [];

    private IEnumerable<Project> Sorted => Projects
        .Where(p => KittyClaw.Web.Services.ProjectDirectorySearch.Matches(p, ColumnsFor(p), _filterText))
        .OrderBy(p => p.IsPaused ? 1 : 0).ThenBy(SortKey).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase);

    private IComparable SortKey(Project p) => _sortOrder switch
    {
        "created" => p.CreatedAt,
        "updated" => p.UpdatedAt,
        _ => p.Name.ToUpperInvariant()
    };

    protected override void OnInitialized()
    {
        RunsState.OnChange += OnRunsChanged;
        _ = RefreshIntegrationAlertsLoopAsync(_alertRefreshCancellation.Token);
    }

    protected override Task OnParametersSetAsync() => RefreshIntegrationAlertsAsync();

    private async Task RefreshIntegrationAlertsAsync()
    {
        if (_refreshingAlerts) return;
        _refreshingAlerts = true;
        try
        {
            foreach (var project in Projects)
            {
                try { _integrationAlerts[project.Slug] = await WorktreeMergeQueueService.GetAlertSummaryAsync(project.Slug); }
                catch { _integrationAlerts[project.Slug] = null; }
            }
        }
        finally { _refreshingAlerts = false; }
    }

    private async Task RefreshIntegrationAlertsLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(10), cancellationToken);
                await InvokeAsync(async () =>
                {
                    await RefreshIntegrationAlertsAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    private KittyClaw.Core.Services.WorktreeMergeAlertSummary? IntegrationAlert(Project project) =>
        _integrationAlerts.TryGetValue(project.Slug, out var alert) ? alert : null;

    private static string IntegrationAlertClass(KittyClaw.Core.Services.WorktreeMergeAlertSummary alert) =>
        alert.MostSevereStatus is KittyClaw.Core.Services.WorktreeMergeStatus.Conflict
            or KittyClaw.Core.Services.WorktreeMergeStatus.Quarantined
            or KittyClaw.Core.Services.WorktreeMergeStatus.Failed
            or KittyClaw.Core.Services.WorktreeMergeStatus.NeedsReview
            ? "project-card-integration-alert--danger"
            : "project-card-integration-alert--warning";

    private string IntegrationAlertText(KittyClaw.Core.Services.WorktreeMergeAlertSummary alert) =>
        alert.MostSevereStatus == KittyClaw.Core.Services.WorktreeMergeStatus.BlockedByExternalChanges
            ? L["ProjectIntegrationBlockedByLocalChanges"]
            : L.Get(alert.ActiveCount == 1 ? "ProjectIntegrationPendingOne" : "ProjectIntegrationPendingMany", alert.ActiveCount);

    private string IntegrationAlertTitle(KittyClaw.Core.Services.WorktreeMergeAlertSummary alert) =>
        $"{IntegrationAlertText(alert)} · {L.Get("ProjectIntegrationWaitingSince", RelativeAge(alert.OldestUpdatedAt))}";

    private static string RelativeAge(DateTime since)
    {
        var age = DateTime.UtcNow - since.ToUniversalTime();
        if (age.TotalMinutes < 1) return "< 1 min";
        if (age.TotalHours < 1) return $"{(int)age.TotalMinutes} min";
        if (age.TotalDays < 1) return $"{(int)age.TotalHours} h";
        return $"{(int)age.TotalDays} d";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "kc-project-sort");
            if (stored is "name" or "created" or "updated") _sortOrder = stored;
        }
        catch (JSException) { /* Browser storage can be unavailable. */ }
        _interactive = true;
        StateHasChanged();
    }

    private async Task SetSort(ChangeEventArgs args)
    {
        var order = args.Value?.ToString();
        if (order is not ("name" or "created" or "updated")) return;
        _sortOrder = order;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "kc-project-sort", order); }
        catch (JSException) { /* Sorting still works without persisted preferences. */ }
    }

    private void OnRunsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _alertRefreshCancellation.Cancel();
        _alertRefreshCancellation.Dispose();
        RunsState.OnChange -= OnRunsChanged;
    }
}
