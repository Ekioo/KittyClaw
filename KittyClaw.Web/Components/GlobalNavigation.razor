@rendermode InteractiveServer
@implements IAsyncDisposable
@inject LocalizationService L
@inject ProjectService Projects
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject BoardUpdateNotifier Updates

<button @ref="_mobileTrigger" class="mobile-sidebar-trigger" type="button" aria-label="@L["OpenProjectNavigation"]" title="@L["OpenProjectNavigation"]" aria-expanded="false" aria-controls="project-sidebar">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
</button>
<button @ref="_mobileBackdrop" class="sidebar-backdrop" type="button" tabindex="-1" aria-label="@L["Close"]"></button>
<aside id="project-sidebar" @ref="_sidebar" class="app-sidebar @(_collapsed ? "is-collapsed" : "")" aria-label="@L["Projects"]">
    <a class="sidebar-brand" href="/" title="KittyClaw"><img src="/KittyClaw-Logo-Horizontal.webp?v=posture07-rounded" alt="KittyClaw" /></a>
    <button @ref="_mobileClose" class="mobile-sidebar-close" type="button" aria-label="@L["CloseProjectNavigation"]" title="@L["CloseProjectNavigation"]">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
    <button class="sidebar-toggle" type="button" @onclick="Toggle" aria-expanded="@(!_collapsed)" aria-controls="sidebar-navigation" aria-label="@ToggleLabel" title="@ToggleLabel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M9 4v16"/><path d="@(_collapsed ? "M12 8l3 4-3 4" : "M15 8l-3 4 3 4")"/></svg>
    </button>
    <div id="sidebar-navigation" class="sidebar-navigation">
        <nav class="sidebar-pages" aria-label="KittyClaw">
            <NavLink href="/" Match="NavLinkMatch.All" title="@L["Projects"]" aria-label="@L["Projects"]"><span class="sidebar-icon" aria-hidden="true">▦</span><span class="sidebar-label">@L["Projects"]</span></NavLink>
            <NavLink href="/costs" title="@L["Costs"]" aria-label="@L["Costs"]"><span class="sidebar-icon" aria-hidden="true">◴</span><span class="sidebar-label">@L["Costs"]</span></NavLink>
            <NavLink href="/temporary-storage" title="@L["TemporaryStorageTitle"]" aria-label="@L["TemporaryStorageTitle"]"><span class="sidebar-icon" aria-hidden="true">▤</span><span class="sidebar-label">@L["TemporaryStorageTitle"]</span></NavLink>
            <NavLink href="/settings" title="@L["GlobalSettings"]" aria-label="@L["GlobalSettings"]"><span class="sidebar-icon" aria-hidden="true">⚙</span><span class="sidebar-label">@L["GlobalSettings"]</span></NavLink>
        </nav>
        <div class="sidebar-section-label">@L["Projects"]</div>
        <nav class="sidebar-projects" aria-label="@L["Projects"]">
            @foreach (var project in _projects)
            {
                <NavLink @key="project.Slug" href="@($"/board/{Uri.EscapeDataString(project.Slug)}")" title="@project.Name" aria-label="@project.Name">
                    <ProjectAvatar Seed="@project.Slug" />
                    <span class="sidebar-label">@project.Name</span>
                </NavLink>
            }
        </nav>
    </div>
    <div class="sidebar-resize-handle" role="separator" tabindex="0" aria-orientation="vertical" aria-label="@ResizeLabel" title="@ResizeLabel" aria-valuemin="200" aria-valuemax="480" aria-valuenow="232"></div>
</aside>

@code {
    private List<Project> _projects = [];
    private bool _collapsed;
    private ElementReference _sidebar;
    private ElementReference _mobileTrigger;
    private ElementReference _mobileBackdrop;
    private ElementReference _mobileClose;
    private string ResizeLabel => L.Lang == "fr" ? "Redimensionner la barre latérale" : "Resize sidebar";
    private IJSObjectReference? _module;
    private bool _disposed;
    private string ToggleLabel => L.Lang == "fr" ? (_collapsed ? "Déplier la barre latérale" : "Replier la barre latérale") : (_collapsed ? "Expand sidebar" : "Collapse sidebar");
    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Updates.OnProjectUpdated += OnProjectUpdated;
        L.OnLanguageChanged += OnLanguageChanged;
        _projects = await Projects.ListProjectsAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sidebar.js");
            _collapsed = await _module.InvokeAsync<bool>("readCollapsed");
            await _module.InvokeVoidAsync("initializeResize", _sidebar);
            await _module.InvokeVoidAsync("initializeMobileNavigation", _sidebar, _mobileTrigger, _mobileClose, _mobileBackdrop);
            StateHasChanged();
        }
        catch (JSException) { }
    }
    private async Task Toggle()
    {
        _collapsed = !_collapsed;
        try { if (_module is not null) await _module.InvokeVoidAsync("saveCollapsed", _collapsed); }
        catch (JSException) { }
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => RefreshProjects();
    private void OnProjectUpdated(string slug) => RefreshProjects();
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    private void RefreshProjects() => _ = InvokeAsync(async () =>
    {
        var projects = await Projects.ListProjectsAsync();
        if (_disposed) return;
        _projects = projects;
        StateHasChanged();
    });
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;
        Updates.OnProjectUpdated -= OnProjectUpdated;
        L.OnLanguageChanged -= OnLanguageChanged;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeMobileNavigation", _sidebar);
                await _module.InvokeVoidAsync("disposeResize", _sidebar);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }
}
