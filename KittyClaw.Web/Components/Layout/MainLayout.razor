@inherits LayoutComponentBase
@using KittyClaw.Core.Services
@inject LocalizationService L
@inject NavigationManager Navigation

<EscapeKeyHost />
<BoardFocusHost />
<a class="app-skip-link" href="@(Navigation.Uri.Split('#')[0] + "#main-content")" data-enhance-nav="false">@L["SkipToContent"]</a>
<div class="app-shell">
    <GlobalNavigation />
    <main id="main-content" class="app-content" tabindex="-1">@Body</main>
</div>

<UpdateBanner />

<div id="blazor-error-ui" data-nosnippet>
    <div class="error-copy">
        <strong>@L["SessionInterrupted"]</strong>
        <span>@L["SessionInterruptedHint"]</span>
    </div>
    <button type="button" class="reload" onclick="location.reload()">@L["ReloadPage"]</button>
    <button type="button" class="dismiss" aria-label="@L["Close"]">&#10005;</button>
</div>
