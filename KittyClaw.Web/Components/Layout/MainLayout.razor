@inherits LayoutComponentBase
@using KittyClaw.Core.Services
@inject LocalizationService L

<EscapeKeyHost />
@Body

<UpdateBanner />

<div id="blazor-error-ui" data-nosnippet>
    <div class="error-copy">
        <strong>@L["SessionInterrupted"]</strong>
        <span>@L["SessionInterruptedHint"]</span>
    </div>
    <button type="button" class="reload" onclick="location.reload()">@L["ReloadPage"]</button>
    <button type="button" class="dismiss" aria-label="@L["Close"]">&#10005;</button>
</div>
