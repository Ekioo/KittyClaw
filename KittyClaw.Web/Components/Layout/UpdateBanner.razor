@rendermode InteractiveServer
@implements IDisposable
@inject KittyClaw.Web.Services.UpdateCheckService UpdateCheck
@inject KittyClaw.Web.Services.InstalledUpdateService Installer

@if (UpdateCheck.HasUpdate || (Installer.IsSupported && (Installer.IsReady || Installer.IsBusy || Installer.Error is not null || Installer.IsRestarting)))
{
    <div class="update-banner" role="status">
        <span class="update-banner-icon">✨</span>
        <span class="update-banner-text">
            A new version is available
            <a href="@($"https://github.com/Ekioo/KittyClaw/releases/tag/{ReleaseTag}")"
               target="_blank" rel="noopener">@AvailableVersion</a>
            (current: @UpdateCheck.CurrentVersion)
        </span>
        @if (Installer.IsSupported)
        {
            @if (Installer.IsRestarting)
            {
                <span>Restarting KittyClaw… This page will reconnect after the update.</span>
            }
            else if (Installer.IsBusy)
            {
                <span>Downloading update: @Installer.Progress%</span>
            }
            else if (Installer.IsReady)
            {
                <button type="button" class="btn btn-primary" data-update-restart @onclick="Installer.InstallAndRestart">Update and restart</button>
            }
            @if (Installer.Error is not null)
            {
                <span role="alert">@Installer.Error</span>
            }
        }
        <button type="button" class="update-banner-dismiss" @onclick="OnDismiss" aria-label="Dismiss">✕</button>
    </div>
}

@code {
    private string? AvailableVersion => Installer.IsSupported ? Installer.AvailableVersion : UpdateCheck.LatestVersion;
    private string? ReleaseTag => AvailableVersion is { } version
        ? "v" + version.TrimStart('v', 'V') : null;

    protected override void OnInitialized()
    {
        UpdateCheck.OnChange += HandleChange;
        Installer.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnDismiss()
    {
        UpdateCheck.Dismiss();
    }

    public void Dispose()
    {
        UpdateCheck.OnChange -= HandleChange;
        Installer.OnChange -= HandleChange;
    }
}
