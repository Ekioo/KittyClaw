@using KittyClaw.Core.Automation
@using KittyClaw.Web.Services
@using Markdig
@inject AgentRunsState RunsState
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LocalizationService L
@implements IAsyncDisposable

<div class="chat-drawer-overlay" @onclick="Close"></div>
<div class="chat-drawer" @onclick:stopPropagation>
    @if (_view == View.Selection)
    {
        <div class="chat-drawer-header">
            <span class="chat-drawer-title">@L["NewInstruction"]</span>
            <button class="agent-close-btn" @onclick="Close" title="@L["Close"]">×</button>
        </div>
        <div class="chat-target-list">
            <h3>@L["ChatPickTarget"]</h3>
            @if (!_ready)
            {
                <div class="chat-history-loading" role="status">
                    <span class="chat-loading-spinner" aria-hidden="true"></span>
                    <span>@L["ChatLoadingTargets"]</span>
                </div>
            }
            else
            {
                @foreach (var t in _targets)
                {
                    <button class="chat-target-item @(t.Kind == "claude" ? "claude-direct" : "")"
                            @onclick="() => SelectTarget(t)">
                        <span class="chat-target-name">@t.Name</span>
                        <span class="chat-target-kind">@(t.Kind == "claude" ? L["ChatTalkToClaude"] : L["ChatMember"])</span>
                    </button>
                }
                @if (_targets.Count == 0)
                {
                    <div class="chat-empty">@L["ChatPickTarget"]</div>
                }
            }
        </div>
    }
    else
    {
        <div class="chat-drawer-header">
            @if (TicketId is null)
            {
                <button class="chat-back-btn" @onclick="BackToSelection" title="@L["Back"]">‹</button>
            }
            <span class="chat-drawer-title">
                @_activeTarget!.Name
                @if (TicketId is int tid)
                {
                    <span class="chat-drawer-ticket-ref" title="@TicketTitle">· #@tid @(string.IsNullOrEmpty(TicketTitle) ? "" : "— " + SharedRenderHelpers.Truncate(TicketTitle!, 40))</span>
                }
            </span>
            <select class="chat-drawer-model-select" @bind="_selectedModel" @bind:after="PersistSelectedModelAsync" disabled="@_historyLoading">
                <optgroup label="Claude">
                    @foreach (var m in ClaudeModels)
                    {
                        <option value="@m">@m</option>
                    }
                </optgroup>
                @if (_grokModels.Count > 0)
                {
                    <optgroup label="Grok">
                        @foreach (var m in _grokModels)
                        {
                            <option value="@m">@m</option>
                        }
                    </optgroup>
                }
                @if (_codexModels.Count > 0)
                {
                    <optgroup label="OpenAI Codex">
                        @foreach (var m in _codexModels)
                        {
                            <option value="@m">@m</option>
                        }
                    </optgroup>
                }
                @if (_mistralModels.Count > 0)
                {
                    <optgroup label="Mistral Vibe">
                        @foreach (var m in _mistralModels)
                        {
                            <option value="@m">@m</option>
                        }
                    </optgroup>
                }
                @if (_ollamaModels.Count > 0)
                {
                    <optgroup label="Local (Ollama)">
                        @foreach (var m in _ollamaModels)
                        {
                            <option value="@m">@m</option>
                        }
                    </optgroup>
                }
                @if (!string.IsNullOrWhiteSpace(_selectedModel) && !AllModels.Contains(_selectedModel))
                {
                    <option value="@_selectedModel">@_selectedModel</option>
                }
            </select>
            <button class="chat-newsession-btn" @onclick="StartNewSession" disabled="@_historyLoading" title="@L["NewSession"]">＋</button>
            <button class="agent-close-btn" @onclick="Close" title="@L["Close"]">×</button>
        </div>

        <div class="chat-messages" @ref="_messagesRef">
            @if (_historyLoading)
            {
                <div class="chat-history-loading" role="status">
                    <span class="chat-loading-spinner" aria-hidden="true"></span>
                    <span>@L["ChatLoadingConversation"]</span>
                </div>
            }
            @foreach (var msg in _messages)
            {
                if (msg.Role == "tool_use")
                {
                    var toolMsg = (ToolCallMessage)msg;
                    <div class="chat-message chat-message-tool">
                        <details class="tool-call-block">
                            <summary class="tool-call-summary">
                                <span class="tool-call-icon">⚙</span>
                                <span class="tool-call-name">@toolMsg.ToolName</span>
                                <span class="tool-call-preview">@toolMsg.Preview</span>
                            </summary>
                            <pre class="tool-call-detail">@toolMsg.Detail</pre>
                        </details>
                    </div>
                }
                else if (msg.Role == "ask_user_question")
                {
                    var askMsg = (AskUserQuestionMessage)msg;
                    <div class="chat-message chat-ask-user @(askMsg.IsAnswered ? "chat-ask-user-answered" : "")">
                        <div class="chat-bubble">
                            <p class="chat-ask-prompt">
                                @if (string.IsNullOrWhiteSpace(askMsg.Prompt))
                                {
                                    <span>The agent is asking for input</span>
                                }
                                else
                                {
                                    @askMsg.Prompt
                                }
                            </p>
                            @if (askMsg.Options.Length > 0)
                            {
                                @foreach (var opt in askMsg.Options)
                                {
                                    var optCopy = opt;
                                    <button class="chat-ask-option" disabled="@askMsg.IsAnswered"
                                            @onclick="() => SubmitAskUserQuestion(askMsg, optCopy)">@opt</button>
                                }
                            }
                            else
                            {
                                <textarea class="chat-ask-textarea" disabled="@askMsg.IsAnswered"
                                          @bind="askMsg.InputText" placeholder="Type your answer…"></textarea>
                                <button class="chat-ask-submit" disabled="@(askMsg.IsAnswered || string.IsNullOrWhiteSpace(askMsg.InputText))"
                                        @onclick="() => SubmitAskUserQuestion(askMsg, askMsg.InputText)">Submit</button>
                            }
                        </div>
                    </div>
                }
                else if (msg.Role == "reset")
                {
                    <div class="chat-message chat-message-reset">@L["ChatSessionReset"]</div>
                }
                else if (msg.Role == "inject")
                {
                    <div class="chat-message chat-message-inject">
                        <div class="chat-bubble">↩ @msg.Text</div>
                    </div>
                }
                else if (msg is DiagnosticMessage diagnostic)
                {
                    <div class="chat-message chat-message-diagnostic chat-message-@diagnostic.Role">
                        <details class="chat-diagnostic-block">
                            <summary class="chat-diagnostic-summary">
                                <span class="chat-diagnostic-icon">!</span>
                                <span class="chat-diagnostic-title">@diagnostic.Summary</span>
                                <span class="chat-diagnostic-disclosure">@L["ChatTechnicalDetails"]</span>
                            </summary>
                            <pre class="chat-diagnostic-detail">@diagnostic.Text</pre>
                        </details>
                    </div>
                }
                else
                {
                    <div class="chat-message chat-message-@msg.Role">
                        <div class="chat-bubble markdown-body">@((MarkupString)RenderMarkdown(msg.Text))</div>
                    </div>
                }
            }
            @if (_loading)
            {
                <div class="chat-message chat-message-assistant">
                    <div class="chat-bubble chat-bubble-loading">
                        @if (string.IsNullOrEmpty(_streamingText))
                        {
                            <text>…</text>
                        }
                        else
                        {
                            @((MarkupString)RenderMarkdown(_streamingText))
                        }
                    </div>
                </div>
            }
            @if (_messages.Count == 0 && !_loading && !_historyLoading)
            {
                <div class="chat-empty">
                    @(_activeTarget!.Kind == "member"
                        ? L.Get("ChatEmptyMember", _activeTarget.Name)
                        : L["ChatEmpty"])
                </div>
            }
        </div>

        @if (_hitMaxTurns)
        {
            <div class="chat-max-turns-banner">
                <span>@L["ChatMaxTurns"]</span>
                <button class="chat-continue-btn" @onclick="Continue">@L["ChatContinue"]</button>
            </div>
        }

        <div class="chat-input-area @(_loading ? "chat-input-area-thinking" : "")">
            @if (!string.IsNullOrEmpty(_pasteError))
            {
                <div class="chat-paste-error">@_pasteError</div>
            }
            @if (_pendingImages.Count > 0)
            {
                <div class="chat-paste-previews">
                    @for (var i = 0; i < _pendingImages.Count; i++)
                    {
                        var idx = i;
                        var img = _pendingImages[i];
                        <div class="chat-paste-preview">
                            <img src="@img.DataUrl" alt="@img.Name" />
                            <button type="button" class="chat-paste-remove" @onclick="() => RemoveImage(idx)" title="Remove">×</button>
                        </div>
                    }
                </div>
            }
            <textarea @ref="_inputRef"
                      value="@_inputText"
                      @oninput="OnInput"
                      disabled="@_historyLoading"
                      placeholder="@(_historyLoading ? L["ChatLoadingConversation"] : _loading ? L["ChatInjectPlaceholder"] : L["ChatPlaceholder"])"
                      @onkeydown="OnKeyDown"></textarea>
            @if (_loading && !string.IsNullOrEmpty(_activeStreamId))
            {
                <div class="chat-input-actions">
                    <button class="chat-inject-btn" @onclick="Inject" disabled="@string.IsNullOrWhiteSpace(_inputText)" title="@L["ChatInject"]">↩ @L["ChatInject"]</button>
                    <button class="chat-stop-btn" @onclick="StopActiveRun" title="@L["Stop"]">⏹ @L["Stop"]</button>
                </div>
            }
            else
            {
                <button @onclick="Send" disabled="@(_historyLoading || (string.IsNullOrWhiteSpace(_inputText) && _pendingImages.Count == 0) || _loading)">@L["Send"]</button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string ProjectSlug { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Optional. When set, skip the target picker and start a chat with this agent slug.</summary>
    [Parameter] public string? InitialAgent { get; set; }
    /// <summary>Optional. Display name for the InitialAgent (falls back to slug).</summary>
    [Parameter] public string? InitialAgentName { get; set; }
    /// <summary>Optional draft placed in the composer without sending it automatically.</summary>
    [Parameter] public string? InitialMessage { get; set; }
    /// <summary>Explicit opt-in for confirmed flows that must start immediately (for example an approved migration).</summary>
    [Parameter] public bool AutoSendInitialMessage { get; set; }
    /// <summary>Optional. When set together with InitialAgent, scopes the chat to a specific ticket.</summary>
    [Parameter] public int? TicketId { get; set; }
    /// <summary>Optional. Title of the scoped ticket, shown in the drawer header.</summary>
    [Parameter] public string? TicketTitle { get; set; }

    private enum View { Selection, Conversation }
    private View _view = View.Selection;

    private readonly List<ChatTarget> _targets = [];
    private ChatTarget? _activeTarget;
    private bool _ready = false;
    private bool _historyLoading;

    private readonly List<ChatMessage> _messages = [];
    private string _inputText = "";
    private bool _loading = false;
    private ElementReference _messagesRef;
    private ElementReference _inputRef;
    private AgentRun? _activeRun;
    private IJSObjectReference? _sseModule;
    private DotNetObjectReference<ChatDrawer>? _dotnetRef;
    private string? _activeStreamId;
    private bool _hitMaxTurns = false;

    private string _selectedModel = DefaultModel;
    private string? _sessionModel; // model used by the current session (for detecting changes)
    private string? _streamingText;
    private List<string> _ollamaModels = new();
    private List<string> _grokModels = new();
    private List<string> _codexModels = new();
    private List<string> _mistralModels = new();
    private const string DefaultModel = ClaudeModelCatalog.DefaultModel;
    private static readonly IReadOnlyList<string> ClaudeModels = ClaudeModelCatalog.Models;
    private List<string> AllModels => ClaudeModels.Concat(_grokModels).Concat(_codexModels).Concat(_mistralModels).Concat(_ollamaModels).ToList();
    private string SelectedModelStorageKey => $"kc-chat-model-{ProjectSlug}";

    // Image paste (#115). Accepted clipboard images await Send() in this buffer; rejections
    // surface in _pasteError as a small inline banner.
    public sealed record PendingImage(string DataUrl, string Mime, string Name, long SizeBytes);
    private readonly List<PendingImage> _pendingImages = [];
    private string? _pasteError;

    private record ChatMessage(string Role, string Text);
    private sealed record DiagnosticMessage(string DiagnosticRole, string Summary, string Detail)
        : ChatMessage(DiagnosticRole, Detail);
    private sealed record ToolCallMessage(string ToolName, string Preview, string Detail)
        : ChatMessage("tool_use", ToolName);
    private sealed record AskUserQuestionMessage(string Prompt, string[] Options, string? RunId = null)
        : ChatMessage("ask_user_question", Prompt)
    {
        public bool IsAnswered { get; set; }
        public string InputText { get; set; } = "";
    }
    private sealed record ChatTarget(string Slug, string Name, string Kind);

    private string? _activeRunId => _activeStreamId;

    protected override async Task OnInitializedAsync()
    {
        _inputText = InitialMessage ?? "";
        // Force an initial render before any disk/network work. This matters after a reboot,
        // when model discovery and SQLite warm-up can take several seconds.
        await Task.Yield();
        var modelCatalogTask = FetchOllamaModelsAsync();
        // Ticket-scoped or pre-targeted chat: skip the picker entirely.
        if (!string.IsNullOrWhiteSpace(InitialAgent))
        {
            var slug = TicketId is int id ? $"{InitialAgent}#ticket-{id}" : InitialAgent!;
            var name = string.IsNullOrWhiteSpace(InitialAgentName) ? InitialAgent! : InitialAgentName!;
            var target = new ChatTarget(slug, name, "member");
            await EnterConversationAsync(target);
            _ready = true;
            if (AutoSendInitialMessage && !string.IsNullOrWhiteSpace(_inputText))
                await Send();
            await modelCatalogTask;
            return;
        }

        using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
        try
        {
            var resp = await http.GetFromJsonAsync<TargetsResponse>($"/api/projects/{ProjectSlug}/chat/targets");
            if (resp is not null)
            {
                _targets.Clear();
                foreach (var t in resp.Targets)
                    _targets.Add(new ChatTarget(t.Slug, t.Name, t.Kind));

                if (!string.IsNullOrEmpty(resp.LastTarget))
                {
                    var last = _targets.FirstOrDefault(t => t.Slug == resp.LastTarget);
                    if (last is not null)
                    {
                        await EnterConversationAsync(last);
                    }
                }
            }
        }
        catch { /* leave _view = Selection */ }
        finally { _ready = true; }
        await modelCatalogTask;
    }

    private bool IsAvailableModel(string? model) =>
        !string.IsNullOrWhiteSpace(model) &&
        (ClaudeModels.Contains(model) || _ollamaModels.Contains(model) ||
         _grokModels.Contains(model) || _codexModels.Contains(model) || _mistralModels.Contains(model));

    private async Task PersistSelectedModelAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", SelectedModelStorageKey, _selectedModel);
        }
        catch { /* localStorage unavailable — selection remains valid for this drawer instance */ }
    }

    private async Task RestoreRememberedModelAsync()
    {
        try
        {
            var storedModel = await JS.InvokeAsync<string?>("localStorage.getItem", SelectedModelStorageKey);
            if (IsAvailableModel(storedModel))
                _selectedModel = storedModel!;
        }
        catch { /* localStorage unavailable — keep the current model */ }
    }

    private async Task FetchOllamaModelsAsync()
    {
        if (string.IsNullOrWhiteSpace(ProjectSlug)) return;
        using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
        var ollamaTask = TryFetchModelsAsync(http, $"/api/projects/{ProjectSlug}/ollama-models");
        var grokTask = TryFetchModelsAsync(http, "/api/grok-models");
        var codexTask = TryFetchModelsAsync(http, "/api/codex-models");
        var mistralTask = TryFetchModelsAsync(http, "/api/mistral-models");
        await Task.WhenAll(ollamaTask, grokTask, codexTask, mistralTask);
        _ollamaModels = await ollamaTask;
        _grokModels = await grokTask;
        _codexModels = await codexTask;
        _mistralModels = await mistralTask;
    }

    private static async Task<List<string>> TryFetchModelsAsync(HttpClient http, string uri)
    {
        try { return await http.GetFromJsonAsync<List<string>>(uri) ?? new(); }
        catch { return new(); }
    }

    private async Task EnterConversationAsync(ChatTarget target)
    {
        _activeTarget = target;
        _messages.Clear();
        _view = View.Conversation;
        _historyLoading = true;
        StateHasChanged();
        string? latestMessageAt = null;
        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            var escapedTarget = Uri.EscapeDataString(target.Slug);
            var modelTask = http.GetFromJsonAsync<ChatModelResponse>(
                $"/api/projects/{ProjectSlug}/chat/model?target={escapedTarget}");
            var messagesTask = http.GetFromJsonAsync<List<ServerChatMessage>>(
                $"/api/projects/{ProjectSlug}/chat/messages?target={escapedTarget}");

            ChatModelResponse? modelResponse = null;
            List<ServerChatMessage>? msgs = null;
            try { modelResponse = await modelTask; } catch { }
            try { msgs = await messagesTask; } catch { }
            if (!string.IsNullOrWhiteSpace(modelResponse?.Model))
            {
                _sessionModel = modelResponse.Model;
                _selectedModel = modelResponse.Model;
            }
            if (msgs is not null)
            {
                foreach (var m in msgs)
                {
                    if (m.Role == "tool_use")
                    {
                        var preview = GetToolPreview(m.ToolName ?? m.Text, m.Detail);
                        _messages.Add(new ToolCallMessage(m.ToolName ?? m.Text, preview, m.Detail ?? "{}"));
                    }
                    else if (m.Role == "ask_user_question")
                    {
                        var (prompt, options) = ParseAskUserQuestionDetail(m.Detail);
                        _messages.Add(new AskUserQuestionMessage(prompt, options) { IsAnswered = true });
                    }
                    else
                    {
                        if (m.Role == "stderr") AddStderrMessage(m.Text);
                        else if (m.Role == "error") AddErrorMessage(m.Text);
                        else _messages.Add(new ChatMessage(m.Role, m.Text));
                    }
                    latestMessageAt = m.CreatedAt;
                }
            }
        }
        catch { /* show empty conversation */ }
        finally { _historyLoading = false; }
        StateHasChanged();

        // If a chat run is still in flight server-side (drawer was closed mid-stream
        // and the backend kept emitting events), reattach the SSE stream so the
        // remaining and future events surface in the UI. The `since` cursor avoids
        // replaying buffered events already persisted before this reopen.
        await TryReattachActiveRunAsync(target, latestMessageAt);
    }

    private async Task TryReattachActiveRunAsync(ChatTarget target, string? sinceIso)
    {
        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            var resp = await http.GetFromJsonAsync<ActiveResponse>(
                $"/api/projects/{ProjectSlug}/chat/active?target={Uri.EscapeDataString(target.Slug)}");
            if (resp?.RunId is not string runId) return;

            _activeRun = RunsState.Get(runId);
            _loading = true;
            _sseModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/agent-sse.js");
            _dotnetRef ??= DotNetObjectReference.Create(this);
            _activeStreamId = runId;
            var url = $"/api/projects/{ProjectSlug}/runs/{runId}/stream";
            if (!string.IsNullOrEmpty(sinceIso))
                url += $"?since={Uri.EscapeDataString(sinceIso)}";
            await _sseModule.InvokeVoidAsync("start", _dotnetRef, url);
            StateHasChanged();
        }
        catch { /* best-effort */ }
    }

    private async Task SelectTarget(ChatTarget t)
    {
        // When the drawer is ticket-scoped but no agent was preselected, re-key the
        // chosen target into the per-ticket composite slug so this conversation
        // gets its own thread.
        if (TicketId is int id && !t.Slug.Contains('#'))
        {
            t = t with { Slug = $"{t.Slug}#ticket-{id}" };
        }
        await EnterConversationAsync(t);
    }

    private async Task BackToSelection()
    {
        await StopStream();
        _view = View.Selection;
        _activeTarget = null;
        _messages.Clear();
        _streamingText = null;
        _loading = false;
        StateHasChanged();
    }

    private async Task StartNewSession()
    {
        if (_activeTarget is null) return;
        await StopStream();
        _streamingText = null;
        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            await http.DeleteAsync($"/api/projects/{ProjectSlug}/chat/session?target={Uri.EscapeDataString(_activeTarget.Slug)}");
        }
        catch { /* best-effort */ }
        _messages.Clear();
        _loading = false;
        _sessionModel = null;
        await RestoreRememberedModelAsync();
        // Ticket-scoped chats stay on the same target after a reset; only the picker mode falls back to selection.
        if (string.IsNullOrWhiteSpace(InitialAgent))
        {
            _view = View.Selection;
            _activeTarget = null;
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_sessionModel is null)
            {
                await RestoreRememberedModelAsync();
                StateHasChanged();
            }
            try { await _inputRef.FocusAsync(); } catch { }
        }
        if (_view == View.Conversation)
        {
            try { await JS.InvokeVoidAsync("chatDrawerInstallEnterGuard", _inputRef); } catch { }
            _dotnetRef ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("chatDrawerInstallPasteHandler", _inputRef, _dotnetRef); } catch { }
        }
        try
        {
            await JS.InvokeVoidAsync("chatDrawerScrollToBottom", _messagesRef);
        }
        catch { }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            if (_loading && !string.IsNullOrEmpty(_activeStreamId))
                await Inject();
            else
                await Send();
        }
    }

    private async Task Inject()
    {
        var text = _inputText.Trim();
        if (string.IsNullOrEmpty(text) || string.IsNullOrEmpty(_activeStreamId)) return;

        _messages.Add(new ChatMessage("inject", text));
        _inputText = "";
        StateHasChanged();

        using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
        try
        {
            var resp = await http.PostAsJsonAsync(
                $"/api/projects/{ProjectSlug}/runs/{_activeStreamId}/steer",
                new { text });
            if (!resp.IsSuccessStatusCode)
                _messages.Add(new ChatMessage("error", $"Inject failed: {resp.StatusCode}"));
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage("error", ex.Message));
        }
        StateHasChanged();
    }

    private void OnInput(ChangeEventArgs e)
    {
        _inputText = e.Value?.ToString() ?? "";
    }

    [JSInvokable]
    public Task OnImagePasted(PendingImage img)
    {
        if (_pendingImages.Count >= 5)
        {
            _pasteError = "too many images attached (max 5)";
        }
        else
        {
            _pendingImages.Add(img);
            _pasteError = null;
        }
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnImagePasteError(string reason)
    {
        _pasteError = reason;
        return InvokeAsync(StateHasChanged);
    }

    private void RemoveImage(int idx)
    {
        if (idx >= 0 && idx < _pendingImages.Count) _pendingImages.RemoveAt(idx);
    }

    private async Task Send()
    {
        var text = _inputText.Trim();
        if ((string.IsNullOrEmpty(text) && _pendingImages.Count == 0) || _loading || _activeTarget is null) return;

        _hitMaxTurns = false;
        _streamingText = null;
        if (!string.IsNullOrEmpty(text))
            _messages.Add(new ChatMessage("user", text));
        var imagesPayload = _pendingImages.Select(p => new { dataUrl = p.DataUrl, mime = p.Mime, name = p.Name, sizeBytes = p.SizeBytes }).ToList();
        _inputText = "";
        _pendingImages.Clear();
        _pasteError = null;
        _loading = true;
        StateHasChanged();

        await StopStream();

        using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
        try
        {
            var forceNew = _selectedModel != _sessionModel && _sessionModel is not null;
            var resp = await http.PostAsJsonAsync($"/api/projects/{ProjectSlug}/chat/start",
                new { message = text, target = _activeTarget.Slug, ticketId = TicketId, images = imagesPayload, model = _selectedModel, forceNew });
            if (!resp.IsSuccessStatusCode)
            {
                _messages.Add(new ChatMessage("error", $"Error {resp.StatusCode}"));
                _loading = false;
                StateHasChanged();
                return;
            }
            var body = await resp.Content.ReadFromJsonAsync<ChatStartResponse>();
            if (body is null) { _loading = false; StateHasChanged(); return; }

            _sessionModel = _selectedModel;
            _activeRun = RunsState.Get(body.RunId);
            if (_activeRun is not null)
            {
                _activeRun.OnEvent += HandleEvent;
                _sseModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/agent-sse.js");
                _dotnetRef ??= DotNetObjectReference.Create(this);
                _activeStreamId = body.RunId;
                await _sseModule.InvokeVoidAsync("start", _dotnetRef, $"/api/projects/{ProjectSlug}/runs/{body.RunId}/stream");
            }
            else
            {
                _messages.Add(new ChatMessage("error", "Run not found"));
                _loading = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage("error", ex.Message));
            _loading = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task ReceiveSse(string kind, string text, string? detail = null)
    {
        // "steer" events are echoed back from PumpSteeringAsync — skip to avoid duplicating
        // the inject message already added optimistically in Inject().
        // "steer_replay" is an internal marker for auto-continuation; no UI bubble needed.
        if (kind == "steer" || kind == "steer_replay") return Task.CompletedTask;
        if (kind == "max_turns")
        {
            _hitMaxTurns = true;
            return InvokeAsync(StateHasChanged);
        }
        if (kind == "ask_user_question")
        {
            var (prompt, options) = ParseAskUserQuestionDetail(detail);
            _messages.Add(new AskUserQuestionMessage(prompt, options, _activeStreamId));
        }
        else if (kind == "tool_use" && !string.IsNullOrWhiteSpace(text))
        {
            var preview = GetToolPreview(text, detail);
            _messages.Add(new ToolCallMessage(text, preview, detail ?? "{}"));
        }
        else if (kind == "reset")
        {
            _messages.Add(new ChatMessage("reset", text));
        }
        else if (kind == "error")
        {
            AddErrorMessage(text);
        }
        else if (kind == "stderr")
        {
            // Suppress the non-actionable connectors warning that Claude CLI emits
            // whenever ANTHROPIC_AUTH_TOKEN/API_KEY is set (always true for Ollama).
            if (text.Contains("claude.ai connectors are disabled", StringComparison.OrdinalIgnoreCase))
                return Task.CompletedTask;
            AddStderrMessage(text);
        }
        else if (kind == "content_block_delta")
        {
            // Streaming text delta — strip the "[content_block_delta] " prefix from FlattenJson
            var delta = text.StartsWith("[content_block_delta] ") ? text[22..] : text;
            _streamingText = (_streamingText ?? "") + delta;
        }
        else if (kind == "assistant")
        {
            if (_streamingText is not null)
            {
                // Finalize from streamed deltas (content_block_delta already captured all text)
                _messages.Add(new ChatMessage("assistant", _streamingText));
                _streamingText = null;
            }
            else
            {
                // No streaming deltas — use the full assistant event text directly
                const string prefix = "[assistant] ";
                var reply = text.StartsWith(prefix) ? text[prefix.Length..] : text;
                reply = reply.Trim();
                if (!string.IsNullOrWhiteSpace(reply) && !reply.StartsWith("tool:"))
                    _messages.Add(new ChatMessage("assistant", reply));
            }
        }
        return InvokeAsync(StateHasChanged);
    }

    private async Task Continue()
    {
        _hitMaxTurns = false;
        _inputText = "Continue";
        await Send();
    }

    private static string GetToolPreview(string toolName, string? detail) =>
        SharedRenderHelpers.GetToolPreview(toolName, detail);

    private void AddStderrMessage(string text)
    {
        AddDiagnosticMessage("stderr", text);
    }

    private void AddErrorMessage(string text)
    {
        AddDiagnosticMessage("error", text);
    }

    private void AddDiagnosticMessage(string role, string text)
    {
        var clean = RunDrawerEventPresentation.Sanitize(text);
        if (string.IsNullOrWhiteSpace(clean)) return;
        var summary = GetDiagnosticSummary(role, clean);
        if (_messages.Count > 0 && _messages[^1] is DiagnosticMessage previous && previous.Role == role)
            _messages[^1] = new DiagnosticMessage(role, previous.Summary, previous.Text + "\n" + clean);
        else
            _messages.Add(new DiagnosticMessage(role, summary, clean));
    }

    private string GetDiagnosticSummary(string role, string text)
    {
        if (text.Contains("blocked by policy", StringComparison.OrdinalIgnoreCase) ||
            text.Contains("rejected: blocked", StringComparison.OrdinalIgnoreCase))
            return L["ChatCommandBlocked"];

        return role == "stderr" ? L["ChatCommandWarning"] : L["ChatCommandFailed"];
    }

    private static (string Prompt, string[] Options) ParseAskUserQuestionDetail(string? detail)
    {
        if (string.IsNullOrWhiteSpace(detail)) return ("", []);
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(detail);
            var root = doc.RootElement;

            // Real CLI schema: {questions:[{question:"...",header:"...",options:[{label:"...",description:"..."}],multiSelect:false}]}
            if (root.TryGetProperty("questions", out var qs)
                && qs.ValueKind == System.Text.Json.JsonValueKind.Array
                && qs.GetArrayLength() > 0)
            {
                var q0 = qs[0];
                var prompt = q0.TryGetProperty("question", out var qt) ? qt.GetString() ?? "" : "";
                var options = q0.TryGetProperty("options", out var opts) && opts.ValueKind == System.Text.Json.JsonValueKind.Array
                    ? opts.EnumerateArray()
                          .Select(o => o.TryGetProperty("label", out var lbl) ? lbl.GetString() ?? "" : "")
                          .Where(s => s.Length > 0)
                          .ToArray()
                    : Array.Empty<string>();
                return (prompt, options);
            }

            // Fallback: legacy mock schema {prompt:"...", options:["..."]} for backward compat
            var fallbackPrompt = root.TryGetProperty("prompt", out var p) ? p.GetString() ?? ""
                : root.TryGetProperty("question", out var q) ? q.GetString() ?? "" : "";
            var fallbackOptions = root.TryGetProperty("options", out var o) && o.ValueKind == System.Text.Json.JsonValueKind.Array
                ? o.EnumerateArray().Select(x => x.GetString() ?? "").Where(s => s.Length > 0).ToArray()
                : root.TryGetProperty("choices", out var c) && c.ValueKind == System.Text.Json.JsonValueKind.Array
                    ? c.EnumerateArray().Select(x => x.GetString() ?? "").Where(s => s.Length > 0).ToArray()
                    : Array.Empty<string>();
            return (fallbackPrompt, fallbackOptions);
        }
        catch { return ("", []); }
    }

    private async Task SubmitAskUserQuestion(AskUserQuestionMessage msg, string answer)
    {
        if (_activeRunId is null) return;
        var runId = msg.RunId ?? _activeRunId;
        msg.IsAnswered = true;
        StateHasChanged();
        using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
        try
        {
            await http.PostAsJsonAsync($"/api/projects/{ProjectSlug}/runs/{runId}/steer", new { text = answer });
        }
        catch { /* best-effort */ }
    }

    [JSInvokable]
    public Task StreamEnded()
    {
        _loading = false;
        _streamingText = null;
        if (_activeRun is not null)
            _activeRun.OnEvent -= HandleEvent;
        _activeRun = null;
        _activeStreamId = null;
        return InvokeAsync(StateHasChanged);
    }

    private void HandleEvent(StreamEvent ev)
    {
        // Handled via SSE; no-op here to avoid duplicates
    }

    private async Task StopStream()
    {
        if (_sseModule is not null && _activeStreamId is not null)
        {
            try { await _sseModule.InvokeVoidAsync("stop"); } catch { }
        }
        if (_activeRun is not null)
            _activeRun.OnEvent -= HandleEvent;
        _activeRun = null;
        _activeStreamId = null;
    }

    /// <summary>
    /// Cancel the in-flight chat run server-side (kills the claude subprocess), then close
    /// the local SSE stream. Wired to the Stop button surfaced while a turn is streaming.
    /// </summary>
    private async Task StopActiveRun()
    {
        var runId = _activeStreamId;
        if (string.IsNullOrEmpty(runId)) return;
        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            await http.PostAsync($"/api/projects/{ProjectSlug}/runs/{runId}/stop", content: null);
        }
        catch { /* best-effort: if the stop call fails the SSE will still detach below */ }
        await StopStream();
        _loading = false;
        StateHasChanged();
    }

    private async Task Close()
    {
        await StopStream();
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await StopStream();
        _dotnetRef?.Dispose();
        if (_sseModule is not null)
        {
            try { await _sseModule.DisposeAsync(); } catch { }
        }
    }

    private static string RenderMarkdown(string text) =>
        KittyClaw.Web.Markdown.ChatMarkdownRenderer.Render(text);

