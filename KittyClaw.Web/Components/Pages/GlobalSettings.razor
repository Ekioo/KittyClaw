@page "/settings"
@using KittyClaw.Core.Automation
@using KittyClaw.Core.Services
@inject IJSRuntime JS
@inject AppSettingsService AppSettings
@inject AgentCliReadinessService CliReadiness
@inject RtkIntegrationService RtkIntegration
@inject LocalizationService L
@inject RemoteAccessStore RemoteAccess
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>@L["GlobalSettingsTitle"] — KittyClaw</PageTitle>

<div class="page-header">
    <a class="back-link" href="/">&larr; @L["Board"]</a>
    <h1>@L["GlobalSettingsTitle"]</h1>
</div>

<MobileSectionNavigation Sections="@MobileSections" @bind-Active="_mobileSection" />

<div class="settings-container">
    <section class="settings-section mobile-section-panel @(_mobileSection == "network" ? "mobile-section-active" : "")" data-testid="network-global-settings">
        <h2>@L["NetworkTitle"]</h2>
        <p class="settings-hint">@L["NetworkHint"]</p>
        <a class="settings-browse" href="/network-setup">@L["NetworkConfigure"]</a>
        <p class="settings-hint">@L["NetworkLocalSetup"]</p>
        <form method="post" action="/access/logout">
            <AntiforgeryToken />
            <button type="submit" class="settings-browse">@L["NetworkLogout"]</button>
        </form>
    </section>
    <section class="settings-section mobile-section-panel @(_mobileSection == "remote" ? "mobile-section-active" : "")" data-testid="remote-global-settings">
        <h2>@L["RemoteTitle"]</h2>
        <p class="settings-hint">@L["RemoteHint"]</p>
        @if (RemoteAccess.Snapshot.Url is { } publicUrl)
        {
            <RemoteAccessQr Url="@publicUrl" Enabled="@RemoteAccess.Snapshot.Enabled" />
        }
        <a class="settings-browse" href="/remote-setup">@L["RemoteConfigure"]</a>
        <p class="settings-hint">@L["NetworkLocalSetup"]</p>
    </section>
    <section class="settings-section mobile-section-panel @(_mobileSection == "language" ? "mobile-section-active" : "")" data-testid="language-global-settings">
        <h2>@L["Language"]</h2>
        <div class="settings-row">
            <select aria-label="@L["Language"]" class="settings-input" style="max-width:200px" value="@L.Lang" @onchange="OnLangChanged">
                <option value="fr">@L["LangFr"]</option>
                <option value="en">@L["LangEn"]</option>
                <option value="es">@L["LangEs"]</option>
                <option value="de">@L["LangDe"]</option>
                <option value="it">@L["LangIt"]</option>
                <option value="pt-BR">@L["LangPtBr"]</option>
                <option value="ja">@L["LangJa"]</option>
                <option value="zh-CN">@L["LangZhCn"]</option>
            </select>
        </div>
    </section>

    <section class="settings-section mobile-section-panel @(_mobileSection == "providers" ? "mobile-section-active" : "")" data-testid="agent-provider-settings">
        <div class="provider-section-heading">
            <div>
                <h2>@L["AgentProvidersTitle"]</h2>
                <p class="settings-hint">@L["AgentProvidersHint"]</p>
            </div>
            <button class="settings-browse" @onclick="RefreshProvidersAsync" disabled="@_checkingProviders">
                @(_checkingProviders ? L["AgentProvidersChecking"] : L["AgentProvidersRefresh"])
            </button>
        </div>

        <div class="provider-readiness-grid">
            @foreach (var provider in ProviderCards)
            {
                <article class="provider-readiness-card @(provider.Detected ? "provider-ready" : "provider-missing")">
                    <div class="provider-card-header">
                        <strong>@provider.Name</strong>
                        <span class="provider-status-pill @(provider.Detected ? "ready" : "missing")">
                            @(provider.Detected ? L["ProviderDetected"] : L["ProviderNotDetected"])
                        </span>
                    </div>
                    <p>@provider.Configuration</p>
                    <code>@provider.Executable</code>
                    @if (provider.UsesSharedCli)
                    {
                        <small>@L["ProviderSharedClaudeCli"]</small>
                    }
                    <a href="@provider.InstallUrl" target="_blank" rel="noopener">@L["ProviderInstallationGuide"] &nearr;</a>
                </article>
            }
            <JevSettingsPanel @ref="_jevPanel" />
            <article class="provider-readiness-card @(_rtkStatus?.Available == true ? "provider-ready" : "provider-missing")" data-testid="rtk-global-settings">
                <div class="provider-card-header">
                    <strong>RTK</strong>
                    <span class="provider-status-pill @(_rtkStatus?.Available == true ? "ready" : "missing")">
                        @L[_rtkStatus?.Available == true ? "ProviderDetected" : "ProviderNotDetected"]
                    </span>
                </div>
                <p>@L["RtkGlobalHelp"]</p>
                <code>rtk @(_rtkStatus?.Version)</code>
                <a href="https://github.com/rtk-ai/rtk" target="_blank" rel="noopener">@L["RtkInstall"] &nearr;</a>
            </article>
        </div>

        <p class="provider-readiness-note">@L["AgentProvidersDetectionNote"]</p>
    </section>

    <section class="settings-section mobile-section-panel @(_mobileSection == "mcp" ? "mobile-section-active" : "")" data-testid="mcp-global-settings">
        <h2>@L["McpServerTitle"]</h2>
        <p class="settings-hint">@L["McpServerHint"]</p>

        <label class="settings-option">
            <input type="checkbox"
                   data-testid="mcp-enabled"
                   checked="@AppSettings.McpEnabled"
                   @onchange="OnMcpChanged" />
            <span>
                <strong>@L["McpEnable"]</strong>
                <small>@L["McpEnableEffect"]</small>
            </span>
        </label>

        <div class="settings-status @(AppSettings.McpEnabled ? "settings-status-ok" : "")"
             data-testid="mcp-status">
            @(AppSettings.McpEnabled
                ? L.Get("McpEnabledStatus", "/mcp")
                : L["McpDisabledStatus"])
        </div>
    </section>
</div>

@code {
    private string _mobileSection = "network";
    private IReadOnlyList<MobileSectionNavigation.Section> MobileSections =>
    [
        new("network", L["NetworkTitle"]),
        new("remote", L["RemoteTitle"]),
        new("language", L["Language"]),
        new("providers", L["AgentProvidersTitle"]),
        new("mcp", L["McpServerTitle"]),
    ];

    protected override void OnInitialized() => L.OnLanguageChanged += OnLanguageChanged;
    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);
    private async Task OnLangChanged(ChangeEventArgs e)
    {
        AppSettings.Language = (string?)e.Value ?? "en";
        await JS.InvokeVoidAsync("setApplicationLanguage", AppSettings.Language);
    }
    public void Dispose() => L.OnLanguageChanged -= OnLanguageChanged;

    private CliReadiness _readiness = new(false, false, false, false, false, false);
    private JevSettingsPanel? _jevPanel;
    private RtkIntegrationStatus? _rtkStatus;
    private bool _checkingProviders;
    private bool _providerCheckStarted;

    private IReadOnlyList<ProviderCardModel> ProviderCards =>
    [
        new("Claude Code", "claude", _readiness.Claude,
            "https://docs.anthropic.com/en/docs/claude-code/setup", L["ProviderClaudeConfiguration"], false),
        new("OpenAI Codex", "codex", _readiness.Codex,
            "https://developers.openai.com/codex/cli/", L["ProviderCodexConfiguration"], false),
        new("Grok Build", "grok", _readiness.Grok,
            "https://docs.x.ai/docs/grok-code-fast-1", L["ProviderGrokConfiguration"], false),
        new("Mistral Vibe", "vibe", _readiness.Mistral,
            "https://docs.mistral.ai/vibe/code/cli/install-setup", L["ProviderMistralConfiguration"], false),
        new("Ollama", "ollama", _readiness.Ollama,
            "https://ollama.com/download", L["ProviderOllamaConfiguration"], false),
        new("DeepSeek V4", "claude", _readiness.Claude,
            "https://api-docs.deepseek.com/quick_start/agent_integrations/claude_code/", L["ProviderDeepSeekConfiguration"], true),
    ];

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_providerCheckStarted)
        {
            _providerCheckStarted = true;
            _ = RefreshProvidersAsync();
        }

        return Task.CompletedTask;
    }

    private async Task RefreshProvidersAsync()
    {
        if (_checkingProviders) return;
        _checkingProviders = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var providers = CliReadiness.ProbeAsync();
            var rtk = RtkIntegration.ProbeAvailabilityAsync();
            var jev = _jevPanel?.RefreshAsync() ?? Task.CompletedTask;
            await Task.WhenAll(providers, rtk, jev);
            _readiness = await providers;
            _rtkStatus = await rtk;
        }
        finally
        {
            _checkingProviders = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnMcpChanged(ChangeEventArgs e)
    {
        AppSettings.McpEnabled = e.Value is true;
    }

    private sealed record ProviderCardModel(
        string Name,
        string Executable,
        bool Detected,
        string InstallUrl,
        string Configuration,
        bool UsesSharedCli);
}
