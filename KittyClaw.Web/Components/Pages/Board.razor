@page "/board/{Slug}"
@page "/board/{Slug}/ticket/{TicketId:int}"
@page "/board/{Slug}/sub/{ParentId:int}"
@page "/board/{Slug}/sub/{ParentId:int}/ticket/{TicketId:int}"
@using Microsoft.AspNetCore.Components
@using KittyClaw.Core.Models
@using KittyClaw.Core.Services
@using KittyClaw.Core.Extensions
@using KittyClaw.Web.Extensions
@inject ProjectService ProjectService
@inject TicketService TicketService
@inject KittyClaw.Web.Services.BoardFilterState FilterState
@inject KittyClaw.Web.Services.BoardSortState SortState
@inject KittyClaw.Web.Services.BoardUpdateNotifier BoardUpdateNotifier
@inject ILogger<Board> Logger
@inject KittyClaw.Web.Services.AgentRunsState AgentRuns
@inject ColumnService ColumnService
@inject PipelineService PipelineService
@inject ColumnProcessorService ProcessorService
@inject KittyClaw.Core.Automation.AutomationStore AutomationStore
@inject MemberService MemberService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject LocalizationService L
@inject KittyClaw.Web.Services.EscapeKeyStack EscapeStack
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>@(_project?.Name ?? "Board")</PageTitle>

@if (_project is null)
{
    <p>@L["ProjectNotFound"]</p>
}
else
{
    <div class="board-layout">
    <div class="page-header">
        <a href="@_homeHref" class="back-link">&larr; @L["BackToProjects"]</a>
        <h1>@_project.Name</h1>
        @if (_subKanbanParentId is not null && _subKanbanParent is not null)
        {
            <div class="sub-kanban-breadcrumb">
                <button class="breadcrumb-back" @onclick="ExitSubKanban">&larr; @L["MainBoard"]</button>
                <span class="breadcrumb-separator">/</span>
                <span class="breadcrumb-parent">#@_subKanbanParent.Id &mdash; @_subKanbanParent.Title</span>
            </div>
        }
        <div class="view-toggle">
            <span class="view-toggle-btn view-toggle-btn--active">@L["KanbanView"]</span>
            <a class="view-toggle-btn" href="/board/@Slug/dashboard">@L["Dashboard"]</a>
            <a class="view-toggle-btn" href="/costs">@L["Costs"]</a>
        </div>
        <BoardFilterBar OnChanged="ResetLoadedColumns" />
        <div class="header-right">
            <button class="header-action-btn pause-btn @(_project.IsPaused ? "pause-btn--paused" : "")"
                    title="@(_project.IsPaused ? L["Resume"] : L["Pause"])"
                    @onclick="ToggleProjectPause">
                @(_project.IsPaused ? "▶ " + L["Resume"] : "⏸ " + L["Pause"])
            </button>
            <button class="header-action-btn undo-btn"
                    @onclick="PerformUndo"
                    disabled="@(!_undoStack.Any())"
                    title="@(_undoStack.Any() ? $"{L["UndoPrefix"]} : {_undoStack.Peek().Label}" : L["UndoNothing"])">
                &#8630;
            </button>
            <button class="header-action-btn new-instruction-btn" @onclick="OpenChatDrawer" title="@L["NewInstruction"]">&#128172; @L["NewInstruction"]</button>
            <a class="header-action-btn" href="/board/@Slug/approvals" title="Runtime approvals">&#128737; Approvals</a>
            <a class="header-action-btn" href="/board/@Slug/automations" title="@L["Automations"]">&#9881; @L["Automations"]</a>
            <a class="header-action-btn" href="/board/@Slug/workflows" title="@L["WorkflowTitle"]">&#8644; @L["WorkflowTitle"]</a>
            <a class="header-action-btn" href="/board/@Slug/settings" title="@L["ProjectSettingsTooltip"]">&#9881;&#65039; @L["ProjectSettings"]</a>
        </div>
    </div>

    @if (_pipelines.Count > 0)
    {
        <nav class="pipeline-tabs" aria-label="@L["WorkflowTitle"]">
            @foreach (var pipeline in _pipelines)
            {
                var unreadCount = PipelineUnreadCount(pipeline.Id);
                <button class="pipeline-tab @(pipeline.Id == _selectedPipelineId ? "pipeline-tab--active" : "")"
                        @onclick="() => SelectPipelineAsync(pipeline.Id)">
                    <span>@pipeline.Name</span>
                    @if (unreadCount > 0)
                    {
                        <span class="pipeline-unread-badge"
                              title="@string.Format(L["PipelineUnreadTickets"], unreadCount)"
                              aria-label="@string.Format(L["PipelineUnreadTickets"], unreadCount)">@unreadCount</span>
                    }
                </button>
            }
        </nav>
    }

    <div class="board">
        @foreach (var col in _columns)
        {
            var colIndex = _columns.IndexOf(col);
            var ticketDropAllowed = IsTicketDropAllowed(col);
            var ticketDropClass = _draggedTicket is null
                ? ""
                : ticketDropAllowed ? "column-ticket-drop-allowed" : "column-ticket-drop-forbidden";
            <div class="column-insert-slot" aria-hidden="false">
                <button class="column-insert-btn" title="@L["InsertColumnHere"]" aria-label="@L["InsertColumnHere"]"
                        @onclick="() => OpenCreateColumn(colIndex)">+</button>
            </div>
            <div @key="col.Id" class="column @(_draggedColumn?.Id == col.Id ? "column-dragging" : "") @ticketDropClass"
                 data-column-status="@col.Name"
                 style="--col-color: @col.Color"
                 @ondragover="(e) => OnDragOverColumn(col.Name, e)"
                 @ondragover:preventDefault="@ticketDropAllowed"
                 @ondrop="() => OnDrop(col.Name)"
                 @ondrop:preventDefault="@ticketDropAllowed">
                @if (_draggedColumn is not null && _draggedTicket is null && _colDropIndex == colIndex && _draggedColumn.Id != col.Id)
                {
                    <div class="column-drop-indicator"></div>
                }
                <div class="column-header"
                     draggable="true"
                     @ondragstart="() => OnColumnDragStart(col)"
                     @ondragend="OnColumnDragEnd"
                     @ondragover="(e) => OnColumnDragOver(colIndex, e)"
                     @ondragover:preventDefault
                     @ondrop="OnColumnDrop"
                     @ondrop:preventDefault
                     @oncontextmenu="(e) => OpenSortMenu(col.Name, e)"
                     @oncontextmenu:preventDefault>
                    <span class="status-pill" style="color: @col.Color; background: color-mix(in srgb, @col.Color 12%, transparent)">
                        <span class="column-processor-indicator @(_activeProcessorColumnIds.Contains(col.Id) ? "column-processor-indicator--active" : "")"
                              title="@L[_activeProcessorColumnIds.Contains(col.Id) ? "ColumnProcessorActive" : "ColumnProcessorInactive"]"
                              aria-label="@L[_activeProcessorColumnIds.Contains(col.Id) ? "ColumnProcessorActive" : "ColumnProcessorInactive"]">
                            @(_activeProcessorColumnIds.Contains(col.Id) ? "⚙" : "○")
                        </span>
                        <span>@col.Name</span>
                    </span>
                    @{ var _sortHere = SortState.Get(Slug, col.Name); }
                    @if (_sortHere.Mode != KittyClaw.Web.Services.ColumnSortMode.Manual)
                    {
                        <span class="column-sort-indicator" title="@SortLabel(_sortHere.Mode) @DirectionLabel(_sortHere.Direction)">@(_sortHere.Direction == KittyClaw.Web.Services.SortDirection.Ascending ? "▲" : "▼")</span>
                    }
                    <span class="count">@GetTickets(col.Name).Count</span>
                </div>
                <div class="column-body">
                    @{
                        var allTickets = GetTickets(col.Name);
                        _loadedPerColumn.TryGetValue(col.Name, out var loaded);
                        if (loaded <= 0) loaded = int.MaxValue;
                        var columnTickets = allTickets.Take(loaded).ToList();
                    }
                    @for (int i = 0; i <= columnTickets.Count; i++)
                    {
                        var slotIndex = i;
                        @if (_draggedTicket is not null && ticketDropAllowed)
                        {
                            var isActiveSlot = _dragOverStatus == col.Name && _dragActiveSlot == slotIndex && !IsNoOpReorder(col.Name, slotIndex);
                            <div class="drop-slot @(isActiveSlot ? "active" : "")"
                                 @ondragover="() => OnDragOverSlot(col.Name, slotIndex)"
                                 @ondragover:preventDefault
                                 @ondragover:stopPropagation
                                 @ondrop="() => OnDropReorder(col.Name, slotIndex)"
                                 @ondrop:preventDefault
                                 @ondrop:stopPropagation>
                                @if (isActiveSlot) { <span>@L["PlaceHere"]</span> }
                            </div>
                        }
                        @if (i < columnTickets.Count)
                        {
                            var ticket = columnTickets[i];
                            var index = i;
                            var isCardTarget = _draggedTicket is not null && _dragActiveSlot < 0 && _dragOverStatus == col.Name && _dragHoverIndex == index && _dropTargetTicketId == ticket.Id;
                            <BoardTicketCard
                                @key="ticket.Id"
                                Ticket="ticket"
                                ColRole="col.Role"
                                IsSelected="@(_openTicketId == ticket.Id)"
                                IsDragging="@(_draggedTicket?.Id == ticket.Id)"
                                IsCardTarget="@isCardTarget"
                                IsUpdated="@IsTicketUpdated(ticket)"
                                IsDropAllowed="@ticketDropAllowed"
                                Columns="_columns"
                                Slug="@Slug"
                                AllMembers="_allMembers"
                                OnDragStart="@(() => OnDragStart(ticket))"
                                OnDragEnd="OnDragEnd"
                                OnDragOverCard="@(() => OnDragOverCard(col.Name, index, ticket))"
                                OnDropAsChild="@(() => OnDropAsChild(ticket, col.Name))"
                                OnContextMenu="@(e => OpenTicketMenuAsync(ticket, e))"
                                OnClick="@(() => SelectTicket(ticket))"
                                OnOpenRunDrawer="OpenRunDrawer"
                                 OnEnterSubKanban="@(() => EnterSubKanban(ticket))" />
                        }
                    }
                    @if (allTickets.Count > loaded)
                    {
                        <div class="load-more-container">
                            <button class="load-more-btn" @onclick="() => LoadMore(col.Name)">
                                @L["LoadMoreTickets"] (@(allTickets.Count - loaded) @L["Remaining"])
                            </button>
                        </div>
                    }
                </div>
                @if (col == _columns[0])
                {
                    <div class="add-ticket">
                        <button class="add-ticket-btn" @onclick="OpenCreatePopup">+ @L["NewTicket"]</button>
                    </div>
                }
            </div>
        }
        @if (_columnsLoaded && _columns.Count == 0)
        {
            <button class="add-column-lane" @onclick="() => OpenCreateColumn(0)">
                <span>＋</span>
                <span>@L["AddColumnFromBoard"]</span>
            </button>
        }
    </div>
    </div>

    @* ── Column sort context menu ── *@
    @if (_sortMenuOpenFor is not null)
    {
        var current = SortState.Get(Slug, _sortMenuOpenFor);
        <div class="column-context-menu-backdrop" @onclick="CloseSortMenu" @oncontextmenu="CloseSortMenu" @oncontextmenu:preventDefault></div>
        <div class="column-context-menu" style="left:@(_sortMenuX)px; top:@(_sortMenuY)px;" @onclick:stopPropagation @oncontextmenu:preventDefault>
            <button class="column-context-menu-item column-context-menu-configure" @onclick="OpenColumnDialogFromMenu">
                <span class="column-context-menu-check">⚙</span>
                <span>@L["ConfigureColumn"]</span>
            </button>
            <button class="column-context-menu-item"
                    disabled="@(ColumnUnreadCount(_sortMenuOpenFor) == 0)"
                    @onclick="MarkColumnViewedAsync">
                <span class="column-context-menu-check">✓</span>
                <span>@L["MarkColumnRead"]</span>
            </button>
            <div class="column-context-menu-separator"></div>
            <button class="column-context-menu-item" @onclick="InsertColumnBeforeFromMenu">
                <span class="column-context-menu-check">＋</span>
                <span>@L["InsertColumnBefore"]</span>
            </button>
            <button class="column-context-menu-item" @onclick="InsertColumnAfterFromMenu">
                <span class="column-context-menu-check">＋</span>
                <span>@L["InsertColumnAfter"]</span>
            </button>
            <button class="column-context-menu-item" @onclick="DuplicateColumnFromMenu">
                <span class="column-context-menu-check">⧉</span>
                <span>@L["DuplicateColumn"]</span>
            </button>
            <div class="column-context-menu-separator"></div>
            <div class="column-context-menu-title">@L["SortMenuTitle"]</div>
            <button class="column-context-menu-item @(current.Mode == KittyClaw.Web.Services.ColumnSortMode.Manual ? "column-context-menu-item--active" : "")"
                    @onclick="() => SelectSort(KittyClaw.Web.Services.ColumnSortMode.Manual, KittyClaw.Web.Services.SortDirection.Ascending)">
                <span class="column-context-menu-check">@(current.Mode == KittyClaw.Web.Services.ColumnSortMode.Manual ? "✓" : "")</span>
                <span>@L["SortManual"]</span>
            </button>
            <div class="column-context-menu-separator"></div>
            @foreach (var mode in _sortModes)
            {
                foreach (var dir in _sortDirections)
                {
                    var active = current.Mode == mode && current.Direction == dir;
                    <button class="column-context-menu-item @(active ? "column-context-menu-item--active" : "")"
                            @onclick="() => SelectSort(mode, dir)">
                        <span class="column-context-menu-check">@(active ? "✓" : "")</span>
                        <span>@SortLabel(mode) — @DirectionLabel(dir)</span>
                    </button>
                }
            }
        </div>
    }

    @* ── Ticket context menu ── *@
    @if (_ticketMenuTicket is not null)
    {
        var menuTicket = _ticketMenuTicket;
        <div class="column-context-menu-backdrop" @onclick="CloseTicketMenu" @oncontextmenu="CloseTicketMenu" @oncontextmenu:preventDefault></div>
        <div class="column-context-menu ticket-context-menu" style="left:@(_ticketMenuX)px; top:@(_ticketMenuY)px;" @onclick:stopPropagation @oncontextmenu:preventDefault>
            <button class="column-context-menu-item column-context-menu-configure" @onclick="OpenTicketFromMenuAsync">
                <span class="column-context-menu-check">↗</span>
                <span>@L["TicketMenuOpen"]</span>
            </button>
            <div class="column-context-menu-separator"></div>
            <div class="column-context-menu-title">@L["TicketMenuMoveTo"]</div>
            @if (_ticketMenuRoutingPolicy?.IsRestricted == true)
            {
                <div class="ticket-context-menu-routing-hint">@L["TicketMenuRoutingRestricted"]</div>
            }
            @if (_ticketMenuColumns.Count == 0)
            {
                <div class="ticket-context-menu-loading">@L["Loading"]</div>
            }
            @foreach (var pipeline in _pipelines)
            {
                if (_ticketMenuColumns.TryGetValue(pipeline.Id, out var targetColumns) && targetColumns.Count > 0)
                {
                    <div class="ticket-context-menu-pipeline">@pipeline.Name</div>
                    @foreach (var targetColumn in targetColumns)
                    {
                        var isCurrent = menuTicket.PipelineId == pipeline.Id &&
                            (menuTicket.ColumnId == targetColumn.Id || menuTicket.Status == targetColumn.Name);
                        <button class="column-context-menu-item @(isCurrent ? "column-context-menu-item--active" : "")"
                                disabled="@isCurrent"
                                @onclick="() => MoveTicketFromMenuAsync(pipeline, targetColumn)">
                            <span class="column-context-menu-check">@(isCurrent ? "✓" : "")</span>
                            <span>@targetColumn.Name</span>
                        </button>
                    }
                }
            }
        </div>
    }

    @if (_columnEditorOpen && _selectedPipelineId is int editorPipelineId)
    {
        <ColumnProcessorDialog @key="_columnDialogKey"
                               Slug="@Slug"
                               PipelineId="@editorPipelineId"
                               Column="@_columnDialogColumn"
                               TemplateColumn="@_columnDialogTemplate"
                               InsertIndex="@_columnDialogInsertIndex"
                               OnClose="CloseColumnDialog"
                               OnSaved="OnColumnSavedAsync" />
    }

    @* ── Trash drop zone (visible during drag) ── *@
    @if (_draggedTicket is not null || _draggedColumn is not null)
    {
        <div class="bottom-drop-zones">
            @if (_draggedTicket is not null && _subKanbanParentId is not null)
            {
                <div class="unparent-zone @(_unparentHover ? "unparent-zone-hover" : "")"
                     @ondragover="OnUnparentDragOver"
                     @ondragover:preventDefault
                     @ondragleave="() => _unparentHover = false"
                     @ondrop="OnUnparentDrop"
                     @ondrop:preventDefault>
                    <span class="unparent-icon">&#128279;</span>
                    <span>@L["Unparent"]</span>
                </div>
            }
            <div class="trash-zone @(_trashHover ? "trash-zone-hover" : "")"
                 @ondragover="OnTrashDragOver"
                 @ondragover:preventDefault
                 @ondragleave="() => _trashHover = false"
                 @ondrop="OnTrashDrop"
                 @ondrop:preventDefault>
                <span class="trash-icon">&#128465;</span>
                <span>@L["Delete"]</span>
            </div>
        </div>
    }

    @* ── Trash confirmation dialog ── *@
    @if (_trashConfirmColumn is not null)
    {
        <div class="confirm-overlay">
            <div class="confirm-dialog">
                <p>@L["DeleteColumnConfirm"] «&#160;@_trashConfirmColumn.Name&#160;»&#160;?</p>
                @if (_columns.Count > 1)
                {
                    <p class="confirm-warning">@L["MoveTicketsTo"]</p>
                    <select @bind="_deleteColumnMoveTo" style="margin-bottom:0.5rem;width:100%">
                        @foreach (var other in _columns.Where(c => c.Id != _trashConfirmColumn.Id))
                        {
                            <option value="@other.Name">@other.Name</option>
                        }
                    </select>
                }
                <div class="confirm-actions">
                    <button class="cancel-btn" @onclick="CancelTrash">@L["Cancel"]</button>
                    <button class="delete-btn" @onclick="ConfirmTrashColumn">@L["Delete"]</button>
                </div>
            </div>
        </div>
    }
    @if (_trashConfirmTicket is not null)
    {
        <div class="confirm-overlay">
            <div class="confirm-dialog">
                <p>@L["DeleteTicketConfirm"] #@_trashConfirmTicket.Id «&#160;@_trashConfirmTicket.Title&#160;»&#160;?</p>
                <div class="confirm-actions">
                    <button class="cancel-btn" @onclick="CancelTrash">@L["Cancel"]</button>
                    <button class="delete-btn" @onclick="ConfirmTrashTicket">@L["Delete"]</button>
                </div>
            </div>
        </div>
    }

    @* ── Create ticket popup ── *@
    @if (_showCreatePopup)
    {
        <BoardCreateTicketDialog
            Slug="@Slug"
            Columns="_columns"
            SubKanbanParentId="_subKanbanParentId"
            SelectedPipelineId="_selectedPipelineId"
            AllMembers="_allMembers"
            OnCreated="OnTicketDialogCreated"
            OnClosed="CloseCreatePopup" />
    }

    @if (_openTicketId is int openTicketId)
    {
        <TicketPanel Slug="@Slug"
                     TicketId="openTicketId"
                     RefreshToken="_panelRefreshToken"
                     PushUndo="PushTicketUndo"
                     OnClose="ClosePanel"
                     OnChanged="OnPanelChanged"
                     OnMutatedTicket="MarkTicketViewedAsync"
                     OnDeleted="OnPanelDeleted"
                     OnEnterSubKanban="EnterSubKanbanById" />
    }

}

@if (_activeRunDrawerId is not null)
{
    <ErrorBoundary>
        <ChildContent>
            <AgentRunDrawer RunId="@_activeRunDrawerId" OnClose="CloseRunDrawer" OnRetried="OpenRunDrawer" />
        </ChildContent>
        <ErrorContent Context="ex">
            <div class="agent-drawer-overlay" @onclick="CloseRunDrawer"></div>
            <div class="agent-drawer" style="padding:1.5rem;color:#f06b6b">
                <strong>Error: </strong>@ex.Message
                <br/><button @onclick="CloseRunDrawer" style="margin-top:1rem">Close</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
}

@if (_showChatDrawer)
{
    <ErrorBoundary>
        <ChildContent>
            <ChatDrawer ProjectSlug="@Slug"
                              InitialAgent="@_chatInitialAgent"
                              InitialAgentName="@_chatInitialAgentName"
                              TicketId="_chatTicketId"
                              TicketTitle="@_chatTicketTitle"
                              OnClose="CloseChatDrawer" />
        </ChildContent>
        <ErrorContent Context="ex">
            <div class="chat-drawer-overlay" @onclick="CloseChatDrawer"></div>
            <div class="chat-drawer" style="padding:1.5rem;color:#f06b6b">
                <strong>Erreur : </strong>@ex.Message
                <br/><button @onclick="CloseChatDrawer" style="margin-top:1rem">Fermer</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
}

@if (_showMigrationWizard)
{
    <WorkflowMigrationWizard ProjectSlug="@Slug" OnClose="CloseMigrationWizard" />
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public int? TicketId { get; set; }
    [Parameter] public int? ParentId { get; set; }
    [SupplyParameterFromQuery(Name = "pipeline")]
    public int? PipelineId { get; set; }

    private Project? _project;
    private List<TicketSummary> _tickets = [];
    private List<BoardColumn> _columns = [];
    private bool _columnsLoaded;
    private HashSet<int> _activeProcessorColumnIds = [];
    private List<Pipeline> _pipelines = [];
    private int? _selectedPipelineId;
    private bool _restoreScrollAfterRender;
    // "← Projects" target: the home route matching the display mode last used there.
    private string _homeHref = "/";
    // The ticket detail itself lives in the extracted TicketPanel component; the board only
    // tracks WHICH ticket is open and bumps _panelRefreshToken to force a panel reload
    // after board-side mutations the panel can't observe (undo).
    private int? _openTicketId;
    private int _panelRefreshToken;
    private TicketSummary? _draggedTicket;
    private string? _dragOverStatus;
    private int _dragHoverIndex = -1;
    private int _dragActiveSlot = -1;

    // Column drag & drop
    private BoardColumn? _draggedColumn;
    private int _colDropIndex = -1;

    // Create popup
    private bool _showCreatePopup = false;

    // Column management
    private string _deleteColumnMoveTo = "";

    // Trash drop zone
    private bool _trashHover = false;
    private BoardColumn? _trashConfirmColumn = null;
    private TicketSummary? _trashConfirmTicket = null;

    // Chat drawer
    private bool _showChatDrawer = false;
    private string? _chatInitialAgent;
    private string? _chatInitialAgentName;
    private int? _chatTicketId;
    private string? _chatTicketTitle;
    private bool _showMigrationWizard;

    // Members
    private List<Member> _allMembers = [];

    // Sub-ticket / sub-kanban
    private int? _subKanbanParentId = null;
    private TicketSummary? _subKanbanParent = null;
    private bool _unparentHover = false;
    private int? _dropTargetTicketId = null;
    private bool _suppressRender = false;

    protected override bool ShouldRender()
    {
        if (_suppressRender) { _suppressRender = false; return false; }
        return true;
    }

    // "Updated since you last looked" tracking. Per-ticket timestamps are the
    // source of truth (so opening one ticket only clears its own badge).
    // _lastVisitedAt is a board-wide fallback used only for tickets the user has
    // never explicitly opened — that way users with no per-ticket data still see
    // sensible "what changed since last activity" behavior.
    private const int InitialPageSize = 20;
    private const int LoadMoreSize = 10;
    private Dictionary<string, int> _loadedPerColumn = new();
    private DateTime? _lastVisitedAt;
    private Dictionary<int, DateTime> _viewedAt = new();
    private readonly LatestRefreshGuard _ticketRefreshGuard = new();

    private bool IsTicketUpdated(TicketSummary ticket)
    {
        var activity = ticket.LastActivityAt ?? ticket.UpdatedAt;
        return BoardUnreadState.IsUpdated(activity, ticket.Id, _viewedAt, _lastVisitedAt);
    }

    private int PipelineUnreadCount(int pipelineId) =>
        BoardUnreadState.CountPipelineUnread(
            _tickets,
            pipelineId,
            _subKanbanParentId,
            FilterState.FilterText,
            _viewedAt,
            _lastVisitedAt,
            GetPriorityLabel);

    private IEnumerable<TicketSummary> TicketsInColumnContext(string status) =>
        _tickets.Where(ticket => ticket.PipelineId == _selectedPipelineId &&
                                 ticket.ParentId == _subKanbanParentId &&
                                 ticket.Status == status);

    private int ColumnUnreadCount(string status) =>
        TicketsInColumnContext(status).Count(IsTicketUpdated);

    private async Task MarkTicketViewedAsync(int ticketId)
    {
        _viewedAt[ticketId] = DateTime.UtcNow;
        await PersistViewedStateAsync();
    }

    private async Task PersistViewedStateAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(
                _viewedAt.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value.ToString("O")));
            await JS.InvokeVoidAsync("localStorage.setItem", $"board-viewed-{Slug}", json);
        }
        catch { /* localStorage unavailable */ }
    }

    private async Task RefreshTicketsAsync()
    {
        await _ticketRefreshGuard.ApplyLatestAsync(
            () => TicketService.ListTicketsAsync(Slug),
            tickets => _tickets = tickets);
    }

    private async Task LoadSelectedPipelineColumnsAsync()
    {
        _pipelines = await PipelineService.ListAsync(Slug);
        if (_selectedPipelineId is null || !_pipelines.Any(p => p.Id == _selectedPipelineId))
            _selectedPipelineId = _pipelines.FirstOrDefault(p => p.IsDefault)?.Id ?? _pipelines.FirstOrDefault()?.Id;
        var columnsTask = _selectedPipelineId is int pipelineId
            ? ColumnService.ListColumnsAsync(Slug, pipelineId)
            : Task.FromResult(new List<BoardColumn>());
        var processorsTask = ProcessorService.ListAsync(Slug);
        await Task.WhenAll(columnsTask, processorsTask);
        _columns = columnsTask.Result;
        _columnsLoaded = true;
        _activeProcessorColumnIds = processorsTask.Result
            .Where(processor => processor.Enabled)
            .Select(processor => processor.ColumnId)
            .ToHashSet();
        _routingPolicies.Clear();
        foreach (var processor in processorsTask.Result)
            _routingPolicies[processor.ColumnId] = ColumnRoutingPolicy.From(processor);
    }

    private async Task SelectPipelineAsync(int pipelineId)
    {
        if (_selectedPipelineId == pipelineId) return;
        _selectedPipelineId = pipelineId;
        _openTicketId = null;
        await LoadSelectedPipelineColumnsAsync();
        ResetLoadedColumns();
        Navigation.NavigateTo(BoardUrl(_subKanbanParentId, null), replace: true);
    }

    private string BoardUrl(int? parentId, int? ticketId)
    {
        var path = parentId is int parent
            ? $"/board/{Slug}/sub/{parent}"
            : $"/board/{Slug}";
        if (ticketId is int ticket)
            return $"{path}/ticket/{ticket}";
        return _selectedPipelineId is int pipeline ? $"{path}?pipeline={pipeline}" : path;
    }

    private async Task ReplaceTicketUrlAsync(int? ticketId)
    {
        var url = BoardUrl(_subKanbanParentId, ticketId);
        if (!await TryInvokeBoardJsAsync("boardReplaceUrl", url))
            Navigation.NavigateTo(url, replace: true);
    }

    private async ValueTask<bool> TryInvokeBoardJsAsync(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
            return true;
        }
        catch (JSException)
        {
            // A tab opened before a KittyClaw update may not have the latest optional board
            // helpers yet. Losing scroll preservation is preferable to terminating its circuit.
            return false;
        }
    }

    // Undo
    private record UndoAction(string Label, Func<Task> Undo, int? AffectedTicketId);
    private readonly Stack<UndoAction> _undoStack = new();
    private const int MaxUndoSize = 30;
    private IJSObjectReference? _undoHandler;
    private DotNetObjectReference<Board>? _dotNetRef;

    private void PushUndo(string label, Func<Task> undo, int? affectedTicketId = null)
    {
        if (_undoStack.Count >= MaxUndoSize)
        {
            var items = _undoStack.ToArray();
            _undoStack.Clear();
            for (int i = items.Length - 2; i >= 0; i--)
                _undoStack.Push(items[i]);
        }
        _undoStack.Push(new UndoAction(label, undo, affectedTicketId));
    }

    private void PushTicketUndo(string label, Func<Task> undo) =>
        PushUndo(label, undo, _openTicketId);

    [JSInvokable]
    public async Task OnCtrlZ() => await PerformUndo();

    private async Task PerformUndo()
    {
        if (!_undoStack.Any()) return;
        var action = _undoStack.Pop();
        await action.Undo();
        await RefreshTicketsAsync();
        if (action.AffectedTicketId is int ticketId && _tickets.Any(t => t.Id == ticketId))
            await MarkTicketViewedAsync(ticketId);
        await LoadSelectedPipelineColumnsAsync();
        // The panel loads its own data — bump the token so an open panel reloads too.
        _panelRefreshToken++;
        StateHasChanged();
    }

