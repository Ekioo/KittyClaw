    private async Task MoveTicketFromMenuAsync(Pipeline pipeline, BoardColumn column)
    {
        var ticket = _ticketMenuTicket;
        _ticketMenuTicket = null;
        if (ticket is null) return;

        var oldStatus = ticket.Status;
        var oldPipelineId = ticket.PipelineId;
        var oldColumnId = ticket.ColumnId;
        await TicketService.UpdateTicketAsync(Slug, ticket.Id, author: "owner",
            status: column.Name, pipelineId: pipeline.Id, columnId: column.Id, enforceRouting: true);
        PushUndo($"{L["UndoMove"]} #{ticket.Id}", async () =>
            await TicketService.UpdateTicketAsync(Slug, ticket.Id, author: "owner",
                status: oldStatus, pipelineId: oldPipelineId, columnId: oldColumnId), ticket.Id);
        await RefreshTicketsAsync();
        BoardUpdateNotifier.NotifyProjectUpdated(Slug);
    }

