        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", $"board-sort-{Slug}");
            if (string.IsNullOrWhiteSpace(json)) return;
            var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, KittyClaw.Web.Services.ColumnSortSetting>>(json);
