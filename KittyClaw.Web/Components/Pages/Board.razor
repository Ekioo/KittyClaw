    private void OnAgentRunsChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        BoardUpdateNotifier.OnProjectUpdated += OnProjectUpdatedExternal;
        AgentRuns.OnChange += OnAgentRunsChanged;
        _project = await ProjectService.GetProjectAsync(Slug);
        if (_project is not null)
        {
            _selectedPipelineId = PipelineId;
            await LoadSelectedPipelineColumnsAsync();
            ResetLoadedColumns();
            await RefreshTicketsAsync();
            _allMembers = await MemberService.ListMembersAsync(Slug);

            // A legacy board deserves an explicit migration path, but opening a deep-linked
            // ticket must remain interruption-free. The wizard is shown once for this board
            // component and can be dismissed without changing any project state.
            if (TicketId is null && ParentId is null)
            {
                var (legacyConfig, _, _) = await AutomationStore.LoadAsync(Slug);
                _showMigrationWizard = KittyClaw.Web.Services.WorkflowMigrationEligibility.ShouldOffer(
                    legacyConfig.Automations.Count > 0);
            }

            // Legacy ticket links did not carry the pipeline in the URL. Infer it from
            // the ticket so direct links still open in the pipeline that owns the card.
            if (PipelineId is null && TicketId is int ticketId &&
                _tickets.FirstOrDefault(ticket => ticket.Id == ticketId)?.PipelineId is int ticketPipelineId &&
                ticketPipelineId != _selectedPipelineId)
            {
                _selectedPipelineId = ticketPipelineId;
                await LoadSelectedPipelineColumnsAsync();
                ResetLoadedColumns();
            }
        }
        if (ParentId.HasValue)
        {
            _subKanbanParentId = ParentId.Value;
            _subKanbanParent = _tickets.FirstOrDefault(t => t.Id == ParentId.Value);
        }
        _openTicketId = TicketId;
    }

    private void OnProjectUpdatedExternal(string slug)
    {
        if (slug != Slug) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadSelectedPipelineColumnsAsync();
                ResetLoadedColumns();
                await RefreshTicketsAsync();
                _allMembers = await MemberService.ListMembersAsync(Slug);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unable to refresh board for project {ProjectSlug}", Slug);
            }
        });
    }

    public void Dispose()
    {
        BoardUpdateNotifier.OnProjectUpdated -= OnProjectUpdatedExternal;
        AgentRuns.OnChange -= OnAgentRunsChanged;
        if (_undoHandler is not null)
            _ = JS.InvokeVoidAsync("unregisterUndoShortcut", _undoHandler);
        _dotNetRef?.Dispose();
        _escRunDrawer?.Dispose();
        _escChatDrawer?.Dispose();
        _escTrashDialog?.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_project is null) return; // handled by OnInitializedAsync

        var requestedPipelineId = PipelineId;
        if (requestedPipelineId is null && TicketId is int ticketId)
            requestedPipelineId = _tickets.FirstOrDefault(ticket => ticket.Id == ticketId)?.PipelineId;
        if (requestedPipelineId is int pipelineId && pipelineId != _selectedPipelineId &&
            _pipelines.Any(pipeline => pipeline.Id == pipelineId))
        {
            _selectedPipelineId = pipelineId;
            await LoadSelectedPipelineColumnsAsync();
            ResetLoadedColumns();
        }

        // Sync sub-kanban state with URL
        if (ParentId.HasValue && _subKanbanParentId != ParentId.Value)
        {
            _subKanbanParentId = ParentId.Value;
            _subKanbanParent = _tickets.FirstOrDefault(t => t.Id == ParentId.Value);
        }
        else if (!ParentId.HasValue && _subKanbanParentId is not null)
        {
            _subKanbanParentId = null;
            _subKanbanParent = null;
        }

        // Sync the open panel with the URL (deep links, browser navigation).
        _openTicketId = TicketId;
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _undoHandler = await JS.InvokeAsync<IJSObjectReference>("registerUndoShortcut", _dotNetRef);

            // Load board-wide fallback timestamp. Do NOT write the current time here —
            // indicators must persist across reloads. This legacy value is only a
            // fallback for tickets without a per-ticket viewed timestamp.
            var key = $"board-last-visited-{Slug}";
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", key);
            if (stored is not null && DateTime.TryParse(stored, null, System.Globalization.DateTimeStyles.RoundtripKind, out var parsed))
                _lastVisitedAt = parsed;

            // Load per-ticket viewed timestamps.
            var viewedJson = await JS.InvokeAsync<string?>("localStorage.getItem", $"board-viewed-{Slug}");
            if (!string.IsNullOrWhiteSpace(viewedJson))
            {
                try
                {
                    var raw = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(viewedJson);
                    if (raw is not null)
                    {
                        _viewedAt = raw
                            .Select(kv => (Id: int.TryParse(kv.Key, out var id) ? id : -1,
                                          At: DateTime.TryParse(kv.Value, null, System.Globalization.DateTimeStyles.RoundtripKind, out var at) ? at : DateTime.MinValue))
                            .Where(t => t.Id >= 0 && t.At != DateTime.MinValue)
                            .ToDictionary(t => t.Id, t => t.At);
                    }
                }
                catch { /* corrupt JSON — ignore, will be overwritten on next view */ }
            }

            if (_openTicketId is int openTicketId)
                await MarkTicketViewedAsync(openTicketId);

            await LoadSortAsync();

            // Point "← Projects" at the home mode the user last used ("/" is the unified
            // kanban, "/projects" the cards grid — the route carries the mode).
            var homeView = await JS.InvokeAsync<string?>("localStorage.getItem", "unified-board-view");
            if (homeView == "cards") _homeHref = "/projects";

            StateHasChanged();
        }
        if (_restoreScrollAfterRender)
        {
            _restoreScrollAfterRender = false;
            await TryInvokeBoardJsAsync("restoreColumnScrollPositions");
        }
    }


    private List<TicketSummary> GetTickets(string status)
    {
        // Main board: top-level tickets. Sub-kanban: only children of its parent.
        IEnumerable<TicketSummary> tickets = TicketsInColumnContext(status);

        if (!string.IsNullOrWhiteSpace(FilterState.FilterText))
            tickets = BoardTicketFilter.Apply(tickets, FilterState.FilterText, GetPriorityLabel);

        var sort = SortState.Get(Slug, status);
        if (sort.Mode != KittyClaw.Web.Services.ColumnSortMode.Manual)
            tickets = KittyClaw.Web.Services.BoardSortState.ApplySort(tickets, sort.Mode, sort.Direction);
        else if (status == "Scheduled")
            // Scheduled column defaults to soonest-fire-first so upcoming reactivations sit on top.
            tickets = tickets.OrderBy(t => t.FireAt ?? DateTime.MaxValue).ThenBy(t => t.SortOrder);

        return tickets.ToList();
    }

    private void ResetLoadedColumns()
    {
        // GroupBy: duplicate column names are prevented upstream (unique index), but a board
        // that somehow still contains them must degrade to showing one, not crash the page.
        _loadedPerColumn = _columns.GroupBy(c => c.Name).ToDictionary(g => g.Key, _ => InitialPageSize);
    }

    private void LoadMore(string columnName)
    {
        if (!_loadedPerColumn.ContainsKey(columnName))
            _loadedPerColumn[columnName] = InitialPageSize;
        else
            _loadedPerColumn[columnName] += LoadMoreSize;
    }

