    private async Task OpenTicketMenuAsync(TicketSummary ticket, Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        _sortMenuOpenFor = null;
        _ticketMenuTicket = ticket;
        _ticketMenuX = e.ClientX;
        _ticketMenuY = e.ClientY;
        _ticketMenuColumns.Clear();
        _ticketMenuRoutingPolicy = ticket.ColumnId is int sourceColumnId
            ? _routingPolicies.GetValueOrDefault(sourceColumnId)
                ?? ColumnRoutingPolicy.From(await ProcessorService.GetAsync(Slug, sourceColumnId))
            : null;
        StateHasChanged();

        var loads = _pipelines.Select(async pipeline =>
            (pipeline.Id, Columns: await ColumnService.ListColumnsAsync(Slug, pipeline.Id)));
        foreach (var result in await Task.WhenAll(loads))
            _ticketMenuColumns[result.Id] = result.Columns
                .Where(column => _ticketMenuRoutingPolicy is null
                    || _ticketMenuRoutingPolicy.Allows(ticket.ColumnId ?? 0, column.Id))
                .ToList();
        StateHasChanged();
    }

