@page "/board/{Slug}/approvals"
@using KittyClaw.Core.Models
@inject ProjectService ProjectService
@inject ApprovalRegistryService Registry
@inject ApprovalWorkflowService Workflow
@inject LocalizationService L
@rendermode InteractiveServer

<PageTitle>@L["RuntimeApprovalsTitle"]</PageTitle>

<div class="page-header">
    <a class="back-link" href="/board/@Slug">&larr; @L["ApprovalBackToBoard"]</a>
    <h1>@L["RuntimeApprovalsTitle"]</h1>
    <button class="header-action-btn" @onclick="LoadAsync">@L["Refresh"]</button>
</div>

@if (_loading)
{
    <p>@L["ApprovalLoading"]</p>
}
else if (_requests.Count == 0)
{
    <div class="approval-empty">@L["ApprovalEmpty"]</div>
}
else
{
    <div class="approval-list">
        @foreach (var request in _requests.OrderByDescending(r => r.ObservedAt))
        {
            var decisions = Decisions(request.RequestId);
            var receipts = Receipts(request.RequestId);
            <article class="approval-card approval-card--@request.State" data-request-id="@request.RequestId">
                <header>
                    <div><span class="approval-state">@request.State</span> <strong>@request.Operation</strong></div>
                    <span>@request.ObservedAt.ToLocalTime().ToString("g")</span>
                </header>
                <dl class="approval-grid">
                    <dt>@L["ApprovalAction"]</dt><dd>@request.ActionClass</dd>
                    <dt>@L["ApprovalDestinationResource"]</dt><dd>@request.ResourceDisplay <code>@request.ResourceCanonicalId</code></dd>
                    <dt>@L["ApprovalReason"]</dt><dd>@request.Reason</dd>
                    <dt>@L["ApprovalScope"]</dt><dd>@(request.ScopeRequested ?? L["ApprovalSingleEffect"])</dd>
                    <dt>@L["ApprovalDuration"]</dt><dd>@Duration(request)</dd>
                    <dt>@L["ApprovalProvider"]</dt><dd>@request.ProviderName @request.ProviderCliVersion · @request.EnforcementProfile</dd>
                    <dt>@L["ApprovalRun"]</dt><dd><code>@request.RunId</code></dd>
                    <dt>@L["ApprovalTicket"]</dt><dd><a href="/board/@Slug/ticket/@request.TicketId">#@request.TicketId</a></dd>
                </dl>
                @if (request.State == "pending")
                {
                    <div class="approval-actions">
                        <button class="approval-allow" @onclick="() => DecideAsync(request, ApprovalDecisionKind.AllowOnce)">@L["ApprovalAllowOnce"]</button>
                        <button class="approval-ticket" @onclick="() => DecideAsync(request, ApprovalDecisionKind.AllowForTicket)">@L["ApprovalAllowForTicket"]</button>
                        <button class="approval-deny" @onclick="() => DecideAsync(request, ApprovalDecisionKind.Deny)">@L["ApprovalDeny"]</button>
                    </div>
                }
                @if (decisions.Count > 0 || receipts.Count > 0)
                {
                    <details class="approval-audit">
                        <summary>@L.Get("ApprovalAuditHistory", decisions.Count + receipts.Count)</summary>
                        @foreach (var decision in decisions)
                        {
                            <p><strong>@decision.Kind</strong> @L.Get("ApprovalDecisionAudit", decision.Actor, decision.CreatedAt.ToLocalTime().ToString("g"), decision.Scope, decision.ExpiresAt.ToLocalTime().ToString("g"))</p>
                        }
                        @foreach (var receipt in receipts)
                        {
                            <p><strong>@receipt.Outcome</strong> @L.Get("ApprovalReceiptAudit", receipt.EnforcementPointId, receipt.EndedAt.ToLocalTime().ToString("g")) <code>@receipt.IntegrityHash[..12]</code></p>
                        }
                    </details>
                }
            </article>
        }
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private bool _loading = true;
    private IReadOnlyList<ApprovalRequestRecord> _requests = [];
    private IReadOnlyList<ApprovalDecisionRecord> _decisions = [];
    private IReadOnlyList<ApprovalReceiptRecord> _receipts = [];

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        if (await ProjectService.GetProjectAsync(Slug) is not null)
        {
            _requests = await Registry.QueryRequestsAsync(Slug, new());
            _decisions = await Registry.QueryDecisionsAsync(Slug);
            _receipts = await Registry.QueryReceiptsAsync(Slug);
        }
        _loading = false;
    }

    private List<ApprovalDecisionRecord> Decisions(string id) => _decisions.Where(d => d.RequestId == id).OrderByDescending(d => d.CreatedAt).ToList();
    private List<ApprovalReceiptRecord> Receipts(string id) => _receipts.Where(r => r.RequestId == id).OrderByDescending(r => r.EndedAt).ToList();
    private string Duration(ApprovalRequestRecord r) => r.DurationRequestedSeconds is int seconds
        ? TimeSpan.FromSeconds(seconds).ToString()
        : L.Get("ApprovalUntil", r.ExpiresAt.ToLocalTime().ToString("g"));

    private async Task DecideAsync(ApprovalRequestRecord request, ApprovalDecisionKind kind)
    {
        var now = DateTime.UtcNow;
        var expiry = kind == ApprovalDecisionKind.AllowForTicket
            ? new[] { request.ExpiresAt, now.AddHours(24) }.Min()
            : kind == ApprovalDecisionKind.AllowOnce && request.DurationRequestedSeconds is int seconds
                ? new[] { request.ExpiresAt, now.AddSeconds(seconds) }.Min()
                : request.ExpiresAt;
        await Workflow.DecideAsync(Slug, new(Guid.NewGuid().ToString("N"), request.RequestId, kind,
            "owner", now, expiry, kind == ApprovalDecisionKind.AllowForTicket ? $"ticket:{request.TicketId}" : "once",
            "Operator decision from the runtime approval queue", null));
        await LoadAsync();
    }
}
