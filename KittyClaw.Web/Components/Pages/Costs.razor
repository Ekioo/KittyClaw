@page "/costs"
@inject CostReportService CostReports
@inject LocalizationService L
@rendermode InteractiveServer

<PageTitle>@L["Costs"]</PageTitle>
<main class="costs-page">
 <header class="page-header costs-header"><a href="/" class="back-link">&larr; @L["BackToProjects"]</a><h1>@L["Costs"]</h1></header>
 <section class="cost-filters" aria-label="@L["CostFilters"]">
  <label>@L["FromDate"] <input class="cost-from" type="date" value="@_from.ToString("yyyy-MM-dd")" @onchange="OnFromChanged" /></label>
  <label>@L["ToDate"] <input class="cost-to" type="date" value="@_to.ToString("yyyy-MM-dd")" @onchange="OnToChanged" /></label>
  <label>@L["Pipeline"] <select class="cost-pipeline" value="@(_pipelineKey ?? "")" @onchange="OnPipelineChanged"><option value="">@L["AllPipelines"]</option>@foreach (var pipeline in _options?.Pipelines ?? []) { <option value="@pipeline.Key">@(pipeline.Key.EndsWith(":unknown", StringComparison.Ordinal) ? $"{pipeline.Name} / {L["UnknownPipeline"]}" : pipeline.Name)</option> }</select></label>
  <fieldset class="cost-project-filter"><legend>@L["Projects"]</legend>
   <label><input type="checkbox" checked="@(_selectedProjects.Count == 0)" @onchange="SelectAllProjects" /> @L["AllProjects"]</label>
   @foreach (var project in _options?.Projects ?? []) { <label><input type="checkbox" checked="@_selectedProjects.Contains(project.Slug)" @onchange="e => ToggleProject(project.Slug, e)" /> @project.Name</label> }
  </fieldset>
 </section>
 @if (_loading) { <p class="cost-state" role="status">@L["Loading"]</p> }
 else if (_error is not null) { <p class="cost-state cost-error" role="alert">@L["CostLoadError"]</p> }
 else if (_report is not null)
 {
  <section class="cost-total-card @(_report.Estimated ? "cost-estimated" : "")"><span>@L["TotalCost"]</span><strong class="cost-total">@Usd(_report.TotalUsd)</strong>@if (_report.Estimated) { <span class="estimated-marker" title="@L["EstimatedHelp"]" tabindex="0">~ @L["Estimated"]</span> }</section>
  @if (_report.Daily.Count == 0) { <div class="cost-state cost-empty"><h2>@L["NoCostData"]</h2><p>@L["NoCostDataHint"]</p></div> }
  else
  {
   <section class="cost-chart-card"><h2>@L["DailyEvolution"]</h2><div class="cost-chart" role="img" aria-label="@L["CostChartLabel"]">
    @foreach (var bucket in _report.Daily) { var height = _maxCost == 0 ? 0 : Math.Max(3, bucket.UsdCost / _maxCost * 100); <button class="cost-bar @(bucket.Estimated ? "cost-estimated" : "")" style="height:@height.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%" title="@($"{bucket.Day:d} — {bucket.ProjectName}: {Usd(bucket.UsdCost)}")"><span class="visually-hidden">@bucket.Day, @bucket.ProjectName, @Usd(bucket.UsdCost)</span></button> }
   </div></section>
   <section class="cost-breakdown"><h2>@L["ByProject"]</h2>@foreach (var project in _report.Projects) { <div class="cost-project-row @(project.Estimated ? "cost-estimated" : "")"><span>@project.ProjectName</span><strong>@Usd(project.UsdCost)</strong>@if(project.Estimated){<span title="@L["EstimatedHelp"]">~</span>}</div> }</section>
  }
 }
</main>
@code {
 private DateOnly _to = DateOnly.FromDateTime(DateTime.Now); private DateOnly _from = DateOnly.FromDateTime(DateTime.Now).AddDays(-29);
 private string? _pipelineKey; private HashSet<string> _selectedProjects = []; private CostReportOptions? _options; private CostReport? _report; private bool _loading = true; private string? _error;
 private decimal _maxCost => _report?.Daily.Max(x => x.UsdCost) ?? 0;
 protected override async Task OnInitializedAsync() { try { _options = await CostReports.GetOptionsAsync(); await Reload(); } catch(Exception ex) { _error = ex.Message; _loading = false; } }
 private async Task Reload() { _loading = true; _error = null; try { _report = await CostReports.GetReportAsync(new(_from, _to, _selectedProjects, _pipelineKey)); } catch(Exception ex) { _error = ex.Message; } finally { _loading = false; } }
 private async Task OnFromChanged(ChangeEventArgs e) { if(DateOnly.TryParse(e.Value?.ToString(), out var value)) _from=value; await Reload(); }
 private async Task OnToChanged(ChangeEventArgs e) { if(DateOnly.TryParse(e.Value?.ToString(), out var value)) _to=value; await Reload(); }
 private async Task OnPipelineChanged(ChangeEventArgs e) { _pipelineKey=string.IsNullOrWhiteSpace(e.Value?.ToString())?null:e.Value!.ToString(); await Reload(); }
 private async Task SelectAllProjects(ChangeEventArgs e) { _selectedProjects.Clear(); await Reload(); }
 private async Task ToggleProject(string slug, ChangeEventArgs e) { if((bool?)e.Value == true) _selectedProjects.Add(slug); else _selectedProjects.Remove(slug); await Reload(); }
 private static string Usd(decimal value) => value.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
}
