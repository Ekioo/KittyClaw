@page "/costs"
@inject CostReportService CostReports
@inject LocalizationService L
@rendermode InteractiveServer
@attribute [StreamRendering]

<PageTitle>@L["Costs"]</PageTitle>
<main class="costs-page">
    <header class="costs-header">
        <a href="/" class="costs-back-link"><span aria-hidden="true">&larr;</span> @L["BackToProjects"]</a>
        <h1>@L["Costs"]</h1>
    </header>

    <section class="cost-filter-card" aria-label="@L["CostFilters"]">
        <div class="cost-filter-grid">
            <label class="cost-field"><span>@L["FromDate"]</span><input class="cost-from" type="date" value="@_from.ToString("yyyy-MM-dd")" @onchange="OnFromChanged" /></label>
            <label class="cost-field"><span>@L["ToDate"]</span><input class="cost-to" type="date" value="@_to.ToString("yyyy-MM-dd")" @onchange="OnToChanged" /></label>
            <details class="cost-project-picker">
                <summary><span class="cost-field-label">@L["Projects"]</span><strong>@ProjectSelectionLabel</strong><span class="cost-picker-chevron" aria-hidden="true"></span></summary>
                <fieldset class="cost-project-menu">
                    <legend class="visually-hidden">@L["Projects"]</legend>
                    <label class="cost-project-option cost-project-all"><input type="checkbox" checked="@(_selectedProjects.Count == 0)" @onchange="SelectAllProjects" /><span>@L["AllProjects"]</span></label>
                    <div class="cost-project-list">
                        @foreach (var project in _options?.Projects ?? [])
                        {
                            <label class="cost-project-option"><input type="checkbox" checked="@_selectedProjects.Contains(project.Slug)" @onchange="e => ToggleProject(project.Slug, e)" /><span>@project.Name</span></label>
                        }
                    </div>
                </fieldset>
            </details>
            <label class="cost-field">
                <span>@L["Pipeline"]</span>
                <select class="cost-pipeline" value="@(_pipelineKey ?? "")" @onchange="OnPipelineChanged">
                    <option value="">@L["AllPipelines"]</option>
                    @foreach (var pipeline in AvailablePipelines)
                    {
                        <option value="@pipeline.Key">@(pipeline.Key.EndsWith(":unknown", StringComparison.Ordinal) ? $"{pipeline.Name} / {L["UnknownPipeline"]}" : pipeline.Name)</option>
                    }
                </select>
            </label>
            <label class="cost-field">
                <span>@L["Model"]</span>
                <select class="cost-model" value="@(_model ?? "")" @onchange="OnModelChanged">
                    <option value="">@L["AllModels"]</option>
                    @foreach (var model in _options?.Models ?? [])
                    {
                        <option value="@model.Key">@model.Name</option>
                    }
                </select>
            </label>
        </div>
        <div class="cost-date-presets" role="group" aria-label="@L["QuickPeriod"]">
            <span class="cost-date-presets-label">@L["QuickPeriod"]</span>
            <button type="button" class="@PresetClass(DatePreset.Last30Days)" @onclick="() => ApplyDatePreset(DatePreset.Last30Days)">@L["Last30Days"]</button>
            <button type="button" class="@PresetClass(DatePreset.CurrentMonth)" @onclick="() => ApplyDatePreset(DatePreset.CurrentMonth)">@L["CurrentMonth"]</button>
            <button type="button" class="@PresetClass(DatePreset.PreviousMonth)" @onclick="() => ApplyDatePreset(DatePreset.PreviousMonth)">@L["PreviousMonth"]</button>
            <button type="button" class="@PresetClass(DatePreset.LastThreeMonths)" @onclick="() => ApplyDatePreset(DatePreset.LastThreeMonths)">@L["LastThreeMonths"]</button>
            <button type="button" class="@PresetClass(DatePreset.CurrentYear)" @onclick="() => ApplyDatePreset(DatePreset.CurrentYear)">@L["CurrentYear"]</button>
        </div>
    </section>

    @if (_loading)
    {
        <section class="cost-loading" role="status" aria-live="polite">
            <span class="visually-hidden">@L["Loading"]</span>
            <div class="cost-skeleton-projects">
                <div class="cost-skeleton"></div><div class="cost-skeleton"></div><div class="cost-skeleton"></div>
            </div>
        </section>
    }
    else if (_error is not null)
    {
        <p class="cost-state cost-error" role="alert">@L["CostLoadError"]</p>
    }
    else if (_report is not null)
    {
        <div class="cost-visible-total" data-testid="cost-visible-total" aria-live="polite">
            <span>@L["DisplayedTotal"]</span>
            <strong>@Usd(VisibleTotalUsd)</strong>
            @if (VisibleTotalEstimated)
            {
                <span class="estimated-marker" title="@L["EstimatedHelp"]" tabindex="0">~ @L["Estimated"]</span>
            }
        </div>

        @if (_report.Projects.Count == 0)
        {
            <div class="cost-state cost-empty"><h2>@L["NoCostData"]</h2><p>@L["NoCostDataHint"]</p></div>
        }
        else
        {
            <section class="cost-projects-section">
                <header class="cost-projects-header">
                    <div class="cost-projects-heading">
                        <h2>@L["ByProject"]</h2>
                    </div>
                    <div class="cost-legend" role="list" aria-label="@L["CostLegend"]">
                        <span role="listitem"><i class="cost-legend-swatch cost-legend-measured" aria-hidden="true"></i>@L["Measured"]</span>
                        <span role="listitem"><i class="cost-legend-swatch cost-legend-estimated" aria-hidden="true"></i>@L["Estimated"]</span>
                        <span role="listitem"><i class="cost-legend-swatch cost-legend-rtk" aria-hidden="true"></i>@L["RtkSavings"]</span>
                    </div>
                </header>
                <div class="cost-project-card-grid">
                    @foreach (var project in _projectCosts)
                    {
                        <article class="cost-project-cost-card">
                            <header>
                                <h3>@project.ProjectName</h3>
                                @if (project.Estimated) { <span class="estimated-marker" title="@L["EstimatedHelp"]" tabindex="0">~ @L["Estimated"]</span> }
                            </header>
                            <strong class="cost-project-total">@Usd(project.UsdCost)</strong>
                            @if (project.RtkSavedTokens > 0)
                            {
                                <div class="cost-project-rtk" title="@L["RtkSavingsHelp"]" tabindex="0">
                                    <span class="cost-project-rtk-badge">RTK</span>
                                    <div>
                                        <strong>~ @Tokens(project.RtkSavedTokens) @L["RtkSavedTokens"]</strong>
                                        <span>@RtkDetail(project)</span>
                                    </div>
                                </div>
                            }
                            @if (project.Daily.Count > 0)
                            {
                                <span class="cost-project-trend-label">@L["DailyEvolution"]</span>
                                <div class="cost-project-trend" role="img" aria-label="@($"{L["DailyEvolution"]} — {project.ProjectName}")">
                                    @foreach (var day in project.Daily)
                                    {
                                        var height = project.MaxDailyCost == 0 ? 0 : Math.Max(5, day.UsdCost / project.MaxDailyCost * 100);
                                        <span class="cost-project-bar @(day.Estimated ? "cost-estimated" : "")" style="--bar-height:@height.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%" title="@($"{day.Day:d} — {Usd(day.UsdCost)}")">
                                            <span class="visually-hidden">@day.Day, @Usd(day.UsdCost)</span>
                                        </span>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    }
</main>

@code {
    private DateOnly _to = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly _from = DateOnly.FromDateTime(DateTime.Now).AddDays(-29);
    private DatePreset? _activePreset = DatePreset.Last30Days;
    private string? _pipelineKey;
    private string? _model;
    private HashSet<string> _selectedProjects = [];
    private CostReportOptions? _options;
    private CostReport? _report;
    private IReadOnlyList<ProjectCostView> _projectCosts = [];
    private bool _loading = true;
    private string? _error;

    private string ProjectSelectionLabel => _selectedProjects.Count == 0 ? L["AllProjects"] : $"{_selectedProjects.Count} {L["Projects"]}";
    private IReadOnlyList<CostPipelineOption> AvailablePipelines => CostPipelineFilter.Filter(_options?.Pipelines, _selectedProjects);
    private decimal VisibleTotalUsd => CostDisplayTotal.Sum(_projectCosts.Select(project => project.UsdCost));
    private bool VisibleTotalEstimated => _projectCosts.Any(project => project.Estimated);

    protected override async Task OnInitializedAsync()
    {
        try { _options = await CostReports.GetOptionsAsync(); await Reload(); }
        catch (Exception ex) { _error = ex.Message; _loading = false; }
    }

    private async Task Reload()
    {
        _loading = true; _error = null;
        try
        {
            _report = await CostReports.GetReportAsync(new(_from, _to, _selectedProjects, _pipelineKey, _model));
            _projectCosts = BuildProjectCosts(_report);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task OnFromChanged(ChangeEventArgs e) { if (DateOnly.TryParse(e.Value?.ToString(), out var value)) { _from = value; _activePreset = null; } await Reload(); }
    private async Task OnToChanged(ChangeEventArgs e) { if (DateOnly.TryParse(e.Value?.ToString(), out var value)) { _to = value; _activePreset = null; } await Reload(); }
    private async Task OnPipelineChanged(ChangeEventArgs e) { _pipelineKey = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString(); await Reload(); }
    private async Task OnModelChanged(ChangeEventArgs e) { _model = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString(); await Reload(); }
    private async Task SelectAllProjects(ChangeEventArgs e) { _selectedProjects.Clear(); ValidatePipelineSelection(); await Reload(); }
    private async Task ToggleProject(string slug, ChangeEventArgs e) { if ((bool?)e.Value == true) _selectedProjects.Add(slug); else _selectedProjects.Remove(slug); ValidatePipelineSelection(); await Reload(); }
    private void ValidatePipelineSelection() => _pipelineKey = CostPipelineFilter.KeepValidSelection(_pipelineKey, AvailablePipelines);
    private string PresetClass(DatePreset preset) => $"cost-date-preset{(_activePreset == preset ? " is-active" : string.Empty)}";

    private async Task ApplyDatePreset(DatePreset preset)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        var currentMonth = new DateOnly(today.Year, today.Month, 1);
        (_from, _to) = preset switch
        {
            DatePreset.Last30Days => (today.AddDays(-29), today),
            DatePreset.CurrentMonth => (currentMonth, today),
            DatePreset.PreviousMonth => (currentMonth.AddMonths(-1), currentMonth.AddDays(-1)),
            DatePreset.LastThreeMonths => (currentMonth.AddMonths(-2), today),
            DatePreset.CurrentYear => (new DateOnly(today.Year, 1, 1), today),
            _ => throw new ArgumentOutOfRangeException(nameof(preset), preset, null)
        };
        _activePreset = preset;
        await Reload();
    }

    private static string Usd(decimal value) => value.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
    private static string Tokens(long value) => value.ToString("N0");

    private string RtkDetail(ProjectCostView project)
    {
        var rate = project.RtkInputTokens <= 0
            ? null
            : (decimal?)Math.Min(100, project.RtkSavedTokens * 100m / project.RtkInputTokens);
        var parts = new List<string>();
        if (project.RtkEstimatedUsd is decimal usd)
            parts.Add($"{L["RtkEstimatedValue"]} {UsdSavings(usd)}");
        if (rate is decimal percentage)
            parts.Add($"{percentage:0.#}% {L["RtkReduction"]}");
        return string.Join(" · ", parts);
    }

    private static string UsdSavings(decimal value) => value is > 0 and < 0.01m ? "< $0.01" : Usd(value);

    private static IReadOnlyList<ProjectCostView> BuildProjectCosts(CostReport report) => report.Projects
        .Select(project =>
        {
            var daily = report.Daily.Where(bucket => bucket.ProjectSlug == project.ProjectSlug).OrderBy(bucket => bucket.Day).ToArray();
            var maxDailyCost = daily.Length == 0 ? 0 : daily.Max(bucket => bucket.UsdCost);
            return new ProjectCostView(
                project.ProjectName,
                project.UsdCost,
                project.Estimated,
                daily,
                maxDailyCost,
                project.RtkSavedTokens,
                project.RtkInputTokens,
                project.RtkEstimatedUsd);
        })
        .ToArray();

    private sealed record ProjectCostView(
        string ProjectName,
        decimal UsdCost,
        bool Estimated,
        IReadOnlyList<CostBucket> Daily,
        decimal MaxDailyCost,
        long RtkSavedTokens,
        long RtkInputTokens,
        decimal? RtkEstimatedUsd);
    private enum DatePreset { Last30Days, CurrentMonth, PreviousMonth, LastThreeMonths, CurrentYear }
}
