@page "/"
@page "/board"
@page "/projects"
@using KittyClaw.Core.Models
@using KittyClaw.Core.Services
@inject ProjectService ProjectService
@inject ColumnService ColumnService
@inject KittyClaw.Web.Services.BoardUpdateNotifier BoardUpdateNotifier
@inject ILogger<UnifiedBoard> Logger
@inject LocalizationService L
@inject KittyClaw.Web.Services.UpdateCheckService UpdateCheck
@rendermode InteractiveServer
@attribute [StreamRendering]
@implements IDisposable

<PageTitle>@L["HomeTitle"]</PageTitle>

<OnboardingGate />

<div class="unified-page project-directory">
    <header class="page-header project-directory-header">
        <img src="/KittyClaw-Logo-Horizontal.webp?v=posture07-rounded" alt="KittyClaw" class="home-logo-horizontal" />
        <nav class="project-directory-global-actions" aria-label="@L["GlobalSettings"]">
            <a class="view-toggle-btn" href="/costs">@L["Costs"]</a>
            <a class="view-toggle-btn" href="/settings">@L["GlobalSettings"]</a>
        </nav>
    </header>

    <main class="project-directory-content">
        <div class="project-directory-heading">
            <h1>@L["Projects"]</h1>
            <ProjectCreation OnCreated="OnProjectCreated" />
        </div>
        @if (_projects is null)
        {
            <p class="empty-hint" role="status">@L["UnifiedBoardLoading"]</p>
        }
        else if (_projects.Count == 0)
        {
            <p class="empty-hint">@L["UnifiedBoardNoProjects"]</p>
        }
        else
        {
            <ProjectCards Projects="_projects" ProjectColumns="_columns" />
        }
    </main>

    <footer class="unified-footer">
        <TipOfTheDay />
        <div class="legal-notice">
            KittyClaw v@(UpdateCheck.CurrentVersion) · © 2026 <a href="https://ekioo.com" target="_blank" rel="noopener">Ekioo</a>
            · <a href="https://github.com/Ekioo/KittyClaw" target="_blank" rel="noopener">Source</a>
            · <a href="https://github.com/Ekioo/KittyClaw/blob/main/LICENSE" target="_blank" rel="noopener">AGPL-3.0-or-later</a>
        </div>
    </footer>
</div>

@code {
    private List<Project>? _projects;
    private readonly Dictionary<string, IReadOnlyList<BoardColumnSummary>> _columns = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, KittyClaw.Web.Services.LatestRefreshGuard> _projectRefreshGuards = new(StringComparer.OrdinalIgnoreCase);
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        BoardUpdateNotifier.OnProjectUpdated += OnProjectUpdatedExternal;
        L.OnLanguageChanged += OnLanguageChanged;
        _projects = await ProjectService.ListProjectsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Publish the project directory before opening each project's column-count summary.
        foreach (var project in (_projects ?? []).ToArray())
        {
            if (_disposed) break;
            await RefreshProjectAsync(project.Slug);
        }
    }

    private async Task OnProjectCreated(Project project)
    {
        if (_projects is not null && _projects.All(p => p.Slug != project.Slug))
            _projects.Add(project);
        await RefreshProjectAsync(project.Slug);
    }

    private async Task RefreshProjectAsync(string slug)
    {
        if (!_projectRefreshGuards.TryGetValue(slug, out var guard))
            _projectRefreshGuards[slug] = guard = new();
        try
        {
            await guard.ApplyLatestAsync(
                async () =>
                {
                    var project = await ProjectService.GetProjectAsync(slug);
                    IReadOnlyList<BoardColumnSummary> columns = project is null ? [] : await ColumnService.ListColumnSummariesAsync(slug);
                    return (Project: project, Columns: columns);
                },
                result =>
                {
                    if (_disposed || _projects is null) return;
                    var index = _projects.FindIndex(p => p.Slug == slug);
                    if (result.Project is null)
                    {
                        if (index >= 0) _projects.RemoveAt(index);
                        _columns.Remove(slug);
                    }
                    else
                    {
                        if (index >= 0) _projects[index] = result.Project;
                        else _projects.Add(result.Project);
                        _columns[slug] = result.Columns;
                    }
                });
            if (!_disposed) StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not refresh project directory entry {ProjectSlug}", slug);
        }
    }

    private void OnProjectUpdatedExternal(string slug)
    {
        if (!_disposed) _ = InvokeAsync(() => RefreshProjectAsync(slug));
    }

    private void OnLanguageChanged()
    {
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        BoardUpdateNotifier.OnProjectUpdated -= OnProjectUpdatedExternal;
        L.OnLanguageChanged -= OnLanguageChanged;
    }
}
