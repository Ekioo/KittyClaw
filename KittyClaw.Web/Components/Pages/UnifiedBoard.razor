    private void OnDragStart(string slug, TicketSummary ticket)
    {
        _draggedFromSlug = slug;
        _draggedTicket = ticket;
    }

    private void OnDragEnd()
    {
        _draggedFromSlug = null;
        _draggedTicket = null;
        _dragOverStatus = null;
    }

    private void OnDragOverColumn(string slug, string status)
    {
        // Ignore hover updates for lanes other than the drag's source lane — this keeps the
        // "active drop target" highlight scoped to the source lane only.
        if (_draggedTicket is null || slug != _draggedFromSlug) return;
        _dragOverStatus = status;
    }

    private async Task OnDrop(string slug, string newStatus)
    {
        if (_draggedTicket is null || slug != _draggedFromSlug)
        {
            // Cross-lane drop reached the server despite the client-side guard (e.g. a stale
            // drag state) — reject it as a no-op rather than moving the ticket.
            OnDragEnd();
            return;
        }

        var ticketId = _draggedTicket.Id;
        var oldStatus = _draggedTicket.Status;
        if (oldStatus == newStatus) { OnDragEnd(); return; }

        if (_draggedTicket.ColumnId is int sourceColumnId)
        {
            var processor = await ProcessorService.GetAsync(slug, sourceColumnId);
            var destination = _lanes!
                .First(lane => lane.Project.Slug == slug).Columns
                .FirstOrDefault(column => column.Name == newStatus);
            if (destination is not null
                && !ColumnRoutingPolicy.From(processor).Allows(sourceColumnId, destination.Id))
            {
                OnDragEnd();
                return;
            }
        }

        var lanes = _lanes!;
        var targetIndex = GetTickets(lanes.First(l => l.Project.Slug == slug), newStatus).Count;
        await TicketService.ReorderTicketAsync(slug, ticketId, newStatus, targetIndex, enforceRouting: true);
        OnDragEnd();

        var idx = lanes.FindIndex(l => l.Project.Slug == slug);
        if (idx >= 0)
        {
            lanes[idx] = await LoadLaneAsync(lanes[idx].Project, lanes[idx].SelectedPipelineId);
            StateHasChanged();
        }
    }

    private void OnProjectUpdatedExternal(string slug)
    {
        InvokeAsync(async () =>
        {
            // Keep the lightweight project list (cards mode) in sync regardless of lanes.
            if (_projects is not null)
            {
                var updatedProject = await ProjectService.GetProjectAsync(slug);
                var pIdx = _projects.FindIndex(p => p.Slug == slug);
                if (updatedProject is null && pIdx >= 0) _projects.RemoveAt(pIdx);
                else if (updatedProject is not null && pIdx >= 0) _projects[pIdx] = updatedProject;
                else if (updatedProject is not null) _projects.Add(updatedProject);
                StateHasChanged();
            }

            if (_lanes is null) return;
            var idx = _lanes.FindIndex(l => l.Project.Slug == slug);
            if (idx < 0)
            {
                // Unknown slug: could be a project created after this page loaded. Try to pick
                // it up as a brand-new lane instead of silently ignoring the notification.
                var project = await ProjectService.GetProjectAsync(slug);
                if (project is null) return;
                var newLane = await LoadLaneAsync(project);
                _lanes.Add(newLane);
                _lanes = _lanes.OrderBy(l => l.Project.Name, StringComparer.OrdinalIgnoreCase).ToList();
                StateHasChanged();
                return;
            }

            var refreshedProject = await ProjectService.GetProjectAsync(slug);
            if (refreshedProject is null)
            {
                // Project was deleted.
                _lanes.RemoveAt(idx);
                StateHasChanged();
                return;
            }

            _lanes[idx] = await LoadLaneAsync(refreshedProject, _lanes[idx].SelectedPipelineId);
            StateHasChanged();
        });
    }

    // ── Per-column sort (shared with Board.razor through BoardSortState) ────

    private static readonly KittyClaw.Web.Services.ColumnSortMode[] _sortModes = new[]
    {
        KittyClaw.Web.Services.ColumnSortMode.Title,
        KittyClaw.Web.Services.ColumnSortMode.Priority,
        KittyClaw.Web.Services.ColumnSortMode.Assignee,
        KittyClaw.Web.Services.ColumnSortMode.CreatedAt,
        KittyClaw.Web.Services.ColumnSortMode.UpdatedAt,
    };
    private static readonly KittyClaw.Web.Services.SortDirection[] _sortDirections = new[]
    {
        KittyClaw.Web.Services.SortDirection.Ascending,
        KittyClaw.Web.Services.SortDirection.Descending,
    };
    private string? _sortMenuSlug;
    private string? _sortMenuColumn;
    private double _sortMenuX;
    private double _sortMenuY;

    private void OpenSortMenu(string slug, string columnName, MouseEventArgs e)
    {
        _sortMenuSlug = slug;
        _sortMenuColumn = columnName;
        _sortMenuX = e.ClientX;
        _sortMenuY = e.ClientY;
    }

    private void CloseSortMenu()
    {
        _sortMenuSlug = null;
        _sortMenuColumn = null;
    }

    private async Task SelectSort(KittyClaw.Web.Services.ColumnSortMode mode, KittyClaw.Web.Services.SortDirection direction)
    {
        if (_sortMenuSlug is null || _sortMenuColumn is null) return;
        var slug = _sortMenuSlug;
        SortState.Set(slug, _sortMenuColumn, mode, direction);
        CloseSortMenu();
        await PersistSortAsync(slug);
    }

    private string SortLabel(KittyClaw.Web.Services.ColumnSortMode mode) => mode switch
    {
        KittyClaw.Web.Services.ColumnSortMode.Title => L["SortByTitle"],
        KittyClaw.Web.Services.ColumnSortMode.Priority => L["SortByPriority"],
        KittyClaw.Web.Services.ColumnSortMode.Assignee => L["SortByAssignee"],
        KittyClaw.Web.Services.ColumnSortMode.CreatedAt => L["SortByCreated"],
        KittyClaw.Web.Services.ColumnSortMode.UpdatedAt => L["SortByUpdated"],
        _ => L["SortManual"],
    };

    private string DirectionLabel(KittyClaw.Web.Services.SortDirection dir)
        => dir == KittyClaw.Web.Services.SortDirection.Ascending ? L["SortAsc"] : L["SortDesc"];

    private async Task LoadSortAsync(string slug)
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", $"board-sort-{slug}");
            if (string.IsNullOrWhiteSpace(json)) return;
            var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, KittyClaw.Web.Services.ColumnSortSetting>>(json);
            if (dict is not null) SortState.LoadForSlug(slug, dict);
        }
        catch { /* ignore corrupt JSON */ }
    }

    private async Task PersistSortAsync(string slug)
    {
        try
        {
            var snapshot = SortState.SnapshotForSlug(slug);
            var json = System.Text.Json.JsonSerializer.Serialize(snapshot);
            await JS.InvokeVoidAsync("localStorage.setItem", $"board-sort-{slug}", json);
        }
        catch { /* ignore */ }
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        BoardUpdateNotifier.OnProjectUpdated -= OnProjectUpdatedExternal;
        L.OnLanguageChanged -= OnLanguageChanged;
        _escCreateTicket?.Dispose();
    }
