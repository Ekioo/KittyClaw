        var idx = _lanes.FindIndex(l => l.Project.Slug == _panelSlug);
        if (idx >= 0)
        {
            _lanes[idx] = await LoadLaneAsync(_lanes[idx].Project, _lanes[idx].SelectedPipelineId);
            StateHasChanged();
        }
    }

    private async Task OnPanelTicketDeleted()
