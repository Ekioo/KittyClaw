@using KittyClaw.Core.Services
@using KittyClaw.Core.Automation
@inject AgentCliReadinessService CliReadiness
@inject AppSettingsService AppSettings
@inject LocalizationService L
@inject IJSRuntime JS
@inject KittyClaw.Web.Services.EscapeKeyStack EscapeStack
@rendermode InteractiveServer
@implements IDisposable

@* First-launch onboarding modal (agent providers + Git detection), extracted from Home.razor
   so it can gate whichever page is the app's landing route. *@
@if (_showOnboarding)
{
    <div class="modal-backdrop">
        <div class="modal-dialog onboarding-dialog" @onclick:stopPropagation>
            <img src="/KittyClaw.webp" alt="KittyClaw" class="onboarding-logo" />
            <h2>@L["OnboardingTitle"]</h2>
            <p>@L["OnboardingIntro1"]</p>
            <p>@L["OnboardingIntro2"]</p>

            <h3 style="margin-top:1rem;font-size:0.95rem">@L["OnboardingRequirements"]</h3>
            <div class="onboarding-check @ProviderClass(_readiness.Claude)">
                <span>@(_readiness.Claude ? "✓" : "○") Claude Code</span>
                @if (!_readiness.Claude)
                {
                    <small>@L["OnboardingClaudeGuidance"]</small>
                    <a class="header-action-btn" href="https://docs.claude.com/en/docs/claude-code/overview" target="_blank" rel="noopener">@L["OnboardingInstall"]</a>
                }
            </div>
            <div class="onboarding-check @ProviderClass(_readiness.Codex)">
                <span>@(_readiness.Codex ? "✓" : "○") OpenAI Codex</span>
                @if (!_readiness.Codex)
                {
                    <small>@L["OnboardingCodexGuidance"]</small>
                    <a class="header-action-btn" href="https://developers.openai.com/codex/cli/" target="_blank" rel="noopener">@L["OnboardingInstall"]</a>
                }
            </div>
            <div class="onboarding-check @ProviderClass(_readiness.Grok)">
                <span>@(_readiness.Grok ? "✓" : "○") Grok Build</span>
                @if (!_readiness.Grok)
                {
                    <small>@L["OnboardingGrokGuidance"]</small>
                    <a class="header-action-btn" href="https://docs.x.ai/docs/grok-code-fast-1" target="_blank" rel="noopener">@L["OnboardingInstall"]</a>
                }
            </div>
            <div class="onboarding-check @ProviderClass(_readiness.Mistral)">
                <span>@(_readiness.Mistral ? "✓" : "○") Mistral Vibe</span>
                @if (!_readiness.Mistral)
                {
                    <small>@L["OnboardingMistralGuidance"]</small>
                    <a class="header-action-btn" href="https://docs.mistral.ai/vibe/code/cli/install-setup" target="_blank" rel="noopener">@L["OnboardingInstall"]</a>
                }
            </div>
            <div class="onboarding-check @ProviderClass(_readiness.Ollama)">
                <span>@(_readiness.Ollama ? "✓" : "○") Ollama</span>
                @if (!_readiness.Ollama)
                {
                    <small>@L["OnboardingOllamaGuidance"]</small>
                    <a class="header-action-btn" href="https://ollama.com/download" target="_blank" rel="noopener">@L["OnboardingInstall"]</a>
                }
            </div>
            <div class="onboarding-check @(_readiness.Git ? "ok" : "missing")">
                <span>@(_readiness.Git ? "✓" : "✗") Git</span>
                @if (!_readiness.Git)
                {
                    <small>@L["OnboardingGitGuidance"]</small>
                    <a class="header-action-btn" href="https://git-scm.com/downloads" target="_blank" rel="noopener">@L["OnboardingInstall"]</a>
                }
            </div>

            @if (!_readiness.HasAgentProvider || !_readiness.Git)
            {
                <p class="settings-status settings-status-err" style="margin-top:0.75rem">@L["OnboardingMissingWarning"]</p>
            }
            else
            {
                <p class="onboarding-provider-hint">@L["OnboardingProviderHint"]</p>
            }

            <div class="modal-actions">
                <button class="header-action-btn" @onclick="RecheckAndRefreshAsync" disabled="@_checking">@(_checking ? L["Checking"] : L["Recheck"])</button>
                <button class="header-action-btn settings-primary" @onclick="DismissOnboarding">@L["Continue"]</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _showOnboarding;
    private CliReadiness _readiness = new(false, false, false, false, false, false);
    private bool _checking;
    private bool _checkStarted;
    private IDisposable? _escOnboarding;

    protected override void OnInitialized()
    {
        _showOnboarding = !AppSettings.OnboardingSeen;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // External CLI probes can each take several seconds. Starting them only after the
        // first render keeps the landing page responsive while the onboarding updates in place.
        if (firstRender && !_checkStarted)
        {
            _checkStarted = true;
            _ = RecheckAndRefreshAsync();
        }
        if (_showOnboarding && _escOnboarding is null)
            _escOnboarding = EscapeStack.PushWithFocus(JS, () => InvokeAsync(DismissOnboarding));
        else if (!_showOnboarding && _escOnboarding is not null)
        {
            _escOnboarding.Dispose();
            _escOnboarding = null;
        }
        return Task.CompletedTask;
    }

    private async Task RecheckAndRefreshAsync()
    {
        await RecheckTools();
        _showOnboarding = !AppSettings.OnboardingSeen || !_readiness.HasAgentProvider || !_readiness.Git;
        await InvokeAsync(StateHasChanged);
    }

    private string ProviderClass(bool installed) => installed ? "ok" : "optional";

    private async Task RecheckTools()
    {
        _checking = true;
        try
        {
            _readiness = await CliReadiness.ProbeAsync();
        }
        finally
        {
            _checking = false;
        }
    }

    private Task DismissOnboarding()
    {
        AppSettings.OnboardingSeen = true;
        _showOnboarding = false;
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _escOnboarding?.Dispose();
    }
}
