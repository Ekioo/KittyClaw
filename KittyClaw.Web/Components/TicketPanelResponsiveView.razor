@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_mobile is true)
{
    <TicketPanelMobileView TicketId="@TicketId" Title="@Title" Loading="@Loading" EditingTitle="@EditingTitle"
                           Priority="@Priority" TitleEditor="@TitleEditor" Column="@Column" Labels="@Labels"
                           Properties="@Properties" Context="@Context" DependencyEditor="@DependencyEditor"
                           Content="@Content" OnClose="@OnClose" OnImprove="@OnImprove" OnSplit="@OnSplit" OnEditTitle="@OnEditTitle" />
}
else
{
    @* Keep the ticket visible during prerendering and while the viewport observer connects. *@
    <TicketPanelDesktopView Loading="@Loading" Header="@DesktopHeader" Column="@Column" Properties="@Properties"
                            Context="@Context" DependencyEditor="@DependencyEditor" Content="@Content" />
}

@code {
    [Parameter] public int TicketId { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool EditingTitle { get; set; }
    [Parameter] public RenderFragment? DesktopHeader { get; set; }
    [Parameter] public RenderFragment? Priority { get; set; }
    [Parameter] public RenderFragment? TitleEditor { get; set; }
    [Parameter] public RenderFragment? Column { get; set; }
    [Parameter] public RenderFragment? Labels { get; set; }
    [Parameter] public RenderFragment? Properties { get; set; }
    [Parameter] public RenderFragment? Context { get; set; }
    [Parameter] public RenderFragment? DependencyEditor { get; set; }
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnImprove { get; set; }
    [Parameter] public EventCallback OnSplit { get; set; }
    [Parameter] public EventCallback OnEditTitle { get; set; }

    private bool? _mobile;
    private bool _disposed;
    private IJSObjectReference? _module;
    private IJSObjectReference? _observer;
    private DotNetObjectReference<TicketPanelResponsiveView>? _reference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ticket-panel-viewport.js");
            if (_disposed) return;
            _reference = DotNetObjectReference.Create(this);
            _observer = await _module.InvokeAsync<IJSObjectReference>("observe", _reference);
        }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public Task SetMobile(bool mobile) => InvokeAsync(() =>
    {
        if (_disposed || _mobile == mobile) return;
        _mobile = mobile;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_observer is not null)
            {
                await _observer.InvokeVoidAsync("dispose");
                await _observer.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _reference?.Dispose(); }
    }
}
