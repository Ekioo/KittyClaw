@using KittyClaw.Core.Services
@using Microsoft.EntityFrameworkCore
@inject JevQualificationService Qualification
@inject JevDecisionStore Decisions
@inject LocalizationService L
@inject TicketService Tickets
@inject ColumnExecutionService Executions
@inject ColumnProcessorService Processors
@inject ProjectService Projects
@implements IAsyncDisposable

@if (_eligible && _processor is not null)
{
    <section class="jev-route-assistance" data-testid="jev-assistance" aria-label="@L["JevNextAction"]">
        <div class="jev-card-heading">
            <strong>@L["JevValidateNextStep"]</strong>
        </div>
        @if (_busy) { <p role="status">@L["JevThinking"]</p> }
        @if (_proposal is not null)
        {
            <div data-testid="jev-proposal">
                @if (_proposal.Error is not null)
                {
                    <p role="status">@L["JevClassicFallback"]</p>
                }
                else if (JevCertainty.Routing(_proposal, _processor.JevConfidenceThreshold))
                {
                    <div class="jev-next-action">
                    <p class="jev-verdict">@L["JevSuggestedRoute"]: <strong>@DestinationName(_proposal)</strong></p>
                    <JevProposalDecisionPanel @key="JevDecisionStore.ProposalId(_proposal)" Slug="@Slug" TicketId="@TicketId" Proposal="@_proposal" AcceptLabel="@L.Get("JevMoveTo", DestinationName(_proposal))" OnDecided="DecisionTakenAsync" />
                    </div>
                }
                else { <p role="status">@L["JevClassicFallback"]</p> }
                <details class="jev-disclosure jev-technical">
                    <summary>@L["JevTechnicalDetails"]</summary>
                    <p data-testid="jev-routing-policy">@(_automatic ? string.Format(L["JevAutomaticPolicy"], (_processor.JevConfidenceThreshold * 100).ToString("0.#")) : L["JevManualPolicy"])</p>
                    <p>@_proposal.Model · @_proposal.ObservedAt.ToLocalTime().ToString("g") · @L["JevConfidence"]: @_proposal.Confidence?.ToString("P0")</p>
                    @if (_proposal.Error is not null) { <p>@_proposal.Error</p> }
                    @foreach (var option in _proposal.Probabilities.OrderByDescending(p => p.Value))
                    { <p>@_proposal.Destinations.GetValueOrDefault(option.Key, option.Key): @option.Value.ToString("P1")</p> }
                    @if (_proposal.Triage is { } triage)
                    {
                        <div data-testid="jev-triage">
                            <p>@L["JevRequestType"]: @L[$"JevType{triage.RequestType.Choice}"]</p>
                            <p>@L["JevComplexity"]: @L[$"JevComplexity{triage.Complexity.Choice}"]</p>
                            <p>@L["JevClarificationProbability"]: @triage.ClarificationProbability.ToString("P0")</p>
                        </div>
                    }
                    @if (_proposal.Usage is { } usage)
                    { <p data-testid="jev-usage">@L["JevTokens"]: @usage.InputTokens / @usage.OutputTokens · @_proposal.DurationMs ms</p> }
                </details>
            </div>
        }
        @if (_error is not null) { <p class="settings-status-error" role="status">@_error</p> }
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public int TicketId { get; set; }
    [Parameter] public EventCallback OnDecisionTaken { get; set; }
    [Parameter] public EventCallback OnHistoryChanged { get; set; }
    private string? _historyKey;
    private JevRoutingProposal? _proposal;
    private KittyClaw.Core.Models.ColumnProcessor? _processor;
    private Dictionary<int, string> _columnNames = [];
    private bool _busy;
    private bool _automatic;
    private bool _eligible;
    private string? _contextKey, _attemptedContext;
    private int _observedTicket;
    private int? _observedColumn;
    private string? _error;
    private readonly CancellationTokenSource _stop = new();
    private readonly CancellationToken _stopToken;
    private Task? _poll;

    public JevProposalPanel() => _stopToken = _stop.Token;

    private string DestinationName(JevRoutingProposal proposal)
        => proposal.Choice?.StartsWith("column-") == true && int.TryParse(proposal.Choice[7..], out var id)
            ? _columnNames.GetValueOrDefault(id, proposal.Destinations.GetValueOrDefault(proposal.Choice, L["JevNoRoute"]))
            : L["JevNoRoute"];

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await ReloadAsync();
            if (!_stop.IsCancellationRequested) _poll ??= PollAsync();
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_eligible && _proposal is null && !_busy && _attemptedContext != _contextKey)
            await RecommendAsync();
    }
    private async Task ReloadAsync(bool notifyColumnChanges = false)
    {
        var ticket = await Tickets.GetTicketAsync(Slug, TicketId);
        var moved = ticket is not null && _observedTicket == TicketId && _observedColumn != ticket.ColumnId;
        if (_observedTicket != TicketId || notifyColumnChanges)
        { _observedTicket = TicketId; _observedColumn = ticket?.ColumnId; }
        var configured = ticket?.ColumnId is int columnId ? await Processors.GetAsync(Slug, columnId) : null;
        await using var db = Projects.GetProjectDb(Slug);
        var columns = await db.BoardColumns.AsNoTracking().ToListAsync(_stopToken);
        _automatic = configured?.UsesAutomaticJevRouting ?? false;
        _processor = columns.FirstOrDefault(c => c.Id == ticket?.ColumnId) is { } source
            ? JevQualificationService.RecommendationProcessor(configured, source, columns) : null;
        var activeExecution = (await Executions.ListAsync(Slug, TicketId)).Any(e =>
            e.Status is ColumnExecutionStatus.Running or ColumnExecutionStatus.Retrying or ColumnExecutionStatus.WaitingForChildren);
        _eligible = (configured is null || configured.JevObservationOnly) && !activeExecution && _processor is { HasBusinessRouting: true, JevAcceptanceValidation: false } &&
            columns.FirstOrDefault(c => c.Id == ticket?.ColumnId)?.Role is not (ColumnRole.Success or ColumnRole.Failure);
        _columnNames = columns.ToDictionary(c => c.Id, c => c.Name);
        var decisions = await Decisions.ListAsync(Slug, TicketId, _stopToken);
        var history = await Qualification.GetPostRunAsync(Slug, TicketId, _stopToken);
        var historyKey = $"{Slug}:{TicketId}:" + string.Join(";", history.Select(JevDecisionStore.ProposalId).Order()) +
            ":" + string.Join(";", decisions.Select(d => $"{d.ProposalId}:{d.DecidedAt:O}").Order());
        var historyChanged = _historyKey != historyKey;
        _historyKey = historyKey;
        var proposal = await Qualification.GetAsync(Slug, TicketId, _stopToken);
        var feedback = ticket is not null && _processor is not null ? JevQualificationService.RejectionFeedback(decisions, _processor, ticket) : [];
        _contextKey = ticket is not null && _processor is not null
            ? $"{Slug}:{TicketId}:" + JevQualificationService.Fingerprint(_processor, ticket, columns, feedback.Count > 0 ? feedback : null) : null;
        _proposal = proposal is not null && ticket is not null && _processor is { Enabled: true } &&
            proposal.SourceColumnId == ticket.ColumnId &&
            !decisions.Any(d => d.ProposalId == JevDecisionStore.ProposalId(proposal)) &&
            proposal.Fingerprint == JevQualificationService.Fingerprint(_processor, ticket, columns, feedback.Count > 0 ? feedback : null, proposal.RoutingResult)
                ? proposal : null;
        if (notifyColumnChanges && moved && !_stop.IsCancellationRequested) await OnDecisionTaken.InvokeAsync();
        else if (notifyColumnChanges && historyChanged && !_stop.IsCancellationRequested) await OnHistoryChanged.InvokeAsync();
    }
    private async Task RecommendAsync()
    {
        if (_busy) return;
        _busy = true; _error = null;
        _attemptedContext = _contextKey;
        var slug = Slug; var ticketId = TicketId;
        StateHasChanged();
        try
        {
            var ticket = await Tickets.GetTicketAsync(slug, ticketId);
            var processor = ticket?.ColumnId is int id ? await Processors.GetAsync(slug, id) : null;
            if (ticket is null || processor is { JevObservationOnly: false }) return;
            await using var db = Projects.GetProjectDb(slug);
            var columns = await db.BoardColumns.AsNoTracking().ToListAsync(_stopToken);
            if (columns.FirstOrDefault(c => c.Id == ticket.ColumnId) is not { } source) return;
            processor = JevQualificationService.RecommendationProcessor(processor, source, columns);
            await Qualification.ObserveAsync(slug, processor, ticket, columns, _stopToken);
            await ReloadAsync(notifyColumnChanges: true);
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception) { _error = L["JevDecisionError"]; }
        finally { _busy = false; if (!_stop.IsCancellationRequested) StateHasChanged(); }
    }
    private async Task DecisionTakenAsync()
    {
        await ReloadAsync();
        await OnDecisionTaken.InvokeAsync();
    }
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            while (await timer.WaitForNextTickAsync(_stopToken))
                await InvokeAsync(async () => { if (!_busy) { await ReloadAsync(notifyColumnChanges: true); StateHasChanged(); } });
        }
        catch (OperationCanceledException) { }
    }
    public async ValueTask DisposeAsync()
    {
        _stop.Cancel();
        if (_poll is not null) await _poll;
        _stop.Dispose();
    }
}
