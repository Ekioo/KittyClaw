@using KittyClaw.Core.Services
@inject JevQualificationService Qualification
@inject LocalizationService L
@inject TicketService Tickets
@inject ColumnProcessorService Processors
@inject ProjectService Projects
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable

@if (_proposal is not null)
{
    <section class="worktree-summary" data-testid="jev-proposal" aria-label="JEV qualification">
        <strong>JEV — observation only</strong>
        <p>Routing suggestion only. No workflow action was applied.</p>
        @if (_stale) { <p class="settings-hint">This observation predates changes to the ticket or its column.</p> }
        @if (_proposal.Error is not null)
        {
            <p role="status">@_proposal.Error</p>
        }
        else
        {
            <p>Suggested destination: <strong>@_proposal.Destinations.GetValueOrDefault(_proposal.Choice ?? "", "None")</strong></p>
            <p>Confidence: @_proposal.Confidence?.ToString("P0")</p>
            @if (_proposal.Triage is { } triage)
            {
                <div data-testid="jev-triage">
                    <p>@L["JevRequestType"]: <strong>@L[$"JevType{triage.RequestType.Choice}"]</strong> · @L["JevConfidence"]: @triage.RequestType.Confidence.ToString("P0")</p>
                    <p>@L["JevComplexity"]: <strong>@L[$"JevComplexity{triage.Complexity.Choice}"]</strong> · @L["JevConfidence"]: @triage.Complexity.Confidence.ToString("P0")</p>
                    <p>@L["JevClarificationProbability"]: <strong>@triage.ClarificationProbability.ToString("P0")</strong></p>
                    <small class="settings-hint">@L["JevTriageHint"]</small>
                    <details>
                        <summary>@L["JevTriageProbabilities"]</summary>
                        @foreach (var option in triage.RequestType.Probabilities.OrderByDescending(p => p.Value))
                        { <p>@L[$"JevType{option.Key}"]: @option.Value.ToString("P1")</p> }
                        @foreach (var option in triage.Complexity.Probabilities.OrderByDescending(p => p.Value))
                        { <p>@L[$"JevComplexity{option.Key}"]: @option.Value.ToString("P1")</p> }
                    </details>
                </div>
            }
            <details>
                <summary>Destination probabilities</summary>
                @foreach (var option in _proposal.Probabilities.OrderByDescending(p => p.Value))
                {
                    <p>@_proposal.Destinations.GetValueOrDefault(option.Key, option.Key): @option.Value.ToString("P1")</p>
                }
            </details>
        }
        @if (_proposal.Usage is { } usage)
        {
            <p class="settings-hint" data-testid="jev-usage">@L["JevTokens"]: @usage.InputTokens / @usage.OutputTokens · @_proposal.DurationMs ms</p>
        }
        <p class="settings-hint">@_proposal.QuestionVersion · @_proposal.Model · @_proposal.ObservedAt.ToLocalTime().ToString("g")</p>
    </section>
}


@foreach (var observation in _postRun)
{
    <section class="worktree-summary" data-testid="jev-post-run-proposal" aria-label="@L["JevPostRunHeading"]">
        <strong>@L["JevPostRunHeading"]</strong>
        <p>@L["JevPostRunNotice"]</p>
        <p>@L["JevSourceColumn"]: @_columnNames.GetValueOrDefault(observation.SourceColumnId, $"#{observation.SourceColumnId}")</p>
        <p>@L["JevActualRoute"]: @(observation.ActualTargetColumnId is int target ? _columnNames.GetValueOrDefault(target, $"#{target}") : L["JevNoRoute"])</p>
        @if (_currentTicket?.UpdatedAt != observation.TicketUpdatedAt || _currentTicket?.ColumnId != observation.TicketColumnId)
        { <p class="settings-hint">@L["JevPostRunHistorical"]</p> }
        <p class="settings-hint">@L[observation.EvidenceAvailable ? "JevEvidenceAvailable" : "JevEvidenceMissing"]</p>
        @if (observation.Error is not null)
        { <p role="status">@observation.Error</p> }
        else
        {
            <p>@L["JevSuggestedRoute"]: <strong>@observation.Destinations.GetValueOrDefault(observation.Choice ?? "", L["JevNoRoute"])</strong></p>
            <p>@L["JevConfidence"]: @observation.Confidence?.ToString("P0")</p>
            <details>
                <summary>@L["JevRouteProbabilities"]</summary>
                @foreach (var option in observation.Probabilities.OrderByDescending(p => p.Value))
                { <p>@observation.Destinations.GetValueOrDefault(option.Key, option.Key): @option.Value.ToString("P1")</p> }
            </details>
        }
        <p class="settings-hint">@L["JevExecution"]: <code>@observation.ExecutionId</code> · @L["JevRun"]: <code>@observation.RunId</code></p>
        <p class="settings-hint">@observation.ExecutionEndedAt?.ToLocalTime().ToString("g") · @observation.Model · @observation.ObservedAt.ToLocalTime().ToString("g")</p>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public int TicketId { get; set; }
    private JevRoutingProposal? _proposal;
    private List<JevRoutingProposal> _postRun = [];
    private KittyClaw.Core.Models.Ticket? _currentTicket;
    private Dictionary<int, string> _columnNames = [];
    private bool _stale;
    private readonly CancellationTokenSource _stop = new();
    private Task? _poll;
    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
        _poll ??= PollAsync();
    }
    private async Task ReloadAsync()
    {
        _proposal = await Qualification.GetAsync(Slug, TicketId, _stop.Token);
        var ticket = await Tickets.GetTicketAsync(Slug, TicketId);
        _currentTicket = ticket;
        _postRun = await Qualification.GetPostRunAsync(Slug, TicketId, _stop.Token);
        if (_postRun.Count > 0)
        {
            await using var namesDb = Projects.GetProjectDb(Slug);
            _columnNames = await namesDb.BoardColumns.AsNoTracking().ToDictionaryAsync(c => c.Id, c => c.Name, _stop.Token);
        }
        _stale = false;
        if (_proposal is not null)
        {
            var processor = await Processors.GetAsync(Slug, _proposal.SourceColumnId);
            await using var db = Projects.GetProjectDb(Slug);
            var columns = await db.BoardColumns.AsNoTracking().ToListAsync(_stop.Token);
            _stale = ticket is null || processor is null || !processor.Enabled || !processor.JevObservationOnly ||
                ticket.ColumnId != _proposal.SourceColumnId ||
                JevQualificationService.Fingerprint(processor, ticket, columns) != _proposal.Fingerprint;
        }
    }
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            while (await timer.WaitForNextTickAsync(_stop.Token))
                await InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }
    public async ValueTask DisposeAsync()
    {
        _stop.Cancel();
        if (_poll is not null) await _poll;
        _stop.Dispose();
    }
}
