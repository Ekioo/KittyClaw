    <link rel="icon" type="image/webp" href="/KittyClaw.webp" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/base.css"]" />
    <link rel="stylesheet" href="@Assets["css/shared.css"]" />
    <link rel="stylesheet" href="@Assets["css/board.css"]" />
    <link rel="stylesheet" href="@Assets["css/ticket-card.css"]" />
    <link rel="stylesheet" href="@Assets["css/ticket-panel.css"]" />
    <link rel="stylesheet" href="@Assets["css/agent-run.css"]" />
    <link rel="stylesheet" href="@Assets["css/settings.css"]" />
