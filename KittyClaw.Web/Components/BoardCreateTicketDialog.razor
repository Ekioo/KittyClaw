@using KittyClaw.Web.Services
@inject TicketIntakeService Intake
@inject TicketService TicketService
@inject LabelService LabelService
@inject EscapeKeyStack EscapeStack
@inject IJSRuntime JS
@inject LocalizationService L
@inject ILogger<BoardCreateTicketDialog> Logger
@implements IDisposable

<ConversationDrawer Title="@L["NewTicket"]" IsBusy="@_thinking" OnClose="CloseAsync" CssClass="ticket-intake-drawer">
    <ChildContent>
        <div class="ticket-intake-tabs" role="tablist" aria-label="@L["NewTicket"]">
            <button class="tile-config-revise" disabled="@(_thinking || _creating)" role="tab" id="intake-assisted-tab" aria-controls="intake-assisted-panel" aria-selected="@_assisted" @onclick="() => _assisted = true">@L["IntakeAssisted"]</button>
            <button class="tile-config-revise" disabled="@(_thinking || _creating)" role="tab" id="intake-manual-tab" aria-controls="intake-manual-panel" aria-selected="@(!_assisted)" @onclick="() => _assisted = false">@L["IntakeManual"]</button>
        </div>
        <div id="intake-assisted-panel" class="ticket-intake-panel" role="tabpanel" aria-labelledby="intake-assisted-tab" hidden="@(!_assisted)">
            <ConversationView @ref="_messagesView">
                <ConversationMessage Markdown="false">@L["IntakeWelcome"]</ConversationMessage>
                @foreach (var message in _messages)
                {
                    <ConversationMessage Role="@message.Role">
                        @((MarkupString)KittyClaw.Web.Markdown.ChatMarkdownRenderer.Render(message.Text))
                    </ConversationMessage>
                }
                @if (_thinking)
                {
                    <ConversationMessage Markdown="false" BubbleClass="chat-bubble-loading"><span role="status">@L["IntakeThinking"]</span></ConversationMessage>
                }
            </ConversationView>
        </div>
        <div id="intake-manual-panel" @ref="_popup" class="create-popup-body" role="tabpanel" aria-labelledby="intake-manual-tab" hidden="@_assisted">
            <label class="field-label">@L["Title"]</label>
            <input class="create-input" @bind="_title" @bind:event="oninput" placeholder="@L["TicketTitlePlaceholder"]" />

            <label class="field-label">@L["DescriptionMarkdown"]</label>
            <textarea @ref="_descTextarea" class="create-textarea" @bind="_description" @bind:event="oninput" placeholder="@L["DescriptionPlaceholder"]"></textarea>

            <label class="field-label">@L["Priority"]</label>
            <div class="priority-picker">
                @foreach (var p in Enum.GetValues<TicketPriority>())
                {
                    <button class="priority-option @(_priority == p ? "active" : "")"
                            @onclick="() => _priority = p">
                        <span class="priority-dot priority-@GetPriorityClass(p)"></span>
                        @GetPriorityLabel(p)
                    </button>
                }
            </div>

            <label class="field-label">@L["Labels"]</label>
            <div class="label-picker">
                @foreach (var label in _allLabels)
                {
                    var selected = _labelIds.Contains(label.Id);
                    <button class="label-toggle @(selected ? "active" : "")"
                            style="--lc: @label.Color"
                            @onclick="() => ToggleLabel(label.Id)">
                        @label.Name
                    </button>
                }
                @if (_showNewLabelForm)
                {
                    <div class="new-label-form">
                        <input @bind="_newLabelName" placeholder="@L["LabelNamePlaceholder"]" />
                        <input type="color" @bind="_newLabelColor" />
                        <button class="save-btn icon-btn" @onclick="CreateLabelAsync">&#10003;</button>
                        <button class="cancel-icon-btn icon-btn" @onclick="() => _showNewLabelForm = false">&#10005;</button>
                    </div>
                }
                else
                {
                    <button class="label-add-btn" @onclick="() => _showNewLabelForm = true">+ Label</button>
                }
            </div>

        </div>
    </ChildContent>
    <Composer>
        @if (_assisted)
        {
            <ConversationComposer IsBusy="@_thinking" CanSend="@(!string.IsNullOrWhiteSpace(_input))" Disabled="@_creating"
                                  OnSend="() => ConverseAsync(false)" OnStop="StopIntake">
                <Editor>
                    <textarea id="ticket-intake-input" @ref="_inputRef" aria-label="@L["IntakeMessage"]"
                              placeholder="@L["ChatPlaceholder"]" @bind="_input" @bind:event="oninput"
                              disabled="@(_thinking || _creating)" maxlength="20000"></textarea>
                </Editor>
            </ConversationComposer>
        }
    </Composer>
    <Footer>
        @if (_creationError is not null) { <p role="alert">@_creationError</p> }
        @if (_assisted)
        {
            <label class="ticket-intake-auto"><input type="checkbox" @bind="_autoCreate" disabled="@_thinking" /> @L["IntakeAutoCreate"]</label>
            <button class="tile-config-accept" @onclick="CreateNowAsync" disabled="@(_thinking || _creating || (_messages.Count == 0 && string.IsNullOrWhiteSpace(_input)))">@L["IntakeCreateNow"]</button>
        }
        else
        {
            <button class="tile-config-accept" @onclick="CreateAsync" disabled="@(_thinking || _creating || string.IsNullOrWhiteSpace(_title))">@L["CreateTicket"]</button>
        }
    </Footer>
</ConversationDrawer>
@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public List<BoardColumn> Columns { get; set; } = [];
    [Parameter] public int? SubKanbanParentId { get; set; }
    [Parameter] public int? SelectedPipelineId { get; set; }
    [Parameter] public EventCallback<Ticket?> OnCreated { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private bool _assisted = true, _thinking, _autoCreate = true, _ready, _disposed, _created;
    private string _input = "";
    private readonly List<TicketIntakeMessage> _messages = [];
    private readonly CancellationTokenSource _intakeCts = new();
    private CancellationTokenSource? _turnCts;
    private DotNetObjectReference<BoardCreateTicketDialog>? _self;
    private ElementReference _inputRef;
    private ConversationView? _messagesView;
    private int _renderedMessageCount = -1;
    private bool _wasThinking;
    private string _title = "";
    private string _description = "";
    private TicketPriority _priority = TicketPriority.NiceToHave;
    private List<int> _labelIds = [];
    private List<string> _acceptanceCriteria = [];
    private List<Label> _allLabels = [];
    private bool _showNewLabelForm;
    private string _newLabelName = "";
    private string _newLabelColor = "#6366f1";
    private ElementReference _descTextarea;
    private ElementReference _popup;
    private bool _creating;
    private string? _creationError;
    private string DraftKey => $"kittyclaw.ticket-draft:{Slug}:{SelectedPipelineId}:{SubKanbanParentId}";
    private IDisposable? _escHandle;

    protected override async Task OnInitializedAsync()
    {
        _allLabels = await LabelService.ListLabelsAsync(Slug);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_assisted)
        {
            _self ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("chatDrawerInstallEnterGuard", _inputRef, _self);
                if (_renderedMessageCount != _messages.Count || _wasThinking != _thinking)
                {
                    await JS.InvokeVoidAsync("chatDrawerScrollToBottom", _messagesView?.Element);
                    _renderedMessageCount = _messages.Count;
                    _wasThinking = _thinking;
                }
            }
            catch (JSException ex) { Logger.LogWarning(ex, "Ticket chat initialization failed"); }
        }
        if (firstRender)
        {
            try
            {
                var draft = await JS.InvokeAsync<string[]?>("ticketDraft.attach", _popup, DraftKey);
                if (draft is { Length: 2 })
                {
                    _title = draft[0];
                    _description = draft[1];
                    StateHasChanged();
                }
            }
            catch (Exception ex) { Logger.LogWarning(ex, "Ticket draft initialization failed"); }
            _escHandle = EscapeStack.PushWithFocus(JS,
                () => InvokeAsync(async () => { await OnClosed.InvokeAsync(); }));
            try { await JS.InvokeVoidAsync("attachImagePaste", _descTextarea, "/api/images"); }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Image paste initialization failed");
            }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _escHandle?.Dispose();
        _self?.Dispose();
        _intakeCts.Cancel();
        _intakeCts.Dispose();
    }

    [JSInvokable]
    public Task OnComposerEnter(string text)
    {
        if (_thinking || _creating || _disposed) return Task.CompletedTask;
        _input = text;
        return ConverseAsync(false);
    }

    private void StopIntake() => _turnCts?.Cancel();

    private Task CreateNowAsync() => _ready && string.IsNullOrWhiteSpace(_input)
        ? CreateAsync() : ConverseAsync(true);

    private async Task ConverseAsync(bool createNow)
    {
        if (_disposed || _created || _thinking || _creating || (!createNow && string.IsNullOrWhiteSpace(_input))) return;
        if (!string.IsNullOrWhiteSpace(_input))
        {
            _messages.Add(new("user", _input.Trim()));
            _input = "";
            _ready = false;
        }
        if (_messages.Count == 0) return;
        _thinking = true;
        _creationError = null;
        try
        {
            using var turnCts = CancellationTokenSource.CreateLinkedTokenSource(_intakeCts.Token);
            _turnCts = turnCts;
            var reply = await Intake.ReplyAsync(Slug, _messages.ToArray(), createNow, turnCts.Token);
            if (_disposed) return;
            _messages.Add(new("assistant", reply.Message));
            _ready = reply.Ready;
            if (reply.Ready)
            {
                _title = reply.Title!;
                _description = reply.Description!;
                _labelIds = reply.LabelIds ?? [];
                _acceptanceCriteria = reply.AcceptanceCriteria ?? [];
                if (_autoCreate || createNow) await CreateAsync();
                else _messages.Add(new("assistant", L["IntakeReview"]));
            }
        }
        catch (OperationCanceledException) when (_disposed || _turnCts?.IsCancellationRequested == true) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ticket intake failed for {Project}", Slug);
            _creationError = ex.Message;
        }
        finally { _turnCts = null; _thinking = false; }
    }

    private async Task CloseAsync() => await OnClosed.InvokeAsync();

    private void ToggleLabel(int id)
    {
        if (_labelIds.Contains(id)) _labelIds.Remove(id);
        else _labelIds.Add(id);
    }

    private async Task CreateLabelAsync()
    {
        if (string.IsNullOrWhiteSpace(_newLabelName)) return;
        var label = await LabelService.CreateLabelAsync(Slug, _newLabelName.Trim(), _newLabelColor);
        _allLabels = await LabelService.ListLabelsAsync(Slug);
        _labelIds.Add(label.Id);
        _newLabelName = "";
        _newLabelColor = "#6366f1";
        _showNewLabelForm = false;
    }

    private async Task CreateAsync()
    {
        if (_disposed || _created || _creating || string.IsNullOrWhiteSpace(_title) || Columns.Count == 0) return;
        _creating = true;
        _creationError = null;
        Ticket ticket;
        try
        {
        var status = Columns[0].Name;
        ticket = await TicketService.CreateTicketAsync(
            Slug, _title.Trim(), _description.Trim(),
            status: status,
            labelIds: _labelIds,
            priority: _priority,
            parentId: SubKanbanParentId,
            pipelineId: SelectedPipelineId,
            columnId: Columns[0].Id,
            acceptanceCriteria: _acceptanceCriteria);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Manual ticket creation failed for {Project}", Slug);
            _creationError = ex.GetBaseException().Message.Contains("column_acceptance_criteria_not_validated") ? L["ColumnAcceptanceCriteriaNotValidatedError"] : ex.GetBaseException().Message.Contains("column_acceptance_criteria_required") ? L["ColumnAcceptanceCriteriaRequiredError"] : ex.GetBaseException().Message.Contains("column_capacity_reached") ? L["ColumnCapacityError"] : ex.Message;
            return;
        }
        finally { _creating = false; }
        _created = true;
        try { await JS.InvokeVoidAsync("ticketDraft.clear", DraftKey); }
        catch (Exception ex) { Logger.LogWarning(ex, "Ticket draft cleanup failed"); }
        await OnCreated.InvokeAsync(ticket);
    }

    private string GetPriorityLabel(TicketPriority p) => p switch
    {
        TicketPriority.Idea => L["PriorityIdea"],
        TicketPriority.NiceToHave => L["PriorityNiceToHave"],
        TicketPriority.Required => L["PriorityRequired"],
        TicketPriority.Critical => L["PriorityCritical"],
        _ => p.ToString()
    };

    private static string GetPriorityClass(TicketPriority p) => p switch
    {
        TicketPriority.Idea => "idea",
        TicketPriority.NiceToHave => "nice",
        TicketPriority.Required => "required",
        TicketPriority.Critical => "critical",
        _ => "nice"
    };
}
