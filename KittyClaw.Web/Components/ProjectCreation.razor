@using KittyClaw.Core.Models
@using KittyClaw.Core.Services
@using KittyClaw.Core.Automation
@inject ProjectService ProjectService
@inject RepositoryIntakeService RepositoryIntake
@inject MinimalWorkflowService MinimalWorkflow
@inject FirstRunProviderService FirstRunProvider
@inject AgentsTemplateService AgentsTemplate
@inject LocalizationService L
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject KittyClaw.Web.Services.EscapeKeyStack EscapeStack
@rendermode InteractiveServer
@implements IDisposable

@* Project creation, extracted from Home.razor so every host page shares one flow that
   cannot diverge. A single button opens the modal; the name lives inside the modal. *@
<button class="header-action-btn settings-primary" data-testid="create-project-open" disabled="@(!_interactive)" @onclick="OpenCreation">+ @L["CreateProjectButton"]</button>

@if (_open)
{
    <div class="modal-backdrop">
        <div class="modal-dialog project-creation" role="dialog" aria-modal="true" aria-labelledby="project-creation-title" aria-describedby="project-creation-intro" aria-busy="@_initializing" @onclick:stopPropagation>
            <header class="project-creation-header">
                <h2 id="project-creation-title">@L["CreateProjectButton"]</h2>
                <p id="project-creation-intro">@L["RepositoryIntakeIntro"]</p>
            </header>

            <div class="project-creation-field">
            <label for="new-project-name" class="settings-label">@L["ProjectName"] <span aria-hidden="true">*</span></label>
            <div class="settings-row">
                <input id="new-project-name" class="settings-input" placeholder="@L["NewProjectPlaceholder"]"
                       required autocomplete="off" data-testid="create-project-name"
                       @bind="_newProjectName" @bind:event="oninput" @onkeydown="HandleKeyDown" />
            </div>

            </div>

            <div class="project-creation-field">
            <label for="repository-path" class="settings-label">@L["WorkspacePath"] <span aria-hidden="true">*</span></label>
            <p id="creation-workspace-hint" class="settings-hint">@L["CreationWorkspaceHint"]</p>
            <div class="settings-row">
                <input id="repository-path" required aria-describedby="creation-workspace-hint" class="settings-input" data-testid="create-project-workspace" placeholder="@L["WorkspacePlaceholder"]" @bind="_newWorkspacePath" @bind:event="oninput" @bind:after="OnWorkspaceChanged" />
                <button class="settings-browse" type="button" @onclick="OpenFolderPicker">
                    <span aria-hidden="true">📁</span> @L["Browse"]
                </button>
            </div>

            </div>

            <div class="project-creation-field">
            <label for="first-objective" class="settings-label">@L["FirstObjective"] <span aria-hidden="true">*</span></label>
            <textarea id="first-objective" required rows="4" class="settings-input" placeholder="@L["FirstObjectiveHint"]" @bind="_objective" @bind:event="oninput"></textarea>
            </div>

            @if (!string.IsNullOrWhiteSpace(_newWorkspacePath) && _workspaceExists == false)
            {
                <div class="settings-status settings-status-err">
                    <span>@L["WorkspaceMissing"]</span>
                    <button class="header-action-btn" @onclick="CreateWorkspaceFolder" disabled="@_creatingFolder" style="margin-left:0.75rem">
                        @(_creatingFolder ? "…" : L["CreateFolder"])
                    </button>
                </div>
            }

            @if (_gitWorkspace?.CanInitialize == true)
            {
                <label class="settings-option creation-git-option" data-testid="create-project-git-option">
                    <input type="checkbox" data-testid="create-project-git-init" @bind="_initializeGit" />
                    <span>
                        <strong>@L["CreateGitRepository"]</strong>
                        <small>@L["CreateGitRepositoryHint"]</small>
                    </span>
                </label>
            }

            @if (_creationStatus is not null)
            {
                <div class="settings-status @_creationStatus.Value.css">@_creationStatus.Value.text</div>
            }

            @if (_initConflicts is not null)
            {
                <div class="init-conflict-block">
                    <p><strong>@L["InitializeConfirmTitle"]</strong></p>
                    <p>@L["InitializeConfirmIntro"]</p>
                    <ul class="init-conflict-list">
                        @foreach (var f in _initConflicts)
                        {
                            <li><code>@f</code></li>
                        }
                    </ul>
                    <div class="modal-actions">
                        <button class="header-action-btn" @onclick="() => _initConflicts = null">@L["Cancel"]</button>
                        <button class="header-action-btn" @onclick="() => CreateAndInitialize(false)">@L["InitializeSkip"]</button>
                        <button class="header-action-btn settings-primary" @onclick="() => CreateAndInitialize(true)">@L["InitializeOverwrite"]</button>
                    </div>
                </div>
            }

            <div class="modal-actions">
                <button class="header-action-btn" @onclick="CancelCreation" disabled="@_initializing">@L["Cancel"]</button>
                <button id="validate-repository" class="header-action-btn settings-primary" data-testid="create-project-initialize" @onclick="StartInitialize" disabled="@(_initializing || _initConflicts is not null || string.IsNullOrWhiteSpace(_newProjectName) || string.IsNullOrWhiteSpace(_newWorkspacePath) || string.IsNullOrWhiteSpace(_objective))">
                    @(_initializing ? "…" : L["ValidateRepository"])
                </button>
            </div>
        </div>
    </div>
}

@if (_folderPickerOpen)
{
    <FolderPickerDialog InitialPath="@_newWorkspacePath"
                        OnSelected="SelectWorkspaceFolder"
                        OnCancel="CloseFolderPicker" />
}

@if (_createdProject is not null && _validatedIntake is not null && !_firstTicketConfirmed)
{
    <FirstTicketDraft ProjectSlug="@_createdProject.Slug" Intake="@_validatedIntake" OnConfirmed="FirstTicketConfirmed" />
}
else if (_createdProject is not null)
{
    <WorkflowMigrationWizard ProjectSlug="@_createdProject.Slug"
                             IsProjectOnboarding="true"
                             WorkspaceWasEmpty="@_workspaceWasEmpty"
                             InitialPurpose="@_objective"
                             OnClose="FinishOnboarding" />
}

@if (_providerGuidance is not null)
{
    <div class="modal-backdrop"><div class="modal-dialog" @onclick:stopPropagation>
        <h2>@L["FirstRunProviderTitle"]</h2>
        <div class="settings-status settings-status-err">@_providerGuidance</div>
        <div class="modal-actions"><button id="retry-first-run-provider" class="header-action-btn settings-primary" @onclick="RetryFirstRunAsync">@L["FirstRunProviderRetry"]</button></div>
    </div></div>
}

@code {
    [Parameter] public bool NavigateToProject { get; set; } = true;
    [Parameter] public EventCallback<Project> OnCreated { get; set; }

    private bool _open;
    private string _newProjectName = "";
    private string _newWorkspacePath = "";
    private bool _folderPickerOpen;
    private string _objective = "";
    private string? _journeyId;
    private bool _initializing;
    private bool _creatingFolder;
    private bool? _workspaceExists;
    private List<string>? _initConflicts;
    private (string text, string css)? _creationStatus;
    private IDisposable? _escPending;
    private bool _workspaceWasEmpty;
    private Project? _createdProject;
    private AgentsTemplateService.GitWorkspaceInspection? _gitWorkspace;
    private bool _initializeGit = true;
    private int _workspaceInspectionVersion;
    private RepositoryIntakeState? _validatedIntake;
    private bool _firstTicketConfirmed;
    private int? _firstTicketId;
    private string? _providerGuidance;
    private bool _interactive;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            StateHasChanged();
        }
        if (_open && _escPending is null)
            _escPending = EscapeStack.PushWithFocus(JS, () => InvokeAsync(() => { CancelCreation(); StateHasChanged(); }));
        else if (!_open && _escPending is not null)
        { _escPending.Dispose(); _escPending = null; }
        return Task.CompletedTask;
    }

    private void OpenCreation()
    {
        _open = true;
        _newProjectName = "";
        _newWorkspacePath = "";
        _objective = "";
        _journeyId = null;
        _workspaceExists = null;
        _creationStatus = null;
        _initConflicts = null;
        _gitWorkspace = null;
        _initializeGit = true;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await StartInitialize();
    }

    private async Task OnWorkspaceChanged()
    {
        var inspectionVersion = ++_workspaceInspectionVersion;
        var path = _newWorkspacePath.Trim();
        _workspaceExists = string.IsNullOrEmpty(path) ? null : Directory.Exists(path);
        _initializeGit = true;
        var inspection = _workspaceExists == true
            ? await AgentsTemplateService.InspectGitWorkspaceAsync(path)
            : null;
        if (inspectionVersion == _workspaceInspectionVersion)
            _gitWorkspace = inspection;
    }

    private async Task CreateWorkspaceFolder()
    {
        if (string.IsNullOrWhiteSpace(_newWorkspacePath)) return;
        _creatingFolder = true;
        _creationStatus = null;
        try
        {
            Directory.CreateDirectory(_newWorkspacePath.Trim());
            _workspaceExists = true;
            _creationStatus = (L["FolderCreated"], "settings-status-ok");
            await OnWorkspaceChanged();
        }
        catch (Exception ex)
        {
            _creationStatus = ($"{L["Error"]}: {ex.Message}", "settings-status-err");
        }
        finally { _creatingFolder = false; }
    }

    private void OpenFolderPicker()
    {
        _creationStatus = null;
        _folderPickerOpen = true;
    }

    private async Task SelectWorkspaceFolder(string path)
    {
        _newWorkspacePath = path;
        _folderPickerOpen = false;
        await OnWorkspaceChanged();
    }

    private void CloseFolderPicker() => _folderPickerOpen = false;

    private async Task StartInitialize()
    {
        if (!_open || _initializing) return;
        if (string.IsNullOrWhiteSpace(_newProjectName) || string.IsNullOrWhiteSpace(_newWorkspacePath) || string.IsNullOrWhiteSpace(_objective)) return;
        _initializing = true;
        _creationStatus = null;
        try
        {
            var workspace = _newWorkspacePath.Trim();
            _workspaceWasEmpty = Directory.Exists(workspace) && !Directory.EnumerateFileSystemEntries(workspace).Any();
            var intake = await RepositoryIntake.SelectAndValidateAsync(
                _journeyId, workspace, _objective, initializeGit: _initializeGit);
            _journeyId = intake.JourneyId;
            _validatedIntake = intake;
            _gitWorkspace = await AgentsTemplateService.InspectGitWorkspaceAsync(workspace);
            if (_gitWorkspace?.Kind == AgentsTemplateService.GitWorkspaceKind.GitUnavailable)
            {
                _creationStatus = (L["GitMissingWarning"], "settings-status-err");
            }
            var conflicts = AgentsTemplate.DetectConflicts(workspace);
            if (conflicts.Count == 0)
            {
                await CreateAndInitialize(false);
            }
            else
            {
                _initConflicts = conflicts;
            }
        }
        catch (RepositoryIntakeException ex)
        {
            _journeyId = ex.JourneyId;
            _creationStatus = (L[ex.ErrorCode], "settings-status-err");
        }
        finally { _initializing = false; }
    }

    private async Task CreateAndInitialize(bool overwrite)
    {
        if (!_open || string.IsNullOrWhiteSpace(_newProjectName)) return;
        _initConflicts = null;
        _initializing = true;
        try
        {
            // Validate BEFORE creating: a rejected workspace must not leave a half-created
            // project behind (§2.6 — relative / ".." / drive root / system dirs).
            ProjectService.ValidateWorkspacePath(_newWorkspacePath.Trim());
            var project = await ProjectService.CreateProjectAsync(_newProjectName.Trim());
            await ProjectService.UpdateProjectAsync(project.Slug, _newWorkspacePath.Trim());
            var initializeGit = _gitWorkspace?.CanInitialize == true && _initializeGit;
            await AgentsTemplate.InitializeAsync(_newWorkspacePath.Trim(), overwrite, initializeGit);

            _newProjectName = "";
            _open = false;
            _createdProject = project;
            _firstTicketConfirmed = false;
            await OnCreated.InvokeAsync(project);
        }
        catch (Exception ex)
        {
            _creationStatus = ($"{L["Error"]}: {ex.Message}", "settings-status-err");
        }
        finally { _initializing = false; }
    }

    private void CancelCreation()
    {
        _open = false;
        _folderPickerOpen = false;
        _initConflicts = null;
        _creationStatus = null;
    }

    private Task FinishOnboarding()
    {
        var project = _createdProject;
        _createdProject = null;
        if (NavigateToProject && project is not null)
            Nav.NavigateTo($"/board/{project.Slug}");
        return Task.CompletedTask;
    }

    private async Task FirstTicketConfirmed(int ticketId)
    {
        if (_createdProject is null || _validatedIntake is null) return;
        _firstTicketId = ticketId;
        await StartFirstRunAsync();
    }

    private async Task RetryFirstRunAsync() => await StartFirstRunAsync();

    private async Task StartFirstRunAsync()
    {
        if (_createdProject is null || _validatedIntake is null || _firstTicketId is null) return;
        var plan = await FirstRunProvider.SelectAsync(_validatedIntake.JourneyId);
        if (!plan.Ready) { _providerGuidance = plan.Guidance; return; }
        _providerGuidance = null;
        await ProjectService.UpdateProjectAsync(_createdProject.Slug, _validatedIntake.RepositoryPath,
            plan.Fallback?.Model, updateFallback: true);
        await MinimalWorkflow.EnsureAsync(_createdProject.Slug, _firstTicketId.Value,
            _validatedIntake.JourneyId, plan.Primary!.Model,
            ct => FirstRunProvider.MarkStartedAsync(_validatedIntake.JourneyId, ct));
        _firstTicketConfirmed = true;
    }

    public void Dispose()
    {
        _escPending?.Dispose();
    }

}
