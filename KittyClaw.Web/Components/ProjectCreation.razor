@using KittyClaw.Core.Models
@using KittyClaw.Core.Services
@using KittyClaw.Core.Automation
@inject ProjectService ProjectService
@inject AgentsTemplateService AgentsTemplate
@inject AutomationEngine AutomationEngine
@inject MemberService MemberService
@inject LocalizationService L
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject KittyClaw.Web.Services.EscapeKeyStack EscapeStack
@rendermode InteractiveServer
@implements IDisposable

@* Project creation, extracted from Home.razor so every host page shares one flow that
   cannot diverge. A single button opens the modal; the name lives inside the modal. *@
<button class="header-action-btn settings-primary" data-testid="create-project-open" @onclick="OpenCreation">+ @L["CreateProjectButton"]</button>

@if (_open)
{
    <div class="modal-backdrop">
        <div class="modal-dialog" @onclick:stopPropagation>
            <h2>@L["CreateProjectButton"]</h2>
            <p>@L["CreationSetupIntro"]</p>
            <p class="settings-hint">After initialization, you will define the project's pipelines, columns, processors and skills.</p>

            <label class="settings-label">@L["ProjectName"] *</label>
            <div class="settings-row">
                <input class="settings-input" placeholder="@L["NewProjectPlaceholder"]"
                       data-testid="create-project-name"
                       @bind="_newProjectName" @bind:event="oninput" @onkeydown="HandleKeyDown" />
            </div>

            <label class="settings-label">@L["WorkspacePath"] *</label>
            <p class="settings-hint">@L["WorkspaceHint"]</p>
            <div class="settings-row">
                <input class="settings-input" data-testid="create-project-workspace" placeholder="@L["WorkspacePlaceholder"]" @bind="_newWorkspacePath" @bind:event="oninput" @bind:after="OnWorkspaceChanged" />
                <button class="settings-browse" type="button" @onclick="OpenFolderPicker">
                    📁 @L["Browse"]
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_newWorkspacePath) && _workspaceExists == false)
            {
                <div class="settings-status settings-status-err">
                    <span>@L["WorkspaceMissing"]</span>
                    <button class="header-action-btn" @onclick="CreateWorkspaceFolder" disabled="@_creatingFolder" style="margin-left:0.75rem">
                        @(_creatingFolder ? "…" : L["CreateFolder"])
                    </button>
                </div>
            }

            @if (_gitWorkspace?.CanInitialize == true)
            {
                <label class="settings-option creation-git-option" data-testid="create-project-git-option">
                    <input type="checkbox" data-testid="create-project-git-init" @bind="_initializeGit" />
                    <span>
                        <strong>@L["CreateGitRepository"]</strong>
                        <small>@L["CreateGitRepositoryHint"]</small>
                    </span>
                </label>
            }

            @if (_creationStatus is not null)
            {
                <div class="settings-status @_creationStatus.Value.css">@_creationStatus.Value.text</div>
            }

            @if (_initConflicts is not null)
            {
                <div class="init-conflict-block">
                    <p><strong>@L["InitializeConfirmTitle"]</strong></p>
                    <p>@L["InitializeConfirmIntro"]</p>
                    <ul class="init-conflict-list">
                        @foreach (var f in _initConflicts)
                        {
                            <li><code>@f</code></li>
                        }
                    </ul>
                    <div class="modal-actions">
                        <button class="header-action-btn" @onclick="() => _initConflicts = null">@L["Cancel"]</button>
                        <button class="header-action-btn" @onclick="() => CreateAndInitialize(false)">@L["InitializeSkip"]</button>
                        <button class="header-action-btn settings-primary" @onclick="() => CreateAndInitialize(true)">@L["InitializeOverwrite"]</button>
                    </div>
                </div>
            }

            <div class="modal-actions">
                <button class="header-action-btn" @onclick="CancelCreation" disabled="@_initializing">@L["Cancel"]</button>
                <button class="header-action-btn settings-primary" data-testid="create-project-initialize" @onclick="StartInitialize" disabled="@(_initializing || _initConflicts is not null || string.IsNullOrWhiteSpace(_newProjectName) || string.IsNullOrWhiteSpace(_newWorkspacePath) || _workspaceExists != true)">
                    @(_initializing ? "…" : L["Initialize"])
                </button>
            </div>
        </div>
    </div>
}

@if (_folderPickerOpen)
{
    <FolderPickerDialog InitialPath="@_newWorkspacePath"
                        OnSelected="SelectWorkspaceFolder"
                        OnCancel="CloseFolderPicker" />
}

@if (_createdProject is not null)
{
    <WorkflowMigrationWizard ProjectSlug="@_createdProject.Slug"
                             IsProjectOnboarding="true"
                             WorkspaceWasEmpty="@_workspaceWasEmpty"
                             OnClose="FinishOnboarding" />
}

@code {
    [Parameter] public bool NavigateToProject { get; set; } = true;
    [Parameter] public EventCallback<Project> OnCreated { get; set; }

    private bool _open;
    private string _newProjectName = "";
    private string _newWorkspacePath = "";
    private bool _folderPickerOpen;
    private bool _initializing;
    private bool _creatingFolder;
    private bool? _workspaceExists;
    private List<string>? _initConflicts;
    private (string text, string css)? _creationStatus;
    private IDisposable? _escPending;
    private bool _workspaceWasEmpty;
    private Project? _createdProject;
    private AgentsTemplateService.GitWorkspaceInspection? _gitWorkspace;
    private bool _initializeGit = true;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open && _escPending is null)
            _escPending = EscapeStack.PushWithFocus(JS, () => InvokeAsync(() => { CancelCreation(); StateHasChanged(); }));
        else if (!_open && _escPending is not null)
        { _escPending.Dispose(); _escPending = null; }
        return Task.CompletedTask;
    }

    private void OpenCreation()
    {
        _open = true;
        _newProjectName = "";
        _newWorkspacePath = "";
        _workspaceExists = null;
        _creationStatus = null;
        _initConflicts = null;
        _gitWorkspace = null;
        _initializeGit = true;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await StartInitialize();
    }

    private async Task OnWorkspaceChanged()
    {
        var path = _newWorkspacePath.Trim();
        _workspaceExists = string.IsNullOrEmpty(path) ? null : Directory.Exists(path);
        _initializeGit = true;
        _gitWorkspace = _workspaceExists == true
            ? await AgentsTemplateService.InspectGitWorkspaceAsync(path)
            : null;
    }

    private async Task CreateWorkspaceFolder()
    {
        if (string.IsNullOrWhiteSpace(_newWorkspacePath)) return;
        _creatingFolder = true;
        _creationStatus = null;
        try
        {
            Directory.CreateDirectory(_newWorkspacePath.Trim());
            _workspaceExists = true;
            _creationStatus = (L["FolderCreated"], "settings-status-ok");
            await OnWorkspaceChanged();
        }
        catch (Exception ex)
        {
            _creationStatus = ($"{L["Error"]}: {ex.Message}", "settings-status-err");
        }
        finally { _creatingFolder = false; }
    }

    private void OpenFolderPicker()
    {
        _creationStatus = null;
        _folderPickerOpen = true;
    }

    private async Task SelectWorkspaceFolder(string path)
    {
        _newWorkspacePath = path;
        _folderPickerOpen = false;
        await OnWorkspaceChanged();
    }

    private void CloseFolderPicker() => _folderPickerOpen = false;

    private async Task StartInitialize()
    {
        if (!_open || _initializing) return;
        if (string.IsNullOrWhiteSpace(_newProjectName) || string.IsNullOrWhiteSpace(_newWorkspacePath) || _workspaceExists != true) return;
        _initializing = true;
        _creationStatus = null;
        try
        {
            var workspace = _newWorkspacePath.Trim();
            _workspaceWasEmpty = !Directory.EnumerateFileSystemEntries(workspace).Any();
            await OnWorkspaceChanged();
            if (_gitWorkspace?.Kind == AgentsTemplateService.GitWorkspaceKind.GitUnavailable)
            {
                _creationStatus = (L["GitMissingWarning"], "settings-status-err");
            }
            var conflicts = AgentsTemplate.DetectConflicts(workspace);
            if (conflicts.Count == 0)
            {
                await CreateAndInitialize(false);
            }
            else
            {
                _initConflicts = conflicts;
            }
        }
        finally { _initializing = false; }
    }

    private async Task CreateAndInitialize(bool overwrite)
    {
        if (!_open || string.IsNullOrWhiteSpace(_newProjectName)) return;
        _initConflicts = null;
        _initializing = true;
        try
        {
            // Validate BEFORE creating: a rejected workspace must not leave a half-created
            // project behind (§2.6 — relative / ".." / drive root / system dirs).
            ProjectService.ValidateWorkspacePath(_newWorkspacePath.Trim());
            var project = await ProjectService.CreateProjectAsync(_newProjectName.Trim());
            await ProjectService.UpdateProjectAsync(project.Slug, _newWorkspacePath.Trim());
            var initializeGit = _gitWorkspace?.CanInitialize == true && _initializeGit;
            await AgentsTemplate.InitializeAsync(_newWorkspacePath.Trim(), overwrite, initializeGit);
            await EnsureAgentMembersAsync(project.Slug);
            await AutomationEngine.ReloadProjectAsync(project.Slug);

            _newProjectName = "";
            _open = false;
            _createdProject = project;
            await OnCreated.InvokeAsync(project);
        }
        catch (Exception ex)
        {
            _creationStatus = ($"{L["Error"]}: {ex.Message}", "settings-status-err");
        }
        finally { _initializing = false; }
    }

    private void CancelCreation()
    {
        _open = false;
        _folderPickerOpen = false;
        _initConflicts = null;
        _creationStatus = null;
    }

    private Task FinishOnboarding()
    {
        var project = _createdProject;
        _createdProject = null;
        if (NavigateToProject && project is not null)
            Nav.NavigateTo($"/board/{project.Slug}");
        return Task.CompletedTask;
    }

    private async Task EnsureAgentMembersAsync(string projectSlug)
    {
        foreach (var slug in AgentsTemplate.AgentSlugs())
        {
            if (!await MemberService.MemberExistsAsync(projectSlug, slug))
                await MemberService.CreateMemberAsync(projectSlug, slug);
        }
    }

    public void Dispose()
    {
        _escPending?.Dispose();
    }

}
