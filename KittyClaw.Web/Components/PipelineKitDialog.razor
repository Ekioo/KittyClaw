@using System.IO.Compression
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using KittyClaw.Core.Models
@using KittyClaw.Core.Services
@using Microsoft.AspNetCore.Components.Forms
@inject PipelineExportService Exporter
@inject PipelineImportService Importer
@inject IJSRuntime JS
@inject LocalizationService L

<div class="pipeline-kit-overlay" @onclick="CloseAsync"><section class="pipeline-kit-dialog" role="dialog" aria-modal="true" aria-labelledby="pipeline-kit-title" tabindex="-1" @ref="_dialog" @onkeydown="HandleKeyDown" @onclick:stopPropagation>
<header><div><span class="pipeline-kit-kicker">@L["PipelineKitKicker"]</span><h2 id="pipeline-kit-title">@L["PipelineKitTitle"]</h2></div><button class="dialog-close" @onclick="CloseAsync" aria-label="@L["Close"]">&times;</button></header>
<nav class="pipeline-kit-tabs" aria-label="@L["PipelineKitTitle"]"><button data-testid="pipeline-kit-export-tab" class="@(_mode == KitMode.Export ? "active" : "")" @onclick="() => SetMode(KitMode.Export)">@L["PipelineKitExport"]</button><button data-testid="pipeline-kit-import-tab" class="@(_mode == KitMode.Import ? "active" : "")" @onclick="() => SetMode(KitMode.Import)">@L["PipelineKitImport"]</button></nav>
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="pipeline-kit-alert danger" role="alert">@_error</div> }
@if (_mode == KitMode.Export) { @ExportPanel() } else { @ImportPanel() }
</section></div>

@code {
    [Parameter, EditorRequired] public string ProjectSlug { get; set; } = "";
    [Parameter] public int? PipelineId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<PipelineImportResult> OnImported { get; set; }
    private enum KitMode { Export, Import }
    private KitMode _mode; private bool _busy; private string? _error; private byte[]? _kit; private string _fileName = "pipeline.kittyclaw-pipeline";
    private PipelineKitManifest? _manifest; private PortablePipeline? _portable; private readonly List<KitTextFile> _textFiles = [];
    private ElementReference _dialog; private bool _focusPending = true;
    private PipelineImportPreview? _preview; private PipelineImportResult? _result; private string _pipelineName = "";
    private readonly Dictionary<string, string> _skillRenames = new(StringComparer.Ordinal); private readonly Dictionary<string, string> _parameters = new(StringComparer.Ordinal); private readonly Dictionary<string, string> _secretBindings = new(StringComparer.Ordinal); private readonly HashSet<string> _approvals = new(StringComparer.Ordinal);

    private RenderFragment ExportPanel() => @<div class="pipeline-kit-body">
    @if (_manifest is null) { <div class="pipeline-kit-empty"><p>@L["PipelineKitExportHint"]</p><button data-testid="review-pipeline-export" class="settings-primary" disabled="@(_busy || PipelineId is null)" @onclick="ReviewExportAsync">@(_busy ? L["PipelineKitReviewing"] : L["PipelineKitReviewExport"])</button></div> }
    else { <div class="pipeline-kit-alert safe">@L["PipelineKitExportSafe"]</div>@KitSummary(_manifest.Metadata.Name, _manifest.Metadata.Slug, _manifest.FormatVersion, _manifest.Provenance.Generator + " " + _manifest.Provenance.GeneratorVersion, _manifest.Files.Count)
    <h3>@L["PipelineKitTextReview"]</h3>
    @if (_portable is not null) { @foreach (var column in _portable.Columns) { <details class="pipeline-kit-detail"><summary>@column.Name — @(column.Processor?.Name ?? L["PipelineKitNoProcessor"])</summary><dl><dt>@L["PipelineKitGuidance"]</dt><dd><pre>@column.UserGuidance</pre></dd>@if (column.Processor is not null) { <dt>@L["PipelineKitMission"]</dt><dd><pre>@column.Processor.Mission</pre></dd><dt>Prompt</dt><dd><pre>@column.Processor.Prompt</pre></dd><dt>@L["PipelineKitActions"]</dt><dd><pre>@JsonSerializer.Serialize(new { column.Processor.BeforeActions, column.Processor.AfterActions }, JsonOptions)</pre></dd> }</dl></details> } }
    @foreach (var file in _textFiles) { <details class="pipeline-kit-detail"><summary>@file.Path</summary><pre>@file.Content</pre></details> }
    <footer><button data-testid="cancel-pipeline-export" @onclick="Reset">@L["Cancel"]</button><button data-testid="download-pipeline-kit" class="settings-primary" disabled="@_busy" @onclick="DownloadAsync">@L["PipelineKitDownload"]</button></footer> }
    </div>;

    private RenderFragment ImportPanel() => @<div class="pipeline-kit-body">
    @if (_preview is null && _result is null) { <label class="pipeline-kit-drop @(_busy ? "disabled" : "")"><strong>@(_busy ? L["PipelineKitAnalyzing"] : L["PipelineKitChooseFile"])</strong><span>@L["PipelineKitChooseHint"]</span><InputFile OnChange="AnalyzeImportAsync" accept=".kittyclaw-pipeline,application/zip" disabled="@_busy" /></label> }
    else if (_result is not null) { <div class="pipeline-kit-alert @(_result.Enabled ? "safe" : "warning")"><strong>@L["PipelineKitImported"]</strong><br />@_result.PipelineName — @(_result.Enabled ? L["PipelineKitEnabled"] : L["PipelineKitDisabled"])</div>@if (_result.DisabledReasons.Count > 0) { <h3>@L["PipelineKitMissingActivation"]</h3><ul>@foreach (var reason in _result.DisabledReasons) { <li>@reason</li> }</ul> }<p>@_result.Columns.Count @L["PipelineKitColumnsCreated"], @_result.SkillsCreated.Count @L["PipelineKitSkillsCreated"].</p><footer><button class="settings-primary" @onclick="CloseAsync">@L["Close"]</button></footer> }
    else if (_preview is not null) {
    @if (_preview.Blockages.Count > 0) { <div class="pipeline-kit-alert danger"><strong>@L["PipelineKitRejected"]</strong><ul>@foreach (var issue in _preview.Blockages) { <li><code>@issue.Path</code> — @issue.Message</li> }</ul></div> }
    @KitSummary(_preview.PipelineName, _preview.PipelineSlug, _preview.FormatVersion, _manifest is null ? L["PipelineKitVerifiedArchive"] : $"{_manifest.Provenance.Generator} {_manifest.Provenance.GeneratorVersion} · {_manifest.Provenance.ProjectSlug} · {_manifest.Provenance.ExportedAt}", _preview.Files.Count)
    <section class="pipeline-kit-grid"><div><h3>@L["PipelineKitInventory"]</h3><ul>@foreach (var file in _preview.Files) { <li><code>@file.Path</code><small>@file.Bytes octets · SHA-256 @file.Sha256 · @(file.Verified ? L["PipelineKitVerified"] : L["PipelineKitUnverified"])</small></li> }</ul></div><div><h3>@L["PipelineKitCreation"]</h3><p>@_preview.Creation.ColumnsToCreate @L["PipelineKitColumnsCreated"], @_preview.Creation.ProcessorsToCreate @L["PipelineKitProcessorsCreated"]</p><ul>@foreach (var column in _preview.Columns) { <li>@column.Name <small>@column.Role · @string.Join(", ", column.ActionTypes)</small></li> }@foreach (var skill in _preview.Skills) { <li><code>@skill.Slug</code><small>@skill.Resolution · SHA-256 @skill.Fingerprint</small></li> }@foreach (var model in _preview.Models) { <li>@model.Name <small>@(model.Available ? L["PipelineKitVerified"] : L["PipelineKitVaultMissing"])</small></li> }@foreach (var agent in _preview.Agents) { <li>@agent.Name <small>@(agent.Available ? L["PipelineKitVerified"] : L["PipelineKitVaultMissing"])</small></li> }</ul></div></section>
    @if (_preview.PipelineNameConflict) { <label>@L["PipelineKitRenamePipeline"]<input data-testid="pipeline-kit-pipeline-rename" class="settings-input" @bind="_pipelineName" /></label> }
    @foreach (var skill in _preview.Skills.Where(s => s.Resolution == PipelineImportSkillResolution.RenameRequired)) { <label>@L["PipelineKitRenameSkill"] <code>@skill.Slug</code><input data-testid="pipeline-kit-skill-rename" class="settings-input" value="@_skillRenames.GetValueOrDefault(skill.Slug)" @oninput="e => _skillRenames[skill.Slug] = e.Value?.ToString() ?? string.Empty" /></label> }
    @if (_preview.Parameters.Count > 0) { <h3>@L["PipelineKitParameters"]</h3>@foreach (var item in _preview.Parameters) { <label>@item.Name <small>@item.Occurrences occurrence(s)</small><input data-testid="pipeline-kit-parameter" class="settings-input" value="@_parameters.GetValueOrDefault(item.Name)" @oninput="e => _parameters[item.Name] = e.Value?.ToString() ?? string.Empty" /></label> } }
    @if (_preview.Secrets.Count > 0) { <h3>@L["PipelineKitVaultBindings"]</h3><p class="settings-hint">@L["PipelineKitSecretHint"]</p>@foreach (var item in _preview.Secrets) { <label>@item.Name <small>@(item.VaultSecretExists ? L["PipelineKitVaultExists"] : L["PipelineKitVaultMissing"])</small><input data-testid="pipeline-kit-secret-binding" type="password" autocomplete="new-password" class="settings-input" value="@_secretBindings.GetValueOrDefault(item.Name)" @oninput="e => _secretBindings[item.Name] = e.Value?.ToString() ?? string.Empty" /></label> } }
    @if (_preview.RequiredApprovals.Count > 0) { <h3>@L["PipelineKitApprovals"]</h3><p class="settings-hint">@L["PipelineKitApprovalHint"]</p>@foreach (var approval in _preview.RequiredApprovals) { <label class="pipeline-kit-approval"><input type="checkbox" checked="@_approvals.Contains(approval)" @onchange="e => SetApproval(approval, (bool)(e.Value ?? false))" /><span><strong>@approval</strong><small>@ApprovalDescription(approval)</small></span></label> } }
    @if (_portable is not null) { @foreach (var column in _portable.Columns.Where(c => c.Processor is not null)) { <details class="pipeline-kit-detail"><summary>@column.Name — @L["PipelineKitActions"]</summary><pre>@JsonSerializer.Serialize(new { column.Processor!.BeforeActions, column.Processor.AfterActions }, JsonOptions)</pre></details> } }
    @foreach (var file in _textFiles) { <details class="pipeline-kit-detail"><summary>@file.Path</summary><pre>@file.Content</pre></details> }
    <div class="pipeline-kit-alert warning">@ActivationMessage()</div><footer><button data-testid="cancel-pipeline-import" disabled="@_busy" @onclick="Reset">@L["Cancel"]</button><button data-testid="confirm-pipeline-import" class="settings-primary" disabled="@(!CanConfirm || _busy)" @onclick="ConfirmImportAsync">@(_busy ? L["PipelineKitInstalling"] : L["PipelineKitConfirm"])</button></footer> }
    </div>;

    private RenderFragment KitSummary(string name, string slug, int version, string provenance, int files) => @<section class="pipeline-kit-summary"><div><small>@L["PipelineKitName"]</small><strong>@name</strong></div><div><small>@L["PipelineKitStableKey"]</small><code>@slug</code></div><div><small>@L["PipelineKitCompatibility"]</small><strong>@($"v{version}")</strong></div><div><small>@L["PipelineKitProvenance"]</small><strong>@provenance</strong></div><div><small>@L["PipelineKitFiles"]</small><strong>@files</strong></div></section>;
    private static readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = true, PropertyNameCaseInsensitive = true, Converters = { new JsonStringEnumConverter() } };
    private bool CanConfirm => _preview is { Installable: true } && (!_preview.PipelineNameConflict || !string.IsNullOrWhiteSpace(_pipelineName)) && _preview.Skills.Where(s => s.Resolution == PipelineImportSkillResolution.RenameRequired).All(s => !string.IsNullOrWhiteSpace(_skillRenames.GetValueOrDefault(s.Slug)));
    private async Task ReviewExportAsync() { if (PipelineId is null) return; _busy = true; _error = null; try { var kit = await Exporter.ExportAsync(ProjectSlug, PipelineId.Value); if (kit is null) throw new InvalidOperationException(L["PipelineKitNotFound"]); _kit = kit.Content; _fileName = kit.FileName; ReadKit(_kit); } catch (PipelineExportBlockedException ex) { _error = L["PipelineKitExportBlocked"] + " " + string.Join(" ", ex.Findings.Select(f => $"{f.Path}:{f.Line} — {f.Guidance}")); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private async Task AnalyzeImportAsync(InputFileChangeEventArgs e) { _busy = true; _error = null; ResetData(); try { await using var stream = e.File.OpenReadStream(25 * 1024 * 1024); using var memory = new MemoryStream(); await stream.CopyToAsync(memory); _kit = memory.ToArray(); _fileName = e.File.Name; _preview = await Importer.AnalyzeAsync(ProjectSlug, _kit) ?? throw new InvalidOperationException(L["PipelineKitNotFound"]); ReadKit(_kit); _pipelineName = _preview.PipelineName; } catch (PipelineImportRejectedException ex) { _error = ex.Message + " " + string.Join(" ", ex.Issues.Select(i => $"{i.Path} — {i.Message}")); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private async Task ConfirmImportAsync() { if (_kit is null || !CanConfirm || _busy) return; _busy = true; _error = null; try { _result = await Importer.InstallAsync(ProjectSlug, _kit, new PipelineImportConfirmation { PipelineName = _preview!.PipelineNameConflict ? _pipelineName : null, SkillRenames = new(_skillRenames, StringComparer.Ordinal), Parameters = new(_parameters, StringComparer.Ordinal), SecretBindings = new(_secretBindings, StringComparer.Ordinal), Approvals = [.. _approvals] }) ?? throw new InvalidOperationException(L["PipelineKitNotFound"]); await OnImported.InvokeAsync(_result); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private void ReadKit(byte[] bytes) { using var zip = new ZipArchive(new MemoryStream(bytes), ZipArchiveMode.Read); _manifest = ReadJson<PipelineKitManifest>(zip, PipelineKitFormat.ManifestEntryName); _portable = ReadJson<PortablePipeline>(zip, PipelineKitFormat.PipelineEntryName); ReadTextFiles(bytes); }
    private void ReadTextFiles(byte[] bytes) { _textFiles.Clear(); using var zip = new ZipArchive(new MemoryStream(bytes), ZipArchiveMode.Read); foreach (var entry in zip.Entries.Where(e => e.FullName.StartsWith("skills/", StringComparison.Ordinal) || e.FullName.EndsWith(".ps1", StringComparison.OrdinalIgnoreCase) || e.FullName.EndsWith(".sh", StringComparison.OrdinalIgnoreCase))) { using var reader = new StreamReader(entry.Open(), Encoding.UTF8, true); _textFiles.Add(new(entry.FullName, reader.ReadToEnd())); } }
    private static T? ReadJson<T>(ZipArchive zip, string path) { var entry = zip.GetEntry(path); if (entry is null) return default; using var stream = entry.Open(); return JsonSerializer.Deserialize<T>(stream, JsonOptions); }
    private async Task DownloadAsync() { if (_kit is not null) await JS.InvokeVoidAsync("kittyClaw.downloadBase64", _fileName, "application/zip", Convert.ToBase64String(_kit)); }
    private void SetApproval(string key, bool enabled) { if (enabled) _approvals.Add(key); else _approvals.Remove(key); }
    private string ApprovalDescription(string key) => key switch { "executePowerShell" => L["PipelineKitPowerShellApproval"], "httpRequest" => L["PipelineKitNetworkApproval"], "embeddedScripts" => L["PipelineKitScriptsApproval"], _ => L["PipelineKitGenericApproval"] };
    private string ActivationMessage() { var missing = new List<string>(); missing.AddRange(_preview!.Parameters.Where(p => string.IsNullOrWhiteSpace(_parameters.GetValueOrDefault(p.Name))).Select(p => p.Name)); missing.AddRange(_preview.Secrets.Where(s => !s.VaultSecretExists && string.IsNullOrWhiteSpace(_secretBindings.GetValueOrDefault(s.Name))).Select(s => s.Name)); missing.AddRange(_preview.RequiredApprovals.Where(a => !_approvals.Contains(a))); return missing.Count == 0 ? L["PipelineKitReadyActivation"] : L["PipelineKitDisabledBecause"] + " " + string.Join(", ", missing); }
    private void SetMode(KitMode mode) { if (!_busy) { _mode = mode; Reset(); } } private void Reset() { _error = null; ResetData(); }
    private void ResetData() { _kit = null; _manifest = null; _portable = null; _preview = null; _result = null; _textFiles.Clear(); _skillRenames.Clear(); _parameters.Clear(); _secretBindings.Clear(); _approvals.Clear(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (_focusPending) { _focusPending = false; await _dialog.FocusAsync(); } }
    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape" && !_busy) await CloseAsync(); }
    private Task CloseAsync() => OnClose.InvokeAsync(); private sealed record KitTextFile(string Path, string Content);
}
