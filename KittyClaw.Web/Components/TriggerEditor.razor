@using KittyClaw.Core.Automation
@inject LocalizationService L

<div class="node-editor">
    <label>@L["Type"]
        <select value="@CurrentType" @onchange="OnTypeChanged">
            <option value="interval">@L["TrigTypeInterval"]</option>
            <option value="ticketInColumn">@L["TrigTypeTicketInColumn"]</option>
            <option value="gitCommit">@L["TrigTypeGitCommit"]</option>
            <option value="statusChange">@L["TrigTypeStatusChange"]</option>
            <option value="subTicketStatus">@L["TrigTypeSubTickets"]</option>
            <option value="boardIdle">@L["TrigTypeBoardIdle"]</option>
            <option value="agentInactivity">@L["TrigTypeAgentInactivity"]</option>
            <option value="ticketCommentAdded">@L["TrigTypeCommentAdded"]</option>
        </select>
    </label>

    @switch (Automation.Trigger)
    {
        case IntervalTriggerSpec s:
        {
            var sched = ScheduleModel.Resolve(s);
            <label>@L["ScheduleFrequency"]
                <select value="@sched.Mode.ToString()" @onchange="e => ApplySchedule(s, ChangeMode(sched, (string)e.Value!))">
                    <option value="@ScheduleMode.EveryMinutes">@L["FreqEveryMinutes"]</option>
                    <option value="@ScheduleMode.EveryHours">@L["FreqEveryHours"]</option>
                    <option value="@ScheduleMode.Scheduled">@L["FreqScheduled"]</option>
                </select>
            </label>

            @if (sched.Mode == ScheduleMode.EveryMinutes)
            {
                <label>@L["RepeatEveryLabel"] (@L["MinutesUnit"])
                    <input type="number" min="1" max="59" value="@sched.N"
                           @onchange="e => ApplySchedule(s, sched with { N = ParseIntOr(e.Value, sched.N) })" />
                </label>
            }
            else if (sched.Mode == ScheduleMode.EveryHours)
            {
                <label>@L["RepeatEveryLabel"] (@L["HoursUnit"])
                    <input type="number" min="1" max="23" value="@sched.N"
                           @onchange="e => ApplySchedule(s, sched with { N = ParseIntOr(e.Value, sched.N) })" />
                </label>
            }
            else
            {
                <div class="weekday-picker">
                    @foreach (var day in WeekdayDisplayOrder)
                    {
                        var d = day;
                        <label class="weekday-check">
                            <input type="checkbox" checked="@(sched.Days.Count == 0 || sched.Days.Contains(d))"
                                   @onchange="e => ApplySchedule(s, ToggleDay(sched, d, (bool)e.Value!))" />
                            <span>@L[$"Weekday{d}"]</span>
                        </label>
                    }
                </div>
                <div class="time-list">
                    <label class="time-row">@L["AtTime"]
                        <input type="time" value="@FormatTime(sched.Minute, sched.Hours.ElementAtOrDefault(0))"
                               @onchange="e => ApplySchedule(s, SetPrimaryTime(sched, (string?)e.Value))" />
                    </label>
                    @for (var i = 1; i < sched.Hours.Count; i++)
                    {
                        var idx = i;
                        <div class="time-row">
                            <label>@L["AndAlsoAt"]
                                <select value="@sched.Hours[idx]" @onchange="e => ApplySchedule(s, SetHourAt(sched, idx, (string?)e.Value))">
                                    @for (var h = 0; h < 24; h++)
                                    {
                                        var hh = h;
                                        <option value="@hh">@FormatTime(sched.Minute, hh)</option>
                                    }
                                </select>
                            </label>
                            <button type="button" class="icon-btn" title="@L["RemoveTime"]" @onclick="() => ApplySchedule(s, RemoveTime(sched, idx))">🗑</button>
                        </div>
                    }
                    <button type="button" class="link-btn" @onclick="() => ApplySchedule(s, AddTime(sched))">+ @L["AddTime"]</button>
                </div>
            }
            break;
        }

        case TicketInColumnTriggerSpec s:
            <label>@L["PollSeconds"]
                <input type="number" @bind="s.Seconds" />
            </label>
            <div class="column-picker">
                <div class="column-picker-label">@L["ColumnsOneOrMore"]</div>
                @foreach (var c in Columns)
                {
                    var col = c;
                    <label class="column-check"><input type="checkbox" checked="@s.Columns.Contains(col)"
                               @onchange="e => ToggleColumn(s.Columns, col, (bool)e.Value!)" /><span>@col</span></label>
                }
            </div>
            <label>@L["AssigneeMemberOptional"]
                <select value="@(s.AssigneeSlug ?? "")" @onchange="e => s.AssigneeSlug = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">@L["AnyMemberOption"]</option>
                    @foreach (var sk in Skills) { <option value="@sk">@sk</option> }
                </select>
            </label>
            <label>@L["DebounceSeconds"]
                <input type="number" @bind="s.DebounceSeconds" />
            </label>
            break;

        case GitCommitTriggerSpec s:
            <label>@L["PollSeconds"]
                <input type="number" @bind="s.PollSeconds" />
            </label>
            <label>@L["IgnoreAuthorsHint"]
                <input placeholder="noreply@anthropic.com, bot@example.com" value="@string.Join(", ", s.IgnoreAuthors)"
                       @onchange="e => ParseIgnoreAuthors(s, (string?)e.Value)" />
            </label>
            break;

        case StatusChangeTriggerSpec s:
            <label>@L["PollSeconds"]
                <input type="number" @bind="s.PollSeconds" />
            </label>
            <label>@L["FromOptional"]
                <select value="@(s.From ?? "")" @onchange="e => s.From = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">@L["AnyOption"]</option>
                    @foreach (var c in Columns) { <option value="@c">@c</option> }
                </select>
            </label>
            <label>@L["ToOptional"]
                <select value="@(s.To ?? "")" @onchange="e => s.To = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">@L["AnyOption"]</option>
                    @foreach (var c in Columns) { <option value="@c">@c</option> }
                </select>
            </label>
            <label>@L["DebounceSeconds"]
                <input type="number" value="@(s.DebounceSeconds?.ToString() ?? "")"
                       @onchange="e => s.DebounceSeconds = int.TryParse((string?)e.Value, out var v) ? v : null" />
            </label>
            break;

        case SubTicketStatusTriggerSpec s:
            <label>@L["PollSeconds"]
                <input type="number" @bind="s.PollSeconds" />
            </label>
            <label>@L["ParentColumnOptional"]
                <select value="@(s.ParentColumn ?? "")" @onchange="e => s.ParentColumn = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">@L["AllColumns"]</option>
                    @foreach (var c in Columns) { <option value="@c">@c</option> }
                </select>
            </label>
            <label>@L["DebounceSeconds"]
                <input type="number" value="@(s.DebounceSeconds?.ToString() ?? "")"
                       @onchange="e => s.DebounceSeconds = int.TryParse((string?)e.Value, out var v) ? v : null" />
            </label>
            break;

        case BoardIdleTriggerSpec s:
            <label>@L["PollSeconds"]
                <input type="number" @bind="s.PollSeconds" />
            </label>
            <div class="column-picker">
                <div class="column-picker-label">@L["IdleColumnsHint"]</div>
                @foreach (var c in Columns)
                {
                    var col = c;
                    <label class="column-check">
                        <input type="checkbox" checked="@s.IdleColumns.Contains(col)"
                               @onchange="e => ToggleColumn(s.IdleColumns, col, (bool)e.Value!)" />
                        <span>@col</span>
                    </label>
                }
            </div>
            break;

        case AgentInactivityTriggerSpec s:
            <label>@L["PollSeconds"]
                <input type="number" @bind="s.PollSeconds" />
            </label>
            <label>@L["InactivityMinutes"]
                <input type="number" @bind="s.MinutesIdle" />
            </label>
            break;

        case TicketCommentAddedTriggerSpec s:
            <label>@L["PollSeconds"]
                <input type="number" @bind="s.PollSeconds" />
            </label>
            <label>@L["AuthorsFilterHint"]
                <input placeholder="owner, programmer" value="@string.Join(", ", s.Authors)"
                       @onchange="e => ParseAuthors(s, (string?)e.Value)" />
            </label>
            break;
    }
</div>

@code {
    [Parameter] public Automation Automation { get; set; } = default!;
    [Parameter] public List<string> Skills { get; set; } = new();
    [Parameter] public List<string> Columns { get; set; } = new();
    [Parameter] public EventCallback<TriggerSpec> OnReplace { get; set; }

    private string CurrentType => Automation.Trigger switch
    {
        IntervalTriggerSpec => "interval",
        TicketInColumnTriggerSpec => "ticketInColumn",
        GitCommitTriggerSpec => "gitCommit",
        StatusChangeTriggerSpec => "statusChange",
        SubTicketStatusTriggerSpec => "subTicketStatus",
        BoardIdleTriggerSpec => "boardIdle",
        AgentInactivityTriggerSpec => "agentInactivity",
        TicketCommentAddedTriggerSpec => "ticketCommentAdded",
        _ => throw new NotSupportedException($"No UI mapping for trigger type {Automation.Trigger.GetType().Name}. Register it in TriggerEditor.razor."),
    };

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        TriggerSpec spec = (string?)e.Value switch
        {
            "interval" => new IntervalTriggerSpec { Cron = "0 9 * * *" },
            "ticketInColumn" => new TicketInColumnTriggerSpec {
                Columns = new List<string> { Columns.FirstOrDefault() ?? "Todo" },
                Seconds = 30
            },
            "gitCommit" => new GitCommitTriggerSpec { PollSeconds = 60 },
            "statusChange" => new StatusChangeTriggerSpec { PollSeconds = 30 },
            "subTicketStatus" => new SubTicketStatusTriggerSpec { PollSeconds = 30 },
            "boardIdle" => new BoardIdleTriggerSpec { PollSeconds = 60 },
            "agentInactivity" => new AgentInactivityTriggerSpec { PollSeconds = 60, MinutesIdle = 45 },
            "ticketCommentAdded" => new TicketCommentAddedTriggerSpec { PollSeconds = 30 },
            _ => throw new NotSupportedException($"Unknown trigger type key '{e.Value}'. Register it in TriggerEditor.razor."),
        };
        await OnReplace.InvokeAsync(spec);
    }

    private static void ParseIgnoreAuthors(GitCommitTriggerSpec spec, string? value)
    {
        spec.IgnoreAuthors = (value ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
    }

    private static void ParseAuthors(TicketCommentAddedTriggerSpec spec, string? value)
    {
        spec.Authors = (value ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
    }

    private void ToggleColumn(List<string> list, string col, bool on)
    {
        if (on) { if (!list.Contains(col)) list.Add(col); }
        else { list.Remove(col); }
    }

    // ── Human-friendly schedule builder for IntervalTriggerSpec (no raw cron text entry) ──

    private enum ScheduleMode { EveryMinutes, EveryHours, Scheduled }

    // Days: 0=Sunday..6=Saturday (cron day-of-week convention). Empty list means "every day".
    private sealed record ScheduleModel(ScheduleMode Mode, int N, int Minute, List<int> Hours, List<int> Days)
    {
        public static ScheduleModel Default => new(ScheduleMode.Scheduled, 15, 0, new List<int> { 9 }, new List<int>());

        public static ScheduleModel Resolve(IntervalTriggerSpec s) =>
            Parse(s.Cron) ?? FromLegacySeconds(s.Seconds) ?? Default;

        private static ScheduleModel? FromLegacySeconds(int? seconds)
        {
            if (seconds is not int sec || sec <= 0) return null;
            if (sec < 3600) return new ScheduleModel(ScheduleMode.EveryMinutes, Math.Clamp(sec / 60, 1, 59), 0, new(), new());
            if (sec < 86400) return new ScheduleModel(ScheduleMode.EveryHours, Math.Clamp(sec / 3600, 1, 23), 0, new(), new());
            return Default;
        }

        public static ScheduleModel? Parse(string? cron)
        {
            if (string.IsNullOrWhiteSpace(cron)) return null;
            var parts = cron.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length != 5) return null;
            var (min, hour, dom, mon, dow) = (parts[0], parts[1], parts[2], parts[3], parts[4]);
            if (dom != "*" || mon != "*") return null; // day-of-month/month restrictions aren't representable by this builder

            if (min.StartsWith("*/") && hour == "*" && dow == "*" && int.TryParse(min[2..], out var everyMin))
                return new ScheduleModel(ScheduleMode.EveryMinutes, everyMin, 0, new(), new());

            if (min == "0" && hour.StartsWith("*/") && dow == "*" && int.TryParse(hour[2..], out var everyHour))
                return new ScheduleModel(ScheduleMode.EveryHours, everyHour, 0, new(), new());

            if (!int.TryParse(min, out var minute)) return null;
            var hours = hour.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(h => int.TryParse(h, out var hv) ? hv : (int?)null)
                .Where(h => h is not null).Select(h => h!.Value).ToList();
            if (hours.Count == 0) return null;
            return new ScheduleModel(ScheduleMode.Scheduled, 0, minute, hours, ParseDayField(dow));
        }

        private static List<int> ParseDayField(string dow)
        {
            if (dow == "*") return new List<int>();
            var result = new HashSet<int>();
            foreach (var token in dow.Split(',', StringSplitOptions.RemoveEmptyEntries))
            {
                if (token.Contains('-'))
                {
                    var bounds = token.Split('-');
                    if (bounds.Length == 2 && TryParseDay(bounds[0], out var from) && TryParseDay(bounds[1], out var to))
                        for (var d = from; d <= to; d++) result.Add(d);
                }
                else if (TryParseDay(token, out var d))
                    result.Add(d);
            }
            return result.Count is 0 or 7 ? new List<int>() : result.OrderBy(x => x).ToList();
        }

        private static bool TryParseDay(string token, out int day)
        {
            token = token.Trim().ToUpperInvariant();
            var names = new[] { "SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT" };
            var idx = Array.IndexOf(names, token);
            if (idx >= 0) { day = idx; return true; }
            if (int.TryParse(token, out var n) && n is >= 0 and <= 7) { day = n % 7; return true; }
            day = 0;
            return false;
        }

        public string ToCron() => Mode switch
        {
            ScheduleMode.EveryMinutes => $"*/{Math.Clamp(N, 1, 59)} * * * *",
            ScheduleMode.EveryHours => $"0 */{Math.Clamp(N, 1, 23)} * * *",
            _ => $"{Minute} {string.Join(',', Hours.Distinct().OrderBy(h => h))} * * {(Days.Count == 0 ? "*" : string.Join(',', Days.OrderBy(d => d)))}",
        };
    }

    // Display order Mon..Sun; values are cron day-of-week numbers (0=Sun..6=Sat).
    private static readonly int[] WeekdayDisplayOrder = { 1, 2, 3, 4, 5, 6, 0 };

    private static string FormatTime(int minute, int hour) => $"{hour:D2}:{minute:D2}";

    private static int ParseIntOr(object? value, int fallback) =>
        int.TryParse(value as string, out var v) && v > 0 ? v : fallback;

    private static void ApplySchedule(IntervalTriggerSpec s, ScheduleModel sched)
    {
        s.Cron = sched.ToCron();
        s.Seconds = null;
    }

    private static ScheduleModel ChangeMode(ScheduleModel s, string modeStr)
    {
        var mode = Enum.Parse<ScheduleMode>(modeStr);
        return mode switch
        {
            ScheduleMode.EveryMinutes => s with { Mode = mode, N = s.N is >= 1 and <= 59 ? s.N : 15 },
            ScheduleMode.EveryHours => s with { Mode = mode, N = s.N is >= 1 and <= 23 ? s.N : 1 },
            _ => s with { Mode = mode, Hours = s.Hours.Count == 0 ? new List<int> { 9 } : s.Hours },
        };
    }

    private static ScheduleModel ToggleDay(ScheduleModel s, int day, bool on)
    {
        // Days.Count==0 means "every day" implicitly — toggling one off first expands the set.
        var days = s.Days.Count == 0 ? Enumerable.Range(0, 7).ToList() : new List<int>(s.Days);
        if (on) { if (!days.Contains(day)) days.Add(day); }
        else days.Remove(day);
        if (days.Count == 7) days.Clear(); // collapse back to the "every day" wildcard
        return s with { Days = days };
    }

    private static ScheduleModel SetPrimaryTime(ScheduleModel s, string? value)
    {
        if (!TimeSpan.TryParse(value, out var t)) return s;
        var hours = s.Hours.Count == 0 ? new List<int> { t.Hours } : new List<int>(s.Hours) { [0] = t.Hours };
        return s with { Hours = hours, Minute = t.Minutes };
    }

    private static ScheduleModel SetHourAt(ScheduleModel s, int index, string? value)
    {
        if (!int.TryParse(value, out var h) || index >= s.Hours.Count) return s;
        var hours = new List<int>(s.Hours) { [index] = h };
        return s with { Hours = hours };
    }

    private static ScheduleModel AddTime(ScheduleModel s)
    {
        var hours = s.Hours.Count == 0 ? new List<int> { 9 } : new List<int>(s.Hours);
        hours.Add(Enumerable.Range(0, 24).FirstOrDefault(h => !hours.Contains(h)));
        return s with { Hours = hours };
    }

    private static ScheduleModel RemoveTime(ScheduleModel s, int index)
    {
        if (s.Hours.Count <= 1 || index <= 0 || index >= s.Hours.Count) return s;
        var hours = new List<int>(s.Hours);
        hours.RemoveAt(index);
        return s with { Hours = hours };
    }
}
