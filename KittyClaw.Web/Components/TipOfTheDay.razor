@using KittyClaw.Core.Services
@inject LocalizationService L

@* Game-style "loading screen tips", adapted to an app with no loading screens: a plain
   borderless line of text blended into the page background, always visible in the
   bottom-right corner of the home. One tip per day, deterministic (day number cycles
   the pool). No controls, no persistence — it is décor, not a dialog; pointer-events
   is disabled so it can never intercept a click on content beneath it. The pool mixes
   feature discovery with security reminders (local-only tool, agents run code here). *@

<div class="tip-of-the-day" role="note">
    <span class="tip-text">💡 <b>@L["TipLabel"]</b> — @L[$"Tip{_tipIndex + 1}"]</span>
</div>

@code {
    // Must match the number of TipN keys in Tips.en.json / Tips.fr.json (contract-tested).
    public const int TipCount = 14;

    private int _tipIndex;

    protected override void OnInitialized()
    {
        // Same tip all day; the day number walks the whole pool before repeating.
        _tipIndex = DateOnly.FromDateTime(DateTime.Now).DayNumber % TipCount;
    }
}
