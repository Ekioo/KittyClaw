@inject LocalizationService L

<div class="chat-composer conversation-composer">
    @Tray
    <div class="chat-input-area conversation-input-area @(IsBusy ? "chat-input-area-thinking" : "")">
        @Editor
        <div class="conversation-composer-toolbar">
            <div class="conversation-composer-tools">
                @if (OnAttach.HasDelegate)
                {
                    <button type="button" class="conversation-attach" @onclick="OnAttach" disabled="@Disabled"
                            title="@L["ConversationAttach"]" aria-label="@L["ConversationAttach"]">+</button>
                }
                @if (IsBusy && CanSteer)
                {
                    <button type="button" class="conversation-inject chat-inject-btn" @onclick="OnSend" disabled="@(!CanSend || Disabled)">@L["ChatInject"]</button>
                }
                @Tools
            </div>
            <div class="conversation-composer-submit">
                @ModelPicker
                @if (IsBusy && OnStop.HasDelegate)
                {
                    <button type="button" class="conversation-submit-action chat-stop-btn" @onclick="OnStop"
                            title="@L["StopAgent"]" aria-label="@L["StopAgent"]">
                        <span class="conversation-stop-glyph" aria-hidden="true"></span>
                    </button>
                }
                else
                {
                    <button type="button" class="conversation-submit-action conversation-send" @onclick="OnSend" disabled="@(!CanSend || Disabled || IsBusy)"
                            title="@L["Send"]" aria-label="@L["Send"]">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M12 19V5m-6 6 6-6 6 6" />
                        </svg>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? Editor { get; set; }
    [Parameter] public RenderFragment? Tray { get; set; }
    [Parameter] public RenderFragment? Tools { get; set; }
    [Parameter] public RenderFragment? ModelPicker { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool CanSteer { get; set; }
    [Parameter] public bool CanSend { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnSend { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }
    [Parameter] public EventCallback OnAttach { get; set; }
}
