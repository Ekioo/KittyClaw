@using KittyClaw.Core.Models
@using KittyClaw.Core.Services
@using KittyClaw.Web.Services
@inject TicketImprovementService Improvements
@inject TicketService Tickets
@inject LocalizationService L
@inject EscapeKeyStack EscapeStack
@implements IDisposable

<div class="ticket-improvement-overlay">
    <section class="ticket-improvement-dialog" role="dialog" aria-modal="true" aria-label="@L[Split ? "SplitTicket" : "ImproveTicket"]" aria-busy="@_busy">
        <h3>@L[Split ? "SplitTicket" : "ImproveTicket"]</h3>
        @if (_busy) { <p role="status">@L["ImprovingTicket"]</p> }
        @if (_proposal is not null)
        {
            @if (!Split) { <p>@L["ImprovementReview"]</p> }
            @if (!Split && !string.IsNullOrWhiteSpace(_proposal.Analysis))
            {
                <p style="white-space: pre-line">@_proposal.Analysis</p>
            }
            @if (Split && _proposal.SuggestedTickets is { Count: > 1 } drafts)
            {
                <p>@L["ImprovementSplitHint"]</p>
                <div class="ticket-improvement-drafts">
                    @foreach (var draft in drafts)
                    {
                        <details class="ticket-improvement-draft">
                            <summary>@draft.Title</summary>
                            <div class="ticket-improvement-draft-body">
                                <p>@draft.Description</p>
                                <strong>@L["TicketAcceptanceCriteria"]</strong>
                                <ul>@foreach (var criterion in draft.AcceptanceCriteria) { <li>@criterion</li> }</ul>
                            </div>
                        </details>
                    }
                </div>
            }
            @if (!Split)
            {
            <label>@L["Description"]<textarea class="settings-input" rows="12" @bind="_description" @bind:event="oninput"></textarea></label>
            <label>@L["TicketAcceptanceCriteria"]<textarea class="settings-input" rows="7" @bind="_criteria" @bind:event="oninput"></textarea></label>
            <p>@L["ImprovementCriteriaHint"]</p>
            }
            @if (Split && _proposal.SuggestedTickets is { Count: > 1 })
            {
                <button class="settings-primary" disabled="@_busy" @onclick="() => Apply(true)">@L["ImprovementCreateTickets"]</button>
            }
            else if (!Split)
            {
                <button class="settings-primary" disabled="@_busy" @onclick="() => Apply(false)">@L["Save"]</button>
            }
            else
            {
                <p role="status">@L["ImprovementNoSplitNeeded"]</p>
            }
        }
        @if (_error is not null) { <p class="dep-error" role="alert">@_error</p> }
        <button class="tile-config-cancel" disabled="@(_busy && _proposal is not null)" @onclick="() => OnClose.InvokeAsync()">@L["Cancel"]</button>
    </section>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public int TicketId { get; set; }
    [Parameter] public bool Split { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private readonly CancellationTokenSource _cts = new();
    private IDisposable? _escape;
    private Ticket? _original;
    private TicketImprovement? _proposal;
    private string _description = "", _criteria = "";
    private string? _error;
    private bool _busy;
    protected override async Task OnInitializedAsync()
    {
        _escape = EscapeStack.Push(() => { _ = OnClose.InvokeAsync(); });
        _busy = true;
        try {
            _original = await Tickets.GetTicketAsync(Slug, TicketId) ?? throw new InvalidOperationException("Ticket no longer exists.");
            _proposal = await Improvements.AnalyzeAsync(Slug, _original, _cts.Token, Split);
            _description = _proposal.Description;
            _criteria = string.Join("\n", _proposal.AcceptanceCriteria);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
    private async Task Apply(bool split)
    {
        if (_original is null || _busy) return;
        _busy = true; _error = null;
        try {
            if (split)
                await Tickets.SplitTicketAsync(Slug, _original, _proposal!.SuggestedTickets!);
            else
                await Tickets.ApplyImprovementAsync(Slug, TicketId, _original.Description, _original.AcceptanceCriteriaJson,
                    _description, _criteria.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList(),
                    _original.UpdatedAt);
            await OnChanged.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
    public void Dispose() { _escape?.Dispose(); _cts.Cancel(); _cts.Dispose(); }
}
