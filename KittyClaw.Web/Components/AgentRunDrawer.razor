@inject IHttpClientFactory HttpFactory
@using KittyClaw.Core.Automation
@using KittyClaw.Core.Models
@using KittyClaw.Core.Services
@using KittyClaw.Web.Services
@using Markdig
@inject AgentRunsState RunsState
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject LocalizationService L
@inject ILogger<AgentRunDrawer> Logger
@inject ColumnExecutionService ColumnExecutions
@implements IAsyncDisposable

@if (_run is not null)
{
    <ConversationDrawer Title="@_run.AgentName" Run="_run" CssClass="agent-drawer" IsBusy="@(_run.Status == AgentRunStatus.Running)" OnClose="Close">
        <HeaderActions>
            @if (_run.Status is AgentRunStatus.Failed or AgentRunStatus.Stopped)
            {
                <button class="agent-retry-btn" @onclick="Retry" disabled="@_retrying" title="@L["RetryAgent"]">↻ @L["Retry"]</button>
            }
            @if (_run.Status == AgentRunStatus.Running)
            {
                <button class="agent-stop-btn" @onclick="Stop" title="@L["StopAgent"]">⏹ @L["Stop"]</button>
            }
        </HeaderActions>
        <ChildContent>
        @if (!string.IsNullOrEmpty(_actionError))
        {
            <div class="agent-action-error" role="alert">@_actionError</div>
        }

        @if (_columnExecution is not null)
        {
            <details class="fresh-context-details">
                <summary>Ticket context · technical details</summary>
                <span>Trigger version: <LocalDateTime Value="_columnExecution.TriggerTicketUpdatedAt" EmptyText="unavailable" /></span>
                <span>Trigger signal: @_columnExecution.TriggerSignalType</span>
                <span>Consumed version: <LocalDateTime Value="_columnExecution.ConsumedTicketUpdatedAt" EmptyText="not consumed" /></span>
                <span>Owner feedback: @(_columnExecution.TriggerOwnerCommentId is int commentId ? $"#{commentId}" : "none")</span>
            </details>
            @if (!string.IsNullOrWhiteSpace(_columnExecution.ContextRejectionReason))
            {
                <div class="agent-action-error" role="alert">Context refused: @_columnExecution.ContextRejectionReason</div>
            }
        }


            <ConversationView @ref="_messagesView">
                @foreach (var group in ConversationEventPresentation.Group(_events))
                {
                    if (group.IsActivity)
                    {
                        <ConversationActivity Events="group.Events" />
                    }
                    else
                    {
                        var ev = group.Events[0];
                        var body = GetMessageBody(ev.Text);
                        <ConversationMessage Role="@(ev.Kind is "user" or "steer" ? "user" : ev.Kind == "error" ? "error" : "assistant")"
                                             At="ev.At" BubbleClass="@(ev.Kind == "error" ? "conversation-diagnostic" : null)" Markdown="@(ev.Kind != "error")">
                            @if (ev.Kind == "error")
                            {
                                <details class="chat-diagnostic-block">
                                    <summary class="chat-diagnostic-summary"><span class="chat-diagnostic-title">@RunDrawerEventPresentation.ExtractSummary(body)</span><span>@L["ChatTechnicalDetails"]</span></summary>
                                    <pre class="chat-diagnostic-detail">@ev.Text</pre>
                                    <button class="conversation-copy" @onclick="() => CopyText(ev.Text)">@L["ConversationCopy"]</button>
                                </details>
                            }
                            else
                            {
                                @if (SharedRenderHelpers.IsJson(body))
                                {
                                    <pre>@body</pre>
                                }
                                else
                                {
                                    @((MarkupString)RenderMarkdown(body))
                                }
                            }
                        </ConversationMessage>
                    }
                }
                @if (_events.Count == 0)
                {
                    <div class="chat-empty">@L["WaitingForOutput"]</div>
                }
            </ConversationView>
        </ChildContent>
        <Composer>
            @if (_run.Status == AgentRunStatus.Running)
            {
                <ConversationComposer IsBusy="true" CanSteer="true" CanSend="@(!string.IsNullOrWhiteSpace(_steerText))" OnSend="Steer" OnStop="Stop">
                    <Editor><textarea @ref="_inputRef" @bind="_steerText" @bind:event="oninput" placeholder="@L["SteerPlaceholder"]" aria-label="@L["SteerPlaceholder"]"></textarea></Editor>
                    <ModelPicker><span class="conversation-composer-model-label">@_run.Model</span></ModelPicker>
                </ConversationComposer>
            }
        </Composer>
    </ConversationDrawer>
}

@code {
    [Parameter] public string? RunId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnRetried { get; set; }

    private AgentRun? _run;
    private ColumnExecution? _columnExecution;
    private readonly List<StreamEvent> _events = new();
    private string _steerText = "";
    private bool _retrying;
    private IJSObjectReference? _sseModule;
    private string? _activeStreamId;
    private ConversationView? _messagesView;
    private ElementReference _inputRef;
    private DotNetObjectReference<AgentRunDrawer>? _dotnetRef;
    private bool _needsInitScroll;
    private bool _needsScroll;
    private string? _actionError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_run?.Status == AgentRunStatus.Running)
        {
            _dotnetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("chatDrawerInstallEnterGuard", _inputRef, _dotnetRef);
        }
        if (_sseModule is null) return;
        if (_needsInitScroll)
        {
            _needsInitScroll = false;
            await _sseModule.InvokeVoidAsync("initAutoScroll", _messagesView?.Element);
        }
        if (_needsScroll)
        {
            _needsScroll = false;
            await _sseModule.InvokeVoidAsync("scrollIfNeeded");
        }
    }

    [JSInvokable]
    public Task OnComposerEnter(string text) => InvokeAsync(async () =>
    {
        _steerText = text;
        await Steer();
    });

    protected override async Task OnParametersSetAsync()
    {
        if (RunId is null)
        {
            if (_run is not null) { await StopStream(); _events.Clear(); _run = null; }
            return;
        }
        if (RunId == _activeStreamId) return;
        await StopStream();
        _events.Clear();
        _run = RunsState.Get(RunId);
        if (_run is null) return;
        _columnExecution = (await ColumnExecutions.ListAsync(_run.ProjectSlug, _run.TicketId))
            .FirstOrDefault(execution => execution.Id == RunId || execution.RunId == RunId);

        _events.AddRange(_run.SnapshotBuffer());
        _run.OnEvent += HandleEvent;

        _sseModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/agent-sse.js");
        _activeStreamId = RunId;
        _needsInitScroll = true;
        StateHasChanged();
    }

    private void HandleEvent(StreamEvent ev)
    {
        // OnEvent fires on the runner's background thread; _events is enumerated by the
        // renderer, so mutate it on the sync context only.
        InvokeAsync(() =>
        {
            _events.Add(ev);
            while (_events.Count > 500) _events.RemoveAt(0);
            _needsScroll = true;
            StateHasChanged();
        });
    }

    private async Task Close()
    {
        await StopStream();
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private async Task StopStream()
    {
        if (_run is not null) _run.OnEvent -= HandleEvent;
        if (_sseModule is not null && _activeStreamId is not null)
            try { await _sseModule.InvokeVoidAsync("disposeAutoScroll"); }
            catch (Exception ex) { Logger.LogDebug(ex, "Failed to dispose run drawer auto-scroll for run {RunId}", _activeStreamId); }
        _activeStreamId = null;
    }

    private async Task Steer()
    {
        if (_run is null || string.IsNullOrWhiteSpace(_steerText)) return;
        var payload = new { text = _steerText };
        using var http = HttpFactory.CreateClient("KittyClawLocal");
        try
        {
            var response = await http.PostAsJsonAsync($"/api/projects/{_run.ProjectSlug}/runs/{_run.RunId}/steer", payload);
            if (!response.IsSuccessStatusCode)
            {
                _actionError = "Impossible d’envoyer l’instruction. Réessayez.";
                Logger.LogWarning("Steer request failed for project {ProjectSlug} run {RunId} with status {StatusCode}", _run.ProjectSlug, _run.RunId, (int)response.StatusCode);
                return;
            }
            _events.Add(new StreamEvent(DateTime.UtcNow, "user", _steerText));
            _steerText = "";
            _actionError = null;
        }
        catch (Exception ex)
        {
            _actionError = "Impossible d’envoyer l’instruction. Réessayez.";
            Logger.LogWarning(ex, "Steer request failed for project {ProjectSlug} run {RunId}", _run.ProjectSlug, _run.RunId);
        }
    }

    private async Task Stop()
    {
        if (_run is null) return;
        using var http = HttpFactory.CreateClient("KittyClawLocal");
        try
        {
            var response = await http.PostAsync($"/api/projects/{_run.ProjectSlug}/runs/{_run.RunId}/stop", null);
            if (!response.IsSuccessStatusCode)
            {
                _actionError = "Impossible d’arrêter l’exécution. Réessayez.";
                Logger.LogWarning("Stop request failed for project {ProjectSlug} run {RunId} with status {StatusCode}", _run.ProjectSlug, _run.RunId, (int)response.StatusCode);
            }
            else _actionError = null;
        }
        catch (Exception ex)
        {
            _actionError = "Impossible d’arrêter l’exécution. Réessayez.";
            Logger.LogWarning(ex, "Stop request failed for project {ProjectSlug} run {RunId}", _run.ProjectSlug, _run.RunId);
        }
    }

    private async Task Retry()
    {
        if (_run is null || _retrying) return;
        _retrying = true;
        try
        {
            using var http = HttpFactory.CreateClient("KittyClawLocal");
            var resp = await http.PostAsync($"/api/projects/{_run.ProjectSlug}/runs/{_run.RunId}/retry", null);
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadFromJsonAsync<RetryResponse>();
                if (body is not null && OnRetried.HasDelegate)
                    await OnRetried.InvokeAsync(body.RunId);
            }
            else
            {
                _actionError = "Impossible de relancer l’exécution. Réessayez.";
                Logger.LogWarning("Retry request failed for project {ProjectSlug} run {RunId} with status {StatusCode}", _run.ProjectSlug, _run.RunId, (int)resp.StatusCode);
            }
        }
        catch (Exception ex)
        {
            _actionError = "Impossible de relancer l’exécution. Réessayez.";
            Logger.LogWarning(ex, "Retry request failed for project {ProjectSlug} run {RunId}", _run.ProjectSlug, _run.RunId);
        }
        finally { _retrying = false; }
    }

    private sealed record RetryResponse(string RunId);

    private static string GetMessageBody(string? text)
    {
        var (_, body) = ParseBracketTag(text);
        return body;
    }

    private static (string? Tag, string Body) ParseBracketTag(string? text)
    {
        if (string.IsNullOrEmpty(text)) return (null, "");
        if (!text.StartsWith('[')) return (null, text);
        var close = text.IndexOf(']');
        if (close < 1) return (null, text);
        var tag = text[1..close];
        var body = text[(close + 1)..].TrimStart();
        return (tag, body);
    }

    private static readonly MarkdownPipeline _mdPipeline =
        KittyClaw.Core.Services.SafeMarkdown.Build();

    private static string RenderMarkdown(string? text) =>
        string.IsNullOrEmpty(text) ? "" : Markdig.Markdown.ToHtml(text, _mdPipeline);

    private async Task CopyText(string text)
    {
        _sseModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/agent-sse.js");
        await _sseModule.InvokeVoidAsync("copyText", text);
    }

    public async ValueTask DisposeAsync()
    {
        await StopStream();
        _dotnetRef?.Dispose();
        if (_sseModule is not null)
        {
            try { await _sseModule.DisposeAsync(); }
            catch (Exception ex) { Logger.LogDebug(ex, "Failed to dispose run drawer JS module for run {RunId}", RunId); }
        }
    }
}
