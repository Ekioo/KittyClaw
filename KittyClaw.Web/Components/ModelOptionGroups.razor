@using KittyClaw.Core.Automation
@using KittyClaw.Core.Services
@inject LocalizationService L

@foreach (var group in Groups)
{
    if (!group.IsShown(Selected)) continue;
    var label = group.Installed ? group.Label : $"{group.Label} ({L["ModelProviderNotInstalled"]})";
    <optgroup label="@label">
        @foreach (var m in group.VisibleModels(Selected))
        {
            <option value="@m">@m</option>
        }
    </optgroup>
}
@if (ShowFallback && !string.IsNullOrWhiteSpace(Selected) && !ModelGroups.IsListed(Groups, Selected))
{
    <option value="@Selected">@Selected</option>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ModelGroup> Groups { get; set; } = [];
    [Parameter] public string? Selected { get; set; }
    [Parameter] public bool ShowFallback { get; set; } = true;
}
