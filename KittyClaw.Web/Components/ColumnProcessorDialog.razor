@using Microsoft.AspNetCore.Components
@using KittyClaw.Core.Automation
@using KittyClaw.Core.Models
@using KittyClaw.Core.Services
@using KittyClaw.Web.Services
@inject ColumnProcessorService ProcessorService
@inject ColumnScheduledTaskService ScheduledTaskService
@inject ProjectSkillService SkillService
@inject PipelineService PipelineService
@inject ColumnService ColumnService
@inject LocalizationService L
@inject EscapeKeyStack EscapeStack
@inject IJSRuntime JS
@implements IDisposable

<div class="processor-dialog-overlay" @onclick="CloseAsync">
    <section class="processor-dialog column-editor" role="dialog" aria-modal="true" aria-labelledby="column-dialog-title" @onclick:stopPropagation>
        <header class="processor-dialog-header">
            <div>
                <span class="processor-dialog-eyebrow">@L[IsCreating ? "CreateColumn" : "ConfigureColumn"]</span>
                <h2 id="column-dialog-title">@(IsCreating ? L["ColumnCreateTitle"] : _columnName)</h2>
            </div>
            <button class="agent-close-btn" @onclick="CloseAsync" title="@L["Close"]">×</button>
        </header>

        @if (_loading)
        {
            <div class="processor-dialog-loading">…</div>
        }
        else
        {
            <nav class="column-editor-tabs" aria-label="@L["ColumnEditorSections"]">
                <button class="@GeneralTabClass" @onclick="OpenGeneralTab">@L["ColumnGeneralTab"]</button>
                <button class="@ProcessorTabClass" @onclick="OpenProcessorTab">
                    @L["ColumnProcessorTab"] <span class="column-editor-tab-state">@(_processorDraft ? "⚙" : "○")</span>
                </button>
                <button class="@ActionsTabClass" @onclick="OpenActionsTab">@L["ColumnActionsTab"]</button>
                <button class="@SchedulesTabClass" @onclick="OpenSchedulesTab">@L["ColumnSchedulesTab"]</button>
                <button class="@RoutingTabClass" @onclick="OpenRoutingTab">@L["ColumnRoutingTab"]</button>
            </nav>

            <div class="processor-dialog-body">
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <p class="@(_isError ? "settings-status-error" : "settings-status-ok")">@_message</p>
                }

                @if (_activeTab == "general")
                {
                    <div class="column-editor-grid">
                        <label><FieldHelp Label="@L["Name"]" Help="@L["ColumnNameHelp"]" /><input class="settings-input" @bind="_columnName" @bind:event="oninput" /></label>
                        <label><FieldHelp Label="@L["Color"]" Help="@L["ColumnColorHelp"]" /><input type="color" class="color-input column-editor-color" @bind="_columnColor" /></label>
                        <label><FieldHelp Label="@L["ColumnRole"]" Help="@L["ColumnRoleHelp"]" />
                            <select @bind="_columnRole">
                                @foreach (var role in Enum.GetValues<ColumnRole>())
                                {
                                    <option value="@role">@L[$"WorkflowRole{role}"]</option>
                                }
                            </select>
                        </label>
                        <label><FieldHelp Label="@L["ColumnPosition"]" Help="@L["ColumnPositionHelp"]" />
                            <select @bind="_positionIndex">
                                @for (var index = 0; index <= SiblingColumns.Count; index++)
                                {
                                    <option value="@index">@PositionLabel(index)</option>
                                }
                            </select>
                        </label>
                    </div>
                    <p class="settings-hint">@L["ColumnStableIdentityHint"]</p>

                    @if (!IsCreating && PipelineColumns.Count > 1)
                    {
                        <section class="column-danger-zone">
                            <h3>@L["ColumnDeleteTitle"]</h3>
                            @if (!_confirmDelete)
                            {
                                <p class="settings-hint">@L["ColumnDeleteHint"]</p>
                                <button class="delete-btn" @onclick="() => _confirmDelete = true">@L["DeleteColumn"]</button>
                            }
                            else
                            {
                                <label><FieldHelp Label="@L["MoveTicketsTo"]" Help="@L["ColumnDeleteDestinationHelp"]" />
                                    <select @bind="_deleteTargetId">
                                        @foreach (var target in SiblingColumns)
                                        {
                                            <option value="@target.Id">@target.Name</option>
                                        }
                                    </select>
                                </label>
                                <div class="confirm-actions">
                                    <button class="processor-secondary-btn" @onclick="() => _confirmDelete = false">@L["Cancel"]</button>
                                    <button class="delete-btn" @onclick="DeleteColumnAsync">@L["DeleteColumn"]</button>
                                </div>
                            }
                        </section>
                    }
                }
                else if (_activeTab == "processor")
                {
                    @if (!_processorDraft)
                    {
                        <div class="column-empty-state">
                            <span class="column-empty-state-icon">○</span>
                            <h3>@L["ColumnNoProcessorTitle"]</h3>
                            <p class="settings-hint">@L["ColumnNoProcessorHint"]</p>
                            <button class="settings-primary" @onclick="CreateProcessorDraft">@L["ColumnAddProcessor"]</button>
                        </div>
                    }
                    else
                    {
                        @if (!_processorExists)
                        {
                            <div class="processor-draft-notice" role="status">@L["ProcessorDraftNotice"]</div>
                        }
                        <label class="workflow-check"><input type="checkbox" @bind="_enabled" /> <FieldHelp Label="@L["ProcessorEnabled"]" Help="@L["ProcessorEnabledHelp"]" /></label>
                        <label><FieldHelp Label="@L["Name"]" Help="@L["ProcessorNameHelp"]" /><input class="settings-input" @bind="_name" /></label>
                        <label><FieldHelp Label="@L["ProcessorMission"]" Help="@L["ProcessorMissionHelp"]" /><textarea class="settings-input workflow-textarea" @bind="_mission"></textarea></label>
                        <label><FieldHelp Label="@L["ProcessorPrompt"]" Help="@L["ProcessorPromptHelp"]" /><textarea class="settings-input workflow-textarea processor-prompt" @bind="_prompt"></textarea></label>

                        <div class="workflow-grid">
                            <label><FieldHelp Label="@L["ProcessorTicketOrder"]" Help="@L["ProcessorTicketOrderHelp"]" />
                                <select @bind="_selectionOrder">
                                    @foreach (var order in Enum.GetValues<TicketSelectionOrder>())
                                    {
                                        <option value="@order">@SelectionOrderLabel(order)</option>
                                    }
                                </select>
                            </label>
                            <label><FieldHelp Label="@L["ProcessorMaxAttempts"]" Help="@L["ProcessorMaxAttemptsHelp"]" /><input type="number" min="1" @bind="_maxAttempts" /></label>
                            <label><FieldHelp Label="@L["ProcessorRetryDelay"]" Help="@L["ProcessorRetryDelayHelp"]" /><input type="number" min="1" @bind="_retryBackoff" /></label>
                            <label><FieldHelp Label="@L["ProcessorTurnLimit"]" Help="@L["ProcessorTurnLimitHelp"]" /><input type="number" min="1" @bind="_maxTurns" /></label>
                        </div>

                        <h3>@L["ProcessorSkills"]</h3>
                        <p class="settings-hint">@L["ProcessorSkillsHint"]</p>
                        @if (_skills.Count == 0)
                        {
                            <p class="settings-hint">@L["ProcessorNoSkills"]</p>
                        }
                        else
                        {
                            <div class="skill-matrix">
                                @foreach (var skill in _skills)
                                {
                                    <div><strong>@skill.Name</strong><code>@skill.Slug</code></div>
                                    <label><input type="checkbox" checked="@_availableSkills.Contains(skill.Slug)" @onchange="e => ToggleSkill(_availableSkills, skill.Slug, e)" /> <FieldHelp Label="@L["ProcessorAvailable"]" Help="@L["ProcessorAvailableHelp"]" /></label>
                                    <label><input type="checkbox" checked="@_recommendedSkills.Contains(skill.Slug)" @onchange="e => ToggleSkill(_recommendedSkills, skill.Slug, e)" /> <FieldHelp Label="@L["ProcessorRecommended"]" Help="@L["ProcessorRecommendedHelp"]" /></label>
                                    <label><input type="checkbox" checked="@_requiredSkills.Contains(skill.Slug)" @onchange="e => ToggleSkill(_requiredSkills, skill.Slug, e)" /> <FieldHelp Label="@L["ProcessorRequired"]" Help="@L["ProcessorRequiredHelp"]" /></label>
                                }
                            </div>
                        }

                        @if (_processorExists)
                        {
                            <button class="processor-secondary-btn processor-remove-btn" @onclick="RemoveProcessorDraft">@L["ColumnRemoveProcessor"]</button>
                        }
                    }
                }
                else if (_activeTab == "actions")
                {
                    @if (!_processorDraft)
                    {
                        <div class="column-empty-state">
                            <span class="column-empty-state-icon">○</span>
                            <h3>@L["ColumnActionsNeedsProcessor"]</h3>
                            <button class="settings-primary" @onclick="CreateProcessorAndOpenTab">@L["ColumnAddProcessor"]</button>
                        </div>
                    }
                    else
                    {
                        <p class="settings-hint">@L["ColumnActionsHint"]</p>
                        @ActionSection(_beforeActions, true)
                        <div class="processor-agent-step" role="note">
                            <span class="processor-agent-step-icon">◆</span>
                            <div>
                                <strong>@L["ColumnAgentStep"]</strong>
                                <span>@L["ColumnAgentStepHint"]</span>
                            </div>
                        </div>
                        @ActionSection(_afterActions, false)
                    }
                }
                else if (_activeTab == "schedules")
                {
                    <div class="processor-actions-heading scheduled-task-heading">
                        <div>
                            <h3>@L["ColumnSchedulesTitle"]</h3>
                            <p class="settings-hint">@L["ColumnSchedulesHint"]</p>
                        </div>
                        <button class="processor-secondary-btn" @onclick="AddScheduledTask">@L["ColumnAddSchedule"]</button>
                    </div>
                    @if (_scheduledTasks.Count == 0)
                    {
                        <div class="column-empty-state compact"><span class="column-empty-state-icon">◷</span><p>@L["ColumnNoSchedules"]</p></div>
                    }
                    @foreach (var task in _scheduledTasks)
                    {
                        <article class="scheduled-task-card" @key="task.Id">
                            <header>
                                <label class="workflow-check"><input type="checkbox" @bind="task.Enabled" /> @L["Enabled"]</label>
                                <button class="processor-secondary-btn" @onclick="() => _scheduledTasks.Remove(task)">@L["ProcessorRemove"]</button>
                            </header>
                            <div class="workflow-grid scheduled-task-fields">
                                <label><FieldHelp Label="@L["Name"]" Help="@L["ScheduleNameHelp"]" /><input @bind="task.Name" /></label>
                                <label><FieldHelp Label="@L["ScheduleCron"]" Help="@L["ScheduleCronHelp"]" /><input @bind="task.Cron" placeholder="0 9 * * 1" /></label>
                                <label><FieldHelp Label="@L["ScheduleTimezone"]" Help="@L["ScheduleTimezoneHelp"]" /><input @bind="task.TimeZoneId" /></label>
                                <label><FieldHelp Label="@L["ScheduleTicketScope"]" Help="@L["ScheduleTicketScopeHelp"]" />
                                    <select @bind="task.TicketScope">
                                        <option value="@ScheduledTaskTicketScope.None">@L["ScheduleNoTicket"]</option>
                                        <option value="@ScheduledTaskTicketScope.FirstTicket">@L["ScheduleFirstTicket"]</option>
                                    </select>
                                </label>
                            </div>
                            @ScheduledActionSection(task)
                        </article>
                    }
                }
                else
                {
                    @if (!_processorDraft)
                    {
                        <div class="column-empty-state">
                            <span class="column-empty-state-icon">○</span>
                            <h3>@L["ColumnRoutingNeedsProcessor"]</h3>
                            <button class="settings-primary" @onclick="CreateProcessorAndOpenTab">@L["ColumnAddProcessor"]</button>
                        </div>
                    }
                    else
                    {
                        <p class="settings-hint">@L["ColumnRoutingHint"]</p>
                        <div class="workflow-grid">
                            <label><FieldHelp Label="@L["ProcessorDefaultDestination"]" Help="@L["ProcessorDefaultDestinationHelp"]" />
                                <select @bind="_defaultTargetId">@ColumnOptions(true)</select>
                            </label>
                            <label><FieldHelp Label="@L["ProcessorFailureDestination"]" Help="@L["ProcessorFailureDestinationHelp"]" />
                                <select @bind="_technicalFailureTargetId">@ColumnOptions(true)</select>
                            </label>
                        </div>
                        @foreach (var route in _routes)
                        {
                            <div class="settings-row route-row">
                                <label class="route-field"><FieldHelp Label="@L["ProcessorOutcome"]" Help="@L["ProcessorOutcomeHelp"]" /><input placeholder="@L["ProcessorOutcomePlaceholder"]" @bind="route.Outcome" /></label>
                                <span>&rarr;</span>
                                <label class="route-field"><FieldHelp Label="@L["ProcessorRouteDestination"]" Help="@L["ProcessorRouteDestinationHelp"]" /><select @bind="route.TargetColumnId">@ColumnOptions(false)</select></label>
                                <button class="processor-secondary-btn" @onclick="() => _routes.Remove(route)">@L["ProcessorRemove"]</button>
                            </div>
                        }
                        <button class="processor-secondary-btn" @onclick="AddRoute">@L["ProcessorAddRoute"]</button>
                    }
                }
            </div>

            <footer class="processor-dialog-footer">
                <button class="processor-secondary-btn" @onclick="CloseAsync">@L["Cancel"]</button>
                <button class="settings-primary" @onclick="SaveAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_columnName))">@(_saving ? "…" : L[IsCreating ? "CreateColumn" : "Save"])</button>
            </footer>
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public required string Slug { get; set; }
    [Parameter] public BoardColumn? Column { get; set; }
    [Parameter] public BoardColumn? TemplateColumn { get; set; }
    [Parameter, EditorRequired] public int PipelineId { get; set; }
    [Parameter] public int InsertIndex { get; set; } = -1;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool IsCreating => Column is null;
    private bool _loading = true;
    private bool _saving;
    private bool _processorExists;
    private bool _processorDraft;
    private bool _removeProcessorOnSave;
    private bool _enabled = true;
    private string _activeTab = "general";
    private string _columnName = "";
    private string _columnColor = "#5a6a80";
    private ColumnRole _columnRole;
    private int _positionIndex;
    private string _name = "";
    private string _mission = "";
    private string _prompt = "";
    private string? _model;
    private int _maxTurns = 100;
    private int _maxAttempts = 3;
    private int _retryBackoff = 60;
    private TicketSelectionOrder _selectionOrder;
    private int? _defaultTargetId;
    private int? _technicalFailureTargetId;
    private List<ProjectSkill> _skills = [];
    private List<Pipeline> _pipelines = [];
    private readonly Dictionary<int, List<BoardColumn>> _pipelineColumns = [];
    private HashSet<string> _availableSkills = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _recommendedSkills = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _requiredSkills = new(StringComparer.OrdinalIgnoreCase);
    private List<RouteDraft> _routes = [];
    private List<ColumnActionDraft> _beforeActions = [];
    private List<ColumnActionDraft> _afterActions = [];
    private List<ColumnScheduledTask> _scheduledTasks = [];
    private bool _confirmDelete;
    private int _deleteTargetId;
    private string? _message;
    private bool _isError;
    private IDisposable? _escapeToken;

    private List<BoardColumn> PipelineColumns => _pipelineColumns.GetValueOrDefault(PipelineId, []);
    private List<BoardColumn> SiblingColumns => PipelineColumns.Where(column => column.Id != Column?.Id).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _pipelines = await PipelineService.ListAsync(Slug);
            foreach (var pipeline in _pipelines)
                _pipelineColumns[pipeline.Id] = await ColumnService.ListColumnsAsync(Slug, pipeline.Id);
            _skills = await SkillService.ListAsync(Slug);

            var source = Column ?? TemplateColumn;
            _columnName = Column?.Name ?? (TemplateColumn is null ? "" : L.Get("ColumnCopyName", TemplateColumn.Name));
            _columnColor = source?.Color ?? "#5a6a80";
            _columnRole = source?.Role ?? ColumnRole.Normal;
            var sourceIndex = source is null ? PipelineColumns.Count : PipelineColumns.FindIndex(column => column.Id == source.Id);
            _positionIndex = Math.Clamp(InsertIndex >= 0 ? InsertIndex : Math.Max(0, sourceIndex), 0, SiblingColumns.Count);
            _deleteTargetId = SiblingColumns.FirstOrDefault()?.Id ?? 0;

            var processor = source is null ? null : await ProcessorService.GetAsync(Slug, source.Id);
            _processorExists = Column is not null && processor is not null;
            _processorDraft = processor is not null;
            ApplyProcessor(processor, source?.Name);
            if (TemplateColumn is not null && processor is not null)
                _name = L.Get("ColumnCopyName", processor.Name);
            if (Column is not null)
                _scheduledTasks = await ScheduledTaskService.ListAsync(Slug, Column.Id);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyProcessor(ColumnProcessor? processor, string? sourceName)
    {
        _name = processor?.Name ?? $"{sourceName ?? _columnName} processor";
        _mission = processor?.Mission ?? "Process the selected ticket and return a structured outcome.";
        _prompt = processor?.Prompt ?? "";
        _model = processor?.Model;
        _enabled = processor?.Enabled ?? true;
        _maxTurns = processor?.MaxTurns ?? 100;
        _maxAttempts = processor?.MaxAttempts ?? 3;
        _retryBackoff = processor?.RetryBackoffSeconds ?? 60;
        _selectionOrder = processor?.SelectionOrder ?? TicketSelectionOrder.Position;
        _defaultTargetId = processor?.DefaultTargetColumnId;
        _technicalFailureTargetId = processor?.TechnicalFailureColumnId;
        _availableSkills = new(processor?.AvailableSkills ?? [], StringComparer.OrdinalIgnoreCase);
        _recommendedSkills = new(processor?.RecommendedSkills ?? [], StringComparer.OrdinalIgnoreCase);
        _requiredSkills = new(processor?.RequiredSkills ?? [], StringComparer.OrdinalIgnoreCase);
        _routes = processor?.Routes.Select(route => new RouteDraft { Outcome = route.Outcome, TargetColumnId = route.TargetColumnId }).ToList() ?? [];
        _beforeActions = processor?.BeforeActions.Select(ColumnActionDraft.FromModel).ToList() ?? [];
        _afterActions = processor?.AfterActions.Select(ColumnActionDraft.FromModel).ToList() ?? [];
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _escapeToken = EscapeStack.PushWithFocus(JS, () => InvokeAsync(CloseAsync));
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _message = null;
        try
        {
            var trimmedName = _columnName.Trim();
            if (PipelineColumns.Any(column => column.Id != Column?.Id && column.Name.Equals(trimmedName, StringComparison.OrdinalIgnoreCase)))
                throw new InvalidOperationException(L["ColumnNameAlreadyExists"]);

            BoardColumn savedColumn;
            if (IsCreating)
            {
                savedColumn = await ColumnService.CreateColumnAsync(Slug, trimmedName, _columnColor, PipelineId, _columnRole, _positionIndex);
            }
            else
            {
                savedColumn = await ColumnService.UpdateColumnAsync(Slug, Column!.Id, trimmedName, _columnColor, _columnRole)
                    ?? throw new InvalidOperationException(L["ColumnNameAlreadyExists"]);
                await ColumnService.ReorderColumnAsync(Slug, savedColumn.Id, _positionIndex);
            }

            if (_removeProcessorOnSave)
            {
                await ProcessorService.DeleteAsync(Slug, savedColumn.Id);
            }
            else if (_processorDraft)
            {
                var routes = _routes.Where(route => !string.IsNullOrWhiteSpace(route.Outcome) && route.TargetColumnId > 0)
                    .Select(route => new ColumnRoute(route.Outcome, route.TargetColumnId)).ToList();
                await ProcessorService.SaveAsync(Slug, savedColumn.Id, _name, _mission, _model,
                    _enabled, _maxTurns, _availableSkills.ToList(), _recommendedSkills.ToList(), _requiredSkills.ToList(),
                    _selectionOrder, _maxAttempts, _retryBackoff, _defaultTargetId, _technicalFailureTargetId, routes,
                    prompt: _prompt,
                    beforeActions: _beforeActions.Select(action => action.ToModel()).ToList(),
                    afterActions: _afterActions.Select(action => action.ToModel()).ToList());
            }

            await ScheduledTaskService.SaveColumnAsync(Slug, savedColumn.Id, _scheduledTasks);

            await OnSaved.InvokeAsync();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteColumnAsync()
    {
        var target = SiblingColumns.FirstOrDefault(column => column.Id == _deleteTargetId);
        if (Column is null || target is null) return;
        try
        {
            if (!await ColumnService.DeleteColumnAsync(Slug, Column.Id, target.Name))
                throw new InvalidOperationException(L["ColumnDeleteFailed"]);
            await OnSaved.InvokeAsync();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
    }

    private void RemoveProcessorDraft()
    {
        _removeProcessorOnSave = true;
        _processorExists = false;
        _processorDraft = false;
        ApplyProcessor(null, _columnName);
    }

    private void CreateProcessorDraft()
    {
        _removeProcessorOnSave = false;
        _processorDraft = true;
        ApplyProcessor(null, _columnName);
    }

    private void CreateProcessorAndOpenTab()
    {
        CreateProcessorDraft();
        _activeTab = "processor";
    }

    private string TabClass(string tab) => $"column-editor-tab {(_activeTab == tab ? "column-editor-tab--active" : "")}";
    private string GeneralTabClass => TabClass("general");
    private string ProcessorTabClass => TabClass("processor");
    private string ActionsTabClass => TabClass("actions");
    private string SchedulesTabClass => TabClass("schedules");
    private string RoutingTabClass => TabClass("routing");
    private void OpenGeneralTab() => _activeTab = "general";
    private void OpenProcessorTab() => _activeTab = "processor";
    private void OpenActionsTab() => _activeTab = "actions";
    private void OpenSchedulesTab() => _activeTab = "schedules";
    private void OpenRoutingTab() => _activeTab = "routing";

    private string PositionLabel(int index)
    {
        if (SiblingColumns.Count == 0) return L["ColumnPositionOnly"];
        if (index == 0) return L.Get("ColumnPositionBefore", SiblingColumns[0].Name);
        if (index >= SiblingColumns.Count) return L.Get("ColumnPositionAfter", SiblingColumns[^1].Name);
        return L.Get("ColumnPositionBefore", SiblingColumns[index].Name);
    }

    private void ToggleSkill(HashSet<string> set, string slug, ChangeEventArgs e)
    {
        if (e.Value is true) set.Add(slug); else set.Remove(slug);
    }

    private void AddRoute()
    {
        var targets = TargetColumns;
        _routes.Add(new RouteDraft { TargetColumnId = targets.Count > 0 ? targets[0].Column.Id : 0 });
    }

    private RenderFragment ActionSection(List<ColumnActionDraft> actions, bool beforeAgent) => @<section class="processor-actions-section">
        <div class="processor-actions-heading">
            <div>
                <h3>@L[beforeAgent ? "ColumnActionsBefore" : "ColumnActionsAfter"]</h3>
                <p class="settings-hint">@L[beforeAgent ? "ColumnActionsBeforeHint" : "ColumnActionsAfterHint"]</p>
            </div>
            <button class="processor-secondary-btn" @onclick="() => AddProcessorAction(actions)">@L["ColumnAddAction"]</button>
        </div>
        @if (actions.Count == 0)
        {
            <p class="processor-actions-empty">@L["ColumnNoActions"]</p>
        }
        @for (var index = 0; index < actions.Count; index++)
        {
            var action = actions[index];
            var actionIndex = index;
            <article class="processor-action-card" @key="action.Id">
                <header>
                    <strong>@L.Get("ColumnActionNumber", actionIndex + 1)</strong>
                    <div class="processor-action-order">
                        <button class="processor-secondary-btn" disabled="@(actionIndex == 0)" @onclick="() => MoveAction(actions, actionIndex, -1)" title="@L["MoveUp"]">↑</button>
                        <button class="processor-secondary-btn" disabled="@(actionIndex == actions.Count - 1)" @onclick="() => MoveAction(actions, actionIndex, 1)" title="@L["MoveDown"]">↓</button>
                    </div>
                </header>
                <ActionEditor Action="action.Action"
                              Columns="AllColumnNames"
                              Members="EmptyMembers"
                              Slug="@Slug"
                              ProcessorMode="true"
                              OnReplace="replacement => ReplaceAction(action, replacement)"
                              OnDelete="() => actions.Remove(action)" />
                <label class="processor-action-failure">
                    <FieldHelp Label="@L["ColumnActionFailureDestination"]" Help="@L["ColumnActionFailureDestinationHelp"]" />
                    <select @bind="action.FailureTargetColumnId">@ColumnOptions(true)</select>
                </label>
            </article>
        }
    </section>;

    private List<string> AllColumnNames => TargetColumns.Select(target => target.Column.Name)
        .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    private static readonly List<string> EmptyMembers = [];

    private void AddProcessorAction(List<ColumnActionDraft> actions) => actions.Add(new ColumnActionDraft
    {
        Id = Guid.NewGuid().ToString("N"),
        Action = new ExecutePowerShellActionSpec(),
        FailureTargetColumnId = _technicalFailureTargetId,
    });

    private static void ReplaceAction(ColumnActionDraft draft, ActionSpec replacement) => draft.Action = replacement;

    private static void MoveAction(List<ColumnActionDraft> actions, int index, int delta)
    {
        var target = index + delta;
        if (index < 0 || index >= actions.Count || target < 0 || target >= actions.Count) return;
        (actions[index], actions[target]) = (actions[target], actions[index]);
    }

    private void AddScheduledTask() => _scheduledTasks.Add(new ColumnScheduledTask
    {
        Id = Guid.NewGuid().ToString("N"),
        ColumnId = Column?.Id ?? 0,
        Name = L["ScheduleDefaultName"],
        Cron = "0 9 * * 1",
        TimeZoneId = TimeZoneInfo.Local.Id,
        TicketScope = ScheduledTaskTicketScope.None,
        Actions = [new ColumnProcessorAction(Guid.NewGuid().ToString("N"), new CreateTicketActionSpec())],
    });

    private RenderFragment ScheduledActionSection(ColumnScheduledTask task) => @<section class="processor-actions-section scheduled-actions">
        <div class="processor-actions-heading">
            <h4>@L["ScheduleActions"]</h4>
            <button class="processor-secondary-btn" @onclick="() => AddScheduledAction(task)">@L["ColumnAddAction"]</button>
        </div>
        @for (var index = 0; index < task.Actions.Count; index++)
        {
            var action = task.Actions[index];
            <article class="processor-action-card" @key="action.Id">
                <ActionEditor Action="action.Action" Columns="AllColumnNames" Members="EmptyMembers" Slug="@Slug"
                    ProcessorMode="true"
                    OnReplace="replacement => ReplaceScheduledAction(task, action, replacement)"
                    OnDelete="() => RemoveScheduledAction(task, action)" />
                @if (task.TicketScope == ScheduledTaskTicketScope.FirstTicket)
                {
                    <label class="processor-action-failure"><FieldHelp Label="@L["ColumnActionFailureDestination"]" Help="@L["ScheduleFailureHelp"]" />
                        <select value="@action.FailureTargetColumnId" @onchange="e => ReplaceScheduledFailure(task, action, e.Value?.ToString())">@ColumnOptions(true)</select>
                    </label>
                }
            </article>
        }
    </section>;

    private static void ReplaceScheduledAction(ColumnScheduledTask task, ColumnProcessorAction current, ActionSpec replacement) =>
        task.Actions = task.Actions.Select(action => action.Id == current.Id ? current with { Action = replacement } : action).ToList();
    private static void AddScheduledAction(ColumnScheduledTask task) =>
        task.Actions = task.Actions.Append(new ColumnProcessorAction(
            Guid.NewGuid().ToString("N"), new ExecutePowerShellActionSpec(), null)).ToList();
    private static void RemoveScheduledAction(ColumnScheduledTask task, ColumnProcessorAction current) =>
        task.Actions = task.Actions.Where(action => action.Id != current.Id).ToList();
    private static void ReplaceScheduledFailure(ColumnScheduledTask task, ColumnProcessorAction current, string? value)
    {
        var target = int.TryParse(value, out var parsed) ? parsed : (int?)null;
        task.Actions = task.Actions.Select(action => action.Id == current.Id ? current with { FailureTargetColumnId = target } : action).ToList();
    }

    private List<(Pipeline Pipeline, BoardColumn Column)> TargetColumns =>
        _pipelines.SelectMany(pipeline => _pipelineColumns.GetValueOrDefault(pipeline.Id, [])
            .Where(column => column.Id != Column?.Id).Select(column => (pipeline, column))).ToList();

    private RenderFragment ColumnOptions(bool allowEmpty) => builder =>
    {
        var sequence = 0;
        if (allowEmpty)
        {
            builder.OpenElement(sequence++, "option");
            builder.AddAttribute(sequence++, "value", "");
            builder.AddContent(sequence++, L["ProcessorNone"]);
            builder.CloseElement();
        }
        foreach (var target in TargetColumns)
        {
            builder.OpenElement(sequence++, "option");
            builder.AddAttribute(sequence++, "value", target.Column.Id);
            builder.AddContent(sequence++, $"{target.Pipeline.Name} / {target.Column.Name}");
            builder.CloseElement();
        }
    };

    private string SelectionOrderLabel(TicketSelectionOrder order) => L[$"ProcessorOrder{order}"];

    private async Task CloseAsync()
    {
        _escapeToken?.Dispose();
        _escapeToken = null;
        await OnClose.InvokeAsync();
    }

    public void Dispose()
    {
        _escapeToken?.Dispose();
        _escapeToken = null;
    }

    private sealed class RouteDraft
    {
        public string Outcome { get; set; } = "";
        public int TargetColumnId { get; set; }
    }

    private sealed class ColumnActionDraft
    {
        public string Id { get; set; } = Guid.NewGuid().ToString("N");
        public ActionSpec Action { get; set; } = new SetLabelsActionSpec();
        public int? FailureTargetColumnId { get; set; }

        public ColumnProcessorAction ToModel() => new(Id, Action, FailureTargetColumnId);

        public static ColumnActionDraft FromModel(ColumnProcessorAction action) => new()
        {
            Id = action.Id,
            Action = action.Action,
            FailureTargetColumnId = action.FailureTargetColumnId,
        };
    }
}
