@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using KittyClaw.Core.Automation
@using KittyClaw.Core.Models
@using KittyClaw.Core.Services
@using KittyClaw.Web.Services
@using KittyClaw.Web.Api
@inject ColumnProcessorService ProcessorService
@inject JevConfigurationService JevConfiguration
@inject ColumnScheduledTaskService ScheduledTaskService
@inject ProjectSkillService SkillService
@inject PipelineService PipelineService
@inject ColumnService ColumnService
@inject LocalizationService L
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject EscapeKeyStack EscapeStack
@inject IJSRuntime JS
@implements IDisposable

<div class="processor-dialog-overlay" @onclick="CloseAsync">
    <section class="processor-dialog column-editor" role="dialog" aria-modal="true" aria-labelledby="column-dialog-title" @onclick:stopPropagation>
        <header class="processor-dialog-header">
            <div>
                <span class="processor-dialog-eyebrow">@L[IsCreating ? "CreateColumn" : "ConfigureColumn"]</span>
                <h2 id="column-dialog-title">@(IsCreating ? L["ColumnCreateTitle"] : _columnName)</h2>
            </div>
            <button class="agent-close-btn" @onclick="CloseAsync" title="@L["Close"]">×</button>
        </header>

        @if (_loading)
        {
            <div class="processor-dialog-loading">…</div>
        }
        else
        {
            <nav class="column-editor-tabs" aria-label="@L["ColumnEditorSections"]">
                <button class="@GeneralTabClass" @onclick="OpenGeneralTab">@L["ColumnIdentityTab"]</button>
                <button class="@ProcessorTabClass" @onclick="OpenProcessorTab">@L["ColumnPathTab"]</button>
                <button class="@SchedulesTabClass" @onclick="OpenSchedulesTab">@L["ColumnSchedulesTab"] <span class="column-editor-tab-count">@_scheduledTasks.Count</span></button>
            </nav>

            <div class="processor-dialog-body">
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <p class="@(_isError ? "settings-status-error" : "settings-status-ok")">@_message</p>
                }

                @if (_activeTab == "general")
                {
                    <div class="column-editor-grid">
                        <label><FieldHelp Label="@L["Name"]" Help="@L["ColumnNameHelp"]" /><input class="settings-input" @bind="_columnName" @bind:event="oninput" /></label>
                        <label><FieldHelp Label="@L["Color"]" Help="@L["ColumnColorHelp"]" /><input type="color" class="color-input column-editor-color" @bind="_columnColor" /></label>
                        <label><FieldHelp Label="@L["ColumnRole"]" Help="@L["ColumnRoleHelp"]" />
                            <select @bind="_columnRole">
                                @foreach (var role in Enum.GetValues<ColumnRole>())
                                {
                                    <option value="@role">@L[$"WorkflowRole{role}"]</option>
                                }
                            </select>
                        </label>
                        <label><FieldHelp Label="@L["ColumnPosition"]" Help="@L["ColumnPositionHelp"]" />
                            <select @bind="_positionIndex">
                                @for (var index = 0; index <= SiblingColumns.Count; index++)
                                {
                                    <option value="@index">@PositionLabel(index)</option>
                                }
                            </select>
                        </label>
                    </div>
                    <label class="column-guidance-field">
                        <FieldHelp Label="@L["ColumnUserGuidance"]" Help="@L["ColumnUserGuidanceHelp"]" />
                        <textarea class="settings-input workflow-textarea" @bind="_userGuidance"
                                  placeholder="@L["ColumnUserGuidancePlaceholder"]"></textarea>
                    </label>
                    @if (_columnRole is ColumnRole.Waiting or ColumnRole.OwnerAction)
                    {
                        <p class="settings-hint">@L["ColumnUserGuidanceFallbackHint"]</p>
                    }
                    <p class="settings-hint">@L["ColumnStableIdentityHint"]</p>

                    @if (!IsCreating && PipelineColumns.Count > 1)
                    {
                        <section class="column-danger-zone">
                            <h3>@L["ColumnDeleteTitle"]</h3>
                            @if (!_confirmDelete)
                            {
                                <p class="settings-hint">@L["ColumnDeleteHint"]</p>
                                <button class="delete-btn" @onclick="() => _confirmDelete = true">@L["DeleteColumn"]</button>
                            }
                            else
                            {
                                <label><FieldHelp Label="@L["MoveTicketsTo"]" Help="@L["ColumnDeleteDestinationHelp"]" />
                                    <select @bind="_deleteTargetId">
                                        @foreach (var target in SiblingColumns)
                                        {
                                            <option value="@target.Id">@target.Name</option>
                                        }
                                    </select>
                                </label>
                                <div class="confirm-actions">
                                    <button class="processor-secondary-btn" @onclick="() => _confirmDelete = false">@L["Cancel"]</button>
                                    <button class="delete-btn" @onclick="DeleteColumnAsync">@L["DeleteColumn"]</button>
                                </div>
                            }
                        </section>
                    }
                }
                else if (_activeTab == "processor")
                {
                    <div class="column-timeline" data-testid="column-ticket-path">
                        <ColumnEditorPhase Number="1" Title="@L["ColumnPhaseEntry"]" Hint="@L["ColumnPhaseEntryHint"]" TestId="column-entry-phase">
                    <div class="workflow-grid">
                        <label>@L["ColumnMaxTickets"]<input class="settings-input" type="number" min="0" @bind="_maxTickets" /></label>
                        <label>@L["ColumnCapacityMode"]
                            <select @bind="CapacityBlockingValue" aria-label="@L["ColumnCapacityMode"]">
                                <option value="false">@L["ColumnCapacityWarning"]</option>
                                <option value="true">@L["ColumnCapacityBlocking"]</option>
                            </select>
                        </label>
                    </div>
                    <p class="settings-hint">@L["ColumnCapacityHelp"]</p>
                    <label class="workflow-check"><input type="checkbox" data-testid="require-acceptance-criteria" @bind="_requireAcceptanceCriteria" /> <FieldHelp Label="@L["ColumnRequireAcceptanceCriteria"]" Help="@L["ColumnRequireAcceptanceCriteriaHelp"]" /></label>
                    <label class="workflow-check"><input type="checkbox" data-testid="require-validated-acceptance-criteria" @bind="_requireValidatedAcceptanceCriteria" /> <FieldHelp Label="@L["ColumnRequireValidatedAcceptanceCriteria"]" Help="@L["ColumnRequireValidatedAcceptanceCriteriaHelp"]" /></label>

                        </ColumnEditorPhase>
                        <ColumnEditorPhase Number="2" Title="@L["ColumnPhaseMode"]" Hint="@L["ColumnPhaseModeHint"]" TestId="column-mode-phase">
                            <div class="column-mode-options" role="radiogroup" aria-label="@L["ColumnPhaseMode"]">
                                @foreach (var mode in TreatmentModes)
                                {
                                    <label class="column-mode-option @(TreatmentMode == mode ? "column-mode-option--selected" : "")">
                                        <input type="radio" name="@_modeGroup" value="@mode" checked="@(TreatmentMode == mode)" @onchange="() => SelectTreatmentMode(mode)" data-testid="@($"column-mode-{mode}")" />
                                        <span><strong>@L[$"ColumnMode{mode}"]</strong><small>@L[$"ColumnMode{mode}Hint"]</small></span>
                                    </label>
                                }
                            </div>
                            <p class="settings-hint">@L["ColumnDormantDraftHint"]</p>
                        </ColumnEditorPhase>
                        @if (TreatmentMode != ColumnProcessingMode.None)
                        {
                            @if (!_processorExists)
                            {
                                <div class="processor-draft-notice" role="status">@L["ProcessorDraftNotice"]</div>
                            }
                            @if (IsJevOnlyMode)
                            {
                                <ColumnEditorPhase Number="3" Title="@L[_jevAcceptanceValidation ? "ColumnPhaseReview" : "ColumnPhaseTriage"]" Hint="@L[_jevAcceptanceValidation ? "ColumnPhaseReviewHint" : "ColumnPhaseTriageHint"]" TestId="column-jev-analysis-phase">
                                    @AgentIdentityFields()
                                    @JevConfidenceField()
                                    <p class="settings-hint" data-testid="jev-availability">@L[_jevAvailability.Available ? "JevAvailable" : "ColumnJevUnavailableHint"]</p>
                                    @if (_jevAcceptanceValidation)
                                    {
                                        <label>@L["JevColumnCriteria"]<textarea class="settings-input workflow-textarea" data-testid="jev-column-criteria" @bind="_jevCriteriaText"></textarea></label>
                                    }
                                </ColumnEditorPhase>
                                <ColumnEditorPhase Number="4" Title="@L[_jevAcceptanceValidation ? "ColumnPhaseOwnerDecision" : "ColumnPhaseRouting"]" Hint="@L[_jevAcceptanceValidation ? "ColumnPhaseOwnerDecisionHint" : "ColumnPhaseRoutingHint"]" TestId="column-routing-phase">
                                    @if (_jevAcceptanceValidation)
                                    {
                                        <label>@L["ColumnOwnerApprovalDestination"]<select @bind="_defaultTargetId">@ColumnOptions(true)</select></label>
                                        <label>@L["ColumnOwnerCorrectionsDestination"]<select @bind="CorrectionsTargetId">@ColumnOptions(true)</select></label>
                                        <p class="settings-hint">@L["ColumnOwnerDecisionHint"]</p>
                                    }
                                    else
                                    {
                                        @RoutingFields()
                                    }
                                </ColumnEditorPhase>
                                <section class="column-fallback" data-testid="column-jev-fallback">
                                    <label class="workflow-check"><input type="checkbox" data-testid="jev-fallback-to-agent" @bind="_jevFallbackToAgent" /> @L["ColumnJevFallback"]</label>
                                    <p class="settings-hint">@L["ColumnJevFallbackHint"]</p>
                                    @if (_jevFallbackToAgent)
                                    {
                                        <details class="column-fallback-settings" data-testid="column-fallback-settings">
                                            <summary>@L["ColumnFallbackSettings"]</summary>
                                            @AgentPhases(true)
                                        </details>
                                    }
                                    else
                                    {
                                        <p class="column-phase-notice" data-testid="column-no-fallback">@L["ColumnJevNoFallback"]</p>
                                    }
                                </section>
                            }
                            else
                            {
                                @AgentPhases(false)
                            }
                            @if (_state.RunsAgent)
                            {
                                @RecoveryFields()
                            }
                        }
                    </div>
                }
                else if (_activeTab == "schedules")
                {
                    <div class="processor-actions-heading scheduled-task-heading">
                        <div>
                            <h3>@L["ColumnSchedulesTitle"]</h3>
                            <p class="settings-hint">@L["ColumnSchedulesHint"]</p>
                        </div>
                        <button class="processor-secondary-btn" @onclick="AddScheduledTask">@L["ColumnAddSchedule"]</button>
                    </div>
                    @if (_scheduledTasks.Count == 0)
                    {
                        <div class="column-empty-state compact"><span class="column-empty-state-icon">◷</span><p>@L["ColumnNoSchedules"]</p></div>
                    }
                    @foreach (var task in _scheduledTasks)
                    {
                        <article class="scheduled-task-card" @key="task.Id">
                            <header>
                                <label class="workflow-check"><input type="checkbox" @bind="task.Enabled" /> @L["Enabled"]</label>
                                <button class="processor-secondary-btn" @onclick="() => _scheduledTasks.Remove(task)">@L["ProcessorRemove"]</button>
                            </header>
                            <div class="workflow-grid scheduled-task-fields">
                                <label><FieldHelp Label="@L["Name"]" Help="@L["ScheduleNameHelp"]" /><input @bind="task.Name" /></label>
                                <label><FieldHelp Label="@L["ScheduleTimezone"]" Help="@L["ScheduleTimezoneHelp"]" /><input @bind="task.TimeZoneId" /></label>
                                <label><FieldHelp Label="@L["ScheduleTicketScope"]" Help="@L["ScheduleTicketScopeHelp"]" />
                                    <select @bind="task.TicketScope">
                                        <option value="@ScheduledTaskTicketScope.None">@L["ScheduleNoTicket"]</option>
                                        <option value="@ScheduledTaskTicketScope.FirstTicket">@L["ScheduleFirstTicket"]</option>
                                    </select>
                                </label>
                                <div class="scheduled-task-schedule">
                                    <FieldHelp Label="@L["ScheduleCalendar"]" Help="@L["ScheduleCalendarHelp"]" />
                                    <CronScheduleEditor Cron="@task.Cron" CronChanged="cron => task.Cron = cron" />
                                </div>
                            </div>
                            @ScheduledActionSection(task)
                        </article>
                    }
                }
            </div>

            <footer class="processor-dialog-footer">
                <button class="processor-secondary-btn" @onclick="CloseAsync">@L["Cancel"]</button>
                <button class="settings-primary" @onclick="SaveAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_columnName))">@(_saving ? "…" : L[IsCreating ? "CreateColumn" : "Save"])</button>
            </footer>
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public required string Slug { get; set; }
    [Parameter] public BoardColumn? Column { get; set; }
    [Parameter] public BoardColumn? TemplateColumn { get; set; }
    [Parameter, EditorRequired] public int PipelineId { get; set; }
    [Parameter] public int InsertIndex { get; set; } = -1;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }


    private static readonly ColumnProcessingMode[] TreatmentModes = Enum.GetValues<ColumnProcessingMode>();
    private readonly string _modeGroup = $"column-treatment-{Guid.NewGuid():N}";
    private ColumnProcessingState _state = new();
    private ColumnProcessor? _savedProcessor;
    private bool IsJevOnlyMode => _state.IsJevOnly;
    private ColumnProcessingMode TreatmentMode => _state.Mode;
    private void SelectTreatmentMode(ColumnProcessingMode mode)
    {
        if (!_processorDraft && mode != ColumnProcessingMode.None) CreateProcessorDraft();
        _state = _state.TransitionTo(mode);
    }
    private int? CorrectionsTargetId
    {
        get => _routes.FirstOrDefault(r => r.Outcome.Equals("changes_requested", StringComparison.OrdinalIgnoreCase))?.TargetColumnId;
        set
        {
            _routes.RemoveAll(r => r.Outcome.Equals("changes_requested", StringComparison.OrdinalIgnoreCase));
            if (value is > 0) _routes.Add(new RouteDraft { Outcome = "changes_requested", TargetColumnId = value.Value });
        }
    }
    private RenderFragment AgentIdentityFields() => @<div class="column-agent-identity">
                        <label><FieldHelp Label="@L["Name"]" Help="@L["ProcessorNameHelp"]" /><input class="settings-input" @bind="_name" /></label>
                        <label><FieldHelp Label="@L["ProcessorMission"]" Help="@L["ProcessorMissionHelp"]" /><textarea class="settings-input workflow-textarea" @bind="_mission"></textarea></label>
                        <label><FieldHelp Label="@L["ProcessorPrompt"]" Help="@L["ProcessorPromptHelp"]" /><textarea class="settings-input workflow-textarea processor-prompt" @bind="_prompt"></textarea></label>

    </div>;
    private RenderFragment JevConfidenceField() => @<label><FieldHelp Label="@L["JevConfidenceThreshold"]" Help="@L["ColumnJevConfidenceHint"]" /><input class="settings-input" type="number" min="0" max="100" step="1" data-testid="jev-confidence-threshold" @bind="_jevConfidencePercent" /></label>;
    private RenderFragment RoutingFields() => @<div class="column-routing-fields">
                        <div class="workflow-grid">
                            <label><FieldHelp Label="@L["ProcessorDefaultDestination"]" Help="@L["ProcessorDefaultDestinationHelp"]" />
                                <select @bind="_defaultTargetId">@ColumnOptions(true)</select>
                            </label>
                        </div>
                        @foreach (var route in _routes)
                        {
                            <div class="settings-row route-row">
                                <label class="route-field"><FieldHelp Label="@L["ProcessorOutcome"]" Help="@L["ProcessorOutcomeHelp"]" /><input placeholder="@L["ProcessorOutcomePlaceholder"]" @bind="route.Outcome" /></label>
                                <span>&rarr;</span>
                                <label class="route-field"><FieldHelp Label="@L["ProcessorRouteDestination"]" Help="@L["ProcessorRouteDestinationHelp"]" /><select @bind="route.TargetColumnId">@ColumnOptions(false)</select></label>
                                <button class="processor-secondary-btn" @onclick="() => _routes.Remove(route)">@L["ProcessorRemove"]</button>
                            </div>
                        }
                        <button class="processor-secondary-btn" @onclick="AddRoute">@L["ProcessorAddRoute"]</button>
    </div>;
    private RenderFragment AgentPhases(bool fallback) => @<div class="column-agent-phases" data-testid="@(fallback ? "column-fallback-agent" : "column-agent-phases")">
        <ColumnEditorPhase Number="3" Title="@L["ColumnPhasePrepare"]" Hint="@L["ColumnPhasePrepareHint"]">
                            <label><FieldHelp Label="@L["ProcessorTicketOrder"]" Help="@L["ProcessorTicketOrderHelp"]" />
                                <select @bind="_selectionOrder">
                                    @foreach (var order in Enum.GetValues<TicketSelectionOrder>())
                                    {
                                        <option value="@order">@SelectionOrderLabel(order)</option>
                                    }
                                </select>
                            </label>

            @if (!fallback)
            {
                <label class="workflow-check"><input type="checkbox" data-testid="jev-profile-mode" @bind="_jevExecutionSelection" /> <FieldHelp Label="@L["ColumnJevSelectProfile"]" Help="@L["JevProfileHelp"]" /></label>
                @if (_jevExecutionSelection)
                {
                            @foreach (var profile in _jevProfiles)
                            {
                                <div class="worktree-summary jev-profile-editor" @key="profile" data-testid="jev-profile-editor">
                                    <label>@L["Name"]<input class="settings-input" @bind="profile.Name" /></label>
                                    <label>@L["Description"]<input class="settings-input" @bind="profile.Description" /></label>
                                    <label>@L["ProcessorModel"]<select class="settings-input" @bind="profile.Model">
                                        @foreach (var model in AllModels) { <option value="@model">@model</option> }
                                        @if (!AllModels.Contains(profile.Model)) { <option value="@profile.Model">@profile.Model</option> }
                                    </select></label>
                                    @foreach (var skill in _skills.Where(s => _availableSkills.Contains(s.Slug) || _recommendedSkills.Contains(s.Slug) || _requiredSkills.Contains(s.Slug)))
                                    {
                                        <label class="workflow-check"><input type="checkbox" checked="@(profile.Skills.Contains(skill.Slug) || _requiredSkills.Contains(skill.Slug))" disabled="@_requiredSkills.Contains(skill.Slug)" @onchange="e => ToggleProfileSkill(profile, skill.Slug, e.Value is true)" /> @skill.Name</label>
                                    }
                                    <button class="settings-browse" @onclick="() => _jevProfiles.Remove(profile)">@L["Delete"]</button>
                                </div>
                            }
                            <button class="settings-browse" data-testid="jev-add-profile" @onclick="AddJevProfile">@L["JevAddProfile"]</button>

                    @JevConfidenceField()
                }
            }
            @ActionSection(_beforeActions, true)
            <p class="settings-hint">@L["ColumnActionsSuccessTiming"]</p>
        </ColumnEditorPhase>
        <ColumnEditorPhase Number="4" Title="@L["ColumnPhaseExecute"]" Hint="@L["ColumnPhaseExecuteHint"]">
            @if (!fallback) { @AgentIdentityFields() }
                        <label><FieldHelp Label="@L["ProcessorModel"]" Help="@L["ProcessorModelHelp"]" />
                            <select @key="@($"{_model}#{AllModels.Count}")" value="@(_model ?? "")" @onchange="OnModelChanged">
                                <option value="">@L["ProcessorModelAutomatic"]</option>
                                <optgroup label="Claude">
                                    @foreach (var model in ClaudeModels)
                                    {
                                        <option value="@model">@model</option>
                                    }
                                </optgroup>
                                @if (_grokModels.Count > 0)
                                {
                                    <optgroup label="Grok">
                                        @foreach (var model in _grokModels) { <option value="@model">@model</option> }
                                    </optgroup>
                                }
                                @if (_codexModels.Count > 0)
                                {
                                    <optgroup label="OpenAI Codex">
                                        @foreach (var model in _codexModels) { <option value="@model">@model</option> }
                                    </optgroup>
                                }
                                @if (_mistralModels.Count > 0)
                                {
                                    <optgroup label="Mistral Vibe">
                                        @foreach (var model in _mistralModels) { <option value="@model">@model</option> }
                                    </optgroup>
                                }
                                @if (_deepSeekModels.Count > 0)
                                {
                                    <optgroup label="DeepSeek">
                                        @foreach (var model in _deepSeekModels) { <option value="@model">@model</option> }
                                    </optgroup>
                                }
                                @if (_ollamaModels.Count > 0)
                                {
                                    <optgroup label="Local (Ollama)">
                                        @foreach (var model in _ollamaModels) { <option value="@model">@model</option> }
                                    </optgroup>
                                }
                                @if (!string.IsNullOrWhiteSpace(_model) && !AllModels.Contains(_model))
                                {
                                    <option value="@_model">@_model @L["ProcessorModelCustom"]</option>
                                }
                            </select>
                        </label>


                            <label><FieldHelp Label="@L["ProcessorTurnLimit"]" Help="@L["ProcessorTurnLimitHelp"]" /><input type="number" min="1" @bind="_maxTurns" /></label>

                        <h3>@L["ProcessorSkills"]</h3>
                        <p class="settings-hint">@L["ProcessorSkillsHint"]</p>
                        @if (_skills.Count == 0)
                        {
                            <p class="settings-hint">@L["ProcessorNoSkills"]</p>
                        }
                        else
                        {
                            <div class="skill-matrix">
                                @foreach (var skill in _skills)
                                {
                                    <div><strong>@skill.Name</strong><code>@skill.Slug</code></div>
                                    <label><input type="checkbox" checked="@_availableSkills.Contains(skill.Slug)" @onchange="e => ToggleSkill(_availableSkills, skill.Slug, e)" /> <FieldHelp Label="@L["ProcessorAvailable"]" Help="@L["ProcessorAvailableHelp"]" /></label>
                                    <label><input type="checkbox" checked="@_recommendedSkills.Contains(skill.Slug)" @onchange="e => ToggleSkill(_recommendedSkills, skill.Slug, e)" /> <FieldHelp Label="@L["ProcessorRecommended"]" Help="@L["ProcessorRecommendedHelp"]" /></label>
                                    <label><input type="checkbox" checked="@_requiredSkills.Contains(skill.Slug)" @onchange="e => ToggleSkill(_requiredSkills, skill.Slug, e)" /> <FieldHelp Label="@L["ProcessorRequired"]" Help="@L["ProcessorRequiredHelp"]" /></label>
                                }
                            </div>
                        }
        </ColumnEditorPhase>
        <ColumnEditorPhase Number="5" Title="@L["ColumnPhaseResult"]" Hint="@L["ColumnPhaseResultHint"]">
            <label class="workflow-check"><input type="checkbox" data-testid="evaluate-acceptance-criteria" @bind="_evaluateAcceptanceCriteria" /> <FieldHelp Label="@L["ProcessorEvaluateAcceptance"]" Help="@L["ProcessorEvaluateAcceptanceHelp"]" /></label>
            @if (_evaluateAcceptanceCriteria) { <p class="column-phase-notice">@L["ColumnProofTiming"]</p> }
            <p class="settings-hint">@L["ColumnResultMemoryHint"]</p>
        </ColumnEditorPhase>
        <ColumnEditorPhase Number="6" Title="@L["ColumnPhaseRouting"]" Hint="@L["ColumnPhaseRoutingHint"]">
            @if (!fallback)
            {
                <label class="workflow-check"><input type="checkbox" data-testid="jev-automatic-routing-mode" @bind="_jevAutomaticRouting" /> @L["ColumnJevRouteAfterAgent"]</label>
                @if (_jevAutomaticRouting) { @JevConfidenceField() <p class="settings-hint">@L["ColumnJevRoutingFallback"]</p> }
            }
            @RoutingFields()
        </ColumnEditorPhase>
        <ColumnEditorPhase Number="7" Title="@L["ColumnPhaseFinalize"]" Hint="@L["ColumnPhaseFinalizeHint"]">
            @ActionSection(_afterActions, false)
            <p class="settings-hint">@L["ColumnActionsSuccessTiming"]</p>
        </ColumnEditorPhase>
    </div>;
    private RenderFragment RecoveryFields() => @<details class="column-recovery" data-testid="column-recovery">
        <summary>@L["ColumnTechnicalRecovery"]</summary>
        <div class="workflow-grid">
                            <label><FieldHelp Label="@L["ProcessorMaxAttempts"]" Help="@L["ProcessorMaxAttemptsHelp"]" /><input type="number" min="1" @bind="_maxAttempts" /></label>
                            <label><FieldHelp Label="@L["ProcessorRetryDelay"]" Help="@L["ProcessorRetryDelayHelp"]" /><input type="number" min="1" @bind="_retryBackoff" /></label>

                            <label><FieldHelp Label="@L["ProcessorFailureDestination"]" Help="@L["ProcessorFailureDestinationHelp"]" />
                                <select @bind="_technicalFailureTargetId">@ColumnOptions(true)</select>
                            </label>

        </div>
    </details>;

    private bool IsCreating => Column is null;
    private bool _loading = true;
    private bool _saving;
    private bool _processorExists;
    private bool _processorDraft;
    private JevAvailability _jevAvailability = new(false, false, null);
    private bool _jevAcceptanceValidation => _state.Mode == ColumnProcessingMode.Review;
    private bool _jevExecutionSelection { get => _state.SelectProfile; set => _state = _state with { SelectProfile = value }; }
    private bool _evaluateAcceptanceCriteria;
    private string _jevCriteriaText = "";
    private List<JevProfileDraft> _jevProfiles = [];
    private sealed class JevProfileDraft
    {
        public string Name { get; set; } = "";
        public string Model { get; set; } = "";
        public string Description { get; set; } = "";
        public HashSet<string> Skills { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    }
    private void AddJevProfile() => _jevProfiles.Add(new() { Name = $"Profile {_jevProfiles.Count + 1}", Model = _model ?? ClaudeModels.First(), Skills = new(_requiredSkills, StringComparer.OrdinalIgnoreCase) });
    private static void ToggleProfileSkill(JevProfileDraft profile, string skill, bool selected)
    { if (selected) profile.Skills.Add(skill); else profile.Skills.Remove(skill); }
    private bool _jevFallbackToAgent { get => _state.FallbackToAgent; set => _state = _state with { FallbackToAgent = value }; }
    private bool _jevAutomaticRouting { get => _state.RouteWithJev; set => _state = _state with { RouteWithJev = value }; }
    private double _jevConfidencePercent = 90;
    private string _activeTab = "processor";
    private string _columnName = "";
    private string _columnColor = "#5a6a80";
    private ColumnRole _columnRole;
    private string _userGuidance = "";
    private int _positionIndex;
    private int _maxTickets;
    private bool _capacityBlocking;
    private bool _requireAcceptanceCriteria;
    private bool _requireValidatedAcceptanceCriteria;
    private string CapacityBlockingValue
    {
        get => _capacityBlocking ? "true" : "false";
        set => _capacityBlocking = value == "true";
    }
    private string _name = "";
    private string _mission = "";
    private string _prompt = "";
    private string? _model;
    private static readonly IReadOnlyList<string> ClaudeModels = ClaudeModelCatalog.Models;
    private List<string> _ollamaModels = [];
    private List<string> _grokModels = [];
    private List<string> _mistralModels = [];
    private List<string> _codexModels = [];
    private List<string> _deepSeekModels = [];
    private List<string> AllModels => ClaudeModels.Concat(_grokModels).Concat(_codexModels).Concat(_mistralModels).Concat(_deepSeekModels).Concat(_ollamaModels).ToList();
    private int _maxTurns = 100;
    private int _maxAttempts = 3;
    private int _retryBackoff = 60;
    private TicketSelectionOrder _selectionOrder;
    private int? _defaultTargetId;
    private int? _technicalFailureTargetId;
    private List<ProjectSkill> _skills = [];
    private List<Pipeline> _pipelines = [];
    private readonly Dictionary<int, List<BoardColumn>> _pipelineColumns = [];
    private HashSet<string> _availableSkills = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _recommendedSkills = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _requiredSkills = new(StringComparer.OrdinalIgnoreCase);
    private List<RouteDraft> _routes = [];
    private List<ColumnActionDraft> _beforeActions = [];
    private List<ColumnActionDraft> _afterActions = [];
    private List<ColumnScheduledTask> _scheduledTasks = [];
    private bool _confirmDelete;
    private int _deleteTargetId;
    private string? _message;
    private bool _isError;
    private IDisposable? _escapeToken;

    private List<BoardColumn> PipelineColumns => _pipelineColumns.GetValueOrDefault(PipelineId, []);
    private List<BoardColumn> SiblingColumns => PipelineColumns.Where(column => column.Id != Column?.Id).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _pipelines = await PipelineService.ListAsync(Slug);
            foreach (var pipeline in _pipelines)
                _pipelineColumns[pipeline.Id] = await ColumnService.ListColumnsAsync(Slug, pipeline.Id);
            _skills = await SkillService.ListAsync(Slug);
            _jevAvailability = await JevConfiguration.GetAsync(Slug);
            await LoadModelsAsync();

            var source = Column ?? TemplateColumn;
            _columnName = Column?.Name ?? (TemplateColumn is null ? "" : L.Get("ColumnCopyName", TemplateColumn.Name));
            _columnColor = source?.Color ?? "#5a6a80";
            _columnRole = source?.Role ?? ColumnRole.Normal;
            _userGuidance = source?.UserGuidance ?? "";
            _maxTickets = source?.MaxTickets ?? 0;
            _capacityBlocking = source?.CapacityBlocking ?? false;
            _requireAcceptanceCriteria = source?.RequireAcceptanceCriteria ?? false;
            _requireValidatedAcceptanceCriteria = source?.RequireValidatedAcceptanceCriteria ?? false;
            var sourceIndex = source is null ? PipelineColumns.Count : PipelineColumns.FindIndex(column => column.Id == source.Id);
            _positionIndex = Math.Clamp(InsertIndex >= 0 ? InsertIndex : Math.Max(0, sourceIndex), 0, SiblingColumns.Count);
            _deleteTargetId = SiblingColumns.FirstOrDefault()?.Id ?? 0;

            var processor = source is null ? null : await ProcessorService.GetAsync(Slug, source.Id);
            _processorExists = Column is not null && processor is not null;
            _processorDraft = processor is not null;
            _savedProcessor = processor;
            ApplyProcessor(processor, source?.Name);
            if (TemplateColumn is not null && processor is not null)
                _name = L.Get("ColumnCopyName", processor.Name);
            if (Column is not null)
                _scheduledTasks = await ScheduledTaskService.ListAsync(Slug, Column.Id);
        }
        catch (Exception ex)
        {
            _message = ex.GetBaseException().Message.Contains("column_acceptance_criteria_not_validated") ? L["ColumnAcceptanceCriteriaNotValidatedError"] : ex.GetBaseException().Message.Contains("column_acceptance_criteria_required") ? L["ColumnAcceptanceCriteriaRequiredError"] : ex.Message;
            _isError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadModelsAsync()
    {
        try
        {
            var http = HttpFactory.CreateClient("KittyClawLocal");
            var ollama = http.GetFromJsonAsync<List<string>>($"/api/projects/{Slug}/ollama-models");
            var grok = http.GetFromJsonAsync<List<string>>("/api/grok-models");
            var mistral = http.GetFromJsonAsync<List<string>>("/api/mistral-models");
            var codex = http.GetFromJsonAsync<List<string>>("/api/codex-models");
            var deepSeek = http.GetFromJsonAsync<List<string>>("/api/deepseek-models");
            await Task.WhenAll(ollama, grok, codex, mistral, deepSeek);
            _ollamaModels = await ollama ?? [];
            _grokModels = await grok ?? [];
            _mistralModels = await mistral ?? [];
            _codexModels = await codex ?? [];
            _deepSeekModels = await deepSeek ?? [];
        }
        catch
        {
            // Model discovery is optional; the built-in catalog and any saved custom value remain usable.
        }
    }

    private void OnModelChanged(ChangeEventArgs e) =>
        _model = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString();

    private void ApplyProcessor(ColumnProcessor? processor, string? sourceName)
    {
        _state = ColumnProcessingState.From(processor);
        _name = processor?.Name ?? $"{sourceName ?? _columnName} processor";
        _mission = processor?.Mission ?? "Process the selected ticket and return a structured outcome.";
        _prompt = processor?.Prompt ?? "";
        _model = processor?.Model;
        _evaluateAcceptanceCriteria = processor?.EvaluateAcceptanceCriteria ?? false;
        _jevCriteriaText = string.Join("\n", processor?.JevAcceptanceCriteria ?? []);
        _jevProfiles = processor?.JevExecutionProfiles.Select(p => new JevProfileDraft { Name = p.Name, Model = p.Model, Description = p.Description, Skills = new(p.Skills, StringComparer.OrdinalIgnoreCase) }).ToList() ?? [];
        _jevConfidencePercent = (processor?.JevConfidenceThreshold ?? 0.9) * 100;
        _maxTurns = processor?.MaxTurns ?? 100;
        _maxAttempts = processor?.MaxAttempts ?? 3;
        _retryBackoff = processor?.RetryBackoffSeconds ?? 60;
        _selectionOrder = processor?.SelectionOrder ?? TicketSelectionOrder.Position;
        _defaultTargetId = processor?.DefaultTargetColumnId;
        _technicalFailureTargetId = processor?.TechnicalFailureColumnId;
        _availableSkills = new(processor?.AvailableSkills ?? [], StringComparer.OrdinalIgnoreCase);
        _recommendedSkills = new(processor?.RecommendedSkills ?? [], StringComparer.OrdinalIgnoreCase);
        _requiredSkills = new(processor?.RequiredSkills ?? [], StringComparer.OrdinalIgnoreCase);
        _routes = processor?.Routes.Select(route => new RouteDraft { Outcome = route.Outcome, TargetColumnId = route.TargetColumnId }).ToList() ?? [];
        _beforeActions = processor?.BeforeActions.Select(ColumnActionDraft.FromModel).ToList() ?? [];
        _afterActions = processor?.AfterActions.Select(ColumnActionDraft.FromModel).ToList() ?? [];
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _escapeToken = EscapeStack.PushWithFocus(JS, () => InvokeAsync(CloseAsync));
        return Task.CompletedTask;
    }

    private SaveColumnProcessorRequest? BuildProcessorRequest() => ColumnProcessorEditorSave.Build(_state, _savedProcessor,
        new Dictionary<ColumnProcessingStage, Func<SaveColumnProcessorRequest, SaveColumnProcessorRequest>>
        {
            [ColumnProcessingStage.Definition] = request => request with { Name = _name, Mission = _mission, Prompt = _prompt },
            [ColumnProcessingStage.Preparation] = request => request with { SelectionOrder = _selectionOrder,
                BeforeActions = _beforeActions.Select(action => action.ToModel()).ToList() },
            [ColumnProcessingStage.ProfileSelection] = request => request with { JevConfidenceThreshold = _jevConfidencePercent / 100,
                JevExecutionProfiles = _jevProfiles.Select(p => new JevExecutionProfile(p.Name, p.Model,
                    p.Skills.Union(_requiredSkills, StringComparer.OrdinalIgnoreCase).ToList(), p.Description)).ToList() },
            [ColumnProcessingStage.Execution] = request => request with { Model = _model, MaxTurns = _maxTurns,
                AvailableSkills = _availableSkills.ToList(), RecommendedSkills = _recommendedSkills.ToList(), RequiredSkills = _requiredSkills.ToList() },
            [ColumnProcessingStage.Result] = request => request with { EvaluateAcceptanceCriteria = _evaluateAcceptanceCriteria },
            [ColumnProcessingStage.JevAnalysis] = request => request with { JevConfidenceThreshold = _jevConfidencePercent / 100 },
            [ColumnProcessingStage.ReviewCriteria] = request => request with { JevAcceptanceCriteria = _jevCriteriaText.Split('\n',
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList() },
            [ColumnProcessingStage.OwnerRouting] = request => request with { DefaultTargetColumnId = _defaultTargetId,
                Routes = ColumnProcessorEditorSave.OwnerRoutes(request.Routes, CorrectionsTargetId) },
            [ColumnProcessingStage.Routing] = request => request with { DefaultTargetColumnId = _defaultTargetId,
                Routes = _routes.Where(route => !string.IsNullOrWhiteSpace(route.Outcome) && route.TargetColumnId > 0)
                    .Select(route => new ColumnRoute(route.Outcome, route.TargetColumnId)).ToList(),
                JevConfidenceThreshold = _state.RouteWithJev && _state.Mode == ColumnProcessingMode.Agent
                    ? _jevConfidencePercent / 100 : request.JevConfidenceThreshold },
            [ColumnProcessingStage.Finalization] = request => request with { AfterActions = _afterActions.Select(action => action.ToModel()).ToList() },
            [ColumnProcessingStage.Recovery] = request => request with { MaxAttempts = _maxAttempts,
                RetryBackoffSeconds = _retryBackoff, TechnicalFailureColumnId = _technicalFailureTargetId }
        });

    private async Task SaveAsync()
    {
        _saving = true;
        _message = null;
        try
        {
            var trimmedName = _columnName.Trim();
            if (PipelineColumns.Any(column => column.Id != Column?.Id && column.Name.Equals(trimmedName, StringComparison.OrdinalIgnoreCase)))
                throw new InvalidOperationException(L["ColumnNameAlreadyExists"]);

            BoardColumn savedColumn;
            if (IsCreating)
            {
                savedColumn = await ColumnService.CreateColumnAsync(Slug, trimmedName, _columnColor, PipelineId,
                    _columnRole, _positionIndex, _userGuidance, _maxTickets, _capacityBlocking, _requireAcceptanceCriteria, _requireValidatedAcceptanceCriteria);
            }
            else
            {
                savedColumn = await ColumnService.UpdateColumnAsync(Slug, Column!.Id, trimmedName, _columnColor,
                    _columnRole, _userGuidance, _maxTickets, _capacityBlocking, _requireAcceptanceCriteria, _requireValidatedAcceptanceCriteria)
                    ?? throw new InvalidOperationException(L["ColumnNameAlreadyExists"]);
                await ColumnService.ReorderColumnAsync(Slug, savedColumn.Id, _positionIndex);
            }

            var processorRequest = BuildProcessorRequest();
            if (processorRequest is { } request)
            {
                await ProcessorService.SaveAsync(Slug, savedColumn.Id, request.Name, request.Mission, request.Model,
                    request.Enabled, request.MaxTurns, request.AvailableSkills, request.RecommendedSkills, request.RequiredSkills,
                    request.SelectionOrder, request.MaxAttempts, request.RetryBackoffSeconds, request.DefaultTargetColumnId,
                    request.TechnicalFailureColumnId, request.Routes, request.Prompt, request.BeforeActions, request.AfterActions,
                    request.JevObservationOnly, request.JevPostRunObservation, request.JevAutomaticRouting, request.JevConfidenceThreshold,
                    request.JevAcceptanceValidation, request.JevExecutionSelection, request.JevAcceptanceCriteria,
                    request.JevExecutionProfiles, request.EvaluateAcceptanceCriteria, request.JevFallbackToAgent);
            }

            await ScheduledTaskService.SaveColumnAsync(Slug, savedColumn.Id, _scheduledTasks);

            await CloseAsync();
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _message = ex.GetBaseException().Message.Contains("column_acceptance_criteria_not_validated") ? L["ColumnAcceptanceCriteriaNotValidatedError"] : ex.GetBaseException().Message.Contains("column_acceptance_criteria_required") ? L["ColumnAcceptanceCriteriaRequiredError"] : ex.Message;
            _isError = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteColumnAsync()
    {
        var target = SiblingColumns.FirstOrDefault(column => column.Id == _deleteTargetId);
        if (Column is null || target is null) return;
        try
        {
            if (!await ColumnService.DeleteColumnAsync(Slug, Column.Id, target.Name))
                throw new InvalidOperationException(L["ColumnDeleteFailed"]);
            await OnSaved.InvokeAsync();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            _message = ex.GetBaseException().Message.Contains("column_acceptance_criteria_not_validated") ? L["ColumnAcceptanceCriteriaNotValidatedError"] : ex.GetBaseException().Message.Contains("column_acceptance_criteria_required") ? L["ColumnAcceptanceCriteriaRequiredError"] : ex.Message;
            _isError = true;
        }
    }

    private void CreateProcessorDraft()
    {
        _processorDraft = true;
        ApplyProcessor(null, _columnName);
    }

    private string TabClass(string tab) => $"column-editor-tab {(_activeTab == tab ? "column-editor-tab--active" : "")}";
    private string GeneralTabClass => TabClass("general");
    private string ProcessorTabClass => TabClass("processor");
    private string SchedulesTabClass => TabClass("schedules");
    private void OpenGeneralTab() => _activeTab = "general";
    private void OpenProcessorTab() => _activeTab = "processor";
    private void OpenSchedulesTab() => _activeTab = "schedules";

    private string PositionLabel(int index)
    {
        if (SiblingColumns.Count == 0) return L["ColumnPositionOnly"];
        if (index == 0) return L.Get("ColumnPositionBefore", SiblingColumns[0].Name);
        if (index >= SiblingColumns.Count) return L.Get("ColumnPositionAfter", SiblingColumns[^1].Name);
        return L.Get("ColumnPositionBefore", SiblingColumns[index].Name);
    }

    private void ToggleSkill(HashSet<string> set, string slug, ChangeEventArgs e)
    {
        if (e.Value is true) set.Add(slug); else set.Remove(slug);
    }

    private void AddRoute()
    {
        var targets = TargetColumns;
        _routes.Add(new RouteDraft { TargetColumnId = targets.Count > 0 ? targets[0].Column.Id : 0 });
    }

    private RenderFragment ActionSection(List<ColumnActionDraft> actions, bool beforeAgent) => @<section class="processor-actions-section">
        <div class="processor-actions-heading">
            <div>
                <h3>@L[beforeAgent ? "ColumnActionsBefore" : "ColumnActionsAfter"]</h3>
                <p class="settings-hint">@L[beforeAgent ? "ColumnActionsBeforeHint" : "ColumnActionsAfterHint"]</p>
            </div>
            <button class="processor-secondary-btn" @onclick="() => AddProcessorAction(actions)">@L["ColumnAddAction"]</button>
        </div>
        @if (actions.Count == 0)
        {
            <p class="processor-actions-empty">@L["ColumnNoActions"]</p>
        }
        @for (var index = 0; index < actions.Count; index++)
        {
            var action = actions[index];
            var actionIndex = index;
            <article class="processor-action-card" @key="action.Id">
                <header>
                    <strong>@L.Get("ColumnActionNumber", actionIndex + 1)</strong>
                    <div class="processor-action-order">
                        <button class="processor-secondary-btn" disabled="@(actionIndex == 0)" @onclick="() => MoveAction(actions, actionIndex, -1)" title="@L["MoveUp"]">↑</button>
                        <button class="processor-secondary-btn" disabled="@(actionIndex == actions.Count - 1)" @onclick="() => MoveAction(actions, actionIndex, 1)" title="@L["MoveDown"]">↓</button>
                    </div>
                </header>
                <ActionEditor Action="action.Action"
                              Columns="AllColumnNames"
                              Members="EmptyMembers"
                              Slug="@Slug"
                              ProcessorMode="true"
                              OnReplace="replacement => ReplaceAction(action, replacement)"
                              OnDelete="() => actions.Remove(action)" />
                <label class="processor-action-failure">
                    <FieldHelp Label="@L["ColumnActionFailureDestination"]" Help="@L["ColumnActionFailureDestinationHelp"]" />
                    <select @bind="action.FailureTargetColumnId">@ColumnOptions(true)</select>
                </label>
            </article>
        }
    </section>;

    private List<string> AllColumnNames => TargetColumns.Select(target => target.Column.Name)
        .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    private static readonly List<string> EmptyMembers = [];

    private void AddProcessorAction(List<ColumnActionDraft> actions) => actions.Add(new ColumnActionDraft
    {
        Id = Guid.NewGuid().ToString("N"),
        Action = new ExecutePowerShellActionSpec(),
        FailureTargetColumnId = _technicalFailureTargetId,
    });

    private static void ReplaceAction(ColumnActionDraft draft, ActionSpec replacement) => draft.Action = replacement;

    private static void MoveAction(List<ColumnActionDraft> actions, int index, int delta)
    {
        var target = index + delta;
        if (index < 0 || index >= actions.Count || target < 0 || target >= actions.Count) return;
        (actions[index], actions[target]) = (actions[target], actions[index]);
    }

    private void AddScheduledTask() => _scheduledTasks.Add(new ColumnScheduledTask
    {
        Id = Guid.NewGuid().ToString("N"),
        ColumnId = Column?.Id ?? 0,
        Name = L["ScheduleDefaultName"],
        Cron = "0 9 * * 1",
        TimeZoneId = TimeZoneInfo.Local.Id,
        TicketScope = ScheduledTaskTicketScope.None,
        Actions = [new ColumnProcessorAction(Guid.NewGuid().ToString("N"), new CreateTicketActionSpec())],
    });

    private RenderFragment ScheduledActionSection(ColumnScheduledTask task) => @<section class="processor-actions-section scheduled-actions">
        <div class="processor-actions-heading">
            <h4>@L["ScheduleActions"]</h4>
            <button class="processor-secondary-btn" @onclick="() => AddScheduledAction(task)">@L["ColumnAddAction"]</button>
        </div>
        @for (var index = 0; index < task.Actions.Count; index++)
        {
            var action = task.Actions[index];
            <article class="processor-action-card" @key="action.Id">
                <ActionEditor Action="action.Action" Columns="AllColumnNames" Members="EmptyMembers" Slug="@Slug"
                    ProcessorMode="true"
                    OnReplace="replacement => ReplaceScheduledAction(task, action, replacement)"
                    OnDelete="() => RemoveScheduledAction(task, action)" />
                @if (task.TicketScope == ScheduledTaskTicketScope.FirstTicket)
                {
                    <label class="processor-action-failure"><FieldHelp Label="@L["ColumnActionFailureDestination"]" Help="@L["ScheduleFailureHelp"]" />
                        <select value="@action.FailureTargetColumnId" @onchange="e => ReplaceScheduledFailure(task, action, e.Value?.ToString())">@ColumnOptions(true)</select>
                    </label>
                }
            </article>
        }
    </section>;

    private static void ReplaceScheduledAction(ColumnScheduledTask task, ColumnProcessorAction current, ActionSpec replacement) =>
        task.Actions = task.Actions.Select(action => action.Id == current.Id ? current with { Action = replacement } : action).ToList();
    private static void AddScheduledAction(ColumnScheduledTask task) =>
        task.Actions = task.Actions.Append(new ColumnProcessorAction(
            Guid.NewGuid().ToString("N"), new ExecutePowerShellActionSpec(), null)).ToList();
    private static void RemoveScheduledAction(ColumnScheduledTask task, ColumnProcessorAction current) =>
        task.Actions = task.Actions.Where(action => action.Id != current.Id).ToList();
    private static void ReplaceScheduledFailure(ColumnScheduledTask task, ColumnProcessorAction current, string? value)
    {
        var target = int.TryParse(value, out var parsed) ? parsed : (int?)null;
        task.Actions = task.Actions.Select(action => action.Id == current.Id ? current with { FailureTargetColumnId = target } : action).ToList();
    }

    private List<(Pipeline Pipeline, BoardColumn Column)> TargetColumns =>
        _pipelines.SelectMany(pipeline => _pipelineColumns.GetValueOrDefault(pipeline.Id, [])
            .Where(column => column.Id != Column?.Id).Select(column => (pipeline, column))).ToList();

    private RenderFragment ColumnOptions(bool allowEmpty) => builder =>
    {
        var sequence = 0;
        if (allowEmpty)
        {
            builder.OpenElement(sequence++, "option");
            builder.AddAttribute(sequence++, "value", "");
            builder.AddContent(sequence++, L["ProcessorNone"]);
            builder.CloseElement();
        }
        foreach (var target in TargetColumns)
        {
            builder.OpenElement(sequence++, "option");
            builder.AddAttribute(sequence++, "value", target.Column.Id);
            builder.AddContent(sequence++, $"{target.Pipeline.Name} / {target.Column.Name}");
            builder.CloseElement();
        }
    };

    private string SelectionOrderLabel(TicketSelectionOrder order) => L[$"ProcessorOrder{order}"];

    private async Task CloseAsync()
    {
        _escapeToken?.Dispose();
        _escapeToken = null;
        await OnClose.InvokeAsync();
    }

    public void Dispose()
    {
        _escapeToken?.Dispose();
        _escapeToken = null;
    }

    private sealed class RouteDraft
    {
        public string Outcome { get; set; } = "";
        public int TargetColumnId { get; set; }
    }

    private sealed class ColumnActionDraft
    {
        public string Id { get; set; } = Guid.NewGuid().ToString("N");
        public ActionSpec Action { get; set; } = new SetLabelsActionSpec();
        public int? FailureTargetColumnId { get; set; }

        public ColumnProcessorAction ToModel() => new(Id, Action, FailureTargetColumnId);

        public static ColumnActionDraft FromModel(ColumnProcessorAction action) => new()
        {
            Id = action.Id,
            Action = action.Action,
            FailureTargetColumnId = action.FailureTargetColumnId,
        };
    }
}
